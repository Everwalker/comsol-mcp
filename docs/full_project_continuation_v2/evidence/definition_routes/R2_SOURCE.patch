+def _is_nonfinite_scalar(value: Any) -> bool:
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, (int, float)):
+        return not math.isfinite(float(value))
+    return isinstance(value, str) and value.strip().casefold() in {
+        "nan", "+nan", "-nan", "infinity", "+infinity", "-infinity",
+        "inf", "+inf", "-inf",
+    }
+
+
+def _mapping_method_semantics(method: str, exttol: float, usenan: str) -> str:
+    if method == "closest":
+        return "COMSOL documents closest as defined everywhere by using the nearest source-selection point; exttol is unused. Finite samples do not prove source-mesh overlap."
+    if method == "usetol":
+        outside = "returns NaN" if usenan == "on" else "raises an evaluation error"
+        return f"COMSOL documents usetol as defined within the source selection or slightly outside by relative mesh tolerance exttol={exttol:g}; outside it {outside}."
+    return f"COMSOL documents walk as traversing the source mesh and warns against disconnected components; exttol={exttol:g}, usenan={usenan}. Bounded samples do not prove global coverage."
