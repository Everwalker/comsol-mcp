+                "effective_policy_state": "UNVERIFIED", "safe_retry": False,
+                "cause_code": getattr(cause, "code", type(cause).__name__),
+                "evidence_classification": "SOFTWARE_ONLY" if self.software_only else "WINDOWS_NATIVE_READBACK_ONLY",
