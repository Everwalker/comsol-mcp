+        "authorization_ref_sha256": hashlib.sha256(ref.encode()).hexdigest(),
+        "scope_sha256": scope_sha256(profile.project_id, action, scope),
+        "expires_at_utc": (datetime.now(timezone.utc) + timedelta(hours=1)).strftime("%Y-%m-%dT%H:%M:%SZ"),
