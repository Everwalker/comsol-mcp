+    assert 'MIC_UNVERIFIED' in captured.value.details['reasons']
+    assert boundary._pending=={} and process.never_resumed
+    process.note_resume_attempt()
+    process.note_resume_attempt()
+    assert not process.never_resumed
+    # Even an otherwise live original HANDLE cannot use never-resumed cleanup
+    # after any possible Resume attempt. The actual owner remains retained.
+    with pytest.raises(ExecutionContractError):process.cleanup_owned(api,timeout=1)
+    assert not process._closed and process._owner is api
