+        self.owner=owner;self._seal=seal;self._entries={};self._seq=0;self._lock=threading.RLock()
+    def scope(self):
+        with self._lock:return _ResourceScope(self,self._seq,seal=_SEAL)
+    def acquire(self,adapter,handle,closer,*,mode='CHECKED',label='native_resource',keepalive=()):
+        if mode not in {'BOOL','LOCALFREE','VOID','CHECKED'} or not callable(closer):_fail('unsupported native release binding')
+        value=_value(handle)
+        with self._lock:
+            for entry in self._entries.values():
+                if entry.adapter is adapter and entry.value==value:
+                    return entry
+            self._seq+=1
