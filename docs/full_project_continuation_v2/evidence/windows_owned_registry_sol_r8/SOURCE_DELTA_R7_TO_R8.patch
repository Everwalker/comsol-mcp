+            # closer strongly held before any validation can raise.
+            entry=_OwnedResource(self,adapter,handle,closer,mode,label,self._seq,tuple(keepalive),seal=_SEAL)
+            self._entries[entry.seq]=entry;return entry
+    def find(self,adapter,handle):
+        value=_value(handle)
+        with self._lock:
+            return next((e for e in self._entries.values() if e.adapter is adapter and e.value==value),None)
+    def release(self,adapter,handle):
+        entry=self.find(adapter,handle)
+        if entry is None:_fail('no native acquisition registered for this exact adapter/handle')
+        return entry.release_owned(self.owner)
+    def drain(self,scope):
