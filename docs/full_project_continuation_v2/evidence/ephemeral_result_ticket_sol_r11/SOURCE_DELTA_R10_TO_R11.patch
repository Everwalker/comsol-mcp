+                   and cleanup_gates.get("safe_for_owned_cleanup") is True)
+    daemon_idle = isinstance(idle_proof, Mapping) and idle_proof.get("idle") is True
+    allowed = project_scope["cleanup_allowed"] and ledger_safe and daemon_idle
+    return {
