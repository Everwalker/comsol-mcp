+                                       operation="study.step_create",
+                                       arguments={"study": {"segments": [{"collection": "study", "tag": args.study_tag}]},
+                                                  "tag": "stat", "type_id": "Stationary", "properties": []},
+                                       store=store)
+            if _success(step_created):
