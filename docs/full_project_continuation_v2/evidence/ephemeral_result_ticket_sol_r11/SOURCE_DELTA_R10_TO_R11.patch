+                           or _first_feature_path(inspected)
+                           or {**solver_path, "segments": [
+                               *solver_path["segments"],
+                               {"collection": "feature", "tag": args.solver_feature_tag}]})
+    case.assertions["t020_solver_feature_path"] = solver_feature_path
