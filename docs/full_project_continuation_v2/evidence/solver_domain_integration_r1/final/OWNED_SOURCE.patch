+                                         stage="post_dispatch", details={"expected_model_ref": self.source_ref.as_dict(),
+                                                                          "expected_revision": self.expected_revision,
+                                                                          "actual_revision": state.revision,
+                                                                          "project_binding": binding,
+                                                                          "safe_retry": False})
