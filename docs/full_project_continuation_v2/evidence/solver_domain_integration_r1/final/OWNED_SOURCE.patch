+    reject_unknown_keys(body, allowed, "arguments")
+    missing = [key for key in required if body.get(key) is None]
+    if missing:
+        raise PreWriteRefusal("INVALID_REQUEST", f"arguments are missing required fields: {sorted(missing)}")
+    return body, context
