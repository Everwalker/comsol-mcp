+def test_v2_apply_recovery_required_is_absorbing_if_unknown_finish_write_fails(host_env, tmp_path):
+    profile, _old_plan, _action, _old_api, store, provider, authority, _old_executor = host_env
+    provider.close()
+    plan = _provider_sublayer_plan(profile, with_filter=True)
+    authorization_ref = "apply-unknown-finish-write-failure"
+    provider = _write_provider(tmp_path / "provider-config-apply-recovery-fence", profile,
+                               [_apply_grant(profile, plan, authorization_ref)])
+    authority.authorization_verifier = provider
+    api = FakeWfpSequence(profile)
+    api.fail_after = "wfp_sublayer"
+    executor = WindowsHostChangeExecutor._for_software_test(
+        store=store, authority=authority, profile=profile, api=api,
+        token=_SOFTWARE_TEST_TOKEN,
+    )
+
+    original_finish = store.finish
+
+    def fail_unknown_terminal_write(operation_id, *, status, result):
+        if status == "UNKNOWN":
+            raise OSError("simulated process/store failure before UNKNOWN terminal write")
+        return original_finish(operation_id, status=status, result=result)
+
+    store.finish = fail_unknown_terminal_write
+    with pytest.raises(WindowsHostChangeError) as unknown:
+        executor.apply(plan, approval=resources.HostChangeApproval(plan.sha256, authorization_ref))
+    store.finish = original_finish
+    assert unknown.value.code == "HOST_CHANGE_RECOVERY_REQUIRED"
+    admission = store.db.execute(
+        "SELECT * FROM host_control_admissions WHERE phase='APPLY'").fetchone()
+    assert admission["state"] == "RECOVERY_REQUIRED"
+    assert store.get_operation(admission["operation_id"])["status"] == "RUNNING"
+    assert store.job(admission["job_id"])["status"] == "RUNNING"
+    assert [item["event"] for item in _events_v2(store, admission["job_id"])] == [
+        "APPLY_STEP_INTENT", "APPLY_STEP_READBACK_VERIFIED",
+        "APPLY_STEP_INTENT", "RECOVERY_REQUIRED"]
+    _assert_v2_recovery_fence_absorbs_direct_and_hashed_suffix_events(
+        store, admission, phase="APPLY")
+    assert [item[:2] for item in api.calls] == [
+        ("create", "wfp_provider"), ("create", "wfp_sublayer")]
+    provider.close()
+
