+def _assert_v2_recovery_fence_absorbs_direct_and_hashed_suffix_events(
+        store, admission, *, phase):
+    assert phase in {"APPLY", "RESTORE"}
+    job_id = admission["job_id"]
+    events = _events_v2(store, job_id)
+    assert events[-1]["event"] == "RECOVERY_REQUIRED"
+    assert events[-2]["event"] == f"{phase}_STEP_INTENT"
+    pending = events[-2]["payload"]
+    steps = json.loads(admission["baseline_json"])["mutation_sequence"]["steps"]
+    next_index = pending["step_index"] + 1
+    assert next_index < len(steps)
+    next_step = steps[next_index]
+
+    verified_event = f"{phase}_STEP_READBACK_VERIFIED"
+    verified_payload = {
+        **pending,
+        ("created_resource_sha256" if phase == "APPLY" else "removed_resource_sha256"):
+            (pending.get("expected_resource_sha256") or "e" * 64),
+    }
+    next_intent_event = f"{phase}_STEP_INTENT"
+    next_intent = {
+        "step_index": next_index,
+        "action_id": next_step["action_id"],
+        "resource_kind": next_step["resource_kind"],
+        "resource_key": next_step["resource_key"],
+        "dependency_sha256": next_step["dependency_sha256"],
+        ("desired_identity_sha256" if phase == "APPLY" else "expected_resource_sha256"):
+            (next_step["identity_sha256"] if phase == "APPLY"
+             else next_step["expected_resource_sha256"]),
+    }
+
+    before = len(events)
+    for event, payload in ((verified_event, verified_payload),
+                           (next_intent_event, next_intent)):
+        with pytest.raises(resources.ResourcePolicyError) as refused:
+            store.append_host_control_mutation_step_event(
+                admission_id=admission["admission_id"], event=event, payload=payload)
+        assert refused.value.code == "HOST_CONTROL_JOURNAL_STATE_CONFLICT"
+        assert len(_events_v2(store, job_id)) == before
+        assert store.host_control_admission_state(admission["admission_id"]) == "RECOVERY_REQUIRED"
+
+    # Inject a fully hash-consistent, schema-valid readback suffix as if an
+    # earlier process wrote it before crashing. The next production append
+    # must reject the persisted history instead of treating it as recovery.
+    last = events[-1]
+    body = {key: value for key, value in last.items() if key != "record_sha256"}
+    body.update({
+        "sequence": len(events),
+        "previous_sha256": last["record_sha256"],
+        "event": verified_event,
+        "payload": verified_payload,
+    })
+    canonical = json.dumps(body, sort_keys=True, ensure_ascii=False,
+                           separators=(",", ":"), allow_nan=False)
+    suffix = {**body, "record_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest()}
+    store.db.execute(
+        "INSERT INTO job_events(job_id,event,metadata) VALUES(?,?,?)",
+        (job_id, "HostControlMutationJournalV2",
+         json.dumps(suffix, sort_keys=True, ensure_ascii=False,
+                    separators=(",", ":"), allow_nan=False)),
+    )
+    store.db.commit()
+    after_suffix = len(_events_v2(store, job_id))
+    assert after_suffix == before + 1
+    with pytest.raises(resources.ResourcePolicyError) as replay_refused:
+        store.append_host_control_mutation_step_event(
+            admission_id=admission["admission_id"],
+            event=next_intent_event,
+            payload=next_intent,
+        )
+    assert replay_refused.value.code == "HOST_CONTROL_JOURNAL_STATE_CONFLICT"
+    assert len(_events_v2(store, job_id)) == after_suffix
+    assert store.host_control_admission_state(admission["admission_id"]) == "RECOVERY_REQUIRED"
+
