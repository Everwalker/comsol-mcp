+def _verify_model_package_mph(report: _Report, stream: Any, embedded: list[dict[str, Any]]) -> None:
+    try:
+        with zipfile.ZipFile(stream, "r") as mph:
+            infos = mph.infolist()
+            if len(infos) > MAX_MODEL_PACKAGE_MPH_ENTRIES:
+                report.mark_incomplete("MODEL_MPH_ENTRY_LIMIT", "embedded MPH exceeds the nested entry budget", category="dependency")
+                return
+            members: dict[str, zipfile.ZipInfo] = {}
+            seen_names: set[str] = set()
+            expanded = 0
+            for info in infos:
+                try:
+                    name = _safe_name(info.orig_filename, is_directory=info.is_dir())
+                except ValueError:
+                    report.member_failure("UNSAFE_MPH_MEMBER", "embedded MPH contains an unsafe member name")
+                    continue
+                if name in seen_names or not _regular_member(info):
+                    report.member_failure("INVALID_MPH_MEMBER", "embedded MPH contains a duplicate or special member", name)
+                    continue
+                seen_names.add(name)
+                if info.is_dir():
+                    continue
+                expanded += info.file_size
+                if info.file_size > MAX_MODEL_PACKAGE_MPH_MEMBER_BYTES:
+                    report.mark_incomplete("MODEL_MPH_MEMBER_LIMIT", "embedded MPH member exceeds the per-member budget", category="dependency", member=name)
+                members[name] = info
+            if expanded > MAX_BUNDLE_NESTED_EXPANDED_BYTES:
+                report.mark_incomplete("MODEL_MPH_EXPANDED_LIMIT", "embedded MPH exceeds the expanded-byte budget", category="dependency")
+                return
+            for row in embedded:
+                if row.get("resolution") != "VERIFIED_EMBEDDED_MPH_MEMBER":
+                    report.mark_incomplete("EMBEDDED_DEPENDENCY_UNVERIFIED", "manifest declares an unresolved embedded FileResource", category="dependency")
+                    continue
+                name = row["archive_member"]
+                info = members.get(name)
+                if info is None:
+                    report.dependency_failure("MISSING_EMBEDDED_DEPENDENCY", "declared FileResource member is absent from model.mph", name)
+                    continue
+                if info.file_size > MAX_MODEL_PACKAGE_MPH_MEMBER_BYTES:
+                    continue
+                try:
+                    size, digest, _crc, _ = _read_zip_member(
+                        mph, info, limit=MAX_MODEL_PACKAGE_MPH_MEMBER_BYTES,
+                    )
+                except OverflowError:
+                    report.mark_incomplete("MODEL_MPH_MEMBER_LIMIT", "embedded dependency exceeds the read budget", category="dependency", member=name)
+                    continue
+                except (zipfile.BadZipFile, RuntimeError, OSError, ValueError, zlib.error):
+                    report.member_failure("MPH_MEMBER_READ_FAILURE", "embedded dependency member could not be read safely", name)
+                    continue
+                if size != row["size_bytes"] or digest != row["sha256"]:
+                    report.dependency_failure("EMBEDDED_DEPENDENCY_HASH_MISMATCH", "embedded dependency bytes differ from the model package manifest", name)
+    except (zipfile.BadZipFile, OSError, RuntimeError, ValueError, zlib.error):
+        report.member_failure("INVALID_MPH_ARCHIVE", "declared model.mph is not a readable ZIP archive")
+
+
