+            except OverflowError:
+                report.mark_incomplete("MODEL_PACKAGE_MEMBER_LIMIT", "manifest-declared member exceeds its specific read budget", member=name)
+                continue
+            except (zipfile.BadZipFile, RuntimeError, OSError, ValueError, zlib.error):
+                report.member_failure("MODEL_PACKAGE_MEMBER_READ_FAILURE", "manifest-declared member failed ZIP size/CRC validation", name)
+                continue
+            if size != declared["size_bytes"] or digest != declared["sha256"]:
+                report.member_failure("MODEL_PACKAGE_MEMBER_HASH_MISMATCH", "package member bytes differ from the manifest SHA-256/size", name)
+                if name.startswith("dependencies/"):
