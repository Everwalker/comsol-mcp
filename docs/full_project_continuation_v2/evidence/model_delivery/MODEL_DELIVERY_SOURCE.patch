+def _package_object(value: Any, required: set[str], optional: set[str] = frozenset()) -> bool:
+    return isinstance(value, dict) and required <= set(value) and not (set(value) - required - set(optional))
+
+
+def _package_digest_size(value: Any, *, allow_zero: bool = True) -> bool:
+    return (isinstance(value, dict) and set(value) == {"sha256", "size_bytes"}
+            and isinstance(value.get("sha256"), str) and _SHA256_RE.fullmatch(value["sha256"]) is not None
+            and isinstance(value.get("size_bytes"), int) and not isinstance(value.get("size_bytes"), bool)
+            and (value["size_bytes"] >= 0 if allow_zero else value["size_bytes"] > 0))
+
+
+def _package_relative_path(value: Any) -> str | None:
+    if not isinstance(value, str) or not value or value.startswith("/") or PureWindowsPath(value).drive:
+        return None
+    try:
+        return _safe_name(value)
+    except ValueError:
+        return None
+
+
+def _contains_absolute_path_text(value: Any) -> bool:
+    if isinstance(value, str):
+        return (value.startswith("/") or PureWindowsPath(value).is_absolute()
+                or _ABSOLUTE_PATH_TEXT.search(value) is not None)
+    if isinstance(value, dict):
+        return any(_contains_absolute_path_text(key) or _contains_absolute_path_text(item)
+                   for key, item in value.items())
+    if isinstance(value, list):
+        return any(_contains_absolute_path_text(item) for item in value)
+    return False
+
+
+def _validate_model_package_manifest(manifest: dict[str, Any]) -> tuple[str | None, dict[str, dict[str, Any]]]:
+    """Validate the closed manifest shape and return its expected file map."""
+    root_keys = {
+        "schema", "version", "format_version", "model", "contents", "embedded_dependencies",
+        "resolved_project_dependencies", "file_references", "dependency_coverage", "unresolved_items",
+        "external_code", "external_libraries_services", "portability_status",
+        "absolute_paths_in_manifest", "save_semantics",
+    }
+    if set(manifest) != root_keys:
+        return "manifest has missing or undeclared fields", {}
+    if (manifest.get("schema") != "comsol-mcp-model-package" or type(manifest.get("version")) is not int
+            or manifest.get("version") != 1 or manifest.get("format_version") != "comsol-mcp-model-package/1"):
+        return "manifest schema or version is unsupported", {}
+    model = manifest.get("model")
+    if (not _package_object(model, {"model_ref", "source_revision", "comsol_version", "include_solution"})
+            or not isinstance(model.get("model_ref"), dict)
+            or set(model["model_ref"]) != {"schema_version", "session_id", "server_instance_id", "model_tag", "generation"}
+            or type(model["model_ref"].get("schema_version")) is not int or model["model_ref"]["schema_version"] < 1
+            or not all(isinstance(model["model_ref"].get(name), str) and model["model_ref"][name]
+                       for name in ("session_id", "server_instance_id", "model_tag"))
+            or type(model["model_ref"].get("generation")) is not int or model["model_ref"]["generation"] < 1
+            or type(model.get("source_revision")) is not int or model["source_revision"] < 0
+            or not isinstance(model.get("comsol_version"), str) or not model["comsol_version"].strip()
+            or type(model.get("include_solution")) is not bool):
+        return "manifest model declaration is malformed", {}
+    contents = manifest.get("contents")
+    if (not _package_object(contents, {"model.mph"})
+            or not _package_digest_size(contents.get("model.mph"), allow_zero=False)):
+        return "manifest model.mph hash/size declaration is malformed", {}
+    dependencies = manifest.get("resolved_project_dependencies")
+    if not isinstance(dependencies, list) or len(dependencies) > MAX_OUTER_ENTRIES:
+        return "manifest dependency list is malformed or exceeds its row budget", {}
+    expected_files: dict[str, dict[str, Any]] = {"model.mph": contents["model.mph"]}
+    seen_project_paths: set[str] = set()
+    for row in dependencies:
+        if not _package_object(row, {"project_relative_path", "package_path", "sha256", "size_bytes"}):
+            return "manifest project dependency record is malformed", {}
+        source_path = _package_relative_path(row.get("project_relative_path"))
+        package_path = _package_relative_path(row.get("package_path"))
+        digest, size = row.get("sha256"), row.get("size_bytes")
+        if (source_path is None or package_path is None or source_path in seen_project_paths
+                or not isinstance(digest, str) or _SHA256_RE.fullmatch(digest) is None
+                or type(size) is not int or size < 0):
+            return "manifest project dependency path/hash/size is malformed or duplicated", {}
+        expected_path = f"dependencies/{digest}/{hashlib.sha256(source_path.encode('utf-8')).hexdigest()[:16]}.bin"
+        if package_path != expected_path:
+            return "manifest project dependency path does not match its declared identity", {}
+        if size > MAX_MODEL_PACKAGE_DEPENDENCY_BYTES:
+            return "manifest project dependency exceeds the member budget", {}
+        seen_project_paths.add(source_path)
+        expected_files[package_path] = {"sha256": digest, "size_bytes": size}
+    embedded = manifest.get("embedded_dependencies")
+    if not isinstance(embedded, list) or len(embedded) > MAX_OUTER_ENTRIES:
+        return "manifest embedded dependency list is malformed or exceeds its row budget", {}
+    for row in embedded:
+        if not isinstance(row, dict) or not isinstance(row.get("resource_tag"), str) or not row["resource_tag"]:
+            return "manifest embedded dependency record is malformed", {}
+        if row.get("resolution") == "VERIFIED_EMBEDDED_MPH_MEMBER":
+            if (set(row) != {"resource_tag", "archive_member", "sha256", "size_bytes", "resolution"}
+                    or _package_relative_path(row.get("archive_member")) is None
+                    or not isinstance(row.get("sha256"), str) or _SHA256_RE.fullmatch(row["sha256"]) is None
+                    or type(row.get("size_bytes")) is not int or row["size_bytes"] < 0):
+                return "manifest embedded dependency hash/size declaration is malformed", {}
+        elif row.get("state") == "UNVERIFIED":
+            if (set(row) != {"resource_tag", "state", "archive_members", "reason"}
+                    or not isinstance(row.get("archive_members"), list)
+                    or not all(_package_relative_path(name) is not None for name in row["archive_members"])
+                    or not isinstance(row.get("reason"), str)):
+                return "manifest unresolved embedded dependency record is malformed", {}
+        else:
+            return "manifest embedded dependency resolution state is unsupported", {}
+    references = manifest.get("file_references")
+    if not isinstance(references, list) or len(references) > MAX_OUTER_ENTRIES:
+        return "manifest file-reference list is malformed or exceeds its row budget", {}
+    dependency_by_source = {row["project_relative_path"]: row for row in dependencies}
+    for row in references:
+        if not isinstance(row, dict):
+            return "manifest file-reference entry is not an object", {}
+        kind = row.get("kind")
+        if kind == "function_data":
+            required = {"kind", "tag", "function_type", "authorized_source", "verification"}
+            optional = {"package_path"}
+            if (not _package_object(row, required, optional)
+                    or not isinstance(row.get("function_type"), str)):
+                return "manifest function reference is malformed", {}
+        elif kind == "cad_geometry":
+            required = {"kind", "component", "geometry", "feature", "authorized_source", "verification"}
+            optional = {"package_path"}
+            if not _package_object(row, required, optional):
+                return "manifest CAD reference is malformed", {}
+        else:
+            return "manifest file-reference kind is unsupported", {}
+        source = row.get("authorized_source")
+        if (not isinstance(source, dict) or not {"state", "project_relative_path"} <= set(source)
+                or set(source) - {"state", "project_relative_path", "sha256", "size_bytes", "reason"}
+                or source.get("state") not in {"VERIFIED", "AUTHORIZED_PROJECT_LOCAL", "MISSING", "UNVERIFIED"}):
+            return "manifest authorized-source declaration is malformed", {}
+        rel = source.get("project_relative_path")
+        if rel is not None and _package_relative_path(rel) is None:
+            return "manifest source path is not canonical project-relative", {}
+        if source["state"] == "VERIFIED":
+            dep = dependency_by_source.get(rel)
+            if (dep is None or source.get("sha256") != dep["sha256"]
+                    or source.get("size_bytes") != dep["size_bytes"]
+                    or row.get("package_path") != dep["package_path"]):
+                return "verified file reference is not bound to its packaged dependency", {}
+        elif row.get("package_path") is not None:
+            return "unverified file reference unexpectedly names packaged bytes", {}
+    coverage = manifest.get("dependency_coverage")
+    coverage_names = {"model_file_resource_api", "functions", "geometry_import_features", "external_code",
+                      "external_libraries_services"}
+    if (not _package_object(coverage, coverage_names)
+            or any(value not in {"PASS_SCOPED", "PARTIAL", "UNVERIFIED"} for value in coverage.values())):
+        return "manifest dependency coverage is malformed", {}
+    unresolved = manifest.get("unresolved_items")
+    if not isinstance(unresolved, list) or len(unresolved) > MAX_OUTER_ENTRIES:
+        return "manifest unresolved-item list is malformed or exceeds its row budget", {}
+    unresolved_allowed = {"kind", "state", "reason", "tag", "resource_tag", "component", "geometry", "feature", "archive_members"}
+    for row in unresolved:
+        if (not isinstance(row, dict) or not {"kind", "state", "reason"} <= set(row)
+                or set(row) - unresolved_allowed or not all(isinstance(row.get(key), str) for key in ("kind", "state", "reason"))
+                or ("archive_members" in row and (not isinstance(row["archive_members"], list)
+                    or not all(_package_relative_path(value) is not None for value in row["archive_members"])) )):
+            return "manifest unresolved-item record is malformed", {}
+    for key in ("external_code", "external_libraries_services"):
+        value = manifest.get(key)
+        if (not _package_object(value, {"status", "reason"}) or value.get("status") != "UNVERIFIED"
+                or not isinstance(value.get("reason"), str) or not value["reason"]):
+            return f"manifest {key} declaration is malformed", {}
+    if (manifest.get("portability_status") != "UNVERIFIED"
+            or type(manifest.get("absolute_paths_in_manifest")) is not bool
+            or manifest.get("absolute_paths_in_manifest") is not False
+            or not isinstance(manifest.get("save_semantics"), str)):
+        return "manifest portability or save-semantics declaration is malformed", {}
+    if _contains_absolute_path_text(manifest):
+        return "manifest contains an absolute path", {}
+    return None, expected_files
