+def actual_api(sdk,profile=None):
+    reader=native.CtypesWindowsPolicyApi.__new__(native.CtypesWindowsPolicyApi)
+    reader.FWPM_TXN_READ_ONLY=1
+    reader._sid_string=lambda ptr:profile.windows_isolation.appcontainer_sid
+    reader._wfp_security_sha=lambda *args:'9'*64
+    reader._kernel32=SimpleNamespace(LocalFree=sdk.localfree)
+    reader._advapi=SimpleNamespace(ConvertStringSidToSidW=sdk.sid)
+    reader._fwpu=SimpleNamespace(FwpmEngineOpen0=sdk.open,FwpmEngineClose0=sdk.close,
+        FwpmTransactionBegin0=sdk.begin,FwpmTransactionCommit0=sdk.commit,FwpmTransactionAbort0=sdk.abort,
+        FwpmFreeMemory0=sdk.free,FwpmGetAppIdFromFileName0=sdk.appid,FwpmFilterAdd0=sdk.add,
+        FwpmFilterGetByKey0=sdk.get,FwpmFilterDeleteByKey0=sdk.delete)
+    api=wfp.CtypesWindowsWfpMutationApi.__new__(wfp.CtypesWindowsWfpMutationApi)
+    api.api=reader;api._fwpu=reader._fwpu;api._advapi=reader._advapi;api._kernel32=reader._kernel32
+    owner.registry(api);return api
+
