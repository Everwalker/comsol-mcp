+class SDK:
+    def __init__(self):
+        self.calls=[];self.close_status=0;self.abort_status=0;self.free_result=None;self.local_result=None
+        self.open_result=0;self.begin_result=0;self.commit_result=0;self.open_error=None;self.commit_error=None
+        self.storage=[];self.filters={};self.next_id=21
+    def open(self,_s,_a,_b,_c,out):
+        self.calls.append('open');C.cast(out,C.POINTER(native.HANDLE))[0]=native.HANDLE(300)
+        if self.open_error:raise self.open_error
+        return self.open_result
+    def close(self,h):self.calls.append(('close',getattr(h,'value',h)));return self.close_status
+    def begin(self,h,flags):self.calls.append(('begin',flags));return self.begin_result
+    def commit(self,h):
+        self.calls.append('commit')
+        if self.commit_error:raise self.commit_error
+        return self.commit_result
+    def abort(self,h):self.calls.append('abort');return self.abort_status
+    def free(self,out):self.calls.append(('free',C.cast(out,C.POINTER(C.c_void_p))[0]));return self.free_result
+    def localfree(self,h):self.calls.append(('localfree',h.value));return self.local_result
+    def sid(self,text,out):
+        buf=C.create_string_buffer(b'public-synthetic-sid');self.storage.append(buf)
+        C.cast(out,C.POINTER(C.c_void_p))[0]=C.cast(buf,C.c_void_p);return 1
+    def appid(self,path,out):
+        data=(native.BYTE*4)(1,2,3,4);blob=native.FWP_BYTE_BLOB(4,data);self.storage += [data,blob]
+        C.cast(out,C.POINTER(C.POINTER(native.FWP_BYTE_BLOB)))[0]=C.pointer(blob);return 0
+    def add(self,engine,pointer,sd,out):
+        original=C.cast(pointer,C.POINTER(native.FWPM_FILTER0)).contents
+        original.filterId=self.next_id;self.next_id+=1;original.effectiveWeight=original.weight
+        key=native.CtypesWindowsPolicyApi._guid(None,original.filterKey)
+        self.filters[key]=original;self.storage += [original,pointer._obj]
+        C.cast(out,C.POINTER(C.c_uint64))[0]=original.filterId;self.calls.append(('add',key));return 0
+    def get(self,engine,key,out):
+        key=native.CtypesWindowsPolicyApi._guid(None,C.cast(key,C.POINTER(native.GUID)).contents)
+        if key not in self.filters:return wfp.FWP_E_FILTER_NOT_FOUND
+        C.cast(out,C.POINTER(C.POINTER(native.FWPM_FILTER0)))[0]=C.pointer(self.filters[key]);return 0
+    def delete(self,engine,key):
+        key=native.CtypesWindowsPolicyApi._guid(None,C.cast(key,C.POINTER(native.GUID)).contents)
+        self.calls.append(('delete',key));self.filters.pop(key);return 0
+
