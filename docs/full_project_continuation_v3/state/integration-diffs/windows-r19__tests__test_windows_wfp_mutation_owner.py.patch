+@pytest.mark.parametrize('fault',['open_io','open_bool','begin_bool','commit_bool','commit_io','close_bool','close_nonzero','abort_failure','free_void','localfree_nonzero'])
+def test_original_sdk_owner_retains_unknown_and_explicit_same_closer_cleanup(fault):
+    sdk=SDK();api=actual_api(sdk);cause=OSError('original-public-io');r=owner.registry(api)
+    if fault=='open_io':sdk.open_error=cause
+    elif fault=='open_bool':sdk.open_result=False
+    elif fault=='begin_bool':sdk.begin_result=False
+    elif fault=='commit_bool':sdk.commit_result=False
+    elif fault=='commit_io':sdk.commit_error=cause
+    elif fault=='close_bool':sdk.close_status=False
+    elif fault=='close_nonzero':sdk.close_status=5
+    elif fault=='abort_failure':sdk.abort_status=5
+    elif fault=='free_void':sdk.free_result=0
+    elif fault=='localfree_nonzero':sdk.local_result=123
+    def work(engine):
+        if fault=='abort_failure':raise cause
+        if fault in {'free_void','localfree_nonzero'}:
+            if fault=='free_void':
+                out=C.POINTER(native.FWP_BYTE_BLOB)();api._sdk_alloc('FwpmGetAppIdFromFileName0',out,'public',C.byref(out))
+                api._free(C.cast(out,C.c_void_p).value)
+            else:
+                out=C.c_void_p();api._convert_sid('S-1-1-0',sid_out=out);api._free_local(out)
+        return 'answer'
+    with pytest.raises((ExecutionContractError,OSError)):
+        api._session(readonly=False,callback=work)
+    if fault in {'close_bool','close_nonzero','abort_failure','free_void','localfree_nonzero'}:
+        assert r.unresolved();ref=weakref.ref(api);del api;gc.collect();api=ref();assert api is r.owner
+        before=list(sdk.calls)
+        with pytest.raises(ExecutionContractError):r.retry_owned(r.unresolved()[0],object())
+        assert sdk.calls==before
+        # DLL field replacement cannot redirect the already captured closer.
+        api._fwpu.FwpmEngineClose0=lambda *_:pytest.fail('replacement SDK close used')
+        api._fwpu.FwpmFreeMemory0=lambda *_:pytest.fail('replacement SDK free used')
+        api._kernel32.LocalFree=lambda *_:pytest.fail('replacement LocalFree used')
+        sdk.close_status=0;sdk.abort_status=0;sdk.free_result=None;sdk.local_result=None
+        for entry in reversed(r.unresolved()):r.retry_owned(entry,api)
+        assert not r.unresolved()
+        finished=list(sdk.calls)
+        for entry in list(r.unresolved()):r.retry_owned(entry,api)
+        assert sdk.calls==finished
+    if fault in {'open_io','commit_io','abort_failure'}:assert api._first_mutation_cause is cause
+
