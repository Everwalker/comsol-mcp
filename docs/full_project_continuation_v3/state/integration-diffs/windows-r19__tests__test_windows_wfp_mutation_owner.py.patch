+def test_actual_allocating_io_capture_and_foreign_handle_never_arbitrary_free():
+    sdk=SDK();api=actual_api(sdk);primary=OSError('sdk-wrote-pointer-then-io')
+    def allocate(text,out):sdk.sid(text,out);raise primary
+    api._advapi.ConvertStringSidToSidW=allocate
+    pointer=C.c_void_p()
+    with pytest.raises(OSError):api._sdk_alloc('ConvertStringSidToSidW',pointer,'S-1-1-0',C.byref(pointer),local=True,bool_return=True)
+    r=owner.registry(api);entry=r.unresolved()[0];assert entry.value==pointer.value
+    sdk.local_result=123
+    with pytest.raises(ExecutionContractError):api._free_local(pointer,primary=primary)
+    assert api._first_mutation_cause is primary
+    entry.handle+=1;before=list(sdk.calls)
+    with pytest.raises(ExecutionContractError):r.retry_owned(entry,api)
+    assert sdk.calls==before
+    entry.handle=entry.value;sdk.local_result=None;r.retry_owned(entry,api);assert not r.unresolved()
+    with pytest.raises(ExecutionContractError):api._free_local(C.c_void_p(pointer.value))
+
