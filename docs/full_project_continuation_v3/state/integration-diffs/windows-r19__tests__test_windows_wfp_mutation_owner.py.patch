+@pytest.mark.parametrize('zero',[True,False])
+def test_production_group_emission_sdk_pointer_readback_delete_all_four_layers(zero):
+    p,plan=profile_and_plan(zero_allows=zero);sdk=SDK();api=actual_api(sdk,p)
+    _,actions=changes._normalize_supported_actions(plan,p)
+    api._check_dependencies=lambda *args:None
+    for action in (a for a in actions if a['resource_kind']=='wfp_filter'):
+        row=api.create_filter(profile=p,action=action,expected_dependency_sha256='a'*64)
+        assert row['filter_id']>=21 and not owner.registry(api).unresolved()
+        api.delete_filter(profile=p,action=action,expected_resource_sha256=wfp.sha256(row),expected_dependency_sha256='a'*64)
+        assert not owner.registry(api).unresolved()
+    assert not sdk.filters
+    assert len([c for c in sdk.calls if isinstance(c,tuple) and c[0]=='add'])==len(p.windows_isolation.wfp_filter_keys)
+
