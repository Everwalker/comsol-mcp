+def test_actual_controller_store_mutator_gc_unknown_then_explicit_original_cleanup(tmp_path,monkeypatch):
+    from comsol_mcp._control_daemon import ControlDaemon
+    from comsol_mcp._windows_t037 import WindowsT037ProfileV2
+    from comsol_mcp._windows_t037_broker import WindowsScmServiceBroker,WindowsT037HostControlIssuer,_SCM_TEST_API_TOKEN
+    from tests.test_windows_t037_broker import _ScmApi
+    from tests.test_windows_t037_native import _security_descriptor
+    from tests.test_windows_filter_group import executor,GroupSDK
+    from comsol_mcp import _w26_os_resources as resources
+    p,plan=profile_and_plan();raw=_security_descriptor();sha=native.canonical_security_descriptor_sha256(raw)
+    payload=plan.as_dict()
+    for a in payload['change_manifest']:
+        if a['resource_kind'] in {'wfp_provider','wfp_sublayer'}:a['desired']['security_sha256']=sha
+    fields=['action_id','resource_kind','resource_name','operation','desired','baseline_identity','baseline_sha256','backup_path','backup_sha256']
+    plan=resources.build_host_change_plan(p,change_manifest=[{k:a.get(k) for k in fields} for a in payload['change_manifest']],operator_inputs={})
+    sdk=SDK();sdk.close_status=5;sdk.local_result=123;sdk.abort_status=5
+    api=actual_api(sdk,p);primary=OSError('actual-SDK-after-provider-effect');effect=[]
+    def descriptor(_sddl,_revision,out,size):
+        buf=C.create_string_buffer(raw);sdk.storage.append(buf)
+        C.cast(out,C.POINTER(C.c_void_p))[0]=C.cast(buf,C.c_void_p)
+        C.cast(size,C.POINTER(native.DWORD))[0]=len(raw);return 1
+    api._advapi.ConvertStringSecurityDescriptorToSecurityDescriptorW=descriptor
+    api._advapi.GetSecurityDescriptorLength=lambda pointer:len(raw)
+    api._fwpu.FwpmProviderGetByKey0=lambda *_:wfp.FWP_E_PROVIDER_NOT_FOUND
+    def add_provider(engine,pointer,sd):
+        assert C.cast(pointer,C.POINTER(native.FWPM_PROVIDER0)).contents.flags==1 and sd.value
+        effect.append('provider');sdk.calls.append('provider_add');raise primary
+    api._fwpu.FwpmProviderAdd0=add_provider
+    api.observe_snapshot=GroupSDK(p).observe_snapshot
+    exe,_,store,provider,authority=executor(tmp_path,monkeypatch,p,plan,api)
+    daemon=ControlDaemon.__new__(ControlDaemon);daemon.store=store;daemon.project_authority=authority
+    wrapper=WindowsT037ProfileV2(p,'a'*64,{'device':1,'inode':2},'SOFTWARE_FIXTURE_ONLY')
+    daemon._windows_t037_profile=wrapper;daemon._windows_t037_profile_path='public-synthetic-path'
+    daemon._retained_host_control_executors={};holder={}
+    def loader(path):
+        assert daemon._retained_host_control_executors  # before original preflight/constructor calls
+        return wrapper
+    monkeypatch.setattr('comsol_mcp._windows_t037.load_trusted_profile',loader)
+    monkeypatch.setattr(changes.WindowsHostChangeExecutor,'from_trusted_profile_path',classmethod(lambda cls,**kw:exe))
+    def main(runtime):
+        runtime.mark_running()
+        issuer=WindowsT037HostControlIssuer(authority=authority,provider=provider,profile=p,profile_source_sha256=wrapper.source_sha256)
+        request=issuer.issue(runtime,phase='APPLY',plan=plan,authorization_ref='apply-once')
+        request.consume(service_name=p.windows_isolation.service_name,project_id=p.project_id,profile_sha256=p.sha256)
+        holder['request']=request
+        with pytest.raises(ExecutionContractError):daemon._execute_internal_host_control(request)
+        scm.handler(1,0,None,None)
+    scm=_ScmApi()
+    broker=WindowsScmServiceBroker._for_software_test(p.windows_isolation.service_name,main,api=scm,token=_SCM_TEST_API_TOKEN)
+    try:
+        broker.run();assert effect==['provider'];assert store.db.execute('SELECT status FROM jobs').fetchone()[0]=='UNKNOWN'
+        record=next(iter(daemon._retained_host_control_executors.values()))
+        assert record['key'][0]=='admission' and record['executor'] is exe and record['request'] is holder['request']
+        r=owner.registry(api);assert owner.registry(api).owner is api and owner.registry(api.api) is r
+        assert {entry.domain for entry in r.unresolved()}=={'mutation_engine','mutation_transaction','mutation_local'}
+        assert api._first_mutation_cause is primary
+        assert sdk.calls.index('provider_add') < next(i for i,c in enumerate(sdk.calls) if isinstance(c,tuple) and c[0]=='localfree')
+        ref=weakref.ref(exe);del exe;gc.collect();retained=ref();assert retained is record['executor']
+        with pytest.raises(ExecutionContractError):daemon._reconcile_original_host_control_executor(holder['request'],retained)
+        calls=list(sdk.calls)
+        with pytest.raises(ExecutionContractError):daemon._execute_internal_host_control(holder['request'])
+        assert sdk.calls==calls and effect==['provider']
+        sdk.close_status=0;sdk.local_result=None;sdk.abort_status=0
+        for entry in reversed(r.unresolved()):r.retry_owned(entry,api)
+        assert not r.unresolved()
+        daemon._reconcile_original_host_control_executor(holder['request'],retained)
+        assert not daemon._retained_host_control_executors
+        assert store.db.execute('SELECT status FROM jobs').fetchone()[0]=='UNKNOWN'
+        assert len([c for c in sdk.calls if isinstance(c,tuple) and c[0]=='close'])==1
+    finally:provider.close();store.close()
