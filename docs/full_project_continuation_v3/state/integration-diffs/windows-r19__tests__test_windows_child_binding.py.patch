+def test_late_parent_release_error_cannot_mask_actual_retained_child_owner(monkeypatch):
+    from comsol_mcp import _windows_t037 as win
+    from tests.test_windows_suspended_ownership import _launch_api,_create
+    profile,api,events,state=_launch_api(monkeypatch,cleanup_fail=True)
+    close=api.close_handle
+    def fail_parent(handle):
+        if handle==777:raise RuntimeError('actual parent HANDLE close failed')
+        return close(handle)
+    api.close_handle=fail_parent
+    with pytest.raises(win.NativeSuspendedChildLaunchError) as captured:_create(profile,api)
+    process=captured.value._process
+    assert not process._closed and process._owner is api and process._parent_binding.closed is False
+    assert api._retained_children[id(process)] is process
+    factory=win.T037SessionProcessFactory(profile,'session-parent-release',api=api);factory._job=300
+    with pytest.raises(win.WindowsT037Error) as refused:factory.close()
+    assert refused.value.code=='NATIVE_LAUNCH_RELEASE_UNKNOWN' and factory._job==300
+    api.close_handle=close;process._parent_binding.close();state['cleanup_fail']=False
+    process.cleanup_owned(api,timeout=1);factory.close()
+    assert factory._job is None and process._closed
+
