+def test_prebirth_host_broker_observation_never_demands_an_unborn_child_or_mints_admission(monkeypatch):
+    from comsol_mcp import _windows_t037_resume as boundary
+    from comsol_mcp._execution_contract import ExecutionContractError
+    from tests.test_windows_child_acl import _observer
+    profile,*_=_observer();events=[]
+    observer=SimpleNamespace(api=SimpleNamespace())
+    monkeypatch.setattr('comsol_mcp._windows_t037.WindowsT037Observer',lambda:observer)
+    monkeypatch.setattr('comsol_mcp._windows_t037.windows_host_fingerprint',lambda **_kw:'e'*64)
+    class Adapter:
+        def __init__(self):self.api=SimpleNamespace()
+        def observe(self,p,*,current_host_fingerprint,process_observer):
+            assert p is profile and process_observer is observer
+            events.append('actual_adapter_entrypoint');return SimpleNamespace(reasons=('WFP_EFFECTIVE_ARBITRATION_NOT_PROVEN',))
+    monkeypatch.setattr('comsol_mcp._windows_t037_native.WindowsNativePolicyAdapter',Adapter)
+    from comsol_mcp._windows_t037 import T037SessionProcessFactory
+    owner=T037SessionProcessFactory(profile,"prebirth-owner")
+    with pytest.raises(ExecutionContractError) as captured:boundary.refuse_unverified_prebirth(profile,owner=owner)
+    assert captured.value.details['phase']=='STATIC_HOST_BROKER_POLICY'
+    assert events==['actual_adapter_entrypoint'] and boundary._pending=={}
