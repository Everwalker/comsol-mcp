+from types import SimpleNamespace
+import ctypes as C
+import pytest
+from comsol_mcp import _windows_t037_child as child
+from tests.test_windows_suspended_ownership import _unknown
+
+class Export:
+    def __init__(self,fn):self.fn=fn
+    def __call__(self,*a):return self.fn(*a)
+
+@pytest.mark.parametrize('mode',['present','missing','failure','overflow','closefail'])
+def test_actual_toolhelp_abi_bounded_enumeration_cleanup(mode):
+    events=[];state={'index':0,'error':18}
+    def row(handle,pointer):
+        events.append('row');state['index']+=1
+        if mode=='failure':state['error']=5;return 0
+        if mode=='missing':return 0
+        entry=C.cast(pointer,C.POINTER(child.PROCESSENTRY32W)).contents
+        entry.th32ProcessID=101 if mode!='overflow' else 999
+        entry.th32ParentProcessID=55
+        return 1
+    exports={'GetCurrentProcessId':lambda:55,'GetProcessId':lambda h:101,
+             'CreateToolhelp32Snapshot':lambda flags,pid:events.append((flags,pid)) or 22,
+             'Process32FirstW':row,'Process32NextW':row,
+             'CloseHandle':lambda h:events.append(('close',h)) or (mode!='closefail'),
+             'GetLastError':lambda:state['error']}
+    k=SimpleNamespace(**{n:Export(fn) for n,fn in exports.items()})
+    child.NativeChildProcessApi.bind(k)
+    assert C.sizeof(child.PROCESSENTRY32W)==568 and child.PROCESSENTRY32W.szExeFile.offset==44
+    assert len(k.Process32FirstW.argtypes)==2 and k.CreateToolhelp32Snapshot.restype is child.HANDLE
+    api=child.NativeChildProcessApi.__new__(child.NativeChildProcessApi);api.k=k;api.MAX_PROCESS_ROWS=3
+    if mode=='present':assert api.parent_pid(101)==55
+    else:
+        with pytest.raises(child.ChildObservationError):api.parent_pid(101)
+    assert events[-1]==('close',22)
+    if mode=='overflow':assert state['index']==4 # First + three next queries; budget refuses.
+
+@pytest.mark.parametrize('change',['none','pid','parent','parentbirth','childbirth','job','unsealed'])
+def test_actual_retained_child_original_handle_parent_birth_job_rechecks(monkeypatch,change):
+    profile,api,events,state,error=_unknown(monkeypatch)
+    process=error._process
+    observations=[]
+    api.open_process=lambda pid:777
+    api.close_handle=lambda handle:observations.append(('close-parent',handle))
+    api.process_times=lambda handle: (10,None) if handle==777 else (0 if change=='childbirth' else process.birth_filetime_100ns,None)
+    if change=='parentbirth':api.process_times=lambda handle:(99999999999,None) if handle==777 else (process.birth_filetime_100ns,None)
+    api.is_process_in_job=lambda h,j:change!='job'
+    api.job_snapshot=lambda j:{'state':'READ_ONLY_NOT_PROOF'}
+    query=SimpleNamespace(process_pid=lambda h:process.pid+1 if change=='pid' else process.pid,
+        current_pid=lambda:55,parent_pid=lambda p:56 if change=='parent' else 55)
+    target={'pid':process.pid} if change=='unsealed' else process
+    if change=='none':
+        result=child.observe_retained_child(target,profile,api,api=query)
+        assert result.state=='OBSERVED_NOT_NATIVE_PROOF' and result.same_job is True
+        with pytest.raises(ValueError):child.RetainedChildObservation(1,2,3,4,'x',True,{},state='VERIFIED')
+    else:
+        with pytest.raises(child.ChildObservationError):child.observe_retained_child(target,profile,api,api=query)
+    if change not in {'pid','unsealed'}:assert observations==[('close-parent',777)]
+    # The observation did not Resume, release or steal the child's owner.
+    assert process._owner is api and not process._closed and process.never_resumed
+    state['cleanup_fail']=False;process.cleanup_owned(api,timeout=1)
+
+@pytest.mark.parametrize('capability',['dict','lookalike','unregistered_private'])
+def test_resume_boundary_cannot_be_unlocked_by_wire_or_private_value_without_issuer(monkeypatch,capability):
+    from comsol_mcp import _windows_t037_resume as boundary
+    from comsol_mcp._execution_contract import ExecutionContractError
+    profile,api,events,state,error=_unknown(monkeypatch);process=error._process
+    if capability=='dict':cap={'state':'VERIFIED','process':process,'_proof':True}
+    elif capability=='lookalike':cap=SimpleNamespace(process=process,used=False,_seal=boundary._SEAL)
+    else:cap=boundary._NativeResumeCapability(process,profile.sha256,seal=boundary._SEAL)
+    with pytest.raises(ExecutionContractError):boundary.resume_native_child(process,cap)
+    assert 'RESUME' not in events and process.never_resumed
+    state['cleanup_fail']=False;process.cleanup_owned(api,timeout=1)
+
+
+def test_production_issuer_reports_every_missing_gate_and_never_registers_authority(monkeypatch):
+    from comsol_mcp import _windows_t037_resume as boundary
+    from comsol_mcp._execution_contract import ExecutionContractError
+    profile,api,events,state,error=_unknown(monkeypatch);process=error._process
+    assert isinstance(process._creation_parameters,tuple)
+    assert process._parent_binding.closed is True
+    with pytest.raises(ExecutionContractError) as captured:
+        boundary.issue_native_resume(process,profile,{'state':'VERIFIED'},{'isolation_state':'VERIFIED'})
+    assert 'JOB_LIMITS_CONFIGURED_NATIVE_ACCEPTANCE_UNVERIFIED' in captured.value.details['reasons']
+    assert 'REMOTE_ARGV_READBACK_UNAVAILABLE' in captured.value.details['reasons']
+    assert 'MIC_UNVERIFIED' in captured.value.details['reasons']
+    assert boundary._pending=={} and process.never_resumed
+    process.note_resume_attempt()
+    process.note_resume_attempt()
+    assert not process.never_resumed
+    # Even an otherwise live original HANDLE cannot use never-resumed cleanup
+    # after any possible Resume attempt. The actual owner remains retained.
+    with pytest.raises(ExecutionContractError):process.cleanup_owned(api,timeout=1)
+    assert not process._closed and process._owner is api
+
