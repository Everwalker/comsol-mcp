+def test_parent_birth_and_release_failure_retains_read_handle_owner_before_any_creation():
+    def fail_birth(handle):raise RuntimeError('native parent birth unavailable')
+    def fail_close(handle):raise RuntimeError('native parent close unavailable')
+    launch=SimpleNamespace(open_process=lambda pid:77,process_times=fail_birth,close_handle=fail_close)
+    query=SimpleNamespace(current_pid=lambda:55)
+    with pytest.raises(RuntimeError):child.pin_native_parent(launch,api=query)
+    retained=list(launch._retained_parent_bindings.values())
+    assert len(retained)==1 and retained[0].handle==77 and retained[0].birth is None and not retained[0].closed
+    launch.close_handle=lambda handle:None
+    retained[0].close()
+    assert not launch._retained_parent_bindings
