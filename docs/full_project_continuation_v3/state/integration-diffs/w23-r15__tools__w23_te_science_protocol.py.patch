+def field_scheme_roles(field_scheme: str = "legacy") -> dict[str, Any]:
+    if field_scheme not in {"legacy", "emw_down"}:
+        raise ScienceProtocolError("unknown explicit field_scheme")
+    prefix = "ewfd" if field_scheme=="legacy" else "emw"
