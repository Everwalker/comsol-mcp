+        self.allocation_sizes={}
+        self.k=SimpleNamespace(LocalFree=Function(self.free),LocalSize=Function(lambda h:self.allocation_sizes.get(getattr(h,'value',h),0)));self.shell=SimpleNamespace(CommandLineToArgvW=Function(self.commandline))
