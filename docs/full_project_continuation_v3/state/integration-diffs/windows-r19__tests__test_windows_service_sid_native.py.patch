+        self.pid=os.getpid();self.image_path=r'C:\COMSOL\launcher.exe';self.argv=[self.image_path,'--service'];self.binary='"'+self.image_path+'" --service';self.security=_security_descriptor();self.static=0
+        self.a=SimpleNamespace(**{n:Function(f) for n,f in {'OpenSCManagerW':self.manager,'OpenServiceW':self.service,'CloseServiceHandle':self.close,
+          'QueryServiceConfigW':self.config,'QueryServiceConfig2W':self.sid,'QueryServiceStatusEx':self.status,
