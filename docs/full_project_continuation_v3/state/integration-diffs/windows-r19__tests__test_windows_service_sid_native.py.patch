+@pytest.mark.parametrize('baseline',[0,1])
+def test_actual_SCM_level5_samehandle_freshhandle_exactrestore(monkeypatch,baseline):
+    sdk=SDK(baseline);api=actual(monkeypatch,sdk)
+    before=scm.observe(api,'ComsolHost');after=scm.configure(api,'ComsolHost',before,3)
+    assert after=={**before,'sid_type':3};restored=scm.configure(api,'ComsolHost',after,baseline);assert restored==before
+    assert [r for r in sdk.calls if isinstance(r,tuple) and r[0]=='change']==[('change',3),('change',baseline)]
+    assert all(r[1]==1 for r in sdk.calls if isinstance(r,tuple) and r[0]=='manager')
+    assert set(r[2] for r in sdk.calls if isinstance(r,tuple) and r[0]=='service')=={0x20005,0x20007}
+    assert not owner.registry(api).unresolved()
+
