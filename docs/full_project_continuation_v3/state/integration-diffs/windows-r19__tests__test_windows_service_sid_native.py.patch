+            offset=C.sizeof(scm.Config)
+            for field,value in [('binary',self.binary),('account',self.account),('load_group',''),('display','Public service'),('dependencies','\0')]:
+                encoded=(value+'\0').encode('utf-16-le');C.memmove(C.addressof(buf)+offset,encoded,len(encoded));setattr(row,field,C.addressof(buf)+offset);offset+=len(encoded)
