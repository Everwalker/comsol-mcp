+def _capture(name,data):
+    path=os.environ.get('W23_ACTIVITY021_METADATA_CAPTURE')
+    if path:
+        p=Path(path);p.mkdir(parents=True,exist_ok=True);(p/(name+'.json')).write_text(json.dumps(data,indent=2,sort_keys=True)+'\n')
