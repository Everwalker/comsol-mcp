+            Study study = model.study(studyTag);
+            SolverSequence sequence = requireUniqueAttachedSolverSequence(
+                model, study, studyTag, "time", "Time", "", "");
+            SolverFeature time = findUniqueTimeFeature(sequence, studyTag);
+            String actual = time.getString("geometricNonlinearity");
+            if (!"on".equals(actual)) {
+                throw new IllegalStateException("v2 native Time geometric nonlinearity is not on");
+            }
+            out.put(studyTag, Map.of("receiver_type", time.getType(), "sequence_tag", sequence.tag(),
+                "feature_tag", time.tag(), "property", "geometricNonlinearity", "getter", "getString",
+                "value", actual, "frame_mapping", "REQUIRES_FRESH_EQUATION_VIEW_NOT_INHERITED_FROM_V1"));
+        }
+        return out;
