+@contextmanager
+def ticket_scope(binding,ticket,service,callback,args):
+    if type(binding) is not _Binding or binding._seal is not _SEAL or binding.used or binding.service is not service or binding.callback is not callback:
+        yield None;return
+    try:scope=_Scope(binding,ticket,service,callback,args,seal=_SEAL)
+    except Exception:
+        yield None;return
+    token=_ACTIVE.set(scope)
+    try:yield scope
+    finally:_ACTIVE.reset(token)
+
+def before_submit(worker,kind,body):
+    scope=_ACTIVE.get()
+    return (scope,scope.before_submit(worker,kind,body)) if scope is not None else None
+
+def after_submit(token,worker,reply):
+    if token is not None:token[0].after_submit(token[1],worker,reply)
