+def _parse_numeric_tcp_endpoint(endpoint: str) -> dict[str, Any]:
+    """Parse one numeric lsof endpoint; names, wildcards, and malformed IPv6 fail closed."""
+    host: str
+    raw_port: str
+    bracketed = endpoint.startswith("[")
+    if bracketed:
+        closing = endpoint.find("]")
+        if closing <= 1 or endpoint[closing + 1:closing + 2] != ":":
+            return {"valid": False, "raw": endpoint, "reason": "malformed_bracketed_endpoint"}
+        host, raw_port = endpoint[1:closing], endpoint[closing + 2:]
+    else:
+        if endpoint.count(":") != 1:
+            return {"valid": False, "raw": endpoint, "reason": "unbracketed_or_malformed_ipv6_endpoint"}
+        host, raw_port = endpoint.rsplit(":", 1)
+    if not raw_port.isdigit() or "%" in host:
+        return {"valid": False, "raw": endpoint, "reason": "port_or_scoped_address_not_numeric"}
+    try:
+        address = ipaddress.ip_address(host)
+    except ValueError:
+        return {"valid": False, "raw": endpoint, "reason": "host_is_not_a_numeric_ip_address"}
+    if bracketed != (address.version == 6):
+        return {"valid": False, "raw": endpoint, "reason": "address_family_bracketing_mismatch"}
+    port_number = int(raw_port)
+    if not 1 <= port_number <= 65535:
+        return {"valid": False, "raw": endpoint, "reason": "port_out_of_range"}
+    mapped = address.ipv4_mapped if isinstance(address, ipaddress.IPv6Address) else None
+    loopback = bool(address.is_loopback or (mapped is not None and mapped.is_loopback))
+    return {"valid": True, "raw": endpoint, "host": str(address), "port": port_number,
+            "address_family": address.version, "loopback": loopback,
+            "ipv4_mapped_loopback": bool(mapped is not None and mapped.is_loopback)}
+
+
+def _port_socket_owners(port: int | None) -> dict[str, Any]:
+    """Require every live socket endpoint to parse numerically as loopback.
+
+    lsof can retain a task-owned ``(CLOSED)`` row after disconnect. Such a row
+    is preserved as inactive historical evidence and never counts as a live
+    client or contributes a PID to the active owner set.
+    """
+    if type(port) is not int or not 1 <= port <= 65535:
+        return {"safe": False, "reason": "port unavailable", "port": port, "pids": [], "rows": []}
+    command = ["/usr/sbin/lsof", "-nP", f"-iTCP:{port}"]
+    probe = subprocess.run(command, capture_output=True, text=True, timeout=10, check=False)
+    rows = [line for line in probe.stdout.splitlines()
+            if line.strip() and not line.lstrip().startswith("COMMAND")]
+    parsed: list[dict[str, Any]] = []
+    for line in rows:
+        fields = line.split()
+        try:
+            pid = int(fields[1])
+            tcp_index = fields.index("TCP")
+            socket_text = fields[tcp_index + 1]
+            state_token = fields[tcp_index + 2]
+        except (ValueError, IndexError):
+            parsed.append({"raw": line, "valid": False, "reason": "malformed_lsof_tcp_row"})
+            continue
+        state = state_token[1:-1] if state_token.startswith("(") and state_token.endswith(")") else None
+        row: dict[str, Any] = {"pid": pid, "socket": socket_text, "state": state, "raw": line}
+        if state not in {"LISTEN", "ESTABLISHED", "CLOSED"}:
+            row.update({"valid": False, "active": None, "reason": "unsupported_or_missing_tcp_state"})
+            parsed.append(row)
+            continue
+        parts = socket_text.split("->")
+        if state == "LISTEN":
+            if len(parts) != 1:
+                row.update({"valid": False, "active": True, "reason": "listener_has_remote_endpoint"})
+                parsed.append(row)
+                continue
+            local = _parse_numeric_tcp_endpoint(parts[0])
+            row.update({"local_endpoint": local, "remote_endpoint": None,
+                        "loopback_only": bool(local.get("valid") and local.get("loopback")),
+                        "active": True})
+            valid = (local.get("valid") is True and local.get("loopback") is True
+                     and local.get("port") == port)
+        elif state == "ESTABLISHED":
+            if len(parts) != 2:
+                row.update({"valid": False, "active": True, "reason": "established_socket_requires_two_endpoints"})
+                parsed.append(row)
+                continue
+            local, remote = (_parse_numeric_tcp_endpoint(parts[0]),
+                             _parse_numeric_tcp_endpoint(parts[1]))
+            endpoints = (local, remote)
+            row.update({"local_endpoint": local, "remote_endpoint": remote,
+                        "loopback_only": all(endpoint.get("valid") is True
+                                              and endpoint.get("loopback") is True
+                                              for endpoint in endpoints),
+                        "active": True})
+            valid = (row["loopback_only"] and port in {local.get("port"), remote.get("port")})
+        else:  # CLOSED is an inactive historical row, not a live peer proof.
+            if len(parts) != 2:
+                row.update({"valid": False, "active": False, "reason": "closed_socket_requires_two_numeric_endpoints"})
+                parsed.append(row)
+                continue
+            local, remote = (_parse_numeric_tcp_endpoint(parts[0]),
+                             _parse_numeric_tcp_endpoint(parts[1]))
+            row.update({"local_endpoint": local, "remote_endpoint": remote,
+                        "loopback_only": None, "active": False,
+                        "endpoint_semantics": "inactive_closed_history_only_not_used_as_live_loopback_or_client_proof"})
+            valid = (local.get("valid") is True and remote.get("valid") is True
+                     and port in {local.get("port"), remote.get("port")})
+        row["valid"] = valid
+        if not valid and not row.get("reason"):
+            row["reason"] = "numeric_endpoint_or_live_loopback_check_failed"
+        parsed.append(row)
+    pids = sorted({row["pid"] for row in parsed if row.get("valid") and row.get("active") is True})
+    historical_pids = sorted({row["pid"] for row in parsed if row.get("valid") and row.get("active") is False})
+    probe_ok = (probe.returncode in {0, 1} and not probe.stderr.strip()
+                and all(row.get("valid") for row in parsed))
+    return {"safe": probe_ok, "port": port, "command": command,
+            "returncode": probe.returncode, "stderr": probe.stderr,
+            "pids": pids, "rows": parsed,
+            "inactive_historical_pids": historical_pids,
+            "no_socket_rows": not parsed}
+
+
+def _listener_for_pid(port: int | None, pid: int | None) -> dict[str, Any]:
+    if type(port) is not int or type(pid) is not int:
+        return {"matches": False, "reason": "port or PID unavailable"}
+    command = ["/usr/sbin/lsof", "-nP", "-a", "-p", str(pid),
+               f"-iTCP:{port}", "-sTCP:LISTEN"]
+    probe = subprocess.run(command, capture_output=True, text=True, timeout=10, check=False)
+    rows = [line for line in probe.stdout.splitlines()
+            if line.strip() and not line.lstrip().startswith("COMMAND")]
+    owners = []
+    for line in rows:
+        fields = line.split()
+        try:
+            owner = int(fields[1])
+            endpoint = " ".join(fields[fields.index("TCP") + 1:]).split(" ", 1)[0]
+        except (ValueError, IndexError):
+            continue
+        owners.append({"pid": owner, "endpoint": endpoint, "raw": line})
+    return {"matches": (probe.returncode == 0 and len(owners) == 1
+                         and owners[0]["pid"] == pid
+                         and owners[0]["endpoint"] == f"127.0.0.1:{port}"),
+            "command": command, "returncode": probe.returncode,
+            "stdout": probe.stdout, "stderr": probe.stderr, "owners": owners}
+
+
+def _task_endpoint_identity_gate(server: Any, *, server_identity: dict[str, Any],
+                                 worker_identity: dict[str, Any] | None,
+                                 worker_port: int | None,
+                                 process_snapshot: Callable[[int], Any],
+                                 require_worker_peer: bool = False) -> dict[str, Any]:
+    """Require exact live children, their loopback listeners, and no foreign client."""
+    if server.proc is None or server.worker is None or worker_identity is None:
+        return {"safe": False, "reason": "owned server, Worker, or identity missing"}
+    worker_proc = getattr(server.worker, "_process", None)
+    if worker_proc is None:
+        return {"safe": False, "reason": "Worker has no task-owned child process"}
+    server_current = process_snapshot(server.proc.pid)
+    worker_current = process_snapshot(worker_proc.pid)
+    server_listener = _listener_matches(server)
+    worker_listener = _listener_for_pid(worker_port, worker_proc.pid)
+    server_sockets = _port_socket_owners(server.port)
+    expected_pids = {server.proc.pid, worker_proc.pid}
+    foreign_pids = sorted(set(server_sockets.get("pids", [])) - expected_pids)
+    worker_peer_seen = worker_proc.pid in server_sockets.get("pids", [])
+    safe = (server.proc.poll() is None and worker_proc.poll() is None
+            and _process_identity_matches(server_identity, server_current)
+            and _process_identity_matches(worker_identity, worker_current)
+            and worker_identity.get("pid") == worker_proc.pid
+            and server_listener.get("matches") is True
+            and worker_listener.get("matches") is True
+            and server_sockets.get("safe") is True
+            and server.proc.pid in server_sockets.get("pids", [])
+            and not foreign_pids
+            and (not require_worker_peer or worker_peer_seen))
+    return {"safe": safe,
+            "status": "PASS_EXACT_TASK_OWNERS_AND_LOOPBACK_CLIENT_SET"
+                      if safe else "BLOCKED_IDENTITY_LISTENER_OR_CLIENT_SET",
+            "server_expected": server_identity,
+            "server_current": server_current,
+            "worker_expected": worker_identity,
+            "worker_current": worker_current,
+            "server_listener": server_listener,
+            "worker_listener": worker_listener,
+            "server_sockets": server_sockets,
+            "expected_process_pids": sorted(expected_pids),
+            "foreign_client_pids": foreign_pids,
+            "worker_peer_seen": worker_peer_seen,
+            "require_worker_peer": require_worker_peer}
 
 
