# Runtime state
comsol-server-home/
logs/
output/
outputs/

# COMSOL-generated artifacts
*.mph
*.mphbin
*.class
*.recovery
*.status

# Distribution
*.egg-info/
dist/
build/

# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local editor noise
.DS_Store
.phase1-private/
*credentials*.md
evidence/**/prefs-*/
evidence/**/tmp-*/
Thumbs.db
.idea/
.vscode/
.claude/

# Auditable phase-one engine artifacts (credentials remain ignored above).
!evidence/**/*.mph

# G3 task-owned runtime state (private control homes and worker sandboxes).
.g3-private/
mcp-home/

# Result artifacts published at run time (the ledger pins them by path + digest).
g2_artifacts/

# Run-local working state under evidence/phase4_3/runs/<run_id>/: a run tracks its
# evidence documents (result.json, assertions.json, runner.log, source_manifest.json,
# environment.json, case_inventory.json, SHA256SUMS.json, RUN_NOTES.md) and nothing
# else.  The engine's own working state -- private prefs/workspace, locks, compiled
# worker classes, generated builders, the acceptance venvs and the solved models --
# stays local: committing COMSOL's runtime workspace or a lock file is not evidence.
evidence/phase4_3/runs/*/artifacts/
evidence/phase4_3/runs/*/prefs/
evidence/phase4_3/runs/*/tmp/
evidence/phase4_3/runs/*/locks/
evidence/phase4_3/runs/*/recovery/
evidence/phase4_3/runs/*/worker_*/
evidence/phase4_3/runs/*/test_venv/
evidence/phase4_3/runs/*/wheel_dist/
evidence/phase4_3/runs/*/c16_wheel_dist/
evidence/phase4_3/runs/*/neutral_cwd/
evidence/phase4_3/runs/*/*.java
evidence/phase4_3/runs/*/server.port
evidence/phase4_3/runs/*/mphserver.log

# Independent acceptance: local runtime, credentials, interpreters and binaries.
# Public command/results summaries retain hashes of excluded raw artifacts.
evidence/phase4_3/runs/*/private/
evidence/phase4_3/runs/*/software_venv/
evidence/phase4_3/runs/*/wheel_venv/
evidence/phase4_3/runs/*/install_venv/
evidence/phase4_3/runs/*/java_classes/
evidence/phase4_3/runs/*/javac_classes/
release/
evidence/phase4_3/runs/*/control-private/
# Disposable packaging source copies retain their own manifests locally.
# Do not publish duplicated historical binaries/evidence from wheel staging.
evidence/phase4_3/runs/*/source_stage/
# Verification scratch trees and wheels are local; publish their receipts/hashes.
evidence/phase4_3/runs/*/pytest_tmp/
evidence/phase4_3/runs/*/clean_recovery/
evidence/phase4_3/runs/*/wheelhouse/

# Phase 4.4 W18 run-local working state: keep evidence (plots, acceptance_result.json,
# csv, json, mph), exclude transient engine runtime (prefs, login credentials, locks, workers)
evidence/phase4_4/runs/*/comsol_prefs/
evidence/phase4_4/runs/*/comsol_tmp/
evidence/phase4_4/runs/*/comsol_recovery/
evidence/phase4_4/runs/*/locks/
evidence/phase4_4/runs/*/worker*/
evidence/phase4_4/runs/*/project_c/
evidence/phase4_4/runs/*/cwd_d/
evidence/phase4_4/runs/*/env_site_packages/
evidence/phase4_4/runs/*/control-private/
evidence/phase4_4/runs/*/hermes_isolated/
evidence/phase4_4/runs/*/server.port
evidence/phase4_4/runs/*/mphserver.log
evidence/phase4_4/runs/*/*.java
evidence/phase4_4/runs/*/status.json
evidence/phase4_4/runs/*/workflow_state.json

# G3.5 W19 run-local working state exclusions
evidence/g3_5_acceptance_*/comsol_prefs/
evidence/g3_5_acceptance_*/comsol_tmp/
evidence/g3_5_acceptance_*/comsol_recovery/
evidence/g3_5_acceptance_*/locks/
evidence/g3_5_acceptance_*/worker*/
evidence/g3_5_acceptance_*/project_c/
evidence/g3_5_acceptance_*/cwd_d/
evidence/g3_5_acceptance_*/env_site_packages/
evidence/g3_5_acceptance_*/control-private/
evidence/g3_5_acceptance_*/hermes_isolated/
evidence/g3_5_acceptance_*/server.port
evidence/g3_5_acceptance_*/mphserver.log
evidence/g3_5_acceptance_*/*.java
evidence/g3_5_acceptance_*/status.json
evidence/g3_5_acceptance_*/workflow_state.json

