+    @staticmethod
+    def _g2_alias(operation: str) -> str:
+        return operation.replace(".", "_")
+
+    def _invoke_g3_session_model(self, operation, arguments, execution, operation_id):
+        """Run model list/create/load on the current Worker without selecting a hidden model."""
+        from ._g3_ops import DISPATCH
+        if self.service is None or self.worker is None:
+            raise ExecutionContractError("ENGINE_UNRESPONSIVE", "a connected persistent Worker is required")
+        if operation not in {"model.list", "model.create", "model.load"}:
+            raise ExecutionContractError("UNSUPPORTED_OPERATION", f"not a session-scoped model operation: {operation}")
+        if execution.get("model_ref") is not None or execution.get("expected_revision") is not None:
+            raise ExecutionContractError("INVALID_REQUEST", f"{operation} is an unbound session operation")
+        project_id = execution.get("project_id")
+        session_id = execution.get("session_id")
+        request_id = execution.get("request_id")
+        idempotency_key = execution.get("idempotency_key")
+        if not isinstance(project_id, str) or not project_id:
+            raise ExecutionContractError("PROJECT_IDENTITY_REQUIRED", f"{operation} requires outer project_id")
+        if session_id != self.service.ledger.session_id:
+            raise ExecutionContractError("MODEL_IDENTITY_MISMATCH", "session mismatch")
+        if not isinstance(request_id, str) or not request_id:
+            raise ExecutionContractError("INVALID_REQUEST", f"{operation} requires outer request_id")
+        if operation in {"model.create", "model.load"} and (not isinstance(idempotency_key, str) or not idempotency_key):
+            raise ExecutionContractError("INVALID_REQUEST", f"{operation} requires outer idempotency_key")
+        selected = active_session_context()
+        if selected is not None and (selected.project_id != project_id or selected.session_id != session_id
+                                     or selected.backend is not self or selected.worker is not self.worker
+                                     or selected.service is not self.service):
+            raise ExecutionContractError("WORKER_BINDING_MISMATCH", "active SessionRuntimeContext does not match this exact backend binding")
+        from ._artifact_store import local_artifact_host_identity, local_engine_host_identity
+        function = DISPATCH.get(operation)
+        if function is None:
+            raise ExecutionContractError("UNSUPPORTED_OPERATION", f"G3 operation is not executable: {operation}")
+        body = self._g2_body(arguments, operation)
+        context = {
+            "project_root": str(self.project_root), "project_id": project_id,
+            "operation_id": str(operation_id), "request_id": request_id,
+            "idempotency_key": idempotency_key, "host_identity": local_artifact_host_identity(),
+            "engine_host_identity": local_engine_host_identity(self.endpoint_key),
+            "operation_store": self.store, "backend": self, "execution_service": self.service,
+            "session_context": selected, "project_authorizer": self.project_authorizer,
+        }
+
+        def callback(_args):
+            data = function(self.worker, "", {**body, "_managed_context": context})
+            return {"success": True, "data": data}
+
+        result = self.service.execute_legacy(
+            self._g2_alias(operation), callback, body, model_ref=None,
+            request_id=request_id, session_id=session_id,
+        )
+        result.setdefault("execution", {}).update({
+            "project_id": project_id, "request_id": request_id, "operation_id": operation_id,
+            "idempotency_key": idempotency_key,
+        })
+        data = result.get("data") if isinstance(result.get("data"), Mapping) else {}
+        created_ref = data.get("model_ref")
+        if result.get("success") is True and operation in {"model.create", "model.load"}:
+            if not isinstance(created_ref, Mapping):
+                raise ExecutionContractError("EXECUTION_STATE_UNKNOWN", f"{operation} did not return its new ModelRef",
+                                             stage="post_dispatch", details={"safe_retry": False})
+            bound = model_ref_from_mapping(dict(created_ref))
+            state = self.service.ledger._state_for(bound)
+            result["execution"].update({"model_ref": bound.as_dict(), "revision": state.revision,
+                                        "dirty": state.dirty, "model_ownership": "mcp_owned"})
+        self.persist()
+        return result
