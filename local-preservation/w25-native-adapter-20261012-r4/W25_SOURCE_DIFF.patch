+                or validated["shell_run"]["pattern"] != "invoke"
+                or validated["shell_busy"]["pattern"] != "read"
+                or validated["shell_output"]["pattern"] not in {"read", "value"}
+                or validated["shell_output"]["pattern"] == "invoke"
