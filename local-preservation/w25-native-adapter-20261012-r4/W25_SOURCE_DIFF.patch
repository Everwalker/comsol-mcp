+class JobList(list):
+    def __init__(self, items: list[dict[str, Any]], total: int, offset: int, limit: int):
+        super().__init__(items)
+        self.total = total
+        self.offset = offset
+        self.limit = limit
+        self.has_more = (offset + len(items)) < total
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "jobs": list(self),
+            "total": self.total,
+            "offset": self.offset,
+            "limit": self.limit,
+            "has_more": self.has_more,
+        }
