+        self._fd = fd
+        self._config = config
+        self.config_sha256 = raw_sha256
+        self._file_fingerprint = file_fingerprint
+        self._parent_identity = parent_identity
+        self._config_identity = config_identity
+        self._destinations = destinations
+        self._grants = grants
+        self._lock = threading.RLock()
+        self._closed = False
