+def test_full_restore_recovers_prepared_intent_after_quarantine_rename_before_phase_write(tmp_path, monkeypatch):
+    import comsol_mcp._state_backup as state_backup
+
+    injected = {}
+
+    def after_move(root, relative, quarantine_leaf):
+        if relative == "projects" and not injected:
+            injected.update(root=root, quarantine=quarantine_leaf)
+            raise RuntimeError("simulate interruption after rename and before QUARANTINED journal write")
+
+    state_backup, home, workspace = _interrupt_full_restore_for_cleanup_recovery(
+        tmp_path, monkeypatch, "_after_restore_quarantine_move", after_move
+    )
+    journal = state_backup._read_full_restore_journal(home)
+    cleanup = next(item for item in journal["directory_cleanup"] if item["relative"] == "projects")
+    assert cleanup["phase"] == "PREPARED"
+    assert not (workspace / "projects").exists()
+    assert (workspace / cleanup["quarantine_leaf"]).is_dir()
+
+    recovered = recover_full_restore(home, confirm=True)
