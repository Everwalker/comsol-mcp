+def test_full_restore_recovers_after_quarantine_rmdir_before_done_journal_write(tmp_path, monkeypatch):
+    import comsol_mcp._state_backup as state_backup
+
+    injected = {}
+
+    def after_rmdir(_parent_fd, quarantine_leaf):
+        injected.setdefault("calls", []).append(quarantine_leaf)
+        # The installed projects tree is removed first, then the now-empty
+        # stage root. Interrupt at the last directory after its child removal.
+        if len(injected["calls"]) == 2:
+            injected["quarantine"] = quarantine_leaf
+            raise RuntimeError("simulate interruption after rmdir and before DONE journal write")
+
+    state_backup, home, workspace = _interrupt_full_restore_for_cleanup_recovery(
+        tmp_path, monkeypatch, "_after_restore_quarantine_rmdir", after_rmdir
+    )
+    journal = state_backup._read_full_restore_journal(home)
+    cleanup = next(item for item in journal["directory_cleanup"]
+                   if item["quarantine_leaf"] == injected["quarantine"])
+    assert len(injected["calls"]) == 2
+    assert cleanup["leaf"] == journal["workspace_stage_leaf"]
+    assert cleanup["root_relative"] == ""
+    assert cleanup["phase"] == "REMOVE_INTENT"
+    assert not (workspace / cleanup["quarantine_leaf"]).exists()
+    assert not (workspace / cleanup["leaf"]).exists()
+
+    recovered = recover_full_restore(home, confirm=True)
+    assert recovered["success"] is True
+    assert not (home / ACTIVE_FULL_RESTORE_JOURNAL).exists()
+    assert list(workspace.iterdir()) == []
+    archived_journal = json.loads((Path(recovered["recovery_directory"])
+                                   / "full-restore-journal.json").read_text())
+    assert next(item for item in archived_journal["directory_cleanup"]
+                if item["quarantine_leaf"] == injected["quarantine"])["phase"] == "DONE"
 
 
