+def _rename_restore_entry_to_quarantine(parent_fd: int, leaf: str,
+                                        expected_identity: Mapping[str, Any]) -> tuple[str, dict[str, int]]:
+    try:
+        before = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
+    except OSError as exc:
+        raise StateBackupError("RESTORE_TARGET_CHANGED", "restore cleanup source disappeared before quarantine") from exc
+    identity = {"device": int(before.st_dev), "inode": int(before.st_ino)}
+    if (not (stat.S_ISDIR(before.st_mode) or stat.S_ISREG(before.st_mode))
+            or identity != {"device": expected_identity.get("device"), "inode": expected_identity.get("inode")}):
+        raise StateBackupError("RESTORE_TARGET_CHANGED", "restore cleanup entry differs from its pinned identity")
+    quarantine = f".comsol-restore-remove-{uuid4().hex}"
+    try:
+        _renameat_directory_noreplace(parent_fd, leaf, parent_fd, quarantine)
+        moved = os.stat(quarantine, dir_fd=parent_fd, follow_symlinks=False)
+    except Exception as exc:
+        if isinstance(exc, StateBackupError):
+            raise
+        raise StateBackupError("RESTORE_ROLLBACK_INCOMPLETE", "restore cleanup could not move the exact entry into quarantine") from exc
+    moved_identity = {"device": int(moved.st_dev), "inode": int(moved.st_ino)}
+    if not (stat.S_ISDIR(moved.st_mode) or stat.S_ISREG(moved.st_mode)) or moved_identity != identity:
+        # A same-name substitution may have been moved. Put it back only when
+        # the original name is still vacant; never replace an arriving entry.
+        try:
+            _renameat_directory_noreplace(parent_fd, quarantine, parent_fd, leaf)
+        except Exception:
+            pass
+        raise StateBackupError("RESTORE_TARGET_CHANGED", "quarantined restore entry failed exact moved-identity readback")
+    return quarantine, identity
