+                 "model_tag": "mcp1", "generation": 1}
+    close_scope = {"model_ref": model_ref, "expected_revision": 4, "destination_ref": None}
+    config = {"schema": CONFIG_SCHEMA,
+              "destinations": [{"project_id": project_id, "destination_ref": destination_ref,
+                                "sink_root": str(sink)}],
+              "grants": [
