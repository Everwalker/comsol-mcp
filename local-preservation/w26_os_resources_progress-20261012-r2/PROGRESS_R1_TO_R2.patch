+def test_progress_parent_reparse_replacement_before_relative_create_writes_nothing_outside(
+        tmp_path, monkeypatch):
+    project = tmp_path / "project"
+    outside = tmp_path / "outside"
+    project.mkdir()
+    outside.mkdir()
+    store = OperationStore(tmp_path / "operations.sqlite")
+    record, execution = _bound_job(store, tmp_path)
+    client = _Client()
+    capture = ComsolProgressCapture(
+        _Worker(client), store, project, operation_id=record["operation_id"],
+        operation="study.run", execution=execution, model_ref=MODEL_REF, model_revision=7)
+    from comsol_mcp import _state_backup
+    create_tree = _state_backup._create_directory_tree
+    moved_project = tmp_path / "project-original"
+
+    def replace_parent_after_pin(*args, **kwargs):
+        project.rename(moved_project)
+        project.symlink_to(outside, target_is_directory=True)
+        return create_tree(*args, **kwargs)
+
+    monkeypatch.setattr(_state_backup, "_create_directory_tree", replace_parent_after_pin)
+    with pytest.raises(PreWriteRefusal) as refusal:
+        capture.__enter__()
+    assert refusal.value.details["cleanup_verified"] is True
+    assert client.calls == []
+    assert list(outside.iterdir()) == []
