+def test_progress_capture_fails_closed_when_pinned_path_cleanup_adapter_is_unavailable(tmp_path, monkeypatch):
+    project = tmp_path / "project"
+    project.mkdir()
+    store = OperationStore(tmp_path / "operations.sqlite")
+    record, execution = _bound_job(store, tmp_path)
+    client = _Client()
+    capture = ComsolProgressCapture(
+        _Worker(client), store, project, operation_id=record["operation_id"],
+        operation="study.run", execution=execution, model_ref=MODEL_REF, model_revision=7)
+    monkeypatch.setattr(progress_capture, "_supports_pinned_progress_cleanup", lambda: False)
+    with pytest.raises(PreWriteRefusal) as unsupported:
+        capture.__enter__()
+    assert unsupported.value.code == "COMSOL_PROGRESS_PATH_ADAPTER_UNAVAILABLE"
+    assert unsupported.value.details["native_operation_dispatched"] is False
+    assert unsupported.value.details["residual_status"] == "ABSENT"
+    assert client.calls == []
+    assert list(project.iterdir()) == []
+    store.close()
+
