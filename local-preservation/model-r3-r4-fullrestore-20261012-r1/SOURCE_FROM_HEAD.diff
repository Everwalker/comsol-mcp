+def _require_context(context: Mapping[str, Any], *names: str) -> None:
+    missing = [name for name in names if context.get(name) is None]
+    if missing:
+        raise PreWriteRefusal("MANAGED_CONTEXT_REQUIRED", "managed context lacks " + ", ".join(missing))
+
