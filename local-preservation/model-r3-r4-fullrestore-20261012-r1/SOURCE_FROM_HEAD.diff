+@dataclass(frozen=True)
+class VerifiedLaunchBinding:
+    profile_id: str
+    profile_sha256: str
+    project_id: str
+    root_file_id: str
+    host_id: str
+    snapshot_sha256: str
+    capability_state: CapabilityState = CapabilityState.VERIFIED
