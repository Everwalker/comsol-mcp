+                                         stage="post_dispatch", details={"safe_retry": False})
+        model_row = {"path": mph_path, "sha256": mph_sha, "size_bytes": mph_size,
+                     "artifact_id": None, "role": "model_mph_copy", "artifact_type": "application/vnd.comsol.mph",
