+class _DestinationStore:
+    def __init__(self, root):
+        self.root = root
+
+    def resolve_safe_path(self, relative, allow_overwrite=False):
+        result = self.root / relative
+        if result.exists() and not allow_overwrite:
+            raise FileExistsError(relative)
+        return result
