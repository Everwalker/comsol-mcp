+                if _history_fingerprint(live) != manifest["durable_history_sha256"]:
+                    raise StateBackupError("HISTORY_HASH_MISMATCH", "installed full restore changed durable history")
+            finally:
+                live.close()
+            if stage.exists():
+                if _directory_identity_beneath(target_workspace, stage_leaf,
+                        expected_root_identity=workspace_identity) != journal["workspace_stage_identity"]:
+                    raise StateBackupError("RESTORE_TARGET_CHANGED", "restore staging directory was replaced before cleanup")
+                if any(stage.iterdir()):
+                    raise StateBackupError("RESTORE_STAGE_UNEXPECTED", "staged project directory contains uninstalled files")
+                stage.rmdir()
