+def _patch_function_reader(monkeypatch, *, interp="piecewisecubic", extrap="none", values=None):
+    props = {
+        "argrange": [["0", "1"]],
+        "argunit": ["m"],
+        "extrap": extrap,
+        "interp": interp,
+        "fununit": "Pa",
