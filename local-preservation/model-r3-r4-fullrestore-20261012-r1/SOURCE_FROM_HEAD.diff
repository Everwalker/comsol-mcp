+        if self.count <= 0:
+            self.count = 12
+    def create(self, tag, type_id):
+        feature = self.features.create(tag, type_id)
+        if type_id == "Import":
+            feature.values = {"source": "native", "filename": ""}
+            feature.value_types = {"source": "String", "filename": "String"}
+            feature.importData = self.importData
+    def importData(self):
+        self.import_count += 1
+        self.empty = False
+        self.complete = False
