+class _HashingReader:
+    def __init__(self, handle: Any):
+        self.handle = handle
+        self.digest = hashlib.sha256()
+        self.size = 0
+
+    def read(self, amount: int = -1) -> bytes:
+        data = self.handle.read(amount)
+        if data:
+            self.digest.update(data)
+            self.size += len(data)
+        return data
+
