            "type": "string"
          },
          "dimension": {
            "default": 0,
            "title": "Dimension",
            "type": "integer"
          },
          "dependent_variables": {
            "default": "u",
            "title": "Dependent Variables",
            "type": "string"
          }
        },
        "required": [
          "component",
          "tag",
          "physics_type"
        ],
        "title": "create_physicsArguments",
        "type": "object"
      },
      "legacy_output_schema": {
