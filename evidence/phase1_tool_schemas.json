    {
      "name": "create_physics",
      "description": "Add a physics interface to a component.\n\n    Common physics_type values: \"cfpde\" (Coefficient Form PDE),\n    \"tds\" (Transport of Diluted Species), \"solid\" (Solid Mechanics),\n    \"ht\" (Heat Transfer), \"es\" (Electrostatics), etc.\n\n    dimension: spatial dimension (1, 2, or 3). Default 0 = auto-detect from\n    the component's geometry. Set via configure_single_main_workflow(model_dimension=2).\n\n    dependent_variables: comma-separated dependent variable names. Default \"u\".\n    COMSOL uses these to create the correct physics with matching spatial dimension.\n    For multiple dependent variables use \"u,v\" or \"u,v,w\".\n    ",
      "input_schema": {
        "properties": {
          "component": {
            "title": "Component",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          },
