"""Narrow W25 zero-solve fingerprint probe over an existing managed session.

The caller creates ``BoundManagedPublicGate`` only after the existing project,
runtime, once-binding, owner, and terminal-evidence admission path succeeds.
This module never starts a Server/Worker, reconnects, retries, or calls COMSOL
through a private API. Every model operation goes through ControlDaemon's
public dispatch and every response is written before inspection.
"""
from __future__ import annotations

from dataclasses import dataclass, field
import hashlib
import json
