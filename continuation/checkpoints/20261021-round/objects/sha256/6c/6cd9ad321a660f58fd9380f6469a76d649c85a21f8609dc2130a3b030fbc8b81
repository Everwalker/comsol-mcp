        "SSH.stderr": stderr_path,
        "SSH_STATE.jsonl": state_path,
        "SSH_TERMINAL.json": terminal_path,
        "LOCAL_READONLY_INSPECTION_REPORT.json": report_path,
    }
    for name, path in expected_raw_paths.items():
        rec = actual_report.get("raw_evidence", {}).get(name)
        if (not isinstance(rec, dict) or rec.get("path") != str(path.relative_to(ROOT))
                or rec.get("bytes") != len(raw_by_name[{
                    "SSH_LAUNCH_INTENT.json": "launch_intent", "SSH.stdout": "stdout",
                    "SSH.stderr": "stderr", "SSH_STATE.jsonl": "state",
                    "SSH_TERMINAL.json": "terminal", "LOCAL_READONLY_INSPECTION_REPORT.json": "report"}[name]])
                or rec.get("sha256") != hashes[{
                    "SSH_LAUNCH_INTENT.json": "launch_intent", "SSH.stdout": "stdout",
                    "SSH.stderr": "stderr", "SSH_STATE.jsonl": "state",
                    "SSH_TERMINAL.json": "terminal", "LOCAL_READONLY_INSPECTION_REPORT.json": "report"}[name]]):
            raise RuntimeError("R4 actual-result report does not bind raw producer bytes: " + name)
    expected_file_summaries = {row.get("path"): row for row in actual_report.get("files", [])}
    if (set(expected_file_summaries) != set(EXPECTED_R6D_READONLY_FILES)
            or any(expected_file_summaries[path].get("sha256") != digest
                   or expected_file_summaries[path].get("matches_fixed_expected_sha256") is not True
                   or expected_file_summaries[path].get("same_path_and_handle_signatures_stable") is not True
                   or expected_file_summaries[path].get("path_fd_common_identity_equal") is not True
                   for path, digest in EXPECTED_R6D_READONLY_FILES.items())
            or actual_report.get("domain_observation", {}).get("observed_path_ctime_differs_from_fstat_change_time") != 3):
        raise RuntimeError("R4 actual-result report does not preserve all five expected hashes and domain observations")

    verified_records = actual_review.get("verified_raw_records")
    if not isinstance(verified_records, list) or len(verified_records) != 6:
        raise RuntimeError("R4 independent review does not retain the six raw producer records")
    by_path = {row.get("path"): row for row in verified_records}
    for name, path in expected_raw_paths.items():
        record = by_path.get(str(path.relative_to(ROOT)))
        key = {"SSH_LAUNCH_INTENT.json": "launch_intent", "SSH.stdout": "stdout", "SSH.stderr": "stderr",
               "SSH_STATE.jsonl": "state", "SSH_TERMINAL.json": "terminal",
               "LOCAL_READONLY_INSPECTION_REPORT.json": "report"}[name]
        if (not isinstance(record, dict) or record.get("bytes") != len(raw_by_name[key])
                or record.get("sha256") != hashes[key]):
            raise RuntimeError("R4 independent review raw-record table differs from the captured producer: " + name)
    recovered_records = recovered_actual_review.get("verified_raw_records")
    if not isinstance(recovered_records, list) or len(recovered_records) != 6:
        raise RuntimeError("R4 recovery review does not retain the complete six-record raw evidence table")
    recovered_by_path = {row.get("path"): row for row in recovered_records}
    for name, path in expected_raw_paths.items():
        record = recovered_by_path.get(str(path.relative_to(ROOT)))
        key = {"SSH_LAUNCH_INTENT.json": "launch_intent", "SSH.stdout": "stdout", "SSH.stderr": "stderr",
               "SSH_STATE.jsonl": "state", "SSH_TERMINAL.json": "terminal",
               "LOCAL_READONLY_INSPECTION_REPORT.json": "report"}[name]
        if (not isinstance(record, dict) or record.get("bytes") != len(raw_by_name[key])
                or record.get("sha256") != hashes[key]):
            raise RuntimeError("R4 recovery review raw-record table differs from the restored capture: " + name)

    return {
        "status": result["status"],
        "source_review_sha256": hashes["source_review"],
        "inspector_source_sha256": hashes["inspector_source"],
        "wrapper_review_sha256": hashes["wrapper_review"],
        "execution_authorization_sha256": hashes["execution_authorization"],
        "independent_actual_review_sha256": hashes["independent_actual_review"],
        "recovered_actual_review_sha256": hashes["recovered_actual_review"],
        "incident_sha256": R6D_READONLY_INCIDENT_RECORD_SHA256,
        "restoration_receipt_sha256": R6D_READONLY_RESTORATION_RECEIPT_SHA256,
        "actual_result_sha256": hashes["actual_result"],
        "launch_intent_sha256": hashes["launch_intent"],
        "state_sha256": hashes["state"],
        "report_sha256": hashes["report"],
        "terminal_sha256": hashes["terminal"],
        "stdout_sha256": hashes["stdout"],
        "stderr_sha256": hashes["stderr"],
        "file_sha256": file_sha256,
        "path_fstat_ctime_domain_difference_count": domain_split_count,
        "inspector_bytes": R6D_READONLY_INSPECTOR_BYTES,
        "historical_r6g_inspector_sha256": R6G_HISTORICAL_INSPECTOR_SHA256,
        "diagnostic_only_not_R14_security_path_proof": True,
    }

def _validate_inputs(payload_path: Path, contract_path: Path, manifest_path: Path,
                     request_path: Path, source_review_path: Path, wrapper_review_path: Path,
                     authorization_path: Path, persistent_authorization_path: Path,
                     readonly_wrapper_review_path: Path, readonly_report_path: Path,
                     readonly_terminal_path: Path, readonly_stdout_path: Path,
                     readonly_stderr_path: Path, wrapper_path: Path) -> tuple[bytes, dict[str, Any]]:
    manifest_raw = read_regular(manifest_path)
    if sha(manifest_raw) != R6G_MANIFEST_SHA256:
        raise RuntimeError("R6G manifest differs from the exact reviewed candidate")
    manifest = strict_json(manifest_raw, "R6G candidate manifest")
    if (manifest.get("schema") != "cv3-windows-primary-owner-r6g-local-prep-manifest/1"
            or manifest.get("status") != "LOCAL_CANDIDATE_READY_FOR_MAIN_REVIEW_NO_REMOTE_OR_NATIVE_ACTION"):
        raise RuntimeError("candidate manifest is not the exact closed R6G package schema")

    payload_record = manifest.get("package_files", {}).get(PAYLOAD_FILENAME)
    if (not isinstance(payload_record, dict) or set(payload_record) != {"sha256", "bytes"}
            or payload_record.get("sha256") != R6G_PAYLOAD_SHA256
            or type(payload_record.get("bytes")) is not int or payload_record["bytes"] <= 0):
        raise RuntimeError("R6G manifest does not contain the exact frozen PREP payload record")
    payload_raw = read_regular(payload_path)
    expected_payload_sha256 = payload_record["sha256"]
    expected_payload_bytes = payload_record["bytes"]
    if len(payload_raw) != expected_payload_bytes or sha(payload_raw) != expected_payload_sha256:
        raise RuntimeError("PREP payload bytes differ from the exact R6G manifest payload digest")

    contract_raw = read_regular(contract_path)
    if sha(contract_raw) != R6G_CONTRACT_SHA256:
        raise RuntimeError("R6G contract differs from the exact reviewed candidate")
    contract = strict_json(contract_raw, "R6G PREP contract")
    if (contract.get("schema") != "cv3-windows-primary-owner-r6g-source-only-contract/1"
            or contract.get("status") != "LOCAL_SOURCE_CANDIDATE_ONLY_NO_REMOTE_ACTION"
            or contract.get("candidate_paths", {}).get("five_leaf_targets") != EXPECTED_TARGETS
            or contract.get("candidate_paths", {}).get("distinct_from_partial_R6D") is not True
            or contract.get("R6D_inspector", {}).get("sha256") != R6G_HISTORICAL_INSPECTOR_SHA256):
        raise RuntimeError("R6G contract does not bind exact new targets and separate inert R6D inspector")

    request_raw = read_regular(request_path)
    if sha(request_raw) != R6G_REQUEST_SHA256:
        raise RuntimeError("R6G source request differs from its exact Main-reviewed revision")
    request = strict_json(request_raw, "R6G Main source review request")
    if request.get("status") != "PENDING_MAIN_EXACT_SOURCE_REVIEW_NO_REMOTE_OR_NATIVE_AUTHORITY":
        raise RuntimeError("R6G source request status changed")
    if request.get("authority_boundary", {}).get("SSH") != "NOT_RUN":
        raise RuntimeError("R6G source request no longer says remote SSH is not run")

    source_review_raw = read_regular(source_review_path)
    if sha(source_review_raw) != R6G_SOURCE_REVIEW_SHA256:
        raise RuntimeError("R6G source review differs from its exact Main PASS record")
    source_review = strict_json(source_review_raw, "R6G Main source review")
    if (source_review.get("schema") != "WINDOWS_PRIMARY_OWNER_R6G_MAIN_SOURCE_REVIEW_V1"
            or source_review.get("status") != "PASS_SCOPED_R6G_SOURCE_AND_R6D_READONLY_INSPECTOR"
            or source_review.get("request_sha256") != sha(request_raw)
            or source_review.get("payload") != {
                "path": PAYLOAD_REPO_PATH, "bytes": expected_payload_bytes,
                "sha256": expected_payload_sha256}
            or source_review.get("inspector") != {
                "path": R6G_HISTORICAL_INSPECTOR_PATH,
                "bytes": R6G_HISTORICAL_INSPECTOR_BYTES,
                "sha256": R6G_HISTORICAL_INSPECTOR_SHA256}
            or source_review.get("remote") != "NOT_RUN"
            or source_review.get("rendered_payload_reproduced_exactly") is not True
            or source_review.get("source_and_package_hashes_verified") is not True):
        raise RuntimeError("Main R6G source review does not PASS the exact local candidate")

    human_auth_raw = read_regular(persistent_authorization_path, maximum=1024 * 1024)
    if sha(human_auth_raw) != PERSISTENT_USER_AUTHORIZATION_SHA256:
        raise RuntimeError("persistent user PREP authorization differs from exact saved hash")
    human_auth = strict_json(human_auth_raw, "persistent human PREP authorization")
    if (human_auth.get("schema") != "cv3-persistent-windows-five-leaf-prep-authorization/1"
            or human_auth.get("status") != "USER_AUTHORIZED"
            or human_auth.get("target") != SSH_USER_HOST + ":22"
            or "Main-reviewed corrected PREP source payload revisions" not in human_auth.get("direct_reply_scope", "")
            or "helper, gate, two binding files and zero-byte MAIN_APPROVAL placeholder only"
               not in human_auth.get("direct_reply_scope", "")):
        raise RuntimeError("persistent user authority does not cover the exact bounded PREP effect")

    readonly_evidence = _validate_readonly_evidence(
        readonly_report_path, readonly_terminal_path, readonly_stdout_path, readonly_stderr_path,
        readonly_wrapper_review_path=readonly_wrapper_review_path)

    package_records = manifest.get("package_files")
    if not isinstance(package_records, dict):
        raise RuntimeError("R6G package file records are missing")
    for name, record in package_records.items():
        if not isinstance(name, str) or Path(name).name != name or not isinstance(record, dict):
            raise RuntimeError("R6G package file map is not an exact flat file map")
        raw = read_regular(PACKAGE / name)
        if (set(record) != {"sha256", "bytes"} or len(raw) != record.get("bytes")
                or sha(raw) != record.get("sha256")):
            raise RuntimeError("R6G package member does not match manifest: " + name)

    manifest_sources = manifest.get("source_files")
    request_sources = request.get("source_files")
    if (not isinstance(manifest_sources, dict) or not isinstance(request_sources, dict)
            or manifest_sources != request_sources
            or set(manifest_sources) != set(SOURCE_PATHS)):
        raise RuntimeError("R6G request and manifest source closures differ from the fixed reviewed source set")
    files = {}
    for relative in SOURCE_PATHS:
        record = request_sources[relative]
        raw = read_regular(ROOT / relative)
        if (not isinstance(record, dict) or set(record) != {"sha256", "bytes"}
                or len(raw) != record.get("bytes") or sha(raw) != record.get("sha256")):
            raise RuntimeError("R6G source bytes differ from the Main-reviewed source map: " + relative)
        files[relative] = sha(raw)

    artifacts = request.get("artifacts", {})
    if artifacts.get("manifest") != {
            "path": str(manifest_path.relative_to(ROOT)),
            "bytes": len(manifest_raw), "sha256": sha(manifest_raw)}:
        raise RuntimeError("R6G source request does not bind the exact candidate manifest")
    if artifacts.get("payload") != {
            "path": PAYLOAD_REPO_PATH, "bytes": expected_payload_bytes,
            "sha256": expected_payload_sha256}:
        raise RuntimeError("R6G source request does not bind the exact PREP payload")

    wrapper_path = Path(wrapper_path)
    if wrapper_path != WRAPPER_PATH.resolve() or wrapper_path.is_symlink():
        raise RuntimeError("wrapper is not loaded from its exact fixed source path")
    wrapper_raw = read_regular(wrapper_path)
    wrapper_sha256 = sha(wrapper_raw)
    invocation = invocation_binding(expected_payload_sha256, expected_payload_bytes)
    invocation_sha256 = sha(canonical(invocation))

    wrapper_review_raw = read_regular(wrapper_review_path, maximum=1024 * 1024)
    wrapper_review = strict_json(wrapper_review_raw, "Main R6G PREP wrapper source review")
    wrapper_review_expected = expected_wrapper_review(
        wrapper_sha256=wrapper_sha256, manifest_sha256=sha(manifest_raw),
        contract_sha256=sha(contract_raw), payload_sha256=expected_payload_sha256,
        payload_bytes=expected_payload_bytes, request_sha256=sha(request_raw),
        source_review_sha256=sha(source_review_raw),
        persistent_authorization_sha256=sha(human_auth_raw),
        readonly_evidence=readonly_evidence,
        invocation_sha256=invocation_sha256, invocation=invocation)
    if wrapper_review != wrapper_review_expected:
        raise RuntimeError("Main wrapper review does not PASS this exact R6G PREP wrapper source")

    authorization_raw = read_regular(authorization_path, maximum=1024 * 1024)
    authorization = strict_json(authorization_raw, "Main exact-once R6G PREP authorization")
    authorization_expected = expected_authorization(
        wrapper_sha256=wrapper_sha256, manifest_sha256=sha(manifest_raw),
        contract_sha256=sha(contract_raw), payload_sha256=expected_payload_sha256,
        payload_bytes=expected_payload_bytes, request_sha256=sha(request_raw),
        source_review_sha256=sha(source_review_raw),
        wrapper_review_sha256=sha(wrapper_review_raw),
        persistent_authorization_sha256=sha(human_auth_raw),
        readonly_evidence=readonly_evidence,
        invocation_sha256=invocation_sha256)
    if authorization != authorization_expected:
        raise RuntimeError("Main exact-once authorization does not bind exact R6D readback and R6G PREP scope")

    return payload_raw, {
        "payload_sha256": sha(payload_raw), "payload_bytes": len(payload_raw),
        "contract_sha256": sha(contract_raw), "manifest_sha256": sha(manifest_raw),
        "review_request_sha256": sha(request_raw), "source_review_sha256": sha(source_review_raw),
        "wrapper_review_sha256": sha(wrapper_review_raw),
        "authorization_sha256": sha(authorization_raw),
        "persistent_authorization_sha256": sha(human_auth_raw),
        "readonly_proof": _readonly_proof_binding(readonly_evidence),
        "invocation": invocation, "invocation_sha256": invocation_sha256,
        "source_hashes": files,
    }


def _write_exclusive(path: Path, raw: bytes) -> None:
    with path.open("xb") as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())


def _append_state(path: Path, status: str, *, pid: int | None, started: float,
                  details: Mapping[str, Any] | None = None) -> None:
    record = {"status": status, "original_local_ssh_pid": pid,
              "elapsed_seconds": time.monotonic() - started, **dict(details or {})}
    with path.open("ab", buffering=0) as stream:
        stream.write(json.dumps(record, sort_keys=True, ensure_ascii=False, allow_nan=False).encode("utf-8") + b"\n")
        os.fsync(stream.fileno())


def _output_digest(path: Path) -> dict[str, Any]:
    raw = read_regular(path, maximum=1024 * 1024 * 1024)
    return {"path": str(path), "bytes": len(raw), "sha256": sha(raw)}


_ACTIVE_POPEN_OWNERS: list["OriginalPopenOwner"] = []


class OriginalPopenOwner:
    """Strong owner that never returns while the exact Popen is live.

    Journal and observation failures are diagnostic data. They cannot bypass
    the passive same-object hold, and they never cause a second payload send.
    The guard owns the process object and its original bound communicate/wait
    methods until a natural terminal code is observed.
    """

    def __init__(self, child: Any, *, state_path: Path, started: float,
                 active_cutoff_seconds: float = ACTIVE_CUTOFF_SECONDS,
                 state_writer: Callable[..., Any] = _append_state,
                 fault_hook: Callable[[str], None] | None = None):
        self.child = child
        self.pid = getattr(child, "pid", None)
        self._communicate = child.communicate
        self._wait = child.wait
        self.state_path = state_path
        self.started = started
        self.active_cutoff_seconds = active_cutoff_seconds
        self.state_writer = state_writer
        self.fault_hook = fault_hook
        self.first_cause: BaseException | None = None
        self.diagnostic_errors: list[dict[str, str]] = []
        self.suppressed_diagnostics = 0
        self.failed_journal_statuses: set[str] = set()
        self.payload_send_attempted = False
        self.active_cutoff_exceeded = False
        self.terminal_observed = getattr(child, "returncode", None) is not None
        if not any(item is self for item in _ACTIVE_POPEN_OWNERS):
            _ACTIVE_POPEN_OWNERS.append(self)

    def remember_first(self, cause: BaseException) -> None:
        if self.first_cause is None:
            self.first_cause = cause

    def _remember_diagnostic(self, stage: str, error: BaseException) -> None:
        self.remember_first(error)
        if len(self.diagnostic_errors) < 32:
            self.diagnostic_errors.append({"stage": stage, "error_type": type(error).__name__,
                                           "error": str(error)[:2000]})
        else:
            self.suppressed_diagnostics += 1

    def record_state(self, status: str, details: Mapping[str, Any] | None = None) -> bool:
        if status in self.failed_journal_statuses:
            self.suppressed_diagnostics += 1
            return False
        try:
            self.state_writer(self.state_path, status, pid=self.pid, started=self.started,
                              details=details)
            return True
        except BaseException as exc:
            self.failed_journal_statuses.add(status)
            self._remember_diagnostic("state_journal:" + status, exc)
            return False

    def _fault(self, operation: str) -> None:
        if self.fault_hook is not None:
            self.fault_hook(operation)

    def send_payload_once(self, payload: bytes) -> None:
        if self.payload_send_attempted:
            error = RuntimeError("payload send already entered; no retry or resend")
            self.remember_first(error)
            self.record_state("UNKNOWN_DUPLICATE_SEND_REFUSED", {"action": "NO_RESEND"})
            self.hold_until_terminal()
            return
        self.payload_send_attempted = True
        try:
            self._fault("communicate")
            self._communicate(input=payload, timeout=self.active_cutoff_seconds)
        except subprocess.TimeoutExpired:
            self.active_cutoff_exceeded = True
            self.record_state("UNKNOWN_ACTIVE_CUTOFF_SAME_POPEN_RETAINED", {
                "cutoff_seconds": self.active_cutoff_seconds,
                "action": "PASSIVE_WAIT_SAME_ORIGINAL_POPEN_NO_SIGNAL_NO_RESEND",
            })
        except BaseException as exc:
            self._remember_diagnostic("payload_communicate", exc)
            self.record_state("UNKNOWN_COMMUNICATE_ERROR_SAME_POPEN_RETAINED", {
                "error_type": type(exc).__name__, "error": str(exc),
                "action": "PASSIVE_WAIT_SAME_ORIGINAL_POPEN_NO_SIGNAL_NO_RESEND",
            })
        self.hold_until_terminal()

    def hold_until_terminal(self) -> None:
        """Wait forever if needed, using only this Popen and no input resend."""
        if self.terminal_observed:
            return
        while getattr(self.child, "returncode", None) is None:
            try:
                self._fault("communicate")
                self._communicate()
            except BaseException as exc:
                self._remember_diagnostic("passive_communicate", exc)
                self.record_state("UNKNOWN_PASSIVE_COMMUNICATE_ERROR_SAME_POPEN", {
                    "error_type": type(exc).__name__, "error": str(exc),
                    "action": "RETAIN_AND_WAIT_SAME_ORIGINAL_POPEN_NO_SIGNAL_NO_RESEND",
                })
                # A failed drain may leave the child waiting for stdin. Close
                # only the original input pipe to deliver EOF; do not close the
                # Popen/process handle, signal it, or send another byte.
                stream = getattr(self.child, "stdin", None)
                if stream is not None and not getattr(stream, "closed", True):
                    try:
                        stream.close()
                    except BaseException as close_error:
                        self._remember_diagnostic("original_stdin_eof", close_error)
            if getattr(self.child, "returncode", None) is None:
                try:
                    self._fault("wait")
                    self._wait()
                except BaseException as exc:
                    self._remember_diagnostic("passive_wait", exc)
                    self.record_state("UNKNOWN_WAIT_ERROR_SAME_POPEN_RETAINED", {
                        "error_type": type(exc).__name__, "error": str(exc),
                        "action": "RETAIN_AND_WAIT_SAME_ORIGINAL_POPEN_NO_SIGNAL_NO_RESEND",
                    })
            if getattr(self.child, "returncode", None) is None:
                try:
                    time.sleep(0.01)
                except BaseException as exc:
                    self._remember_diagnostic("passive_wait_pause", exc)

        self.terminal_observed = True
        for index, owner in enumerate(_ACTIVE_POPEN_OWNERS):
            if owner is self:
                del _ACTIVE_POPEN_OWNERS[index]
                break
        self.record_state("NATURAL_TERMINAL_OBSERVED", {
            "returncode": getattr(self.child, "returncode", None),
            "active_cutoff_exceeded": self.active_cutoff_exceeded,
            "first_cause": (type(self.first_cause).__name__ + ":" + str(self.first_cause)
                            if self.first_cause is not None else None),
            "diagnostic_error_count": len(self.diagnostic_errors) + self.suppressed_diagnostics,
        })


def _validate_remote_result(stdout_path: Path, returncode: int) -> tuple[str, dict[str, Any] | None]:
    if returncode != 0:
        return "FAILED_REMOTE_PREP_SSH_NONZERO_NO_REPLAY", None
    raw = read_regular(stdout_path, maximum=1024 * 1024 * 1024)
    try:
        remote = strict_json(raw, "remote PREP stdout")
    except RuntimeError:
        return "FAILED_REMOTE_PREP_STDOUT_INVALID_NO_REPLAY", None
    native = remote.get("native_child")
    if (remote.get("status") != EXPECTED_REMOTE_STATUS
            or remote.get("r14", {}).get("source_helper_count") != 179
            or remote.get("r14", {}).get("stdlib_hash_count") != 179
            or not isinstance(native, dict)
            or native.get("CreateProcessWithTokenW") != "NOT_CALLED"
            or native.get("child_processes") != 0
            or remote.get("remote_objects", {}).get("once_absent") is not True
            or remote.get("remote_objects", {}).get("output_absent") is not True
            or remote.get("remote_objects", {}).get("cases_absent") is not True):
        return "FAILED_REMOTE_PREP_RESULT_SCOPE_NO_REPLAY", remote
    return "PASS_REMOTE_PREP_CLOSED_NO_NATIVE_AUTHORITY", remote


def main(*, popen_factory: Callable[..., Any] = subprocess.Popen,
         run_root: Path = RUN_ROOT, payload_path: Path = PAYLOAD_PATH,
         contract_path: Path = CONTRACT_PATH, manifest_path: Path = MANIFEST_PATH,
         request_path: Path = REQUEST_PATH, source_review_path: Path = SOURCE_REVIEW_PATH,
         wrapper_review_path: Path = WRAPPER_REVIEW_PATH,
         authorization_path: Path = AUTHORIZATION_PATH,
         persistent_authorization_path: Path = PERSISTENT_AUTHORIZATION_PATH,
         readonly_wrapper_review_path: Path = R6D_READONLY_WRAPPER_REVIEW_PATH,
         readonly_report_path: Path = R6D_READONLY_REPORT_PATH,
         readonly_terminal_path: Path = R6D_READONLY_TERMINAL_PATH,
         readonly_stdout_path: Path = R6D_READONLY_STDOUT_PATH,
         readonly_stderr_path: Path = R6D_READONLY_STDERR_PATH,
         wrapper_path: Path = Path(__file__).resolve(),
         state_writer: Callable[..., Any] = _append_state,
         fault_hook: Callable[[str], None] | None = None,
         active_cutoff_seconds: float = ACTIVE_CUTOFF_SECONDS) -> int:
    if run_root.exists() or run_root.is_symlink():
        raise RuntimeError("strict SSH run evidence path already exists; no overwrite, retry, or replay")
    payload, binding = _validate_inputs(
        payload_path, contract_path, manifest_path, request_path, source_review_path,
        wrapper_review_path, authorization_path, persistent_authorization_path,
        readonly_wrapper_review_path, readonly_report_path, readonly_terminal_path,
        readonly_stdout_path, readonly_stderr_path, wrapper_path)
    run_root.mkdir(parents=True, exist_ok=False, mode=0o700)
    intent_path, stdout_path, stderr_path, state_path, terminal_path, report_path = (
        run_root / name for name in OUTPUT_NAMES
    )
    started = time.monotonic()
    launch_intent = {
        "schema": "cv3-windows-primary-owner-r6g-ssh-launch-intent/1",
        "status": "STRICT_SSH_LAUNCH_INTENT_ONE_PAYLOAD_SEND",
        **binding,
        "output_directory": str(run_root),
        "popen_birth": "NOT_YET_OBSERVED",
        "retry": False,
    }
    _write_exclusive(intent_path, canonical(launch_intent))
    state_path.open("xb").close()
    child = None
    with stdout_path.open("xb", buffering=0) as stdout_file, stderr_path.open("xb", buffering=0) as stderr_file:
        try:
            child = popen_factory(
                binding["invocation"]["argv"], stdin=subprocess.PIPE,
                stdout=stdout_file, stderr=stderr_file, shell=False, cwd=str(ROOT),
            )
        except BaseException as exc:
            terminal = {
                "schema": "cv3-windows-primary-owner-r6g-ssh-terminal/1",
                "status": "UNKNOWN_POPEN_CONSTRUCTION_NO_REPLAY",
                "original_local_ssh_pid": None, "original_local_ssh_returncode": None,
                "error_type": type(exc).__name__, "error": str(exc),
                "payload_may_have_been_sent": "UNKNOWN", "retry": False,
                **binding,
            }
            try:
                _write_exclusive(terminal_path, canonical(terminal))
                state_writer(state_path, terminal["status"], pid=None, started=started)
                _write_exclusive(report_path, canonical({"status": terminal["status"], "terminal": terminal}))
            except BaseException:
                # There is no returned original Popen to hold. Preserve the
                # launch attempt and never retry, even if local evidence fails.
                pass
            return 1
        # Install the process owner immediately after birth, before logging or
        # any other operation can fail. Its finally path is the only route out
        # of this frame and cannot return while this exact Popen is live.
        owner = OriginalPopenOwner(child, state_path=state_path, started=started,
                                   active_cutoff_seconds=active_cutoff_seconds,
                                   state_writer=state_writer, fault_hook=fault_hook)
        remote = None
        remote_status = "UNKNOWN_POST_POPEN_NO_REPLAY"
        try:
            valid_pid = type(owner.pid) is int and owner.pid > 0
            if not valid_pid:
                owner.remember_first(RuntimeError("original Popen PID is malformed"))
                owner.record_state("UNKNOWN_POPEN_PID_MALFORMED_NO_REPLAY")
            else:
                birth_logged = owner.record_state("ORIGINAL_POPEN_BIRTH_OBSERVED", {
                    "payload_sha256": binding["payload_sha256"],
                    "payload_bytes": binding["payload_bytes"],
                })
                # If the birth record cannot be persisted, do not send even the
                # first byte. Close only stdin by passive communicate and hold
                # the same child to terminal.
                if birth_logged and owner.first_cause is None:
                    owner.send_payload_once(payload)
                else:
                    owner.hold_until_terminal()
            # Keep the owner guard outside all readback/report operations too.
            owner.hold_until_terminal()
            stdout_file.flush(); os.fsync(stdout_file.fileno())
            stderr_file.flush(); os.fsync(stderr_file.fileno())
            remote_status, remote = _validate_remote_result(stdout_path, child.returncode)
            final_status = ("UNKNOWN_POST_POPEN_FAILURE_TERMINAL_NO_REPLAY"
                            if owner.first_cause is not None else remote_status)
        except BaseException as exc:
            owner.remember_first(exc)
            owner.record_state("UNKNOWN_POST_POPEN_EXCEPTION_SAME_OWNER_RETAINED", {
                "error_type": type(exc).__name__, "error": str(exc),
            })
            final_status = "UNKNOWN_POST_POPEN_FAILURE_TERMINAL_NO_REPLAY"
            remote = None
        finally:
            # Unconditional owner guard: log, classification, or report
            # failures cannot let a live local SSH child escape this scope.
            owner.hold_until_terminal()

    terminal = {
        "schema": "cv3-windows-primary-owner-r6g-ssh-terminal/1",
        "status": "PASSIVE_TERMINAL_AFTER_ACTIVE_CUTOFF" if owner.active_cutoff_exceeded else "NATURAL_TERMINAL_OBSERVED",
        "original_local_ssh_pid": owner.pid,
        "original_local_ssh_returncode": child.returncode,
        "active_cutoff_seconds": active_cutoff_seconds,
        "active_cutoff_exceeded": owner.active_cutoff_exceeded,
        "elapsed_seconds": time.monotonic() - started,
        "argv": binding["invocation"]["argv"],
        "payload_sha256": binding["payload_sha256"],
        "payload_bytes": binding["payload_bytes"],
        "stdout": _output_digest(stdout_path),
        "stderr": _output_digest(stderr_path),
        "remote_status": remote.get("status") if remote else None,
        "final_classification": final_status,
        "same_original_popen_retained_through_terminal": owner.terminal_observed,
        "payload_send_attempted_once": owner.payload_send_attempted,
        "signals_kills_retries_resends": 0,
        "first_cause": (type(owner.first_cause).__name__ + ":" + str(owner.first_cause)
                        if owner.first_cause is not None else None),
        "diagnostic_errors": owner.diagnostic_errors,
        "suppressed_diagnostic_count": owner.suppressed_diagnostics,
        **{key: binding[key] for key in ("contract_sha256", "manifest_sha256", "review_request_sha256",
                                         "source_review_sha256", "authorization_sha256",
                                         "invocation_sha256", "source_hashes")},
    }
    _write_exclusive(terminal_path, canonical(terminal))
    report = {
        "schema": "cv3-windows-primary-owner-r6g-ssh-actual-report/1",
        "status": final_status,
        "remote": remote,
        "terminal": terminal,
        "evidence": {
            "stdout": _output_digest(stdout_path), "stderr": _output_digest(stderr_path),
            "state": _output_digest(state_path), "terminal": _output_digest(terminal_path),
        },
        "replay": False,
        "native_child": "NOT_AUTHORIZED",
    }
    _write_exclusive(report_path, canonical(report))
    return 0 if final_status == "PASS_REMOTE_PREP_CLOSED_NO_NATIVE_AUTHORITY" else 1


def cli_entrypoint(main_callable: Callable[[], int] = main) -> int:
    """Return the CLI status; the final SystemExit is deliberately outside this guard."""
    try:
        code = main_callable()
    except SystemExit as exc:
        code = exc.code if type(exc.code) is int else 1
    except BaseException as exc:
        try:
            sys.stderr.write("STRICT_SSH_PREP_FAILED_NO_RETRY: " + type(exc).__name__ + ": " + str(exc) + "\n")
            sys.stderr.flush()
        except BaseException:
            pass
        return 1
    if type(code) is not int or not 0 <= code <= 255:
        return 1
    return code


if __name__ == "__main__":
    # SystemExit for a successful main return is not caught and converted into
    # a failure string. Any post-Popen exception has already passed through
    # OriginalPopenOwner's unconditional natural-terminal guard in main().
    raise SystemExit(cli_entrypoint())
