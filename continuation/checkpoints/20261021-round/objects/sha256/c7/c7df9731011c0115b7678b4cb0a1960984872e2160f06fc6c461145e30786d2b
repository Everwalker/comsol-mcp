class _FullEntryFixtureDispatcher:
    """Inert transport using the recorded actual direction graph and exact producer shapes."""

    def __init__(self, plan=None, *, two_materials=False, geometry_dimension=2,
                 adjacency_target_dimension=2):
        fixture_path = (SOURCE / "tests" / "fixtures" /
                        "w23_r31r2_actual_direction_replay.json")
        fixture = json.loads(fixture_path.read_text())
        self.graph_records = fixture["records"]
        self.graph_used = set()
        self.calls = []
        self.plan = plan
        self.geometry_dimension = geometry_dimension
        self.adjacency_target_dimension = adjacency_target_dimension
        self.two_materials = two_materials
        self.point_rows = []
        self.integral_rows = []
        self.owner_load_mutation = None
        self.owner_status_mutation = None
        self.owner_jobs = {}
        if two_materials:
            (self.material_inventory, self.material_inspections, _adjacency) = \
                material_fixtures._observed_two_materials(
                    epsilon_core=[["n_core^2", "0", "0"],
                                  ["0", "n_core^2", "0"],
                                  ["0", "0", "n_core^2"]],
                    epsilon_clad=[["n_clad^2", "0", "0"],
                                  ["0", "n_clad^2", "0"],
                                  ["0", "0", "n_clad^2"]],
                )
            self.parameter_payload = material_fixtures._parameter_payload_rows(
                {"n_core": 1.45, "n_clad": 1.0})
        else:
            (self.material_inventory, self.material_inspections,
             _adjacency, _inspection) = material_fixtures._observed()
            self.parameter_payload = None

    @staticmethod
    def _public(data):
        context = _context()
        return {
            "success": True,
            "execution": {
                "project_id": context["project_id"],
                "session_id": context["model_ref"]["session_id"],
                "model_ref": context["model_ref"],
                "revision": context["expected_revision"],
            },
            "data": data,
        }

    def _recorded_graph_response(self, operation_id, arguments):
        for index, row in enumerate(self.graph_records):
            if index in self.graph_used:
                continue
            if row["operation_id"] == operation_id and row["arguments"] == arguments:
                self.graph_used.add(index)
                return row["public_data"]
        raise AssertionError(
            f"no recorded graph response for {operation_id}: "
            f"{json.dumps(arguments, sort_keys=True)}"
        )

    def __call__(self, operation, wrapper, execution):
        if operation != "operation_call" or set(wrapper) != {"operation_id", "arguments"}:
            raise AssertionError("unexpected fake transport envelope")
        operation_id, arguments = wrapper["operation_id"], wrapper["arguments"]
        self.calls.append((operation_id, copy.deepcopy(arguments)))
        if operation_id in {"artifact.register", "model.load", "job.status"}:
            self.assert_unbound_owner_context(execution)
        else:
            self.assert_owner_context(execution)

        if operation_id == "artifact.register":
            if (arguments["project_id"] != _session_context()["project_id"]
                    or arguments["path"] != _source_relative_path()
                    or arguments["role"] != "saved_model"
                    or arguments["classification"] != "project_local"
                    or arguments["artifact_type"] != "application/vnd.comsol.mph"
                    or arguments["format_version"] != "comsol-mph-savecopy/1"):
                raise AssertionError("artifact.register source receipt request drifted")
            identity = runtime.entry.verify_saved_mph_copy(str(_saved_copy()))
            request_id = execution["request_id"]
            operation_id_value = "fixture-artifact-register-operation"
            data = {
                "artifact_id": identity["sha256"], "sha256": identity["sha256"],
                "path": f"g2_artifacts/registered/{identity['sha256']}.mph",
                "size": identity["bytes"], "role": "saved_model",
                "classification": "project_local",
                "artifact_type": "application/vnd.comsol.mph",
                "format_version": "comsol-mph-savecopy/1",
                "provenance": {
                    "source_project_relative_path": arguments["path"],
                    "request_id": request_id,
                    "registering_operation_id": operation_id_value,
                    "source_sha256": identity["sha256"],
                },
                "reused": False, "host_scope": "local_loopback_engine_and_current_project",
            }
            response = {
                "success": True,
                "execution": {
                    "project_id": _session_context()["project_id"],
                    "request_id": request_id, "idempotency_key": execution["idempotency_key"],
                    "operation_id": operation_id_value,
                    "job_id": "fixture-artifact-register-job", "request_hash": "a" * 64,
                },
                "data": data,
            }
            return self._record_owner_job(operation_id, arguments, execution, response)

        if operation_id == "model.load":
            identity = runtime.entry.verify_saved_mph_copy(str(_saved_copy()))
            if (arguments != {"artifact_id": identity["sha256"],
                              "path_policy": {"mode": "registered_artifact"}}):
                raise AssertionError("model.load did not use the fresh registered saved-MPH identity")
            context = _context()
            model_ref = copy.deepcopy(context["model_ref"])
            revision = context["expected_revision"]
            data = {
                "status": "LOADED", "ownership": "mcp_owned",
                "project_id": context["project_id"], "model_tag": model_ref["model_tag"],
                "model_ref": model_ref, "artifact_id": identity["sha256"],
                "sha256": identity["sha256"], "size_bytes": identity["bytes"],
            }
            response = {
                "success": True,
                "execution": {
                    "project_id": context["project_id"],
                    "session_id": context["model_ref"]["session_id"],
                    "model_ref": model_ref, "revision": revision,
                    "model_ownership": "mcp_owned", "dirty": False,
                    "request_id": execution["request_id"],
                    "idempotency_key": execution["idempotency_key"],
                    "operation_id": "fixture-model-load-operation",
                    "job_id": "fixture-model-load-job", "request_hash": "b" * 64,
                },
                "data": data,
            }
            if self.owner_load_mutation == "artifact_sha":
                response["data"]["sha256"] = "0" * 64
            elif self.owner_load_mutation == "project":
                response["execution"]["project_id"] = "foreign-project"
                response["data"]["project_id"] = "foreign-project"
            elif self.owner_load_mutation == "model_ref_execution":
                response["execution"]["model_ref"]["model_tag"] = "other-tag"
            elif self.owner_load_mutation == "model_ref_data":
                response["data"]["model_ref"]["model_tag"] = "other-tag"
            elif self.owner_load_mutation == "revision":
                response["execution"]["revision"] = revision + 1
            elif self.owner_load_mutation == "ownership":
                response["execution"]["model_ownership"] = "user_owned"
                response["data"]["ownership"] = "user_owned"
            return self._record_owner_job(operation_id, arguments, execution, response)

        if operation_id == "job.status":
            if set(arguments) != {"job_id"} or arguments["job_id"] not in self.owner_jobs:
                raise AssertionError("job.status did not query the exact preceding owner job")
            job = copy.deepcopy(self.owner_jobs[arguments["job_id"]])
            if self.owner_status_mutation == "missing_status":
                job.pop("status", None)
                job["operation"].pop("status", None)
            elif self.owner_status_mutation == "failed_status":
                job["status"] = "FAILED"
                job["operation"]["status"] = "FAILED"
            elif self.owner_status_mutation == "foreign_project":
                job["metadata"]["execution"]["project_id"] = "foreign-project"
                job["operation"]["metadata"]["execution"]["project_id"] = "foreign-project"
            elif self.owner_status_mutation == "foreign_request":
                job["operation"]["request_id"] = "other-request"
            elif self.owner_status_mutation == "changed_result":
                job["result"]["data"]["sha256"] = "0" * 64
                job["operation"]["result"]["data"]["sha256"] = "0" * 64
            if self.owner_status_mutation == "foreign_read_project":
                job["metadata"]["execution"]["project_id"] = "foreign-project"
            elif self.owner_status_mutation == "foreign_read_request":
                job["metadata"]["execution"]["request_id"] = "other-status-request"
            # This mirrors ControlDaemon._control_read(job_status): the cached
            # producer returns the stored snapshot in {success,data}, without
            # creating a second execution envelope for the status read.
            return {"success": True, "data": job}

        if operation_id in {"node.children", "node.inspect", "node.property_schema", "node.property_get"}:
            return self._public(self._recorded_graph_response(operation_id, arguments))
        if operation_id == "model.inspect":
            return self._public({"model_identity": _context()["model_ref"],
                                 "revision": _context()["expected_revision"],
                                 "dirty": False, "comsol_version": "6.4.0.293",
                                 "detail": "summary"})
        if operation_id == "runtime.capabilities":
            if arguments != {"refresh": False}:
                raise AssertionError("runtime.capabilities must be a no-refresh read")
            worker_id = "12345678-1234-4234-8234-123456789abc"
            return self._public({
                "worker": {"available": True, "connected": True,
                           "instance_id": worker_id, "generation": 19,
                           "source": "PersistentJavaWorker.runtime_metadata()", "error": None},
                "runtime_identity": {"instance_id": worker_id, "generation": 19,
                                     "connected": True, "source": "PersistentJavaWorker.runtime_metadata()",
                                     "error": None, "runtime_id": "runtime-" + worker_id,
                                     "runtime_id_source": "PersistentJavaWorker.runtime_metadata().instance_id",
                                     "revision_dependency": {"required": False,
                                         "reason": "a runtime capability query is not bound to a model revision"},
                                     "bound_model_required": False},
                "engine": {"comsol_version": "6.4.0.293",
                           "source": "ModelUtil.getComsolVersion()",
                           "channel": "worker", "worker_generation": 19},
            })
        if operation_id == "geometry.inspect":
            return self._public({
                "path": arguments["path"], "kind": "geom",
                "geometry_state": {"dimension": self.geometry_dimension, "length_unit": "um"},
            })
        if operation_id == "dataset.list":
            datasets = [
                {"tag": f"dset{index}", "type_id": "Solution", "solution": f"sol{index}"}
                for index in (1, 2, 3)
            ]
            return self._public({"datasets": datasets, "count": len(datasets), "read_errors": []})
        if operation_id == "dataset.solution_indices":
            tag = arguments["path"]
            index = int(tag.removeprefix("dset"))
            return self._public({
                "dataset": tag, "solution": f"sol{index}",
                "binding_complete": True, "solution_count": 1,
            })
        if operation_id == "selection.list":
            rows = [
                {"tag": tag, "geometry": "geom1", "entity_dimension": 1,
                 "dimension": 1, "entities": entities, "is_inheriting": False}
                for tag, entities in (("selInputPort", [17]), ("selReceiverX8", [24]))
            ]
            return self._public({"selections": rows, "count": len(rows)})
        if operation_id == "selection.inspect":
            tag = arguments["tag"]
            entities = [17] if tag == "selInputPort" else [24]
            return self._public({
                "tag": tag, "component": "comp1", "entity_dimension": 1,
                "dimension": 1, "entities": entities,
                "state": {"geometry": "geom1", "entities": entities,
                          "is_inheriting": False, "named": tag},
            })
        if operation_id == "material.list":
            if arguments != {"component": "comp1"}:
                raise AssertionError("material inventory request drifted")
            return self._public(copy.deepcopy(self.material_inventory))
        if operation_id == "material.inspect":
            tag = arguments["path"]["segments"][1]["tag"]
            inspection = next(row for row in self.material_inspections if row["tag"] == tag)
            return self._public(copy.deepcopy(inspection))
        if operation_id == "selection.adjacency":
            selection_tag = arguments["selection"]["tag"]
            entity = 17 if selection_tag == "selInputPort" else 24
            domain = 1 if not self.two_materials or selection_tag == "selInputPort" else 2
            return self._public({
                "entity_dimension": 1, "target_dimension": self.adjacency_target_dimension,
                "per_entity_truncated": False, "source_entities": [entity],
                "per_entity": [{"entity": entity, "adjacent": [domain]}],
                "adjacent_entities": [domain],
            })
        if operation_id == "parameter.get":
            if self.parameter_payload is None:
                raise AssertionError("plain material fixture must not request fabricated parameters")
            if (arguments.get("names") != ["n_clad", "n_core"]
                    or arguments.get("evaluate") is not True):
                raise AssertionError("global material parameter query was not exact and bounded")
            return self._public(copy.deepcopy(self.parameter_payload))
        if operation_id == "result.at_points":
            if self.plan is None:
                raise AssertionError("full-entry numeric fixture requires the unpatched metadata plan")
            slot = next(row for row in self.plan["point_read_slots"]
                        if row["request_arguments"] == arguments
                        and row not in self.point_rows)
            count = slot["sample_count"]
            prefix, port = slot["physics_identifier_observed"], slot["port_name_observed"]
            entries = {name: (0.0, 0.0) for name in slot["expressions"]}
            entries[f"down({prefix}.Ey)"] = (2.0, 0.0)
            entries[f"down({prefix}.Hz)"] = (1.0, 0.0)
            entries[f"{prefix}.Emodey_{port}"] = (2.0, 0.0)
            entries[f"{prefix}.Hmodez_{port}"] = (-1.0, 0.0)
            entries[f"{prefix}.nx"] = (-1.0, 0.0)
            values = [
                [[[{"real": entries[name][0], "imag": entries[name][1]}
                   for _ in range(count)]]]
                for name in arguments["spec"]["expressions"]
            ]
            points = arguments["points"]
            data = {
                "expressions": arguments["spec"]["expressions"],
                "dataset": slot["dataset_tag_observed"],
                "solution": slot["solution_tag_observed"],
                "complex_mode": "preserve", "is_complex": True,
                "expression_units": dict(zip(slot["expressions"], slot["requested_units"])),
                "coordinate_readback": {
                    "status": "VERIFIED", "unit": "um",
                    "coordinates": [[p["x"] for p in points], [p["y"] for p in points]],
                },
                "field_array": {
                    "axes": ["expression", "outer", "inner", "point"],
                    "shape": [len(slot["expressions"]), 1, 1, count],
                    "is_complex": True, "values": values,
                },
                "values": values,
                "feature_readback": {
                    "data": slot["dataset_tag_observed"], "data_status": "VERIFIED",
                    "source": "NumericalFeature.getString('data') after set('data')",
                },
                "result_budget": {"status": "PASS", "publish_allowed": True},
                "cleanup": {"created": True, "removed": True, "verified_removed": True,
                            "cleanup_failed": False, "error": None},
                "status": {"ok": True, "engine_error": None, "cleanup_failed": False,
                           "verification_status": "PASSED"},
                "verification_status": "PASSED",
            }
            self.point_rows.append(slot)
            return self._public(data)
        if operation_id == "result.evaluate":
            if self.plan is None:
                raise AssertionError("full-entry numeric fixture requires the unpatched metadata plan")
            slot = next(row for row in self.plan["native_integral_slots"]
                        if row["request_arguments"] == arguments
                        and row not in self.integral_rows)
            values = [[[[value]]] for value in (16e-6, -16e-6, -16e-6, 16e-6)]
            data = {
                "aggregate": "integral", "complex_mode": "real",
                "dataset": slot["dataset_tag_observed"], "solution": slot["solution_tag_observed"],
                "expressions": slot["expressions"],
                "expression_units": dict(zip(slot["expressions"], slot["requested_units"])),
                "status": {"ok": True, "cleanup_failed": False},
                "cleanup": {"created": True, "removed": True,
                            "verified_removed": True, "cleanup_failed": False, "children": []},
                "field_array": {"axes": ["expression", "outer", "inner", "point"],
                                "shape": [4, 1, 1, 1], "is_complex": False,
                                "values": values},
                "values": values,
            }
            self.integral_rows.append(slot)
            return self._public(data)
        raise AssertionError(f"unexpected operation in full-entry fake transport: {operation_id}")

    def _record_owner_job(self, operation_id, arguments, execution, response):
        job_id = response["execution"]["job_id"]
        metadata = {"operation": "operation_call",
                    "arguments": {"operation_id": operation_id,
                                  "arguments": copy.deepcopy(arguments)},
                    "execution": copy.deepcopy(execution)}
        operation_record = {
            "operation_id": response["execution"]["operation_id"],
            "request_id": execution["request_id"],
            "idempotency_key": execution["idempotency_key"],
            "request_hash": response["execution"]["request_hash"],
            "operation": "operation_call", "status": "SUCCEEDED",
            "finished_at": "2026-10-19T00:00:00Z",
            "metadata": copy.deepcopy(metadata), "result": copy.deepcopy(response),
        }
        job_metadata = copy.deepcopy(metadata)
        # ControlDaemon persists request identity in both records and merges
        # queue/finish observations into the job-only metadata copy.
        job_metadata.update({"queue_wait_s": 0.002, "engine_started_at": 1792368000.0,
                             "finished_observed_at": 1792368001.0})
        self.owner_jobs[job_id] = {
            "job_id": job_id, "operation_id": operation_record["operation_id"],
            "status": "SUCCEEDED", "finished_at": "2026-10-19T00:00:00Z",
            "metadata": job_metadata, "operation": operation_record,
            "result": copy.deepcopy(response),
        }
        return response

    @staticmethod
    def assert_owner_context(execution):
        if (execution["project_id"] != _context()["project_id"]
                or execution["model_ref"] != _context()["model_ref"]
                or execution["session_id"] != _context()["model_ref"]["session_id"]
                or execution["execution_timeout_s"] is not None):
            raise AssertionError("full-entry fixture context changed")
        forbidden = {"approval", "approval_id", "once", "once_token", "token"}
        if set(execution) & forbidden:
            raise AssertionError("authority field reached inert fixture transport")

    @staticmethod
    def assert_unbound_owner_context(execution):
        if (execution.get("project_id") != _session_context()["project_id"]
                or execution.get("session_id") != _session_context()["session_id"]
                or execution.get("model_ref") is not None
                or execution.get("expected_revision") is not None
                or execution.get("execution_timeout_s") is not None):
            raise AssertionError("fresh artifact registration/model.load used a stale bound context")
        forbidden = {"approval", "approval_id", "once", "once_token", "token"}
        if set(execution) & forbidden:
            raise AssertionError("authority field reached inert fixture transport")


