class _FakeDaemon:
    def __init__(self, response):
        self.response = response
        self.requests = []

    def dispatch(self, endpoint, payload, timeout):
        self.requests.append((endpoint, payload, timeout))
        self.assert_contract(payload)
        return self.response

    @staticmethod
    def assert_contract(payload):
        assert payload["operation"] == "operation_call"
        assert payload["arguments"] == {
            "operation_id": "model.inspect",
            "arguments": {},
        }
        execution = payload["execution"]
        assert execution["project_id"] == _context()["project_id"]
        assert execution["session_id"] == _context()["model_ref"]["session_id"]
        assert execution["model_ref"] == _context()["model_ref"]
        assert execution["expected_revision"] == _context()["expected_revision"]
        assert execution["rpc_timeout_s"] == 30.0
        assert execution["execution_timeout_s"] is None
        assert execution["queue_timeout_s"] == 60.0
        assert execution["request_id"].startswith("w23-zero-r6-req-")
        assert execution["idempotency_key"].startswith("w23-zero-r6-idem-")
        forbidden = {"approval", "approval_id", "once", "once_token", "token"}
        assert not (set(execution) & forbidden)


class _FixtureOperationStoreTransport:
    """Synthetic OperationStore rows for software-only public-contract tests."""

    def __init__(self, dispatcher):
        self.dispatcher = dispatcher
        self.records = {}
        self.calls = []
        self.next_id = 0
        self.owner_identity = {
            "project_id": _context()["project_id"],
            "session_id": _context()["model_ref"]["session_id"],
            "server_pid": 20001, "worker_pid": 20002,
            "worker_instance_id": "12345678-1234-4234-8234-123456789abc",
            "worker_epoch": 19,
        }
        self.gate = _FixtureOwnedGate(self.owner_identity)

    @staticmethod
    def _sha(value):
        import hashlib
        return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
                                  ensure_ascii=False, allow_nan=False).encode()).hexdigest()

    def _record(self, response, operation, arguments, execution):
        response = copy.deepcopy(response)
        response_execution = response.setdefault("execution", {})
        if not isinstance(response_execution, dict):
            raise AssertionError("fixture public response execution must be an object")
        response_execution.pop("status", None)
        self.next_id += 1
        operation_id = f"fixture-public-operation-{self.next_id}"
        job_id = f"fixture-public-job-{self.next_id}"
        request = {"operation": "operation_call",
                   "arguments": {"operation_id": operation, "arguments": copy.deepcopy(arguments)},
                   "execution": copy.deepcopy(execution)}
        request_hash = self._sha({"operation": operation, "arguments": arguments,
                                  "model_ref": execution.get("model_ref"),
                                  "expected_revision": execution.get("expected_revision"),
                                  "request": execution.get("request_id")})
        response_execution.update({
            "project_id": execution["project_id"], "session_id": execution["session_id"],
            "request_id": execution["request_id"],
            "idempotency_key": execution["idempotency_key"],
            "model_ref": execution.get("model_ref"),
            "revision": execution.get("expected_revision"),
            "operation_id": operation_id, "job_id": job_id,
            "request_hash": request_hash,
        })
        metadata = {"operation": "operation_call", "arguments": copy.deepcopy(request["arguments"]),
                    "execution": copy.deepcopy(execution)}
        operation_row = {
            "operation_id": operation_id, "request_id": execution["request_id"],
            "idempotency_key": execution["idempotency_key"], "request_hash": request_hash,
            "operation": "operation_call", "status": "SUCCEEDED",
            "finished_at": "2026-10-19T00:00:00Z", "metadata": metadata,
            "result": copy.deepcopy(response),
        }
        job_metadata = {**metadata, "queue_wait_s": 0.001,
                        "engine_started_at": 1792368000.0,
                        "finished_observed_at": 1792368001.0}
        job_row = {
            "job_id": job_id, "operation_id": operation_id, "status": "SUCCEEDED",
            "finished_at": "2026-10-19T00:00:00Z", "metadata": job_metadata,
            "operation": copy.deepcopy(operation_row), "result": copy.deepcopy(response),
        }
        self.records[(operation_id, job_id)] = {
            "request": request, "operation": operation_row, "job": job_row,
            "owner_identity": dict(self.owner_identity),
        }
        return response

    def __call__(self, operation, arguments, execution):
        self.calls.append((operation, copy.deepcopy(arguments), copy.deepcopy(execution)))
        response = self.dispatcher(operation, arguments, execution)
        if (isinstance(response, dict) and response.get("success") is True
                and arguments.get("operation_id") not in {
                    "artifact.register", "model.load", "job.status"}):
            return self._record(response, arguments["operation_id"],
                                arguments["arguments"], execution)
        return response

    def dispatch(self, operation, arguments, execution):
        return self(operation, arguments, execution)

    def read_terminal_pair(self, request, response):
        execution = response.get("execution") if isinstance(response, dict) else None
        if not isinstance(execution, dict):
            return None
        pair = self.records.get((execution.get("operation_id"), execution.get("job_id")))
        if pair is None or pair["request"] != request:
            return None
        return {key: copy.deepcopy(pair[key]) for key in ("operation", "job", "owner_identity")}

    def bind_direct_response(self, response, operation, arguments, execution):
        return self._record(response, operation, arguments, execution)


