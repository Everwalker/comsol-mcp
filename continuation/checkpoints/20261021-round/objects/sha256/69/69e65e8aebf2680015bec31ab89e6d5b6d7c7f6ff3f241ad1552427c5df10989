@contextmanager
def _exact_candidate_imports():
    candidate_root = CANDIDATE_ROOT
    source_root = candidate_root / "source"
    w25_probe_root = (candidate_root.parents[1] / "_state" /
                      "w25-r5-fresh-runtime-entry-6fc675b5-c7a1-4483-9de5-51d2ceeccd8f-20261019" /
                      "probe")
    saved_modules = {
        name: module for name, module in tuple(sys.modules.items())
        if (name == "probe" or name.startswith("probe.")
            or name == "comsol_mcp" or name.startswith("comsol_mcp.")
            or name == "mcp" or name.startswith("mcp.")
            or name in {"runner", "admission", "operation_store_witness"})
    }
    for name in saved_modules:
        sys.modules.pop(name, None)
    original_path = list(sys.path)
    sys.path[:0] = [str(source_root), str(w25_probe_root)]
    try:
        spec = importlib.util.spec_from_file_location(
            "probe", candidate_root / "probe" / "__init__.py",
            submodule_search_locations=[str(candidate_root / "probe")])
        assert spec is not None and spec.loader is not None
        package = importlib.util.module_from_spec(spec)
        sys.modules["probe"] = package
        spec.loader.exec_module(package)
        from comsol_mcp._control_daemon import ControlDaemon
        from comsol_mcp._session_context import (
            CanonicalSocket, OwnedServerProcessIdentity, SessionEndpointIdentity,
            SessionRuntimeConfig, SessionRuntimeContext,
        )
        from admission import ProbeControlHost, ProbeSessionAdmission, W25ProbeCloseDelegator
        from runner import BoundManagedPublicGate, ProbeCloseGrantSeed
        from probe.w23_owned_runtime_entry import W23OwnedRuntimeBridge
        yield {
            "ControlDaemon": ControlDaemon,
            "CanonicalSocket": CanonicalSocket,
            "OwnedServerProcessIdentity": OwnedServerProcessIdentity,
            "SessionEndpointIdentity": SessionEndpointIdentity,
            "SessionRuntimeConfig": SessionRuntimeConfig,
            "SessionRuntimeContext": SessionRuntimeContext,
            "ProbeControlHost": ProbeControlHost,
            "ProbeSessionAdmission": ProbeSessionAdmission,
            "W25ProbeCloseDelegator": W25ProbeCloseDelegator,
            "BoundManagedPublicGate": BoundManagedPublicGate,
            "ProbeCloseGrantSeed": ProbeCloseGrantSeed,
            "W23OwnedRuntimeBridge": W23OwnedRuntimeBridge,
            "admission_module": sys.modules["admission"],
            "runner": sys.modules["runner"],
            "owned_module": sys.modules["probe.w23_owned_runtime_entry"],
            "runtime_module": sys.modules["probe.w23_zero_solve_runtime"],
        }
    finally:
        for name in tuple(sys.modules):
            if (name == "probe" or name.startswith("probe.")
                    or name == "comsol_mcp" or name.startswith("comsol_mcp.")
                    or name == "mcp" or name.startswith("mcp.")
                    or name in {"runner", "admission", "operation_store_witness"}):
                sys.modules.pop(name, None)
        sys.modules.update(saved_modules)
        sys.path[:] = original_path


