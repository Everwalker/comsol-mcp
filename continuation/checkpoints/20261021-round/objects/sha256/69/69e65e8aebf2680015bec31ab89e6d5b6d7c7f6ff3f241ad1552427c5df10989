def _mkdir_private(path: Path) -> None:
    path.mkdir(mode=0o700)
    assert stat.S_IMODE(path.lstat().st_mode) == 0o700


def _write_file(path: Path, data: bytes = b"fixture\n") -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())


def _owner_root(r6, tmp_path: Path, *, complete: bool, workspace_mode: str = "empty") -> Path:
    run_id = "1234567890abcdef1234567890abcdef"
    root = tmp_path / f".w25-probe-{run_id}"
    _mkdir_private(root)
    setup = root / "setup"
    _mkdir_private(setup)
    ordinals = ((1, "project-create"), (2, "session-start"), (3, "session-connect"))
    suffixes = ("intent", "response") if complete else ("intent",)
    for ordinal, operation in ordinals:
        for suffix in suffixes:
            _write_file(setup / f"{ordinal:02d}-{operation}-{suffix}.json")
    _write_file(root / "ADMISSION_RESULT.json")
    workspace = root / "workspace"
    _mkdir_private(workspace)
    if workspace_mode == "unexpected":
        _write_file(workspace / "unexpected.txt")
    if complete:
        source_identity = r6.entry.verify_saved_mph_copy(str(r6.SAVED_MPH_PATH))
        digest = source_identity["sha256"]
        input_relative = f"w23-input-{run_id}/w23_coarse-phase0_provisional.mph"
        input_root = tmp_path / f"w23-input-{run_id}"
        _mkdir_private(input_root)
        if workspace_mode == "saved":
            saved = input_root / "w23_coarse-phase0_provisional.mph"
            shutil.copyfile(r6.SAVED_MPH_PATH, saved)
            os.chmod(saved, 0o400)
            dest_identity = r6.entry.verify_saved_mph_copy(str(saved))
        else:
            dest_identity = {
                "path": str(input_root / "w23_coarse-phase0_provisional.mph"),
                    "bytes": source_identity["bytes"], "sha256": digest,
                "mode": "0o400", "opened_by_comsol": False,
            }
        binding = {
            "schema": "w23-r6-saved-mph-copy-binding/2",
            "status": "PASS_EXACT_IMMUTABLE_SOURCE_COPIED_TO_NON_HIDDEN_PROJECT_INPUT",
            "run_id": run_id, "project_id": "synthetic-project", "session_id": "synthetic-session",
            "project_root": str(tmp_path), "source_identity": source_identity,
            "destination_identity": dest_identity, "source_project_relative_path": input_relative,
            "opened_by_comsol": False,
        }
        _write_file(root / "W23_SAVED_MPH_COPY_BINDING_R2.json",
                    (json.dumps(binding, sort_keys=True) + "\n").encode())
        evidence = root / "w23-evidence"
        _mkdir_private(evidence)
        run = evidence / f"w23-zero-solve-{uuid.uuid4()}"
        _mkdir_private(run)
        _write_file(run / "public-receipts.jsonl", b"{}\n")
    return root


def test_partial_archive_accepts_only_empty_pre_copy_workspace(tmp_path):
    r6, _ = _load_candidate_modules()
    source = _owner_root(r6, tmp_path, complete=False, workspace_mode="empty")
    destination = tmp_path / "persistent"
    _mkdir_private(destination)

    manifest = r6._persist_raw_evidence(source, destination, partial=True,
                                        project_input_root=source.parent)

    assert manifest["partial"] is True
    assert manifest["status"] == "PARTIAL_BOUNDED_RAW_EVIDENCE_COPIED_AND_READ_BACK"
    assert manifest["workspace_archive_disposition"] == \
        "EMPTY_EARLY_PARTIAL_NO_BINDING_OR_JOURNAL"
    assert all(row["source_root"] == str(source) for row in manifest["files"])
    assert (destination / "ADMISSION_RESULT.json").read_bytes() == \
        (source / "ADMISSION_RESULT.json").read_bytes()


@pytest.mark.parametrize("case", ["copy-binding", "journal", "unexpected-child"])
def test_partial_archive_rejects_empty_or_unexpected_workspace_after_copy_boundary(tmp_path, case):
    r6, _ = _load_candidate_modules()
    source = _owner_root(r6, tmp_path, complete=False, workspace_mode="empty")
    if case == "copy-binding":
        _write_file(source / "W23_SAVED_MPH_COPY_BINDING_R2.json")
    elif case == "journal":
        evidence = source / "w23-evidence"
        _mkdir_private(evidence)
        run = evidence / f"w23-zero-solve-{uuid.uuid4()}"
        _mkdir_private(run)
        _write_file(run / "public-receipts.jsonl", b"{}\n")
    else:
        _write_file(source / "workspace" / "unexpected.txt")
    destination = tmp_path / "persistent"
    _mkdir_private(destination)

    with pytest.raises(r6.ActualEntryGuardError):
        r6._persist_raw_evidence(source, destination, partial=True,
                                 project_input_root=source.parent)


def test_full_archive_still_requires_exact_immutable_saved_mph(tmp_path):
    r6, _ = _load_candidate_modules()
    source = _owner_root(r6, tmp_path, complete=True, workspace_mode="saved")
    destination = tmp_path / "persistent"
    _mkdir_private(destination)

    manifest = r6._persist_raw_evidence(source, destination, partial=False,
                                        project_input_root=source.parent)

    assert manifest["partial"] is False
    assert manifest["status"] == "PASS_EXACT_BOUNDED_RAW_EVIDENCE_COPIED_AND_READ_BACK"
    assert manifest["schema"] == "w23-zero-solve-r6-persisted-raw-evidence/2"
    assert manifest["workspace_archive_disposition"] == \
        "EMPTY_PRIVATE_W25_WORKSPACE_PROJECT_INPUT_COPY_INCLUDED"
    input_relative = "w23-input-1234567890abcdef1234567890abcdef/w23_coarse-phase0_provisional.mph"
    input_row = next(row for row in manifest["files"] if row["source_relative_path"] == input_relative)
    assert input_row["source_root"] == str(source.parent)
    assert (destination / input_relative).read_bytes() == \
        (source.parent / input_relative).read_bytes()


