            public_dispatches.append(request)
            return original_dispatch(request)

        monkeypatch.setattr(daemon, "dispatch", observe_dispatch)

        # The exact W25 relative/absolute pair must pass the strict R6
        # producer-consumer binding and copy the immutable MPH before entering
        # the read route. Stop at the route boundary: no W23 RPC is made.
        class StopBeforePublicReads(Exception):
            pass

        def stop_before_reads(**_kwargs):
            raise StopBeforePublicReads("software control stops before any W23 public read")

        monkeypatch.setattr(api["runtime_module"], "run_zero_solve_entry", stop_before_reads)
        wrong_public = replace(admission, setup_result={
            **admission.setup_result,
            "workspace": str(project_root / "foreign" / "workspace"),
        })
        with pytest.raises(api["owned_module"].OwnedRuntimeEntryError,
                           match="relative workspace and public absolute workspace"):
            api["owned_module"].run_w23_from_owned_admission(
                wrong_public, source_projection_sha256="a" * 64, execute_numeric=True)
        with pytest.raises(api["owned_module"].OwnedRuntimeEntryError,
                           match="relative workspace and public absolute workspace"):
            api["owned_module"].run_w23_from_owned_admission(
                replace(admission, workspace="../foreign/workspace"),
                source_projection_sha256="a" * 64, execute_numeric=True)
        with pytest.raises(api["owned_module"].OwnedRuntimeEntryError,
                           match="not the exact admitted W25 workspace"):
            api["owned_module"]._copy_pinned_mph_to_project_input(
                project_root=project_root, workspace=admission.workspace, run_id=run_id)
        assert not (workspace / "w23_coarse-phase0_provisional.mph").exists()
        assert public_dispatches == []

        with pytest.raises(StopBeforePublicReads, match="before any W23 public read"):
            api["owned_module"].run_w23_from_owned_admission(
                admission, source_projection_sha256="a" * 64, execute_numeric=True)
        copied = project_root / f"w23-input-{run_id}" / "w23_coarse-phase0_provisional.mph"
        assert copied.is_file()
        assert copied.stat().st_size == 13795478
        digest = hashlib.sha256()
        with copied.open("rb") as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(block)
        assert digest.hexdigest() == \
            "cba0c1d404003c4e60a20b04316cb1456c38cc2b45596dc2dc29bbed62674a8c"
        assert stat.S_IMODE(copied.stat().st_mode) == 0o400
        assert list(workspace.iterdir()) == []
        copy_binding = json.loads((host_root / "W23_SAVED_MPH_COPY_BINDING_R2.json").read_text())
        assert copy_binding["opened_by_comsol"] is False
        assert copy_binding["source_project_relative_path"] == \
            f"w23-input-{run_id}/w23_coarse-phase0_provisional.mph"
        assert copy_binding["source_identity"]["sha256"] == \
            "cba0c1d404003c4e60a20b04316cb1456c38cc2b45596dc2dc29bbed62674a8c"
        assert daemon._control_dispatch_inflight == 0
        assert public_dispatches == []

        try:
            bridge = api["W23OwnedRuntimeBridge"](admission)
            owner = bridge._assert_owner()
            assert owner["project_id"] == project_id
            assert owner["session_id"] == session_id
            response = bridge.dispatch(
                "operation_call",
                {"operation_id": "job.status", "arguments": {"job_id": "absent-fixture-job"}},
                {"project_id": project_id, "session_id": session_id,
                 "request_id": "bridge-software-control", "idempotency_key": "bridge-software-control"})
            assert isinstance(response, dict)
            assert response.get("success") is False
            assert response.get("error", {}).get("code") == "NODE_NOT_FOUND"
            assert response["error"].get("safe_retry") is False
            assert len(public_dispatches) == 1
            assert daemon._control_dispatch_inflight == 0
            assert daemon.store is bridge.store
            assert daemon.session_registry.get(project_id, session_id) is context
            assert server_process.poll() is None and worker_process.poll() is None
        finally:
            daemon.session_registry.remove(project_id, session_id, expected=context)
            daemon._session_worker_handles.pop(key, None)
            daemon._session_backends.pop(key, None)
            daemon._session_server_handles.pop(key, None)
            daemon._session_worker_child_identities.pop(key, None)
            daemon.close()
