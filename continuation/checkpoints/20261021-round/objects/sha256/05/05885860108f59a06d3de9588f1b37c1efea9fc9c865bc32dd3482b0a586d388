def _read_authority(binding: dict[str, Any]) -> dict[str, Any]:
    terminal_raw, _ = _read_prior_terminal_proof()
    terminal_sha = sha(terminal_raw)
    review_raw = read_regular(MAIN_REVIEW_PATH, maximum=128 * 1024)
    review = strict_json(review_raw, "Main source review")
    expected = expected_review(binding, terminal_sha)
    if review != expected:
        raise RuntimeError("Main review does not bind exact payload, wrapper, argv and prior terminal proof")
    review_sha = sha(review_raw)
    once_raw = read_regular(ONCE_AUTHORIZATION_PATH, maximum=128 * 1024)
    if strict_json(once_raw, "Main one-send authorization") != expected_once(binding, review_sha, terminal_sha):
        raise RuntimeError("one-send authorization differs from the exact closed metadata-only scope")
    return {"source_review_sha256": review_sha,
            "once_authorization_sha256": sha(once_raw),
            "previous_r6i_r2_terminal_proof_sha256": terminal_sha,
            "invocation": invocation(read_checked_payload()[0])}


def validate_remote_record(raw: bytes) -> dict[str, Any]:
    if len(raw) > MAX_STDOUT_BYTES:
        raise RuntimeError("remote metadata JSON exceeds the fixed stdout cap")
    record = strict_json(raw, "remote metadata-only report")
    scope = record.get("scope")
    rows = record.get("paths")
    if (record.get("schema") != "cv3-windows-r6i-fixed-path-metadata-observation/1"
            or record.get("status") != "METADATA_ONLY_CAPTURED"
            or record.get("remote_root") != REMOTE_ROOT
            or record.get("path_count") != 10
            or not isinstance(rows, list)
            or [row.get("id") for row in rows if isinstance(row, dict)] != list(PATH_IDS)
            or len(rows) != 10
            or not isinstance(scope, dict)
            or scope.get("operation") != "os.lstat once per fixed path"
            or scope.get("target_content_opened") is not False
            or scope.get("target_content_read") is not False
            or scope.get("remote_write_count") != 0
            or scope.get("process_inspection") is not False
            or scope.get("token_access") is not False
            or scope.get("r6i_child_state") != "NOT_OBSERVED"
            or scope.get("r6i_child_alive_or_terminal") != "NOT_ESTABLISHED_BY_METADATA"
            or scope.get("old_r6f_exact_once_authority_applies") is not False):
        raise RuntimeError("remote report differs from the exact ten-path metadata-only contract")
    if any(row.get("status") not in {"PRESENT", "MISSING", "ERROR"} for row in rows):
        raise RuntimeError("remote report contains an unknown lstat status")
    return record


def write_exclusive(path: Path, raw: bytes) -> None:
    with path.open("xb") as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())


def check_only() -> dict[str, Any]:
    payload, binding = read_checked_payload()
    if RUN_ROOT.exists() or RUN_ROOT.is_symlink():
        raise RuntimeError("execution root already exists; no replay")
    inv = invocation(payload)
    return {
        "schema": "windows-r6i-fixed-metadata-strict-ssh-check-only/1",
        "status": "PASS_EXACT_UNSIGNED_METADATA_ONLY_SOURCE_AND_ARGV",
        **binding,
        "ssh_argv": ssh_argv(),
        "ssh_argv_sha256": inv["argv_sha256"],
        "invocation_sha256": sha(canonical(inv)),
        "previous_r6i_r2_terminal_proof": "REQUIRED_BEFORE_ANY_SEND",
        "main_review": "NOT_CREATED",
        "once_authorization": "NOT_CREATED",
        "ssh": "NOT_RUN",
        "popen": "NOT_RUN",
        "remote_write_count": 0,
        "remote_content_read": False,
        "r6i_child_alive_or_terminal": "NOT_ESTABLISHED_BY_METADATA",
        "old_r6f_authority_used": False,
    }


def execute_once(*, popen_factory=subprocess.Popen) -> int:
    payload, binding = read_checked_payload()
    authority = _read_authority(binding)
    if RUN_ROOT.exists() or RUN_ROOT.is_symlink():
        raise RuntimeError("execution root already exists; no replay")
    RUN_ROOT.mkdir(parents=True, exist_ok=False, mode=0o700)
    paths = {name: RUN_ROOT / name for name in OUTPUT_NAMES}
    started = time.monotonic()
    argv = authority["invocation"]["argv"]
    write_exclusive(paths["WRAPPER_ONCE_USED.json"], canonical({
        "schema": "windows-r6i-fixed-metadata-local-once-used/1",
        "status": "LOCAL_ONE_SEND_CONSUMED",
        "source_review_sha256": authority["source_review_sha256"],
        "once_authorization_sha256": authority["once_authorization_sha256"],
        "payload_sha256": binding["payload_sha256"],
        "ssh_argv_sha256": authority["invocation"]["argv_sha256"],
        "remote_write_count": 0,
        "automatic_retry_or_replay": False,
    }))
    write_exclusive(paths["SSH_LAUNCH_INTENT.json"], canonical({
        "schema": "windows-r6i-fixed-metadata-ssh-launch-intent/1",
        "status": "ONE_READONLY_METADATA_PAYLOAD_SEND_INTENT",
        **binding, **authority,
        "remote_write_count": 0, "native_children": 0,
        "automatic_retry_or_replay": False,
    }))
    paths["SSH_STATE.jsonl"].open("xb").close()
    child = owner = None
    remote_record = None
    status = "UNKNOWN_NO_REPLAY"
    try:
        child = popen_factory(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, shell=False, cwd=str(ROOT), bufsize=0)
        owner = load_owner_class()(child)
        owner.start_drainers(paths["SSH.stdout"], paths["SSH.stderr"])
        owner.send_once_then_eof(payload)
        owner.wait_naturally()
        if owner.first_cause:
            status = "UNKNOWN_ORIGINAL_POPEN_OWNER_DIAGNOSTIC_NO_REPLAY"
        elif owner.stdout.total > MAX_STDOUT_BYTES or owner.stderr.total > MAX_STDERR_BYTES:
            status = "FAILED_FIXED_OUTPUT_CAP_NO_REPLAY"
        elif child.returncode != 0:
            status = "FAILED_SSH_NONZERO_NO_REPLAY"
        else:
            remote_record = validate_remote_record(read_regular(paths["SSH.stdout"], maximum=MAX_STDOUT_BYTES))
            status = "PASS_METADATA_ONLY_CAPTURED"
    except BaseException as exc:
        status = "UNKNOWN_LOCAL_AFTER_POPEN_NO_REPLAY" if child is not None else "FAILED_PRE_POPEN_NO_REMOTE_ACTION"
        if owner is not None:
            owner.first_cause = owner.first_cause or (type(exc).__name__ + ":" + str(exc)[:1000])
            owner.wait_naturally()
    terminal = {
        "schema": "windows-r6i-fixed-metadata-ssh-terminal/1",
        "status": status,
        "original_local_ssh_pid": getattr(owner, "pid", None),
        "original_local_ssh_returncode": getattr(child, "returncode", None),
        "elapsed_seconds": time.monotonic() - started,
        "same_original_popen_natural_terminal": bool(child is not None and child.returncode is not None),
        "payload_send_attempted_once": bool(owner and owner.sent),
        "active_cutoff_exceeded": bool(owner and owner.active_cutoff_exceeded),
        "stdout_total_observed": owner.stdout.total if owner and owner.stdout else 0,
        "stderr_total_observed": owner.stderr.total if owner and owner.stderr else 0,
        "first_cause": owner.first_cause if owner else None,
        "signals_kills_retries_resends": 0,
        "remote_write_count": 0,
        "remote_r6i_child_state": "NOT_OBSERVED_BY_METADATA",
        "remote_r6i_child_alive_or_terminal": "NOT_ESTABLISHED_BY_METADATA",
        "authority": authority,
    }
    write_exclusive(paths["SSH_TERMINAL.json"], canonical(terminal))
    write_exclusive(paths["METADATA_OBSERVATION_REPORT.json"], canonical({
        "schema": "windows-r6i-fixed-metadata-observation-local-report/1",
        "status": status, "terminal": terminal, "remote": remote_record,
        "remote_write_count": 0, "replay": False,
    }))
    return 0 if status == "PASS_METADATA_ONLY_CAPTURED" else 1


def main(argv: list[str] | None = None, *, popen_factory=subprocess.Popen) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--check-only"]:
        print(json.dumps(check_only(), sort_keys=True, separators=(",", ":")))
        return 0
    if args == ["--capture-once"]:
        return execute_once(popen_factory=popen_factory)
    raise RuntimeError("use --check-only or separately reviewed and authorized --capture-once")


if __name__ == "__main__":
    try:
        exit_code = main()
    except Exception as exc:
        sys.stderr.write(type(exc).__name__ + ":" + str(exc)[:2000] + "\n")
        exit_code = 2
    raise SystemExit(exit_code)
