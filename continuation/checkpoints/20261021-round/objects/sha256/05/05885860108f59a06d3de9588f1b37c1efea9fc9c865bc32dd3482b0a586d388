def sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def canonical(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False,
                       allow_nan=False) + "\n").encode("utf-8")


def strict_json(raw: bytes, label: str) -> dict[str, Any]:
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError("duplicate JSON key " + key)
            result[key] = value
        return result
    value = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=pairs,
                       parse_constant=lambda item: (_ for _ in ()).throw(ValueError(item)))
    if not isinstance(value, dict):
        raise RuntimeError(label + " must be an object")
    return value


def read_regular(path: Path, *, maximum: int) -> bytes:
    before_name = os.lstat(path)
    if path.is_symlink() or not path.is_file() or before_name.st_size < 0 or before_name.st_size > maximum:
        raise RuntimeError("bounded ordinary local file required: " + str(path))
    with path.open("rb", buffering=0) as stream:
        before = os.fstat(stream.fileno())
        raw = stream.read(maximum + 1)
        after = os.fstat(stream.fileno())
    after_name = os.lstat(path)
    signature = lambda row: (row.st_dev, row.st_ino, row.st_size, row.st_mtime_ns, row.st_ctime_ns)
    if (len(raw) > maximum or len(raw) != after.st_size or signature(before) != signature(after)
            or signature(before_name) != signature(after_name)):
        raise RuntimeError("local source changed during bounded read: " + str(path))
    return raw


def ssh_argv() -> list[str]:
    return [SSH_PATH, "-T", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
            "-o", "UpdateHostKeys=no", "-o", "ControlMaster=no", "-o", "ControlPath=none",
            SSH_USER_HOST, REMOTE_COMMAND]


def invocation(payload: bytes) -> dict[str, Any]:
    argv = ssh_argv()
    record = {
        "argv": argv,
        "argv_sha256": sha(canonical(argv)),
        "shell": False,
        "payload_sha256": sha(payload),
        "payload_bytes": len(payload),
        "target": SSH_USER_HOST,
        "remote_python": REMOTE_PYTHON,
        "remote_root": REMOTE_ROOT,
        "path_ids": list(PATH_IDS),
        "path_count": 10,
        "remote_write_count": 0,
        "file_content_read": False,
        "process_inspection": False,
        "token_access": False,
        "active_cutoff_seconds": ACTIVE_CUTOFF_SECONDS,
        "same_original_popen_passive_hold_to_natural_terminal": True,
        "automatic_retry_or_replay": False,
    }
    return record


def read_checked_payload() -> tuple[bytes, dict[str, Any]]:
    payload = read_regular(PAYLOAD_PATH, maximum=MAX_STDOUT_BYTES)
    if len(payload) != PAYLOAD_BYTES or sha(payload) != PAYLOAD_SHA256:
        raise RuntimeError("fixed ten-path remote payload differs from reviewed bytes")
    module = types.ModuleType("r6i_fixed_metadata_probe_exact")
    module.__file__ = str(PAYLOAD_PATH)
    module.__package__ = ""
    exec(compile(payload.decode("utf-8", "strict"), str(PAYLOAD_PATH), "exec"), module.__dict__)
    if (getattr(module, "REMOTE_ROOT", None) != REMOTE_ROOT
            or tuple(row[0] for row in getattr(module, "PATHS", ())) != PATH_IDS
            or len(module.PATHS) != 10):
        raise RuntimeError("remote payload does not bind the closed ten-path list")
    owner = read_regular(OWNER_PATH, maximum=512 * 1024)
    if sha(owner) != OWNER_SHA256:
        raise RuntimeError("Main-reviewed OriginalReadOnlyPopenOwner source changed")
    return payload, {"payload_sha256": sha(payload), "payload_bytes": len(payload),
                     "owner_source_sha256": sha(owner), "owner_source_bytes": len(owner),
                     "remote_path_ids": list(PATH_IDS), "remote_path_count": 10}


def load_owner_class():
    raw = read_regular(OWNER_PATH, maximum=512 * 1024)
    if sha(raw) != OWNER_SHA256:
        raise RuntimeError("Main-reviewed OriginalReadOnlyPopenOwner source changed")
    module = types.ModuleType("r6i_reviewed_readonly_popen_owner_exact")
    module.__file__ = str(OWNER_PATH)
    module.__package__ = ""
    exec(compile(raw.decode("utf-8", "strict"), str(OWNER_PATH), "exec"), module.__dict__)
    owner = getattr(module, OWNER_CLASS, None)
    if not callable(owner):
        raise RuntimeError("pinned R6I source lacks OriginalReadOnlyPopenOwner")
    return owner


