def _read_prior_terminal_proof() -> tuple[bytes, dict[str, Any]]:
    raw = read_regular(PREVIOUS_TERMINAL_PROOF_PATH, maximum=64 * 1024)
    proof = strict_json(raw, "prior R6I R2 natural-terminal proof")
    if (proof.get("schema") != "windows-r6i-r2-original-ssh-terminal-proof/1"
            or proof.get("status") != "MAIN_CONFIRMED_ORIGINAL_R6I_R2_POPEN_NATURAL_TERMINAL"
            or proof.get("original_run_root") != ORIGINAL_R6I_R2_RUN_ROOT
            or proof.get("natural_terminal_observed") is not True
            or type(proof.get("original_local_ssh_pid")) is not int
            or proof["original_local_ssh_pid"] <= 0
            or type(proof.get("original_local_ssh_returncode")) is not int
            or proof.get("signals_kills_retries_resends") != 0):
        raise RuntimeError("Main has not proven the original R6I R2 SSH Popen reached natural terminal")
    return raw, proof


