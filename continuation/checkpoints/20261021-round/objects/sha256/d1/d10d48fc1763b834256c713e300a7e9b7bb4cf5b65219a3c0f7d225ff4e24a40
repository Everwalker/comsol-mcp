class OriginalOwnerCleanupTests(unittest.TestCase):
    def _fake_r5(self, temp_root):
        r5 = types.ModuleType("r5_fake")
        r5._install_original_owner_shutdown_guards = Mock(return_value=(object(), object(), object()))
        r5._original_owner_references = Mock(return_value=(("server", object()), ("worker", object())))
        r5._remaining_wall_seconds = Mock(return_value=100.0)
        r5._disconnect_operation_once = Mock()
        r5._worker_retirement_ledger = Mock()
        r5._closed_lifecycle_readback = Mock()
        return r5

    def test_cleanup_reserve_exhaustion_does_not_dispatch_or_close(self):
        with tempfile.TemporaryDirectory() as tmp:
            r5 = self._fake_r5(tmp)
            host = types.SimpleNamespace(close=Mock())
            holder = types.SimpleNamespace(host=host, outcome=object(),
                                           close_attempted=False, disconnect_attempted=False,
                                           owner_references=(), shutdown_guards=())
            with unittest.mock.patch.object(TARGET, "_remaining_wall_seconds", return_value=100.0):
                result = TARGET._success_cleanup(r5, holder, {"sha256": "a" * 64}, Path(tmp))
            self.assertEqual(result["cleanup_rpc_calls"], 0)
            self.assertFalse(holder.disconnect_attempted)
            self.assertFalse(holder.close_attempted)
            r5._disconnect_operation_once.assert_not_called()
            host.close.assert_not_called()

    def test_one_disconnect_failure_never_replays_or_closes(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp) / "lifecycle"
            root.mkdir(mode=0o700)
            r5 = self._fake_r5(tmp)
            r5._remaining_wall_seconds = Mock(return_value=600.0)
            r5._disconnect_operation_once = Mock(return_value=({"success": False,
                                                               "raw": {"error": "terminal-failure"}},
                                                              "req-r8", "idem-r8"))
            host = types.SimpleNamespace(close=Mock())
            holder = types.SimpleNamespace(host=host, outcome=object(),
                                           close_attempted=False, disconnect_attempted=False,
                                           owner_references=(), shutdown_guards=())
            with unittest.mock.patch.object(TARGET, "_remaining_wall_seconds", return_value=600.0):
                result = TARGET._success_cleanup(r5, holder, {"sha256": "a" * 64}, root)
            self.assertEqual(result["status"], "UNKNOWN_NO_REPLAY_DISCONNECT_RESPONSE_NOT_SUCCESS")
            self.assertTrue(holder.disconnect_attempted)
            self.assertFalse(holder.close_attempted)
            self.assertEqual(r5._disconnect_operation_once.call_count, 1)
            host.close.assert_not_called()

    def test_exact_success_retirement_uses_one_disconnect_then_one_default_close(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp) / "lifecycle"
            root.mkdir(mode=0o700)
            r5 = self._fake_r5(tmp)
            r5._remaining_wall_seconds = Mock(side_effect=[600.0, 500.0])
            r5._disconnect_operation_once = Mock(return_value=({"success": True,
                                                               "data": {"state": "DISCONNECTED"}},
                                                              "req-r8", "idem-r8"))
