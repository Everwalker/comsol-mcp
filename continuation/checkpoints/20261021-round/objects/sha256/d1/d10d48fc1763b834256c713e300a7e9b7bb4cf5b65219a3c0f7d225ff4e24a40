def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode("utf-8")


def _make_raw_journal(path: Path, *, metadata_calls: int = 115,
                      bad_status_envelope: bool = False,
                      wrong_status_job_id: bool = False,
                      omit_pair_ordinal: int | None = None) -> tuple[dict, dict]:
    rows = []
    ordinal = 0
    counts = {"owner": 0, "owner_terminal_status": 0,
              "metadata": 0, "point": 0, "integral": 0}
    owner_raw = []

    def add(operation_id, category, arguments, *, owner_response=None):
        nonlocal ordinal
        ordinal += 1
        request_id = f"req-{ordinal:03d}"
        idem = f"idem-{ordinal:03d}"
        request_execution = {
            "project_id": "project-r8-test", "session_id": "session-r8-test",
            "model_ref": None, "expected_revision": None,
            "rpc_timeout_s": 30.0, "execution_timeout_s": None,
            "queue_timeout_s": 60.0, "idempotency_key": idem,
            "request_id": request_id,
        }
        nested_arguments = dict(arguments)
        if category == "owner" and operation_id == "artifact.register":
            nested_arguments.update({"request_id": request_id, "idempotency_key": idem})
        intent = {
            "kind": "dispatch_intent", "ordinal": ordinal, "category": category,
            "request": {"operation": "operation_call",
                        "arguments": {"operation_id": operation_id,
                                      "arguments": nested_arguments},
                        "execution": request_execution},
            "retry": "FORBIDDEN_AFTER_DISPATCH",
        }
        rows.append(intent)
        if category == "owner":
            raw = {
                "success": True,
                "data": {"status": "REGISTERED" if operation_id == "artifact.register" else "LOADED"},
                "execution": {"project_id": "project-r8-test", "session_id": "session-r8-test",
                              "operation_id": f"owner-op-{ordinal}", "job_id": f"owner-job-{ordinal}",
                              "request_id": request_id, "idempotency_key": idem,
                              "request_hash": f"{ordinal:064x}"},
            }
            owner_raw.append(raw)
        elif category == "owner_terminal_status":
            owner = owner_response
            operation = {
                "operation_id": owner["execution"]["operation_id"],
                "request_id": owner["execution"]["request_id"],
                "idempotency_key": owner["execution"]["idempotency_key"],
                "request_hash": owner["execution"]["request_hash"],
                "status": "SUCCEEDED", "finished_at": "2026-10-19T00:00:00Z",
                "operation": "operation_call", "result": owner,
                "metadata": {"operation": "operation_call",
                             "arguments": {"operation_id": owner["data"].get("owner_operation"),
                                           "arguments": {}},
                             "execution": request_execution},
            }
            # Copy the exact preceding owner's persisted semantic arguments.
            owner_intent = next(row for row in reversed(rows[:-1])
                                if row.get("kind") == "dispatch_intent"
                                and row.get("category") == "owner")
            operation["metadata"]["arguments"] = owner_intent["request"]["arguments"]
            operation["metadata"]["execution"] = owner_intent["request"]["execution"]
            job = {"job_id": owner["execution"]["job_id"],
                   "operation_id": owner["execution"]["operation_id"],
                   "status": "SUCCEEDED", "finished_at": "2026-10-19T00:00:00Z",
                   "result": owner, "operation": operation,
                   "metadata": dict(operation["metadata"])}
            data = {**job}
            if wrong_status_job_id:
                data["job_id"] = "another-owner-job"
            if bad_status_envelope:
                raw = {"success": True, "data": data, "execution": {"status": "SUCCEEDED"}}
            else:
                raw = {"success": True, "data": data}
        else:
            raw = {"success": True,
                   "data": {"status": "OK", "observed": {"operation": operation_id}},
                   "execution": {"project_id": "project-r8-test", "session_id": "session-r8-test",
                                 "model_ref": {"schema_version": 1, "session_id": "session-r8-test",
                                               "server_instance_id": "server-r8-test",
                                               "model_tag": "Model1", "generation": 1},
                                 "expected_revision": 1, "request_id": request_id,
                                 "idempotency_key": idem, "status": "SUCCEEDED"}}
        raw_sha = hashlib.sha256(canonical(raw)).hexdigest()
        response = {"kind": "dispatch_response", "ordinal": ordinal,
                    "category": category, "operation_id": operation_id,
                    "request_id": request_id, "idempotency_key": idem,
                    "response_sha256": raw_sha, "raw_response": raw}
        rows.append(response)
        if category in {"metadata", "point", "integral"}:
            proof = {"schema": "W23_OWNER_OPERATION_JOB_TERMINAL_PAIR_R1",
                     "source": "LIVE_BOUND_MANAGED_PUBLIC_GATE_OPERATIONSTORE",
                     "terminal_pair_status": "OPERATION_AND_JOB_SUCCEEDED",
                     "public_operation": operation_id,
                     "raw_response_sha256": raw_sha,
                     "operation_status": "SUCCEEDED", "job_status": "SUCCEEDED"}
            if omit_pair_ordinal != ordinal:
                rows.append({"kind": "terminal_operation_job_pair_proof",
                             "ordinal": ordinal, "operation_id": operation_id,
                             "request_id": request_id,
                             "raw_response_sha256": raw_sha, "proof": proof})
        counts[category] += 1
        return raw

    register = add("artifact.register", "owner", {
        "project_id": "project-r8-test", "path": "saved.mph",
        "role": "saved_model", "classification": "project_local",
        "artifact_type": "application/vnd.comsol.mph", "format_version": "comsol-mph-savecopy/1"})
    add("job.status", "owner_terminal_status", {"job_id": register["execution"]["job_id"]},
        owner_response=register)
    load = add("model.load", "owner", {
        "artifact_id": "a" * 64, "path_policy": {"mode": "registered_artifact"}})
    add("job.status", "owner_terminal_status", {"job_id": load["execution"]["job_id"]},
        owner_response=load)
    for i in range(metadata_calls):
        operation = "runtime.capabilities" if i == 0 else "node.inspect"
        add(operation, "metadata", {"path": []})
    for _ in range(4):
        add("result.at_points", "point", {"dataset": "dset1", "points": [[0.0]]})
    for _ in range(2):
        add("result.evaluate", "integral", {"spec": {"aggregate": "integral"}})
    route_total = ordinal
    final = {
        "kind": "terminal_source_readback",
        "input_identity_before": {"path": "/tmp/test/workspace/saved.mph", "bytes": 13795478,
                                  "sha256": "cba0c1d404003c4e60a20b04316cb1456c38cc2b45596dc2dc29bbed62674a8c",
                                  "mode": "0o400", "opened_by_comsol": False},
        "input_identity_after": {"path": "/tmp/test/workspace/saved.mph", "bytes": 13795478,
                                 "sha256": "cba0c1d404003c4e60a20b04316cb1456c38cc2b45596dc2dc29bbed62674a8c",
                                 "mode": "0o400", "opened_by_comsol": False},
        "metadata_call_count": metadata_calls, "point_call_count": 4,
        "integral_call_count": 2, "owner_call_count": 2,
        "owner_terminal_status_read_count": 2, "owner_public_call_count": 4,
        "point_call_count": 4, "integral_call_count": 2,
        "point_calls": 4, "integral_calls": 2,
        "total_public_call_count": route_total,
        "direction_status": "NOT_PROVEN", "scientific_acceptance": "NOT_EVALUATED",
        "Study.run": 0, "solver.run": 0, "node.property_set": 0,
        "model.save": 0, "code.execute_java": 0,
    }
    rows.append(final)
    raw = b"".join(canonical(row) + b"\n" for row in rows)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    path.write_bytes(raw)
    path.chmod(0o600)
    result = {
        "metadata_call_count": metadata_calls, "point_calls": 4,
        "integral_calls": 2, "owner_call_count": 2,
        "owner_terminal_status_read_count": 2,
        "owner_public_call_count": 4, "total_public_call_count": route_total,
    }
    return result, {"sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw)}


