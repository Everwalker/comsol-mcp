    def _copy_complete_r6_packet_layout(self, clone_root: Path):
        packet, _ = TARGET._strict_json(TARGET.R6_PACKET_MANIFEST,
                                         limit=64 * 1024 * 1024)
        excluded = set(packet["excluded_self_referential_files"])
        records = {row["path"] for row in packet["records"]}
        for rel in sorted(records | excluded):
            source = TARGET.R6_ROOT / rel
            source_info = source.lstat()
            if stat.S_ISLNK(source_info.st_mode) or not stat.S_ISREG(source_info.st_mode):
                raise AssertionError(f"accepted R6 packet source is not a regular file: {rel}")
            target = clone_root / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target, follow_symlinks=False)
            target_info = target.lstat()
            if (not stat.S_ISREG(target_info.st_mode)
                    or target_info.st_nlink != 1
                    or target.read_bytes() != source.read_bytes()):
                raise AssertionError(f"R6 packet clone did not preserve independent exact bytes: {rel}")
        return (packet, records, excluded,
                TARGET.R6_COMPILE_RECEIPT_SHA256,
                TARGET.R6_COMPILE_REVIEW_SHA256)

    def _copy_compile_sidecar(self, clone_root: Path):
        source_root = TARGET.R6_PREVIOUS_ROOT
        sidecar = TARGET._verify_r6_compile_sidecar(root=source_root)
        for rel in sidecar["sidecar_paths"]:
            source = source_root / rel
            destination = clone_root / rel
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination, follow_symlinks=False)
        compile_root = clone_root / "evidence/JAVA11_COMPILE_R6"
        classes_root = compile_root / "classes_r15"
        receipt_path = compile_root / "JAVA11_COMPILE_RECEIPT_R6.json"
        review_path = compile_root / "MAIN_JAVA11_COMPILE_REVIEW_R15.json"
        receipt = json.loads(receipt_path.read_text())
        receipt["classes_root"] = str(classes_root)
        receipt["plan_path"] = str(compile_root / "JAVA11_COMPILE_PLAN_R15_UNSIGNED.json")
        review = json.loads(review_path.read_text())
        review["new_output"] = str(classes_root)
        review_bytes = json.dumps(review, indent=2, ensure_ascii=False).encode() + b"\n"
        review_path.write_bytes(review_bytes)
        review_path.chmod(0o600)
        receipt["Main_review_sha256"] = hashlib.sha256(review_bytes).hexdigest()
        receipt_bytes = json.dumps(receipt, indent=2, ensure_ascii=False).encode() + b"\n"
        receipt_path.write_bytes(receipt_bytes)
        receipt_path.chmod(0o600)
        return hashlib.sha256(receipt_bytes).hexdigest(), hashlib.sha256(review_bytes).hexdigest()

    def test_fixed_authority_leaves_on_complete_r6_packet_clone(self):
        with tempfile.TemporaryDirectory(prefix="w23-r6-fixed-authority-clone-") as tmp:
            clone_root = Path(tmp) / "r6"
            packet, records, excluded, receipt_sha, review_sha = self._copy_complete_r6_packet_layout(clone_root)
            cloned_packet = dict(packet)
            cloned_packet["candidate_root"] = str(clone_root)
            packet_raw = TARGET._canonical_bytes(cloned_packet)
            packet_sha = hashlib.sha256(packet_raw).hexdigest()
            (clone_root / "evidence/PACKET_MANIFEST_R6_R3.json").write_bytes(packet_raw)

            # Rebind only the test module's fixed roots to a complete isolated
            # clone. The source records and live bytes remain exactly those in
            # the accepted manifest; the test never writes to the frozen R6.
            with patch.object(TARGET, "R6_ROOT", clone_root), \
                    patch.object(TARGET, "R6_PACKET_MANIFEST_SHA256", packet_sha), \
                    patch.object(TARGET, "R6_COMPILE_RECEIPT_SHA256", receipt_sha), \
                    patch.object(TARGET, "R6_COMPILE_REVIEW_SHA256", review_sha):
                source_only = TARGET._verify_r6_packet_manifest(cloned_packet, packet_sha)
                self.assertEqual(source_only["record_count"], 921)
                self.assertEqual(source_only["live_file_count"], 940)
                self.assertEqual(source_only["observed_runtime_authority_leaves"], [])
                self.assertEqual(source_only["compile_sidecar"]["sidecar_file_count"], 19)

                # These inert bytes exercise only the exact fixed-path live
                # set. They are not review/once records and cannot authorize
                # anything; the R6 strict current-hash reader remains the
                # separate content consumer.
                for rel in sorted(TARGET.R6_RUNTIME_AUTHORITY_LEAVES):
                    leaf = clone_root / rel
                    leaf.parent.mkdir(parents=True, exist_ok=True)
                    leaf.write_bytes(b"inert fixed-layout test placeholder; never an authority\n")
                paired = TARGET._verify_r6_packet_manifest(cloned_packet, packet_sha)
                self.assertEqual(paired["observed_runtime_authority_leaves"],
                                 sorted(TARGET.R6_RUNTIME_AUTHORITY_LEAVES))
                self.assertEqual(paired["runtime_authority_content_consumer"],
                                 "PINNED_R6_STRICT_CURRENT_HASH_READER")

                extra = clone_root / "evidence/UNDECLARED_EXTRA_R10.json"
                extra.write_text("{}\n", encoding="utf-8")
                with self.assertRaisesRegex(TARGET.OuterControllerError,
                                            "exact live regular-file set"):
                    TARGET._verify_r6_packet_manifest(cloned_packet, packet_sha)
                extra.unlink()

                (clone_root / "evidence/W23_R6_MAIN_SINGLE_USE_BINDING.json").unlink()
                with self.assertRaisesRegex(TARGET.OuterControllerError,
                                            "both absent or both present"):
                    TARGET._verify_r6_packet_manifest(cloned_packet, packet_sha)

            # The packet membership rule never makes review/once content
            # optional: source keeps the fixed reader paths and invocation.
            r6_source = TARGET.R6_ENTRY_PATH.read_text(encoding="utf-8")
            r8_source = TARGET.OUTER_SOURCE_PLAN_PATH.read_text(encoding="utf-8")
            self.assertIn('REVIEW_PATH = EVIDENCE_ROOT / "W23_R6_MAIN_RUNTIME_REVIEW.json"',
                          r6_source)
            self.assertIn('ONCE_PATH = EVIDENCE_ROOT / "W23_R6_MAIN_SINGLE_USE_BINDING.json"',
                          r6_source)
            self.assertIn('r6._load_authority(',
                          TARGET.OUTER_ROOT.joinpath("probe/w23_actual_controller_r8.py")
                          .read_text(encoding="utf-8"))
            self.assertIn("PINNED_R6_ENTRY_STRICT_CURRENT_HASH_READER", r8_source)

