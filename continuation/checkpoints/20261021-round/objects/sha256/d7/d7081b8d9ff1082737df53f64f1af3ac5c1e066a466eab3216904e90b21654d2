    assert fixture["schema"] == "W24_R14_PUBLIC_SESSION_INSPECT_PRODUCTION_SHAPE_FIXTURE_V1"
    assert fixture["provenance"]["connect_route_receipt_sha256"] == (
        "b8f48fb4efb93f465ef43daae7e4f7538767bf05e920a8661ce4c1c4e4336247"
