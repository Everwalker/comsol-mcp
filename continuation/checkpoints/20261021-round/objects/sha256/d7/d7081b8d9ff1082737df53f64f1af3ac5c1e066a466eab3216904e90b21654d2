        ("project", ("lifecycle", "project_id"), "foreign-project"),
        ("session", ("lifecycle", "session_id"), "foreign-session"),
        ("endpoint", ("lifecycle", "endpoint"), {"host": "127.0.0.1", "port": 55428}),
