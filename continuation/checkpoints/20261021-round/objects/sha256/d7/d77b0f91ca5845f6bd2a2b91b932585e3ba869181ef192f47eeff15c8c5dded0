from __future__ import annotations

import os
import subprocess
import sys
import unittest
from pathlib import Path


class R6TransportAndCachedStatusContractTests(unittest.TestCase):
    def test_real_control_daemon_contracts_in_isolated_interpreter(self):
        candidate_root = Path(__file__).resolve().parents[1]
        repo_root = candidate_root.parents[1]
        w25_probe = (candidate_root.parent /
                     "w25-r5-fresh-runtime-entry-6fc675b5-c7a1-4483-9de5-51d2ceeccd8f-20261019" /
                     "probe")
        dependency_root = repo_root.parent / "work" / "dev-python312" / "lib" / "python3.12" / "site-packages"
        env = dict(os.environ)
        env["PYTHONPATH"] = os.pathsep.join((
            str(candidate_root / "source"), str(candidate_root), str(w25_probe),
            str(dependency_root),
        ))
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        command = [
            sys.executable, "-m", "unittest", "discover", "-s", "tests",
            "-p", "r6_transport_cached_status_contract_child.py", "-v",
        ]
        completed = subprocess.run(
            command, cwd=candidate_root, env=env, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False,
        )
        self.assertEqual(completed.returncode, 0, completed.stdout)
        self.assertIn("Ran 6 tests", completed.stdout)
        self.assertIn("OK", completed.stdout)


if __name__ == "__main__":
    unittest.main()
