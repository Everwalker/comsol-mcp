def _module(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load candidate source: " + str(path))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _api(module, behavior):
    callback_type = C.CFUNCTYPE(
        C.c_int32, C.c_void_p, C.c_uint32, C.c_void_p, C.c_uint32,
        C.POINTER(module.W.DWORD),
    )
    callback = callback_type(behavior)
    class Api:
        GetTokenInformation = callback
    return Api(), callback


class R6ITokenElevationSourceTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.helper = _module(HELPER, "candidate_r6i_primary_owner_helper")

    def test_token_elevation_uses_one_typed_exact_four_byte_query(self):
        calls = []
        def behavior(_token, info_class, buffer, buffer_size, returned):
            calls.append((int(info_class), bool(buffer), int(buffer_size)))
            returned[0] = 4
            C.memmove(buffer, C.byref(C.c_uint32(1)), 4)
            return 1
        win32 = object.__new__(self.helper.Win32)
        win32.a, callback = _api(self.helper, behavior)
        self.assertEqual(self.helper.Win32.scalar_info(win32, C.c_void_p(1), 20), 1)
        self.assertEqual(calls, [(20, True, 4)])
        self.assertEqual(callback._argtypes_, (
            C.c_void_p, C.c_uint32, C.c_void_p, C.c_uint32,
            C.POINTER(self.helper.W.DWORD),
        ))

    def test_token_elevation_api_failure_remains_failure_with_native_error(self):
        calls = []
        def behavior(_token, info_class, buffer, buffer_size, returned):
            calls.append((int(info_class), bool(buffer), int(buffer_size)))
            returned[0] = 4
            return 0
        win32 = object.__new__(self.helper.Win32)
        win32.a, _callback = _api(self.helper, behavior)
        with patch.object(C, "get_last_error", return_value=24, create=True):
            with self.assertRaises(self.helper.ProbeError) as raised:
                self.helper.Win32.scalar_info(win32, C.c_void_p(1), 20)
        self.assertIn('"winerror": 24', str(raised.exception))
        self.assertEqual(calls, [(20, True, 4)])

    def test_token_elevation_requires_exact_success_return_length_four(self):
        for returned_length in (0, 3, 5):
            with self.subTest(returned_length=returned_length):
                calls = []
                def behavior(_token, info_class, buffer, buffer_size, returned):
                    calls.append((int(info_class), bool(buffer), int(buffer_size)))
                    returned[0] = returned_length
                    C.memmove(buffer, C.byref(C.c_uint32(1)), 4)
                    return 1
                win32 = object.__new__(self.helper.Win32)
                win32.a, _callback = _api(self.helper, behavior)
                with self.assertRaisesRegex(self.helper.ProbeError, "invalid byte count"):
                    self.helper.Win32.scalar_info(win32, C.c_void_p(1), 20)
                self.assertEqual(calls, [(20, True, 4)])

    def test_non_exact_class_20_values_fail_before_any_api_call(self):
        for invalid in (20.0, True, -1, 1 << 32):
            with self.subTest(invalid=repr(invalid)):
                calls = []
                def behavior(*args):
                    calls.append(args)
                    return 1
                win32 = object.__new__(self.helper.Win32)
                win32.a, _callback = _api(self.helper, behavior)
                with self.assertRaises(self.helper.ProbeError):
                    self.helper.Win32.scalar_info(win32, C.c_void_p(1), invalid)
                self.assertEqual(calls, [])

    def test_other_scalar_class_keeps_bounded_two_call_contract(self):
        calls = []
        def behavior(_token, info_class, buffer, buffer_size, returned):
            calls.append((int(info_class), bool(buffer), int(buffer_size)))
            returned[0] = 4
            if not buffer:
                return 0
            C.memmove(buffer, C.byref(C.c_uint32(2)), 4)
            return 1
        win32 = object.__new__(self.helper.Win32)
        win32.a, _callback = _api(self.helper, behavior)
        with patch.object(C, "get_last_error", return_value=self.helper.ERROR_INSUFFICIENT_BUFFER,
                          create=True):
            result = self.helper.Win32.scalar_info(win32, C.c_void_p(1),
                                                   self.helper.TOKEN_ELEVATION_TYPE)
        self.assertEqual(result, 2)
        self.assertEqual(calls, [(18, False, 0), (18, True, 4)])

