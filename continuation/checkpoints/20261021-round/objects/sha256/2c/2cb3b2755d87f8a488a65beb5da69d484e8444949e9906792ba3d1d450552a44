    def test_prep_review_consumer_accepts_exact_candidate_and_rejects_drift(self):
        builder = _module(PREP_BUILDER, "r6i_prep_review_consumer_test")
        rows = {
            "helper": (builder.H_HELPER, builder.H_HELPER_SHA256),
            "gate": (builder.H_GATE, builder.H_GATE_SHA256),
            "inner_binding_proposal": (builder.H_INNER, builder.H_INNER_SHA256),
            "controls": (builder.H_CONTROLS, hashlib.sha256(builder.H_CONTROLS.read_bytes()).hexdigest()),
            "source_plan": (builder.H_PLAN, builder.H_SOURCE_PLAN_SHA256),
        }
        candidate_files = {}
        for name, (path, expected_sha) in rows.items():
            raw = path.read_bytes()
            candidate_files[name] = {
                "path": str(path.relative_to(builder.ROOT)),
                "bytes": len(raw),
                "sha256": expected_sha,
            }
        review = {
            "status": "PASS_R6I_TOKEN_ELEVATION_FIXED_DWORD_SOURCE_ONLY",
            "source_plan_sha256": builder.H_SOURCE_PLAN_SHA256,
            "candidate_files": candidate_files,
        }

        def write_review(path, value):
            raw = (json.dumps(value, sort_keys=True, indent=2) + "\n").encode("utf-8")
            path.write_bytes(raw)
            return hashlib.sha256(raw).hexdigest()

        with tempfile.TemporaryDirectory(prefix="r6i-review-consumer-") as temp:
            review_path = Path(temp) / "synthetic-review.json"
            good_sha = write_review(review_path, review)
            with patch.object(builder, "H_MAIN_REVIEW", review_path), \
                    patch.object(builder, "H_MAIN_REVIEW_SHA256", good_sha):
                accepted, source_bytes = builder._check_h_source_review()
                self.assertEqual(accepted["status"], review["status"])
                self.assertEqual(set(source_bytes), set(rows))
                for name, (path, _expected_sha) in rows.items():
                    self.assertEqual(source_bytes[name], path.read_bytes())

            drift = json.loads(json.dumps(review))
            drift["candidate_files"]["helper"]["sha256"] = "0" * 64
            drift_sha = write_review(review_path, drift)
            with patch.object(builder, "H_MAIN_REVIEW", review_path), \
                    patch.object(builder, "H_MAIN_REVIEW_SHA256", drift_sha):
                with self.assertRaisesRegex(RuntimeError, "does not bind exact helper"):
                    builder._check_h_source_review()

            wrong_status = json.loads(json.dumps(review))
            wrong_status["status"] = "PASS_BUT_NOT_THE_REQUIRED_REVIEW"
            wrong_status_sha = write_review(review_path, wrong_status)
            with patch.object(builder, "H_MAIN_REVIEW", review_path), \
                    patch.object(builder, "H_MAIN_REVIEW_SHA256", wrong_status_sha):
                with self.assertRaisesRegex(RuntimeError, "status or plan pin differs"):
                    builder._check_h_source_review()

