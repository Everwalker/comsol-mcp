        self.assertEqual(plan["future_native_entry"]["max_active_seconds"], 60)
        self.assertEqual(plan["future_native_entry"]["case_processes"], 1)
        self.assertEqual(plan["future_native_entry"]["max_native_child_processes"], 1)
        self.assertEqual(plan["frozen_history"]["R10"],
                         "UNKNOWN_REMOTE_OR_NATIVE_RESULT_NO_REPLAY")
        self.assertEqual(plan["authority_boundary"]["valid_approval_created"], False)
        self.assertEqual(plan["authority_boundary"]["once_created"], False)
        self.assertEqual(len(plan["prep"]["remote_write_targets"]), 5)


