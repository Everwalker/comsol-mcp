    def test_native_payload_inherits_reviewed_r11_diagnostic_without_raw_stream_edits(self):
        source = R11_PAYLOAD.read_text(encoding="utf-8")
        tree = ast.parse(source)
        functions = {node.name: node for node in tree.body
                     if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))}
        start = functions["_system_exit_diagnostic"].lineno - 1
        end = functions["_run_gate"].end_lineno
        expected = ("\n".join(source.splitlines()[start:end]) + "\n")
        expected = expected.replace("R6H", "R6I").replace("r6h", "r6i")
        self.assertEqual(R6I_DIAGNOSTIC.read_text(encoding="utf-8"), expected)
        source = R6I_DIAGNOSTIC.read_text(encoding="utf-8")
        self.assertIn("exit_diagnostic = _system_exit_diagnostic(exc.code)", source)
        self.assertIn("return code, out_raw, err_raw, \"R6I_GATE_RETURNED\"", source)
        self.assertIn('"gate_system_exit_diagnostic": gate_exit_diagnostic',
                      R11_PAYLOAD.read_text(encoding="utf-8"))
        self.assertIn('"gate_stdout_sha256": _sha(out_raw)',
                      R11_PAYLOAD.read_text(encoding="utf-8"))
        self.assertIn('"gate_stderr_sha256": _sha(err_raw)',
                      R11_PAYLOAD.read_text(encoding="utf-8"))
        ast.parse(source)

