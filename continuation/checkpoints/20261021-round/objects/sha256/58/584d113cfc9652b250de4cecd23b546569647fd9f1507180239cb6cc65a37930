def test_templates_are_explicitly_non_authority_and_exact_targets():
    root = WRAPPER.parents[1]
    names = ["PREP_MAIN_REVIEW_TEMPLATE_NOT_AUTHORITY.json", "WRAPPER_MAIN_REVIEW_TEMPLATE_NOT_AUTHORITY.json", "ONCE_AUTHORIZATION_TEMPLATE_NOT_AUTHORITY.json"]
    values = [json.loads((root / "templates" / name).read_bytes()) for name in names]
    accepted_review = ROOT / "repository/docs/full_project_continuation_v3/state/WINDOWS_PRIMARY_OWNER_R6I_FIVE_LEAF_PREP_MAIN_SOURCE_REVIEW_R1.json"
    accepted_review_sha = hashlib.sha256(accepted_review.read_bytes()).hexdigest()
    assert len(values) == 3
    assert all("TEMPLATE_NOT_AUTHORIZED" in value["status"] for value in values)
    assert values[0]["payload_sha256"] == '952eca570a5cc16e3f2639caeade14c0403158a293063aa3f5b1dee3e65778c8'
    assert values[1]["wrapper_sha256"] == hashlib.sha256(WRAPPER.read_bytes()).hexdigest()
    assert values[2]["remote_write_count"] == 5
    assert all(value["remote_targets"] == list(load_module().REMOTE_TARGETS) for value in values)
    assert values[0]["accepted_payload_review_sha256"] == accepted_review_sha
    assert values[1]["prep_source_review_sha256"] == accepted_review_sha
    assert values[2]["prep_source_review_sha256"] == accepted_review_sha
    assert set(values[2]) == {
        "active_cutoff_seconds", "argv_sha256", "contract_sha256",
        "current_resume_sha256", "invocation_sha256", "manifest_sha256",
        "passive_wait_same_original_popen_after_cutoff", "payload_bytes",
        "payload_sha256", "persistent_user_authorization_sha256",
        "prep_source_review_sha256", "remote_native_or_other_effects",
        "remote_targets", "remote_write_count", "run_root", "schema", "status",
        "wrapper_review_sha256", "wrapper_sha256",
    }
    assert values[2]["status"] != "MAIN_AUTHORIZED_EXACT_R6I_PREP_ONCE"
