def _system_exit_diagnostic(code):
    """Keep bounded SystemExit provenance separate from captured raw streams."""
    if code is None:
        return {"exception_type": "SystemExit", "code_type": "NoneType",
                "code_value": None, "code_value_truncated": False}
    if type(code) is str:
        return {"exception_type": "SystemExit", "code_type": "str",
                "code_value": code[:MAX_SYSTEM_EXIT_DIAGNOSTIC_CHARS],
                "code_value_truncated": len(code) > MAX_SYSTEM_EXIT_DIAGNOSTIC_CHARS}
    if type(code) is int:
        in_json_bound = -(2 ** 31) <= code <= (2 ** 31 - 1)
        return {"exception_type": "SystemExit", "code_type": "int",
                "code_value": code if in_json_bound else None,
                "code_value_truncated": not in_json_bound}
    if type(code) is bool:
        return {"exception_type": "SystemExit", "code_type": "bool",
                "code_value": code, "code_value_truncated": False}
    code_class = type(code)
    try:
        module = type.__getattribute__(code_class, "__module__")
        name = type.__getattribute__(code_class, "__qualname__")
        type_name = (module + "." + name) if type(module) is str and type(name) is str else "unknown"
    except BaseException:
        type_name = "unknown"
    return {"exception_type": "SystemExit", "code_type": "other",
            "code_type_name": type_name[:128], "code_value": None,
            "code_value_truncated": False}


def _run_gate(gate, paths):
    saved_argv = list(sys.argv)
    out = io.StringIO()
    err = io.StringIO()
    code = 1
    exception = None
    exit_diagnostic = None
    sys.argv = [paths["gate"], "--binding", paths["inner"], "--approval", paths["approval"],
                "--once", gate.ONCE_PATH]
    try:
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                runpy.run_path(paths["gate"], run_name="__main__")
            except SystemExit as exc:
                exit_diagnostic = _system_exit_diagnostic(exc.code)
                code = exc.code if type(exc.code) is int else (0 if exc.code is None else 1)
            except BaseException as exc:
                exception = type(exc).__name__ + ":" + str(exc)[:2048]
                code = 1
    finally:
        sys.argv = saved_argv
    out_raw = out.getvalue().encode("utf-8", "replace")
    err_raw = err.getvalue().encode("utf-8", "replace")
    if len(out_raw) > MAX_GATE_STREAM_BYTES or len(err_raw) > MAX_GATE_STREAM_BYTES:
        return code, b"", b"", "UNKNOWN_GATE_STREAM_LIMIT", exception, exit_diagnostic
    return code, out_raw, err_raw, "R6I_GATE_RETURNED", exception, exit_diagnostic
