class CheckOnlyError(RuntimeError):
    pass


def _sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def _read_pinned(path: Path, expected_sha256: str, *, maximum: int = 4 * 1024 * 1024) -> bytes:
    path = Path(path)
    before_name = path.lstat()
    if (stat.S_ISLNK(before_name.st_mode) or not stat.S_ISREG(before_name.st_mode)
            or before_name.st_size > maximum):
        raise CheckOnlyError(f"pinned input is not a bounded regular file: {path}")
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        before_fd = os.fstat(fd)
        name_sig = lambda row: (row.st_dev, row.st_ino, row.st_mode, row.st_uid,
                                row.st_nlink, row.st_size, row.st_mtime_ns)
        fd_sig = lambda row: (row.st_dev, row.st_ino, row.st_mode, row.st_uid,
                              row.st_nlink, row.st_size, row.st_mtime_ns)
        if (name_sig(before_name) != name_sig(path.lstat())
                or before_fd.st_dev != before_name.st_dev
                or before_fd.st_ino != before_name.st_ino
                or before_fd.st_size != before_name.st_size
                or before_fd.st_mtime_ns != before_name.st_mtime_ns):
            raise CheckOnlyError(f"pinned input identity changed before read: {path}")
        chunks = []
        remaining = maximum + 1
        while remaining:
            block = os.read(fd, min(1024 * 1024, remaining))
            if not block:
                break
            chunks.append(block)
            remaining -= len(block)
        after_fd = os.fstat(fd)
        after_name = path.lstat()
        if (name_sig(before_name) != name_sig(after_name)
                or fd_sig(before_fd) != fd_sig(after_fd)
                or after_fd.st_dev != after_name.st_dev
                or after_fd.st_ino != after_name.st_ino
                or after_fd.st_size != after_name.st_size
                or after_fd.st_mtime_ns != after_name.st_mtime_ns):
            raise CheckOnlyError(f"pinned input identity changed during read: {path}")
        raw = b"".join(chunks)
        if len(raw) != after_fd.st_size or len(raw) > maximum or _sha(raw) != expected_sha256:
            raise CheckOnlyError(f"pinned input bytes differ from expected SHA-256: {path}")
        return raw
    finally:
        os.close(fd)


def _load_json(path: Path, digest: str) -> dict[str, Any]:
    try:
        value = json.loads(_read_pinned(path, digest).decode("utf-8", "strict"))
    except CheckOnlyError:
        raise
    except Exception as exc:
        raise CheckOnlyError(f"invalid pinned JSON: {path}") from exc
    if not isinstance(value, dict):
        raise CheckOnlyError(f"pinned JSON object required: {path}")
    return value


def _verify_r1_packet() -> tuple[dict[str, Any], dict[str, Any]]:
    manifest = _load_json(R1_MANIFEST, R1_MANIFEST_SHA256)
    if (manifest.get("schema") != "W25_CURRENT175_R12_BLANK_GUI_UNSIGNED_PACKET_MANIFEST/1"
            or manifest.get("candidate_root") != str(R1_ROOT)
            or manifest.get("member_count") != 10
            or manifest.get("status") != "FROZEN_SOURCE_ONLY_PACKET_NO_AUTHORITY"):
        raise CheckOnlyError("R1 frozen unsigned packet identity or scope changed")
    rows = manifest.get("members")
    if not isinstance(rows, list) or len(rows) != 10:
        raise CheckOnlyError("R1 packet member list is not the exact 10-file closure")
    for row in rows:
        if not isinstance(row, dict) or set(row) != {"bytes", "mode_octal", "path", "sha256"}:
            raise CheckOnlyError("R1 packet manifest row is malformed")
        rel = Path(row["path"])
        if rel.is_absolute() or ".." in rel.parts:
            raise CheckOnlyError("R1 packet path escaped candidate root")
        target = R1_ROOT / rel
        raw = _read_pinned(target, row["sha256"], maximum=64 * 1024 * 1024)
        info = target.lstat()
        if len(raw) != row["bytes"] or f"{stat.S_IMODE(info.st_mode):04o}" != row["mode_octal"]:
            raise CheckOnlyError("R1 packet member size or mode differs from its frozen manifest")
    plan = _load_json(R1_PLAN, R1_PLAN_SHA256)
    if (plan.get("schema") != "W25_CURRENT175_R12_BLANK_GUI_UNSIGNED_ENTRY_PLAN_R1"
            or plan.get("candidate_root") != str(R1_ROOT)
            or plan.get("source_lineage", {}).get("r5_main_review", {}).get("sha256")
            != R5_REVIEW_SHA256):
        raise CheckOnlyError("R1 unsigned plan does not bind the accepted R5 source review")
    authority = plan.get("authority")
    expected_authority = {
        "COMSOL": "NOT_RUN", "GUI": "NOT_RUN", "JVM": "NOT_RUN",
        "candidate_review": "NOT_CREATED", "lane_check": "NOT_CREATED",
        "once_binding": "NOT_CREATED", "runtime_candidate": "NOT_CREATED",
        "unit_once_guard": "NOT_CREATED", "valid_approval": "NOT_CREATED",
    }
    if authority != expected_authority:
        raise CheckOnlyError("R1 unsigned plan contains an unexpected authority state")
    if plan.get("scope") != {
        "AX_depth": 2, "AX_nodes_max": 64, "active_observation_seconds": 540,
        "blank_owned_standalone_windows": 1, "cleanup_reserve_seconds": 60,
        "clicks": 0, "control_actions": "NOT_RUN", "endpoint_challenge": "NOT_RUN",
        "model_open": 0, "other_owner_stop_or_reuse": "FORBIDDEN", "pixels": 0,
        "screenshots": 0, "solver_science": "NOT_RUN", "total_seconds": 600,
    }:
        raise CheckOnlyError("R1 W25 observation scope differs from the bounded unsigned plan")
    return manifest, plan


def _load_exact_actor() -> ModuleType:
    raw = _read_pinned(R5_ACTOR, R5_ACTOR_SHA256, maximum=8 * 1024 * 1024)
    review = _load_json(R5_REVIEW_PATH, R5_REVIEW_SHA256)
    if review.get("status") != "PASS_SCOPED_SOURCE_AND_ACTUAL_INSTALLED_CALLER_BYTES_FRESH_GUI_ADMISSION_REQUIRED":
        raise CheckOnlyError("R5 Main review is not the accepted source-only caller review")
    name = "w25_r12_exact_r5_actor_check_only_r2"
    module = ModuleType(name)
    module.__file__ = str(R5_ACTOR)
    module.__package__ = ""
    sys.modules[name] = module
    exec(compile(raw, str(R5_ACTOR), "exec"), module.__dict__)
    if module.CURRENT_R12 != "current175-r12" or module.APP_VERSION != "0.1.10":
        raise CheckOnlyError("Main-reviewed actor did not load the exact R12 profile")
    return module


def run_check_only() -> dict[str, Any]:
    manifest, plan = _verify_r1_packet()
    actor = _load_exact_actor()
    source_inputs = actor._verify_r12_source_inputs()
    actual = actor._verify_current_r12_install(INSTALLED_ROOT, R5_BINDING, source_inputs)
    binding = actual["binding"]
    if (binding.get("sha256") != R5_BINDING_SHA256
            or actual.get("root") != str(INSTALLED_ROOT)
            or actual.get("actual_review", {}).get("sha256") != R26_REVIEW_SHA256
            or len(actual.get("package_records", ())) != 172
            or {key: row.get("sha256") for key, row in actual.get("caller_source_hashes", {}).items()}
            != EXPECTED_CALLER_HASHES):
        raise CheckOnlyError("R5 actual installed-caller consumer returned a mismatched identity")
    return {
        "schema": "W25_R12_READONLY_CHECK_ONLY_RESULT/1",
        "status": "PASS_ACTUAL_R5_CONSUMER_READONLY_CHECK_ONLY",
        "r1_packet_manifest_sha256": R1_MANIFEST_SHA256,
        "r1_packet_members_rehashed": manifest["member_count"],
        "r1_unsigned_plan_sha256": R1_PLAN_SHA256,
        "r5_actor_sha256": R5_ACTOR_SHA256,
        "r5_main_source_review_sha256": R5_REVIEW_SHA256,
        "r26_actual_install_review_sha256": R26_REVIEW_SHA256,
        "install_binding_sha256": R5_BINDING_SHA256,
        "installed_root": actual["root"],
        "source_profile": actor.CURRENT_R12,
        "package_members_rehashed": len(actual["package_records"]),
        "caller_source_hashes": {key: value["sha256"]
                                  for key, value in actual["caller_source_hashes"].items()},
        "retained_lifecycle_status": plan["installed_caller"]["full_lifecycle"],
        "scope": plan["scope"],
        "authority_created": False,
        "once_read_or_consumed": False,
        "runtime_root_created": False,
        "process_inventory": "NOT_RUN",
        "GUI": "NOT_RUN",
        "COMSOL": "NOT_RUN",
        "JVM": "NOT_RUN",
        "native_Popen": 0,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check-only", action="store_true", required=True)
    args = parser.parse_args(argv)
    if args.check_only is not True:
        parser.error("only --check-only is supported")
    print(json.dumps(run_check_only(), sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
