def test_external_driver_process_stays_alive_until_same_python_owner_children_exit(tmp_path):
    run_root = tmp_path / "driver-run"
    child = subprocess.Popen(
        [sys.executable, str(CHILD_DRIVER), str(CONTROLLER), str(run_root)],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, close_fds=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    marker = run_root / "R12_PASSIVE_HOLD_STARTED.json"
    deadline = time.monotonic() + 5.0
    while not marker.exists() and child.poll() is None and time.monotonic() < deadline:
        time.sleep(0.02)
    assert marker.exists(), "driver did not enter passive hold"
    hold = json.loads(marker.read_text())
    assert hold["status"] == "UNKNOWN_ORIGINAL_OWNERS_PASSIVELY_HELD_NO_RPC_NO_CLOSE"
    assert len(hold["original_owner_processes"]) == 2
    assert child.poll() is None, "driver must remain running while the same original owner children are live"
    live_children = []
    for row in hold["original_owner_processes"]:
        try:
            os.kill(row["pid"], 0)
            live_children.append(row["pid"])
        except ProcessLookupError:
            pass
    assert len(live_children) == 2
    stdout, stderr = child.communicate(timeout=6)
    assert child.returncode == 0, stderr
    outer = json.loads(stdout)
    terminal = outer["passive_terminal"]
    assert outer["status"] == "UNKNOWN_NO_REPLAY_ORIGINAL_OWNERS_TERMINAL_OBSERVED"
    assert outer["r8_outer_call_count"] == 1
    assert outer["deadline"]["route_checks"][0]["dispatch_allowed"] is True
    assert outer["driver_public_calls_after_r8_return"] == 0
    assert outer["driver_process_signals"] == 0
    assert outer["driver_host_close_after_r8_return"] == 0
    assert terminal["status"] == "UNKNOWN_NO_REPLAY_ORIGINAL_OWNERS_TERMINAL_OBSERVED"
    assert terminal["passive_process_poll_only"] is True
    assert terminal["signals"] == 0
    assert terminal["RPC_after_R8_return"] == 0
    assert terminal["host_close_after_R8_return"] == 0
    assert terminal["native_child_absence_claimed"] is False
    assert terminal["passive_hold_seconds"] >= 0.75
    assert all(row["returncode"] == 0 for row in terminal["original_owner_processes"])


