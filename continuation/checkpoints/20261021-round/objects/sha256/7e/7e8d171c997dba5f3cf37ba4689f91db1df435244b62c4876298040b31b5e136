def test_dispatch_deadline_wraps_both_existing_routes_and_blocks_before_route_body():
    class R5:
        @staticmethod
        def _server_birth_epoch_seconds(gate):
            assert gate is expected_gate
            return 1000.0

    expected_gate = object()

    class Bridge:
        def __init__(self):
            self.gate = expected_gate

        def dispatch(self, *args, **kwargs):
            raise AssertionError("the synthetic route body is not the dispatcher")

    class FreshOwnerRoute:
        def __init__(self, dispatcher):
            self.dispatcher = dispatcher
            self.calls = 0

        def call_raw(self, *args, **kwargs):
            self.calls += 1
            return "fresh-owner-route-called"

    class PublicRoute:
        def __init__(self, dispatcher):
            self.dispatcher = dispatcher
            self.calls = 0

        def call_raw(self, *args, **kwargs):
            self.calls += 1
            return "public-route-called"

    times = iter((2000.0, 2680.0))  # 800s remain; then exactly 120s reserve remains.
    deadline = TARGET.DispatchDeadline(R5, now=lambda: next(times))
    runtime = SimpleNamespace(FreshOwnerRoute=FreshOwnerRoute, PublicRoute=PublicRoute)
    bridge = Bridge()
    fresh = FreshOwnerRoute(bridge.dispatch)
    public = PublicRoute(bridge.dispatch)
    restore = TARGET.install_dispatch_deadline(runtime, deadline)
    try:
        assert fresh.call_raw() == "fresh-owner-route-called"
        try:
            public.call_raw()
        except TARGET.WallDeadlineExceeded:
            pass
        else:
            raise AssertionError("route with only cleanup reserve remaining must be blocked")
    finally:
        restore()
    assert fresh.calls == 1
    assert public.calls == 0
    assert [row["dispatch_allowed"] for row in deadline.checks] == [True, False]
    assert deadline.deadline_epoch == 2800.0
    assert all(row["cleanup_reserve_seconds"] == TARGET.CLEANUP_RESERVE_SECONDS for row in deadline.checks)


