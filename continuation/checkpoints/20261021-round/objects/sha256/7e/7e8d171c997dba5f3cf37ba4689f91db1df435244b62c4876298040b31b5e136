        "controller_sha256": hashlib.sha256(CONTROLLER.read_bytes()).hexdigest(),
        "r8_main_review_sha256": lower_args["r8_review_sha256"],
        "r8_once_binding_sha256": lower_args["r8_once_sha256"],
        "r8_controller_sha256": TARGET.R8_CONTROLLER_SHA256,
        "r8_source_manifest_sha256": TARGET.R8_SOURCE_MANIFEST_SHA256,
        "r8_source_map_sha256": TARGET.R8_SOURCE_MAP_SHA256,
        "r8_packet_manifest_sha256": TARGET.R8_PACKET_MANIFEST_SHA256,
        "r6_main_review_sha256": lower_args["r6_review_sha256"],
        "r6_once_binding_sha256": lower_args["r6_once_sha256"],
        "r6_source_projection_sha256": TARGET.R6_SOURCE_PROJECTION_SHA256,
        "wall_budget_seconds": TARGET.WALL_BUDGET_SECONDS,
        "cleanup_reserve_seconds": TARGET.CLEANUP_RESERVE_SECONDS,
        "public_budgets": dict(TARGET.PUBLIC_BUDGETS),
    }

    def install_pair(*, review_change=None, once_change=None, drop_review=()):
        review = {
            "schema": TARGET.R12_REVIEW_SCHEMA,
            "decision": "APPROVE_ONE_W23_R12_EXTERNAL_DRIVER_ENTRY",
            **expected,
            "runtime_root": paths["runtime_root"],
            "host_provider_config_root": paths["host_provider_config_root"],
            "persistent_evidence_root": paths["persistent_evidence_root"],
            "r8_outer_run_root": paths["r8_outer_run_root"],
            "driver_run_root": paths["driver_run_root"],
            "approval_sha256": "",
        }
        if review_change:
            review.update({key: value for key, value in review_change.items()
                           if key != "__approval_override"})
        for field in drop_review:
            review.pop(field)
        review["approval_sha256"] = TARGET._review_authority_sha(review)
        if review_change and "__approval_override" in review_change:
            review["approval_sha256"] = review_change["__approval_override"]
        review_raw = json.dumps(review, sort_keys=True, separators=(",", ":"),
                                ensure_ascii=False, allow_nan=False).encode("utf-8")
        once = {key: value for key, value in review.items()
                if key not in {"decision", "approval_sha256"}}
        once.update({
            "schema": TARGET.R12_ONCE_SCHEMA,
            "status": "AUTHORIZED_SINGLE_ENTRY",
            "normal_attempts": 1,
            "main_review_sha256": hashlib.sha256(review_raw).hexdigest(),
            "approval_sha256": review["approval_sha256"],
        })
        if once_change:
            once.update(once_change)
        once_raw = json.dumps(once, sort_keys=True, separators=(",", ":"),
                              ensure_ascii=False, allow_nan=False).encode("utf-8")
        review_path.write_bytes(review_raw)
        once_path.write_bytes(once_raw)
        return hashlib.sha256(review_raw).hexdigest(), hashlib.sha256(once_raw).hexdigest()

    review_sha, once_sha = install_pair()
    accepted = TARGET._strict_r12_authority(
        r12_review_sha256=review_sha, r12_once_sha256=once_sha, **lower_args)
    assert accepted[2]["driver_run_root"] == Path(paths["driver_run_root"])
    assert len(calls) == 1

    negative_pairs = [
        ("review schema", {"schema": "wrong-schema"}, None),
        ("review unknown field", {"unexpected": "x"}, None),
        ("review approval digest", {"__approval_override": "0" * 64}, None),
        ("once schema", None, {"schema": "wrong-schema"}),
        ("once unknown field", None, {"unexpected": "x"}),
        ("once expected source", None, {"source_plan_sha256": "f" * 64}),
        ("once path", None, {"driver_run_root": "/private/tmp/wrong-driver-root"}),
        ("once attempt count", None, {"normal_attempts": True}),
    ]
    for label, review_change, once_change in negative_pairs:
        review_sha, once_sha = install_pair(review_change=review_change,
                                            once_change=once_change)
        try:
            TARGET._strict_r12_authority(
                r12_review_sha256=review_sha, r12_once_sha256=once_sha, **lower_args)
        except TARGET.OuterControllerError:
            pass
        else:
            raise AssertionError(f"R12 authority consumer accepted {label} drift")

    review_sha, once_sha = install_pair(drop_review=("decision",))
    try:
        TARGET._strict_r12_authority(
            r12_review_sha256=review_sha, r12_once_sha256=once_sha, **lower_args)
    except TARGET.OuterControllerError:
        pass
    else:
        raise AssertionError("R12 authority consumer accepted a missing review field")

    install_pair()
    bad_lower = dict(lower_review, runtime_root="/private/tmp/cross-generation-runtime")
    class CrossGenerationR8:
        @staticmethod
        def source_only_preflight():
            return {"status": "SOURCE_ONLY_PASS_NO_AUTHORITY_NO_DISPATCH", "public_calls": 0,
                    "approval_created": False, "once_created": False}

        @staticmethod
        def _strict_authority(**kwargs):
            return bad_lower, {}, {}, object(), object(), object()
    monkeypatch.setattr(TARGET, "_load_r8", lambda: CrossGenerationR8)
    review_sha, once_sha = install_pair()
    try:
        TARGET._strict_r12_authority(
            r12_review_sha256=review_sha, r12_once_sha256=once_sha, **lower_args)
    except TARGET.OuterControllerError as exc:
        assert "paths diverge from exact R8 Main-bound" in str(exc)
    else:
        raise AssertionError("R12 accepted paths from a different R8 authority generation")


