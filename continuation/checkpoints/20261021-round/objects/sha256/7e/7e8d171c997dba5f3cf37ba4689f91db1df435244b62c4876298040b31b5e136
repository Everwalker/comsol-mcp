def test_r12_source_manifest_exactly_binds_all_entry_and_test_members(tmp_path):
    observed = TARGET._verify_r12_source_manifest()
    assert observed["member_count"] == len(TARGET.R12_SOURCE_MEMBERS)
    assert {row["path"] for row in observed["files"]} == set(TARGET.R12_SOURCE_MEMBERS)

    root = tmp_path / "candidate"
    root.mkdir(mode=0o700)
    (root / "nested").mkdir(mode=0o700)
    (root / "entry.py").write_bytes(b"exact entry")
    (root / "nested" / "control.py").write_bytes(b"exact control")
    rows = []
    for name in ("entry.py", "nested/control.py"):
        raw = (root / name).read_bytes()
        rows.append({"path": name, "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()})
    manifest_path = root / "manifest.json"
    manifest_path.write_text(json.dumps({"schema": "W23_R12_SOURCE_MANIFEST/1",
                                        "candidate_root": str(root.resolve()),
                                        "files": rows}, sort_keys=True), encoding="utf-8")
    expected = ("entry.py", "nested/control.py")
    accepted = TARGET._verify_r12_source_manifest(root=root, manifest_path=manifest_path,
                                                 expected_members=expected)
    assert accepted["member_count"] == 2
    (root / "entry.py").write_bytes(b"changed entry")
    try:
        TARGET._verify_r12_source_manifest(root=root, manifest_path=manifest_path,
                                          expected_members=expected)
    except TARGET.OuterControllerError as exc:
        assert "differs from manifest" in str(exc)
    else:
        raise AssertionError("modified candidate source must fail closed")


