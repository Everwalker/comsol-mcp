def _parameter_payload_rows(values):
    return {
        "scope": "model",
        "parameters": [{
            "name": name, "group": "default", "expression": repr(value), "description": "observed test input",
            "description_error": None, "unit": "1", "unit_error": None,
            "evaluated": {"kind": "float64", "shape": [], "data": value}, "evaluate_errors": None,
        } for name, value in values.items()],
        "count": len(values),
        "unit_policy": "units are reported verbatim from evaluateUnit(); this layer never converts",
    }


def _observed_two_materials(*, epsilon_core, epsilon_clad):
    def make_group(epsilon):
        group = fake.FPropertyGroup(
            tag="def",
            value_types={"relpermittivity": "StringMatrix", "relpermeability": "StringMatrix",
                         "electricconductivity": "StringArray"},
            matrices={"relpermittivity": epsilon,
                      "relpermeability": [["1", "0", "0"], ["0", "1", "0"], ["0", "0", "1"]]},
            arrays={"electricconductivity": ["0[S/m]"]},
        )
        group.size = lambda name: [3, 3]
        return group

    materials = {
        "mat_core": fake.material_node(tag="mat_core", groups={"def": make_group(epsilon_core)},
                                        entities=[1], dim=2, geometry="geom1"),
        "mat_clad": fake.material_node(tag="mat_clad", groups={"def": make_group(epsilon_clad)},
                                        entities=[2], dim=2, geometry="geom1"),
    }
    model = fake.build_model(component=fake.FComponent(materials=materials, physics={}))
    worker = fake.worker_for(model)
    inventory = candidate_w15.material_list(worker, "Model", {"component": "comp1"})
    inspections = [candidate_w15.material_inspect(worker, "Model", {
        "path": fake.feature_path(("component", "comp1"), ("material", tag)),
        "groups": ["def"], "properties": PROPERTIES,
    }) for tag in ("mat_core", "mat_clad")]
    adjacency = {
        "entity_dimension": 1, "target_dimension": 2, "per_entity_truncated": False,
        "source_entities": [17, 18],
        "per_entity": [{"entity": 17, "adjacent": [1]}, {"entity": 18, "adjacent": [2]}],
        "adjacent_entities": [1, 2],
    }
    return inventory, inspections, adjacency


