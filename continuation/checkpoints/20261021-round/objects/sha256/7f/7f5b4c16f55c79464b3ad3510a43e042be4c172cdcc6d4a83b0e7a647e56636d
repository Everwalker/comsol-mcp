if not hasattr(sys.modules["pytest"], "raises"):
    class _RaisesContext:
        def __init__(self, expected):
            self.expected = expected
            self.value = None

        def __enter__(self):
            return self

        def __exit__(self, exc_type, exc, traceback):
            if exc_type is None:
                raise AssertionError(f"expected {self.expected.__name__}")
            if not issubclass(exc_type, self.expected):
                return False
            self.value = exc
            return True

    sys.modules["pytest"].raises = lambda expected: _RaisesContext(expected)

