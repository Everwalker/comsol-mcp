    def test_rejects_overlapping_or_incomplete_material_domain_ownership(self):
        inventory, inspections, adjacency, _ = _observed()
        duplicate = dict(inventory["materials"][0])
        duplicate["tag"] = "mat2"
        inventory["materials"].append(duplicate)
        inventory["material_count"] = 2
        inspection2 = dict(inspections[0])
        inspection2["tag"] = "mat2"
        inspections.append(inspection2)
        self.assert_refused(proof.prove_adjacent_materials, adjacency, inventory, inspections,
