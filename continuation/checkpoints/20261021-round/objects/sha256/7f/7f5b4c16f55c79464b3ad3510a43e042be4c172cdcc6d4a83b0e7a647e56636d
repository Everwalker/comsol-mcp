PROPERTIES = ["relpermittivity", "relpermeability", "electricconductivity"]


def _group(*, epsilon=None, mu=None, sigma="0[S/m]", size_error=False):
    epsilon = epsilon or [["2.1", "0", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]]
    mu = mu or [["1", "0", "0"], ["0", "1", "0"], ["0", "0", "1"]]
    group = fake.FPropertyGroup(
        tag="def",
        value_types={"relpermittivity": "StringMatrix", "relpermeability": "StringMatrix",
                     "electricconductivity": "StringArray"},
        matrices={"relpermittivity": epsilon, "relpermeability": mu},
        arrays={"electricconductivity": [sigma]},
    )
    size_map = {"relpermittivity": [3, 3], "relpermeability": [3, 3], "electricconductivity": [3, 3]}

    def size(name):
        if size_error:
            raise fake.FakeEngineError("METHOD_REJECTED", code="METHOD_REJECTED")
        return size_map[name]

    group.size = size
    return group


def _observed(*, epsilon=None, mu=None, sigma="0[S/m]", size_error=False):
    node = fake.material_node(tag="mat1", groups={"def": _group(
        epsilon=epsilon, mu=mu, sigma=sigma, size_error=size_error)},
        entities=[1], dim=2, geometry="geom1")
    component = fake.FComponent(materials={"mat1": node}, physics={})
    worker = fake.worker_for(fake.build_model(component=component))
    inventory = candidate_w15.material_list(worker, "Model", {"component": "comp1"})
    inspection = candidate_w15.material_inspect(worker, "Model", {
        "path": fake.MATERIAL_PATH, "groups": ["def"], "properties": PROPERTIES,
    })
    adjacency = {
        "entity_dimension": 1, "target_dimension": 2, "per_entity_truncated": False,
        "source_entities": [17], "per_entity": [{"entity": 17, "adjacent": [1]}],
        "adjacent_entities": [1],
    }
    return inventory, [inspection], adjacency, inspection


def _prove(*, observed_parameters=None, **kwargs):
    inventory, inspections, adjacency, inspection = _observed(**kwargs)
    return proof.prove_adjacent_materials(adjacency, inventory, inspections,
                                          observed_parameters=observed_parameters,
                                          observed_geometry_dimension=2), inspection


def _parameter_payload(*, name="n_core", value=1.45, unit="1", evaluated_kind="float64"):
    return {
        "scope": "model",
        "parameters": [{
            "name": name, "group": "default", "expression": "1.45", "description": "observed test input",
            "description_error": None, "unit": unit, "unit_error": None,
            "evaluated": {"kind": evaluated_kind, "shape": [], "data": value}, "evaluate_errors": None,
        }],
        "count": 1,
        "unit_policy": "units are reported verbatim from evaluateUnit(); this layer never converts",
    }


class DirectionProofTests(unittest.TestCase):
    def assert_refused(self, function, *args, message=None, **kwargs):
        with self.assertRaises(ValueError) as caught:
            function(*args, **kwargs)
        if message:
            self.assertIn(message, str(caught.exception))

    def test_material_inspect_captures_exact_size_only_for_explicit_properties(self):
        inventory, inspections, adjacency, inspection = _observed()
        self.assertEqual(inventory["material_count"], 1)
        rows = {item["name"]: item for item in inspection["property_groups"][0]["properties"]}
        self.assertEqual(set(rows), set(PROPERTIES))
        self.assertTrue(all(item["size_getter"] == "MaterialModel.size" for item in rows.values()))
        self.assertTrue(all(item["size_argument"] == name for name, item in rows.items()))
        self.assertTrue(all(item["stored_size_raw"] == [3, 3] for item in rows.values()))
        self.assertTrue(all(item["stored_size"] == [3, 3] and item["stored_size_status"] == "CAPTURED"
                            for item in rows.values()))
        broad_group = fake.def_group()
        broad_node = fake.material_node(groups={"def": broad_group})
        broad_component = fake.FComponent(materials={"mat1": broad_node}, physics={})
        broad_worker = fake.worker_for(fake.build_model(component=broad_component))
        broad_result = candidate_w15.material_inspect(broad_worker, "Model", {"path": fake.MATERIAL_PATH})
        self.assertTrue(all("stored_size" not in row for row in broad_result["property_groups"][0]["properties"]))
        self.assertFalse(any(method == "size" for method, _ in broad_group.calls))

    def test_observed_adjacent_materials_pass_lossless_reciprocity_gate(self):
        result, inspection = _prove()
        self.assertEqual(result["status"], "PASS_OBSERVED_ADJACENT_MATERIAL_COVERAGE_AND_RECIPROCITY")
        self.assertEqual(result["domain_material_assignments"], {"1": "mat1"})
        self.assertEqual(result["material_proofs"]["mat1"]["status"], "PASS_OBSERVED_LOSSLESS_RECIPROCAL_MATERIAL")
        self.assertEqual(inspection["errors"], [])
        self.assertTrue(result["raw_material_and_adjacency_observations_retained"])

    def test_rejects_asymmetric_complex_or_unresolved_epsilon(self):
        examples = [
            [["2.1", "0.01", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]],
            [["2.1", "1+0i", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]],
            [["n_core^2", "0", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]],
        ]
        for epsilon in examples:
            with self.subTest(epsilon=epsilon):
                self.assert_refused(_prove, epsilon=epsilon)

    def test_material_expressions_resolve_only_from_observed_typed_dimensionless_parameters(self):
        epsilon = [["n_core^2", "0", "0"], ["0", "n_core^2", "0"], ["0", "0", "n_core^2"]]
        _, inspections, _, _ = _observed(epsilon=epsilon)
        self.assertEqual(proof.required_parameter_names(inspections), ["n_core"])
        result, _ = _prove(epsilon=epsilon, observed_parameters=_parameter_payload())
        material = result["material_proofs"]["mat1"]
        proof_row = material["relative_permittivity"]
        self.assertEqual(proof_row["matrix_decimal"], [["2.1025", "0", "0"], ["0", "2.1025", "0"], ["0", "0", "2.1025"]])
        self.assertEqual(proof_row["observed_parameter_names_used"], ["n_core"])
        parameter = material["observed_parameters"]["n_core"]
        self.assertEqual(parameter["raw_expression"], "1.45")
        self.assertEqual(parameter["typed_evaluated"], {"kind": "float64", "shape": [], "data": 1.45})

    def test_rejects_parameter_payloads_with_extra_unknown_or_dimensional_symbols(self):
        epsilon = [["n_core^2", "0", "0"], ["0", "n_core^2", "0"], ["0", "0", "n_core^2"]]
        payload = _parameter_payload()
        extra = _parameter_payload(name="unused")
        payload["parameters"].extend(extra["parameters"])
        payload["count"] = 2
        self.assert_refused(_prove, epsilon=epsilon, observed_parameters=payload,
                            message="exact global symbol union")
        self.assert_refused(_prove, epsilon=epsilon,
                            observed_parameters=_parameter_payload(unit="m"), message="dimensional")
        self.assert_refused(_prove, epsilon=epsilon,
                            observed_parameters=_parameter_payload(evaluated_kind="complex128"),
                            message="typed scalar real")
        unknown_field = _parameter_payload()
        unknown_field["unreviewed"] = "must fail closed"
        self.assert_refused(_prove, epsilon=epsilon, observed_parameters=unknown_field,
                            message="exact observed model-scope")

    def test_closed_material_expression_grammar_rejects_functions_and_unbound_symbols(self):
        for expression in ("sqrt(2)", "n_core^(1/2)", "n_core^2[kg]"):
            epsilon = [[expression, "0", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]]
            with self.subTest(expression=expression):
                self.assert_refused(_prove, epsilon=epsilon, observed_parameters=_parameter_payload(),
                                    message="UNVERIFIED relpermittivity")
        for expression in ("unbound^2", "n_core+unknown"):
            epsilon = [[expression, "0", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]]
            with self.subTest(expression=expression):
                self.assert_refused(_prove, epsilon=epsilon, observed_parameters=_parameter_payload(),
                                    message="exact global symbol union")
        _, inspections, _, _ = _observed(epsilon=[["sqrt(2)", "0", "0"], ["0", "2.1", "0"], ["0", "0", "2.1"]])
        self.assert_refused(proof.required_parameter_names, inspections)

    def test_rejects_nonzero_underflow_and_wrong_unit_conductivity(self):
        for sigma in ("1e-400[S/m]", "1e-12[S/m]", "0[A/m]"):
            with self.subTest(sigma=sigma):
                self.assert_refused(_prove, sigma=sigma)

