class _Pointer:
    @staticmethod
    def set(pointer, value):
        pointer._obj.value = value


class FakeAPI:
    def __init__(self, leaf):
        self.handle = object()
        self.k = object()
        identity = leaf["identity"]
        self.identity = (identity["device"], identity["inode"])
        file_identity, size, creation, change, write, links = leaf["native_full_fingerprint"]
        self.full = {"file_identity": tuple(file_identity), "size": size,
                     "creation_time": creation, "change_time": change,
                     "write_time": write, "link_count": links}
        self.descriptor = leaf["descriptor_sha256"]
        self.owner_class = leaf["owner_classification"]
        self.owner_sid = leaf["owner_sid"]
        self.content = bytearray()
        self.cursor = 0
        self.open_count = 0
        self.close_count = 0
        self.write_calls = 0
        self.flush_calls = 0
        self.read_calls = 0
        self.seek_calls = 0
        self.events = []

    def open(self, path, *, directory, create):
        assert directory is False and create is False
        self.open_count += 1
        return self.handle

    def close(self, handle):
        assert handle is self.handle
        self.close_count += 1

    def info(self, handle, *, directory):
        assert handle is self.handle and directory is False
        return self.identity, len(self.content)


class FakeOwner:
    def __init__(self, api):
        self.api = api

    def function(self, name, _library):
        api = self.api
        if name == "WriteFile":
            def write(handle, buffer, amount, written, _overlapped):
                assert handle is api.handle
                data = ctypes.string_at(buffer, amount)
                start = api.cursor
                api.content[start:start + amount] = data
                api.cursor = start + amount
                api.full["size"] = len(api.content)
                _Pointer.set(written, amount)
                api.write_calls += 1
                api.events.append(("write", amount, bytes(data)))
                return 1
            return write
        if name == "FlushFileBuffers":
            def flush(handle):
                assert handle is api.handle
                api.flush_calls += 1
                api.events.append(("flush",))
                return 1
            return flush
        if name == "SetFilePointerEx":
            def seek(handle, distance, position, _method):
                assert handle is api.handle
                offset = int(distance)
                api.cursor = offset
                _Pointer.set(position, offset)
                api.seek_calls += 1
                return 1
            return seek
        if name == "ReadFile":
            def read(handle, buffer, amount, count, _overlapped):
                assert handle is api.handle
                data = bytes(api.content[api.cursor:api.cursor + amount])
                if data:
                    ctypes.memmove(buffer, data, len(data))
                api.cursor += len(data)
                _Pointer.set(count, len(data))
                api.read_calls += 1
                api.events.append(("read", len(data), data))
                return 1
            return read
        raise AssertionError("unexpected R6B Win32 function: " + name)

    def hold(self, *_objects):
        return None


def _install_fake_provider(monkeypatch, api, *, descriptor_after_open=None):
    pkg = types.ModuleType("comsol_mcp")
    pkg.__path__ = []
    provider = types.ModuleType("comsol_mcp._host_scoped_provider")
    owner_module = types.ModuleType("comsol_mcp._windows_host_preflight_owner")
    owner = FakeOwner(api)
    finish_calls = []
    descriptor_calls = 0

    def volume(_api, _path):
        return True, api.identity[0]

    def full_getter(_api):
        return lambda _handle, *, directory: [
            tuple(api.full["file_identity"]), api.full["size"], api.full["creation_time"],
            api.full["change_time"], api.full["write_time"], api.full["link_count"],
        ]

    def security(_api):
        return api.owner_sid, frozenset(), None

    def descriptor(_api, _handle, *, directory, require_daemon_owner, daemon_sid, trusted_sids):
        nonlocal descriptor_calls
        assert directory is False and require_daemon_owner is True
        descriptor_calls += 1
        if descriptor_after_open is not None and descriptor_calls >= 2:
            return descriptor_after_open, api.owner_class
        return api.descriptor, api.owner_class

    provider._windows_volume_has_persistent_acls = volume
    provider._windows_original_full_getter = full_getter
    provider._windows_security_context = security
    provider._win32_descriptor_digest = descriptor
    pkg._host_scoped_provider = provider
    owner_module.scalar = lambda value, kind: bool(value) if kind == "BOOL" else (_ for _ in ()).throw(AssertionError(kind))
    monkeypatch.setitem(sys.modules, "comsol_mcp", pkg)
    monkeypatch.setitem(sys.modules, "comsol_mcp._host_scoped_provider", provider)
    monkeypatch.setitem(sys.modules, "comsol_mcp._windows_host_preflight_owner", owner_module)

    def hold_original(_api):
        return owner

    def finish_original(_api, error):
        finish_calls.append(error)
        if error is not None:
            return None

    return owner, finish_calls, hold_original, finish_original


def _prepare_gate(gate, api, monkeypatch, *, descriptor_after_open=None):
    owner, finish_calls, hold_original, finish_original = _install_fake_provider(
        monkeypatch, api, descriptor_after_open=descriptor_after_open,
    )
    gate._runtime_path_binding_api = lambda: (api, hold_original, finish_original)
    gate._runtime_owner_sid_text = lambda _api, _handle: api.owner_sid
    return owner, finish_calls


