def execute_once(*, popen_factory: Callable[..., Any] = subprocess.Popen) -> int:
    payload, binding = read_checked_inputs()
    inv = invocation_binding(payload)
    authority = read_execution_authority(binding, payload)
    if RUN_ROOT.exists() or RUN_ROOT.is_symlink():
        raise RuntimeError("fixed capture run root exists; no replay")
    RUN_ROOT.mkdir(parents=True, exist_ok=False, mode=0o700)
    paths = {name: RUN_ROOT / name for name in OUTPUT_NAMES}
    started = time.monotonic()
    write_exclusive(paths["SSH_LAUNCH_INTENT.json"], canonical({"status": "ONE_READONLY_CAPTURE_SEND_INTENT",
                    **binding, **authority,
                    "permitted_scope": {"approval_metadata_read": True,
                                        "approval_content_read": False,
                                        "remote_once_read": False,
                                        "remote_writes": 0, "native_children": 0},
                    "retry_or_replay": False}))
    paths["SSH_STATE.jsonl"].open("xb").close()
    child = owner = None
    remote_record = None
    status = "UNKNOWN_NO_REPLAY"
    try:
        child = popen_factory(inv["argv"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, shell=False, cwd=str(ROOT), bufsize=0)
        owner = OriginalReadOnlyPopenOwner(child)
        owner.start_drainers(paths["SSH.stdout"], paths["SSH.stderr"])
        append_state(paths["SSH_STATE.jsonl"], "ORIGINAL_POPEN_CREATED", {"pid": owner.pid})
        owner.send_once_then_eof(payload)
        owner.wait_naturally()
        if owner.first_cause:
            status = "UNKNOWN_OWNER_OR_CAPTURE_DIAGNOSTIC_NO_REPLAY"
        elif owner.stdout.total > MAX_STDOUT_BYTES or owner.stderr.total > MAX_STDERR_BYTES:
            status = "FAILED_OUTPUT_CAP_EXCEEDED_NO_REPLAY"
        elif getattr(child, "returncode", None) != 0:
            status = "FAILED_SSH_NONZERO_NO_REPLAY"
        else:
            remote_record = validate_capture_response(read_regular(paths["SSH.stdout"], maximum=MAX_STDOUT_BYTES))
            status = "PASS_READONLY_EMPTY_APPROVAL_PATH_PROOF_CAPTURED"
    except BaseException as exc:
        status = "UNKNOWN_LOCAL_CAPTURE_ERROR_NO_REPLAY" if child is not None else "FAILED_PRE_POPEN_NO_REMOTE_ACTION"
        if owner is not None:
            owner.first_cause = owner.first_cause or (type(exc).__name__ + ":" + str(exc)[:1000])
            owner.wait_naturally()
    terminal = {"status": status, "local_original_popen_pid": getattr(owner, "pid", None),
                "local_original_popen_returncode": getattr(child, "returncode", None),
                "elapsed_seconds": time.monotonic() - started,
                "same_original_popen_natural_terminal": bool(child is not None and child.returncode is not None),
                "payload_send_attempted_once": bool(owner and owner.sent),
                "active_cutoff_exceeded": bool(owner and owner.active_cutoff_exceeded),
                "stdout_bytes": paths["SSH.stdout"].stat().st_size if paths["SSH.stdout"].exists() else 0,
                "stderr_bytes": paths["SSH.stderr"].stat().st_size if paths["SSH.stderr"].exists() else 0,
                "stdout_total_observed": owner.stdout.total if owner and owner.stdout else 0,
                "stderr_total_observed": owner.stderr.total if owner and owner.stderr else 0,
                "first_cause": owner.first_cause if owner else None,
                "remote_status": remote_record.get("status") if remote_record else None,
                "signals_kills_retries_resends": 0, "remote_writes": 0,
                "permitted_approval_metadata_read": True,
                "approval_metadata_read_confirmed_by_response": remote_record is not None,
                "approval_content_read": False, "remote_once_read": False,
                "native_children": 0, "authority": authority}
    write_exclusive(paths["SSH_TERMINAL.json"], canonical(terminal))
    report = {"schema": "cv3-windows-r6i-readonly-capture-ssh-report/1", "status": status,
              "terminal": terminal, "remote": remote_record, "replay": False,
              "remote_writes": 0, "permitted_approval_metadata_read": True,
              "approval_metadata_read_confirmed_by_response": remote_record is not None,
              "approval_content_read": False, "remote_once_read": False, "native_children": 0}
    write_exclusive(paths["LOCAL_READONLY_CAPTURE_REPORT.json"], canonical(report))
    return 0 if status == "PASS_READONLY_EMPTY_APPROVAL_PATH_PROOF_CAPTURED" else 1


def main(argv: list[str] | None = None, popen_factory: Callable[..., Any] = subprocess.Popen) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--check-only"]:
        sys.stdout.write(json.dumps(check_only(), sort_keys=True, separators=(",", ":")) + "\n")
        return 0
    if args == ["--capture-once"]:
        return execute_once(popen_factory=popen_factory)
    raise RuntimeError("use --check-only or a separately authorized --capture-once")


if __name__ == "__main__":
    try:
        code = main()
    except BaseException as exc:
        sys.stderr.write(type(exc).__name__ + ":" + str(exc)[:2000] + "\n")
        code = 2
    raise SystemExit(code)
