class BoundedDrain:
    """Continuously drain one original pipe but retain at most the fixed byte cap."""
    def __init__(self, stream: Any, path: Path, limit: int):
        self.stream, self.path, self.limit = stream, path, limit
        self.total = self.retained = 0
        self.error: str | None = None
        self.thread = threading.Thread(target=self._run, name="r6i-readonly-ssh-output", daemon=True)

    def start(self) -> None:
        self.thread.start()

    def _run(self) -> None:
        try:
            with self.path.open("xb", buffering=0) as out:
                while True:
                    chunk = self.stream.read(64 * 1024)
                    if not chunk:
                        break
                    self.total += len(chunk)
                    keep = chunk[:max(0, self.limit - self.retained)]
                    if keep:
                        out.write(keep)
                        self.retained += len(keep)
                out.flush()
                os.fsync(out.fileno())
        except BaseException as exc:
            self.error = type(exc).__name__ + ":" + str(exc)[:1000]


class OriginalReadOnlyPopenOwner:
    """Single Popen owner: write once, close stdin, passively wait to natural exit."""
    def __init__(self, child: Any):
        self.child = child
        self.pid = getattr(child, "pid", None)
        self.sent = False
        self.active_cutoff_exceeded = False
        self.first_cause: str | None = None
        self.stdout: BoundedDrain | None = None
        self.stderr: BoundedDrain | None = None

    def start_drainers(self, stdout_path: Path, stderr_path: Path) -> None:
        self.stdout = BoundedDrain(self.child.stdout, stdout_path, MAX_STDOUT_BYTES)
        self.stderr = BoundedDrain(self.child.stderr, stderr_path, MAX_STDERR_BYTES)
        self.stdout.start()
        self.stderr.start()

    def send_once_then_eof(self, payload: bytes) -> None:
        if self.sent:
            self.first_cause = "duplicate send refused"
            return
        self.sent = True
        try:
            written = self.child.stdin.write(payload)
            if written != len(payload):
                self.first_cause = "short stdin write; no resend"
            self.child.stdin.flush()
        except BaseException as exc:
            self.first_cause = type(exc).__name__ + ":" + str(exc)[:1000]
        finally:
            try:
                self.child.stdin.close()
            except BaseException as exc:
                if self.first_cause is None:
                    self.first_cause = "stdin EOF close failed:" + type(exc).__name__

    def wait_naturally(self) -> None:
        try:
            self.child.wait(timeout=ACTIVE_CUTOFF_SECONDS)
        except subprocess.TimeoutExpired:
            self.active_cutoff_exceeded = True
            self.child.wait()
        except BaseException as exc:
            self.first_cause = self.first_cause or (type(exc).__name__ + ":" + str(exc)[:1000])
            while getattr(self.child, "returncode", None) is None:
                try:
                    self.child.wait()
                except BaseException:
                    time.sleep(0.05)
        for drain in (self.stdout, self.stderr):
            if drain is not None:
                drain.thread.join()
                if drain.error and self.first_cause is None:
                    self.first_cause = "bounded output drain failed:" + drain.error


def validate_capture_response(raw: bytes) -> dict[str, Any]:
    if len(raw) > MAX_STDOUT_BYTES:
        raise RuntimeError("captured stdout exceeds fixed cap")
    record = strict_json(raw, "remote capture response")
    capture_module, gate = _load_local_capture_and_gate()
    try:
        capture_module.validate_capture_record(record, gate)
    except BaseException as exc:
        raise RuntimeError("remote response violates the exact frozen capture consumer: "
                           + type(exc).__name__ + ":" + str(exc)[:1200]) from exc
    return record


def _load_local_capture_and_gate() -> tuple[types.ModuleType, types.ModuleType]:
    capture_raw = read_regular(CAPTURE_SOURCE, maximum=MAX_STDOUT_BYTES)
    if len(capture_raw) != CAPTURE_SOURCE_BYTES or sha(capture_raw) != CAPTURE_SOURCE_SHA256:
        raise RuntimeError("local frozen capture source differs from the accepted pin")
    capture_module = types.ModuleType("_r6i_empty_approval_capture_consumer")
    capture_module.__file__ = str(CAPTURE_SOURCE)
    capture_module.__package__ = ""
    exec(compile(capture_raw.decode("utf-8", "strict"), str(CAPTURE_SOURCE), "exec"),
         capture_module.__dict__)
    raw = read_regular(R6I_GATE_PATH, maximum=2 * 1024 * 1024)
    if sha(raw) != R6I_GATE_SHA256:
        raise RuntimeError("local frozen R6I gate source differs from the accepted pin")
    module = types.ModuleType("_r6i_empty_approval_response_gate")
    module.__file__ = str(R6I_GATE_PATH)
    module.__package__ = ""
    exec(compile(raw.decode("utf-8", "strict"), str(R6I_GATE_PATH), "exec"), module.__dict__)
    if getattr(module, "APPROVAL_PATH", None) != REMOTE_TARGET:
        raise RuntimeError("local frozen gate does not bind the exact approval path")
    return capture_module, module


def append_state(path: Path, status: str, details: dict[str, Any]) -> None:
    with path.open("ab", buffering=0) as stream:
        stream.write(json.dumps({"status": status, "time_monotonic": time.monotonic(), **details},
                                sort_keys=True, ensure_ascii=False, allow_nan=False).encode() + b"\n")
        os.fsync(stream.fileno())


def write_exclusive(path: Path, raw: bytes) -> None:
    with path.open("xb") as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())


