def sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def canonical(value: Any) -> bytes:
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False,
                       allow_nan=False) + "\n").encode("utf-8")


def strict_json(raw: bytes, label: str) -> dict[str, Any]:
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out:
                raise ValueError("duplicate JSON key " + key)
            out[key] = value
        return out
    value = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=pairs,
                       parse_constant=lambda item: (_ for _ in ()).throw(ValueError(item)))
    if not isinstance(value, dict):
        raise RuntimeError(label + " must be a JSON object")
    return value


def read_regular(path: Path, *, maximum: int) -> bytes:
    before_name = os.lstat(path)
    if path.is_symlink() or not path.is_file() or before_name.st_size < 0 or before_name.st_size > maximum:
        raise RuntimeError("bounded ordinary file required: " + str(path))
    with path.open("rb", buffering=0) as stream:
        before = os.fstat(stream.fileno())
        raw = stream.read(maximum + 1)
        after = os.fstat(stream.fileno())
    after_name = os.lstat(path)
    sig = lambda row: (row.st_dev, row.st_ino, row.st_size, row.st_mtime_ns, row.st_ctime_ns)
    if (len(raw) > maximum or len(raw) != after.st_size or sig(before) != sig(after)
            or sig(before_name) != sig(after_name)):
        raise RuntimeError("file changed during bounded stable read: " + str(path))
    return raw


