#!/usr/bin/env python3
"""A fresh bounded acceptance activity through the normal public MCP transport.

This is a thin client of the production entry points. It never injects an
ExecutionService/Worker, starts a solver, adopts an old process, or derives
termination authority from persisted PIDs. The production daemon owns its
Server/Worker Popen objects; this client retains its own daemon Popen object.
"""
from __future__ import annotations

import argparse
import asyncio
import csv
import io
from datetime import timedelta, datetime, timezone
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import time
from uuid import uuid4
sys.path.insert(0, str(Path(__file__).resolve().parent))
from p0_original_controller_hold import publish_hold, retain_original_controller


def write(path: Path, value) -> None:
    path.write_text(json.dumps(value, ensure_ascii=False, sort_keys=True,
                               indent=2, allow_nan=False) + "\n", encoding="utf-8")


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def verify_artifact(workspace: Path, data: dict, *, exported=False) -> Path:
    relative = data["destination"] if exported else data["path"]
    lexical = Path(relative)
    if lexical.is_absolute() or ".." in lexical.parts:
        raise RuntimeError("artifact path is not project relative")
    path = workspace / lexical
    if path.is_symlink() or not path.resolve(strict=True).is_relative_to(workspace.resolve(strict=True)):
        raise RuntimeError("artifact escapes owned workspace")
    sha = digest(path)
    size = data["size_bytes"] if exported else data["size"]
    if sha != data["sha256"] or sha != data["artifact_id"] or path.stat().st_size != size:
        raise RuntimeError("actual artifact bytes differ from registered SHA/size")
    return path


def changed_csv(raw: str) -> str:
    from comsol_mcp._g3_parameter_io import CSV_HEADER
    stream = io.StringIO(raw, newline="")
    reader = csv.DictReader(stream)
    rows = list(reader)
    if tuple(reader.fieldnames or []) != CSV_HEADER or len(rows) != 1 or rows[0]["name"] != "v3_marker":
        raise RuntimeError("CSV export is not the exact single-marker table")
    rows[0]["expression"] = "5.5[mm]"
    rows[0]["description"] = "V3 CSV modified, quoted roundtrip"
    output = io.StringIO(newline="")
    writer = csv.DictWriter(output, fieldnames=CSV_HEADER, quoting=csv.QUOTE_ALL, lineterminator="\n")
    writer.writeheader()
    writer.writerows(rows)
    return output.getvalue()


def verify_parameter(value: dict, expression: str, description: str, evaluated: float) -> dict:
    rows = value["data"]["parameters"]
    if (len(rows) != 1 or rows[0].get("name") != "v3_marker"
            or rows[0].get("expression") != expression or rows[0].get("description") != description
            or rows[0].get("unit") != "m" or rows[0].get("unit_error") is not None
            or rows[0].get("evaluate_errors") is not None
            or rows[0].get("evaluated", {}).get("data") != evaluated):
        raise RuntimeError("native parameter expression/description/unit/value differs")
    return rows[0]


def verify_runtime_producer(value: dict, attached: dict, runtime_id: str, ref: dict,
                            source_sha: str, expression: str, evaluated: float) -> dict:
    observation = value["execution"].get("runtime_observation", {})
    identity = observation.get("runtime_identity", {})
    expected = {"runtime_id": runtime_id, "worker_instance_id": attached["worker_instance_id"],
                "connection_epoch": attached["worker_epoch"], "server_instance_id": attached["server_instance_id"],
                "endpoint": attached["endpoint"]["host"] + ":" + str(attached["endpoint"]["port"])}
    if (observation.get("status") != "OBSERVED" or observation.get("schema") != "comsol-worker-runtime-observation/v1"
            or observation.get("installation_runtime_id") != runtime_id
            or not isinstance(observation.get("comsol_version"), str)
            or any(identity.get(k) != v or type(identity.get(k)) is not type(v) for k, v in expected.items())
            or value["execution"].get("model_ref") != ref
            or value["data"].get("source_sha256") != source_sha):
        raise RuntimeError("code producer did not return the exact owned observed runtime")
    java = value["data"]["readback"].get("readback", {})
    if java != {"name": "v3_marker", "expression": expression, "value": evaluated, "unit": "m"}:
        raise RuntimeError("read-only Java parameter return differs")
    return observation


def public_arguments(operation: str, supplied: dict, request_id: str) -> dict:
    body = dict(supplied)
    if operation in {"model.package", "model.rebuild_target", "study.run"}:
        identity = {"project_id", "session_id", "model_ref", "expected_revision", "idempotency_key", "request_id"}
        return {name: value for name, value in body.items() if name not in identity}
    if operation != "model.inspect":
        body.setdefault("request_id", request_id)
    if "idempotency_key" in body:
        body["idempotency_key"] = request_id
    return body


def source_identity(source: Path, freeze: dict, *, require_commit=False) -> dict:
    paths = {p.relative_to(source).as_posix() for p in (source / "comsol_mcp").rglob("*")
             if p.is_file() and "__pycache__" not in p.parts}
    if paths != set(freeze["files"]):
        raise RuntimeError("production source snapshot file set differs")
    for rel, expected in freeze["files"].items():
        if (source / rel).is_symlink() or digest(source / rel) != expected:
            raise RuntimeError("production source snapshot differs: " + rel)
    commit = freeze.get("source_commit")
    if require_commit and commit != "65ced71e9d63c56e6b6009984ae5c4185f4be3bd":
        raise RuntimeError("installed mode requires the exact reviewed source commit")
    if commit is not None and (not isinstance(commit,str) or len(commit)!=40 or any(c not in "0123456789abcdef" for c in commit)):
        raise RuntimeError("source freeze commit is malformed")
    return {"source_commit": commit, "source_scope": freeze.get("scope"),
            "uncommitted_source_delta": freeze.get("uncommitted_source_delta", []), "files": len(paths),
            "sha256": hashlib.sha256(json.dumps(freeze["files"], sort_keys=True,
                                                 separators=(",", ":")).encode()).hexdigest()}


async def run(args) -> int:
    science = bool(getattr(args, "science_recipes", False))
    execution_mode = getattr(args,"execution_mode","source")
    if execution_mode not in {"source","installed-current175-r13"}:
        raise RuntimeError("finite execution mode required")
    cost = bool(getattr(args, "checkpoint_cost_cycle", False))
    thermal = bool(getattr(args, "thermal_benchmark", False))
    if thermal and any((science,cost,args.package_cycle,args.parameter_io,args.parameter_csv,args.runtime_observation)):
        raise RuntimeError("T044 thermal benchmark has a separate fixed two-study budget")
    if cost and any((science,args.package_cycle,args.parameter_io,args.parameter_csv,args.runtime_observation)):
        raise RuntimeError("T050 cost cycle has a separate fixed budget and cannot combine modes")
    if science and any((args.package_cycle,args.parameter_io,args.parameter_csv,args.runtime_observation)):
        raise RuntimeError("science recipes have a separate closed zero-solve budget")
    if args.package_cycle and (args.parameter_io or args.parameter_csv or args.runtime_observation):
        raise RuntimeError("package cycle has its own frozen budget and cannot be combined with other optional modes")

    source = args.source.resolve(strict=True)
    freeze = json.loads(args.freeze.read_text(encoding="utf-8"))
    before = source_identity(source, freeze,require_commit=execution_mode=="installed-current175-r13")
    installed_profile = None
    if execution_mode=="installed-current175-r13":
        if not args.installed_profile or not args.installed_profile_sha256 or not args.installed_venv or not args.source_freeze_sha256:
            raise RuntimeError("installed mode requires bound profile, freeze SHA and venv")
        import science_native_once_entry as source_entry
        if Path(source_entry.__file__).resolve()!=Path(__file__).resolve().with_name("science_native_once_entry.py"):
            raise RuntimeError("installed-profile validator origin differs")
        freeze_raw,_=source_entry.read_file(args.freeze)
        if hashlib.sha256(freeze_raw).hexdigest()!=args.source_freeze_sha256:
            raise RuntimeError("installed mode source freeze bytes differ")
        freeze=source_entry._strict_json_bytes(freeze_raw)
        before=source_identity(source,freeze,require_commit=True)
        installed_profile=source_entry.verify_installed_profile(args.installed_profile,args.installed_profile_sha256,
            source,freeze,expected_venv=args.installed_venv,source_freeze_sha256=args.source_freeze_sha256)
    from mcp import ClientSession, StdioServerParameters
    from mcp.client.stdio import stdio_client
    import psutil
    science_module = science_plan = None
    if science:
        import science_recipe_cycle as science_module
        fixed_helper = Path(__file__).resolve().with_name("science_recipe_cycle.py")
        if Path(science_module.__file__).resolve() != fixed_helper:
            raise RuntimeError("fixed science helper import origin differs")
        science_plan = science_module.validate_plan(args.science_plan, args.science_plan_sha256,
            source=source, runtime=args.runtime, installation=args.installation, java_home=args.java_home)
        for relative in ("tools/run_v3_public_mcp_smoke.py", "tools/science_recipe_cycle.py", "tools/p0_owned_control_entry.py", "tools/p0_original_controller_hold.py"):
            actual=Path(__file__).resolve().parent / Path(relative).name
            if digest(actual)!=science_plan["files"][relative]:raise RuntimeError("actual fixed helper/owner import bytes differ from source closure")
    fixture = Path(__file__).resolve().parent / ("java/T044ThermalFixture.java" if thermal else ("java/T050CostModelFixture.java" if cost else ("java/P0ExportJava.java" if args.package_cycle else "java/P0ParameterReadback.java")))
    fixture_bytes = fixture.read_bytes() if args.runtime_observation or args.package_cycle or cost or thermal else None
    fixture_sha = hashlib.sha256(fixture_bytes).hexdigest() if fixture_bytes is not None else None
    package_helper = Path(__file__).resolve().parent / "p0_package_cycle.py"
    package_helper_sha = digest(package_helper) if args.package_cycle else None
    cost_helper = Path(__file__).resolve().parent / "t050_checkpoint_cost_cycle.py"
    cost_helper_sha = digest(cost_helper) if cost else None
    thermal_helper = Path(__file__).resolve().parent / "t044_thermal_benchmark.py"
    thermal_helper_sha = digest(thermal_helper) if thermal else None
    # A caller selects a new activity namespace, never an old fixed entry.
    root = args.runtime.absolute()
    if root.exists() or root.is_symlink() or root.parent.resolve() != Path("/private/tmp"):
        raise RuntimeError("native activity requires a fresh direct /private/tmp directory")
    root.mkdir(mode=0o700)
    home, project_root, evidence = root / "home", root / "workspaces", root / "evidence"
    for path in (home, project_root, evidence, home / "control-private"):
        path.mkdir(mode=0o700)
        if path.stat().st_uid != os.getuid() or path.stat().st_mode & 0o077:
            raise RuntimeError("activity directory ownership or mode is not private")
    started = time.monotonic()
    action_seconds = 510 if thermal else (2160 if science else (600 if cost else (300 if args.package_cycle else 180)))
    cleanup_seconds = 240 if science else 90
    public_call_budget = 30 if thermal else (science_plan["budget"]["public_calls"] if science else (33 if cost else (37 if args.package_cycle else 24)))
    summary = {"schema": "V3_PUBLIC_MCP_NATIVE_SMOKE_V1", "activity_id": root.name,
               "created_at": datetime.now(timezone.utc).isoformat(), "status": "RUNNING",
               "source": before, "runtime": str(root), "calls": [],
               "budget": {"action_seconds": action_seconds, "cleanup_seconds": cleanup_seconds,
                          "public_calls": public_call_budget, "servers": 1, "workers": 1,
                          "explicit_study_or_solver_calls": 2 if thermal else 0, "gui_calls": 0},
               "science_acceptance": "NOT_RUN", "release_acceptance": "NOT_RUN",
               "execution_mode":execution_mode,
               "original_unknown_replay": False}
    if installed_profile is not None:
        summary["installed_package_profile"]={"profile":installed_profile["profile"],
            "venv_root":installed_profile["venv_root"],"profile_sha256":args.installed_profile_sha256,
            "package_files":len(installed_profile["package_files"]),
            "distributions":len(installed_profile["distributions"])}
    harness_hash = digest(Path(__file__).resolve())
    summary["harness_sha256"] = harness_hash
    summary["optional_modes"] = {"csv": args.parameter_csv, "runtime_observation": args.runtime_observation,
                                 "package_cycle": args.package_cycle,
                                 "java_source_sha256": fixture_sha, "package_helper_sha256": package_helper_sha,
                                 "checkpoint_cost_cycle": cost, "cost_helper_sha256": cost_helper_sha}
    if thermal:
        summary["optional_modes"].update(thermal_benchmark=True, thermal_helper_sha256=thermal_helper_sha)
        summary["budget"].update(max_owned_models=2, birth_including_cleanup_seconds=600,
                                additional_protocol_initialize_list_tools_calls=2)
    if cost:
        summary["budget"].update(max_owned_models=2, sampled_workspace_byte_cap=256*1024*1024,
            additional_protocol_initialize_list_tools_calls=2, sampled_disk_cap_not_OS_quota=True)
    if science:
        summary["budget"].update(science_plan["budget"])
        summary["science_literal_plan_sha256"] = args.science_plan_sha256
    summary_path = evidence / "SUMMARY.json"
    write(summary_path, summary)
    install = args.installation.resolve(strict=True)
    xml = install / "bin/servers/webbridge/conf/server.xml"
    installed_hash = digest(xml)
    protected = {str(p.resolve()): digest(p) for p in args.protected_state}
    fresh_processes = []
    for process in psutil.process_iter(["pid", "name", "create_time"]):
        name = process.info.get("name") or ""
        if "comsol" in name.lower() or name.lower() in {"java", "java.exe"}:
            fresh_processes.append(process.info)
    write(evidence / "PREBIRTH.json", {"source": before, "existing_comsol_java": fresh_processes,
                                      "installed_server_xml_sha256": installed_hash,
                                      "protected_state_sha256": protected})
    # Never start another native activity while one of these runtimes may exist.
    if fresh_processes:
        summary.update(status="BLOCKED", reason="existing native processes need ownership inspection")
        write(summary_path, summary)
        return 2
    env = {k: v for k, v in os.environ.items()
           if not k.startswith("COMSOL_") and k not in {"PYTHONPATH","PYTHONHOME"}}
    env.update(COMSOL_ROOT=str(install), COMSOL_JAVA_HOME=str(args.java_home.resolve(strict=True)),
               COMSOL_SERVER_MCP_HOME=str(home), COMSOL_PROJECT_ROOT=str(project_root),
               COMSOL_MCP_HOST_CONTROL="1", COMSOL_MCP_TOOL_PROFILE="full",
               COMSOL_MCP_ISOLATION_RECEIPT=str(root / "isolation.json"),
               PYTHONDONTWRITEBYTECODE="1", TMPDIR=str(root))
    if execution_mode=="source":
        env["PYTHONPATH"]=str(source)
    if args.runtime_observation or args.package_cycle or science or cost or thermal:
        env["COMSOL_MCP_TRUSTED_CODE"] = "1"
    owner_entry = Path(__file__).resolve().parent / "p0_owned_control_entry.py"
    owner_helper = Path(__file__).resolve().parent / "p0_original_controller_hold.py"
    owner_binding = {"activity_id": root.name, "namespace": str(root), "source_sha256": before["sha256"],
        "harness_sha256": harness_hash, "entry_sha256": digest(owner_entry),
        "holder_sha256": digest(owner_helper), "owner_nonce": str(uuid4())}
    if installed_profile is not None:
        owner_binding.update(execution_mode=execution_mode,installed_profile_sha256=args.installed_profile_sha256,
                             source_freeze_sha256=args.source_freeze_sha256)
    owner_config = root / "P0_OWNER_CONFIG.json"
    with owner_config.open("x", encoding="utf-8") as handle:
        os.chmod(owner_config, 0o600)
        owner_config_value={"binding": owner_binding, "source": str(source), "freeze": str(args.freeze.resolve()),
                   "home": str(home / "control-private")}
        if installed_profile is not None:
            owner_config_value.update(execution_mode=execution_mode,installed_profile=str(args.installed_profile),
                installed_profile_sha256=args.installed_profile_sha256,installed_venv=str(args.installed_venv),
                source_freeze_sha256=args.source_freeze_sha256)
        json.dump(owner_config_value, handle, allow_nan=False)
    command = ([sys.executable,"-I","-B",str(owner_entry), "--config", str(owner_config)]
               if installed_profile is not None else [sys.executable, str(owner_entry), "--config", str(owner_config)])
    summary["controller_exact_argv"] = command
    summary["owner_binding"] = owner_binding
    log = (evidence / "control.stdout.log").open("ab", buffering=0)
    controller = subprocess.Popen(command, cwd=(home/"control-private" if installed_profile is not None else source), env=env, stdin=subprocess.DEVNULL,
                                  stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    # Popen is retained before diagnostic observations can fail.
    summary["controller"] = {"pid": controller.pid, "original_popen_retained": True}
    project_id = session_id = model_ref = None
    runtime_id = endpoint = None
    server_started = connected = stopped = uncertain = False
    firstcause = None
    science_cleanup = []
    def failure(exc):
        nonlocal firstcause
        if firstcause is None:
            firstcause = exc
            summary.update(status="FAIL", failure_type=type(exc).__name__, failure=science_module.safe_text(exc) if science else str(exc))
        else:
            summary.setdefault("secondary_failures", []).append({"type": type(exc).__name__, "error": science_module.safe_text(exc) if science else str(exc)})
    def notify_hold():
        try:
            publish_hold(root, owner_binding, firstcause or RuntimeError("public cleanup not confirmed"))
        except FileExistsError:
            pass
        except BaseException as exc:
            summary.setdefault("hold_diagnostics", []).append({"type": type(exc).__name__, "error": science_module.safe_text(exc) if science else str(exc)})
    native_pids: list[int] = []
    endpoint_file = home / "control-private/control.json"
    try:
        summary["controller"]["create_time"] = psutil.Process(controller.pid).create_time()
        write(summary_path, summary)
        deadline = time.monotonic() + 15
        while not endpoint_file.is_file():
            if controller.poll() is not None or time.monotonic() > deadline:
                raise RuntimeError("original control daemon did not publish an endpoint")
            await asyncio.sleep(0.05)
        ep = json.loads(endpoint_file.read_text())
        if ep.get("pid") != controller.pid:
            raise RuntimeError("control endpoint differs from original daemon Popen")
        transport_log = (evidence / "mcp.stderr.log").open("w", encoding="utf-8")
        parameters = StdioServerParameters(command=sys.executable,
                    args=(["-I","-B","-m","comsol_mcp.mcp_server"] if installed_profile is not None
                          else ["-m", "comsol_mcp.mcp_server"]),
                    cwd=str(home/"control-private" if installed_profile is not None else source), env=env)
        async with stdio_client(parameters, errlog=transport_log) as (read, output):
            async with ClientSession(read, output, read_timeout_seconds=timedelta(seconds=science_plan["budget"]["transport_read_timeout_seconds"] if science else 80)) as client:
                await client.initialize()
                tools = await client.list_tools()
                write(evidence / "MCP_TOOLS.json", tools.model_dump(mode="json"))
                if "operation_call" not in {item.name for item in tools.tools}:
                    raise RuntimeError("normal MCP transport does not advertise operation_call")

                async def call(operation: str, body: dict, *, ref=None, revision=None, cleanup=False) -> dict:
                    nonlocal uncertain
                    if uncertain:
                        raise RuntimeError("P0 uncertain outcome prohibits every next public operation")
                    cap = action_seconds + cleanup_seconds if cleanup else action_seconds
                    remaining = started + cap - time.monotonic()
                    if remaining <= 1 or len(summary["calls"]) >= public_call_budget:
                        raise TimeoutError("activity public-call/time budget exhausted")
                    if science:
                        index = len(summary["calls"])
                        science_module.check_closure(source, science_plan)
                        science_module.check_call_order(science_plan,index,operation,cleanup=cleanup,
                            cleanup_history=science_cleanup,connected=connected)
                        bindings={'$PROJECT_ID':project_id,'$SESSION_ID':session_id,'$RUNTIME_ID':runtime_id if index else None,
                                  '$ENDPOINT':endpoint if server_started else None}
                        if cleanup:
                            slot=next(slot for slot in science_plan['literal_cleanup_calls'] if slot['operation']==operation)
                            science_module.check_literal_body(slot,body,bindings)
                            science_cleanup.append(operation)
                        elif index<len(science_plan['literal_base_calls']):
                            science_module.check_literal_body(science_plan['literal_base_calls'][index],body,bindings)
                    key = root.name + "-" + str(len(summary["calls"])) + "-" + uuid4().hex
                    execution = {"request_id": key, "idempotency_key": key,
                                 "rpc_timeout_s": min(60, remaining - 1),
                                 "queue_timeout_s": 15, "execution_timeout_s": min(120, remaining - 1)}
                    if science:execution.update(science_module.execution_timeouts(remaining))
                    if project_id is not None:
                        execution["project_id"] = project_id
                    if session_id is not None:
                        execution["session_id"] = session_id
                    if ref is not None:
                        execution["model_ref"] = ref
                    if revision is not None:
                        execution["expected_revision"] = revision
                    # Transport envelope and catalog body have the same request identity.
                    body = public_arguments(operation, body, key)
                    record = {"operation": operation, "request_id": key, "state": "SUBMITTED"}
                    summary["calls"].append(record)
                    write(summary_path, summary)
                    result = await client.call_tool("operation_call", {"operation_id": operation,
                                      "arguments": body, "execution": execution})
                    write(evidence / (str(len(summary["calls"])) + "-" + operation + ".json"), result.model_dump(mode="json"))
                    value = result.structuredContent
                    if not isinstance(value, dict):
                        uncertain = True
                        raise RuntimeError("MCP structured business result unavailable")
                    record.update(state="OBSERVED", success=value.get("success"),
                                  isError=result.isError, execution=value.get("execution"),
                                  error=value.get("error"))
                    if value.get("data", {}).get("status") in {"RUNNING", "PENDING", "UNKNOWN"}:
                        uncertain = True
                        raise RuntimeError(operation + " has no observed terminal public result")
                    if value.get("success") is not True or result.isError:
                        error = value.get("error", {})
                        uncertain = uncertain or "UNKNOWN" in str(error) or value.get("data", {}).get("status") in {"RUNNING", "PENDING", "UNKNOWN"}
                        write(summary_path, summary)
                        raise RuntimeError(operation + " refused: " + str(error))
                    write(summary_path, summary)
                    return value

                try:
                    runtime = await call("runtime.discover", {"roots": [str(install)]})
                    installations = runtime["data"].get("installations", [])
                    if len(installations) != 1:
                        raise RuntimeError("one exact installation was not discovered")
                    runtime_id = installations[0]["runtime_id"]
                    await call("runtime.inspect", {"runtime_id": runtime_id})
                    created = await call("project.create", {"label": root.name, "workspace": "native-smoke",
                               "policy": {"permissions": ["inspect", "project_write", "compute", "host_control"] + (["trusted_code"] if args.runtime_observation or args.package_cycle or science or cost or thermal else [])}, "idempotency_key": "new"})
                    project_id = created["data"]["project"]["project_id"]
                    workspace = Path(created["data"]["project"]["workspace"]).resolve(strict=True)
                    if not workspace.is_relative_to(project_root.resolve()):
                        raise RuntimeError("public project workspace is outside fresh activity root")
                    launched = await call("session.start", {"project_id": project_id, "runtime_id": runtime_id, "idempotency_key": "new"})
                    server_started = True
                    session_id = launched["data"]["session_id"]
                    endpoint = launched["data"]["endpoint"]
                    server_pid = launched["data"]["server_process_identity"]["pid"]
                    native_pids.append(server_pid)
                    # Read-only host evidence, independently rechecked by the production
                    # mutation gate. A receipt conveys no process termination authority.
                    sys.path.insert(0, str(source))
                    from comsol_mcp._g2_isolation import _process_snapshot, verify_owned_server
                    observed = _process_snapshot(server_pid)
                    if observed is None:
                        raise RuntimeError("fresh owned Server process observation unavailable")
                    write(root / "isolation.json", {"status": "RUNNING", "process": {**observed, "port": endpoint["port"]}})
                    verify_owned_server(root / "isolation.json", endpoint="127.0.0.1:" + str(endpoint["port"]))
                    attached = await call("session.connect", {"project_id": project_id, "session_id": session_id,
                                "runtime_id": runtime_id, "endpoint": endpoint, "idempotency_key": "new"})
                    connected = True
                    summary["actual_attach"] = attached["data"]
                    health = await call("session.health", {"project_id": project_id, "session_id": session_id})
                    summary["health"] = health["data"]
                    model = await call("model.create", {"project_id": project_id, "session_id": session_id,
                                "label": "science-W22-witness" if science else "v3-native-smoke", **({} if science else {"dimension": 2}), "idempotency_key": "new"})
                    model_ref = model["data"]["model_ref"]
                    revision = model["execution"]["revision"]
                    common = {"project_id": project_id, "session_id": session_id, "model_ref": model_ref}
                    if thermal:
