{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COMSOL MCP proposed ActionResult 1.0",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_type": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision_before": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "revision_after": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "QUEUED",
        "STARTING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "UNKNOWN",
        "RECONCILING",
        "BLOCKED"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "description": "Each released action MUST specialize this field with a domain-specific schema."
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Artifact"
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "readback": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unknown",
            "not_applicable"
          ]
        },
        "numerical_acceptance": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unknown",
            "not_applicable"
          ]
        },
        "physical_validation": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unknown",
            "not_applicable"
          ]
        }
      },
      "required": [
        "readback",
        "physical_validation"
      ],
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "properties": {
        "queue_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "engine_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "queue_s",
        "engine_s",
        "total_s"
      ],
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ]
    }
  },
  "required": [
    "ok",
    "operation_id",
    "status",
    "data",
    "changes",
    "warnings",
    "artifacts",
    "verification",
    "timings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAILED",
              "BLOCKED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "Artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "enum": [
            "COMSOL_ENGINE",
            "USER_INPUT",
            "MODEL_GENERATED_CODE",
            "CONTROL_REPORT",
            "EXTERNAL_ANALYSIS"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [
        "artifact_id",
        "name",
        "media_type",
        "sha256",
        "bytes",
        "origin"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "partial_changes": {
          "type": "boolean"
        },
        "safe_to_retry": {
          "type": "boolean"
        },
        "engine_state": {
          "enum": [
            "IDLE",
            "BUSY",
            "UNKNOWN",
            "STOPPED"
          ]
        },
        "log_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggested_next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "phase",
        "message",
        "partial_changes",
        "safe_to_retry",
        "engine_state"
      ],
      "additionalProperties": false
    }
  }
}