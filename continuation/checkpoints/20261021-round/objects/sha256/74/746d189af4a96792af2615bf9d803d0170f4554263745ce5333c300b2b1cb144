def compare_refinements(coarse: Mapping[str, Any], fine: Mapping[str, Any]) -> dict[str, Any]:
    if coarse.get("sample_count") != 641 or fine.get("sample_count") != 1281:
        raise ObservationError("quadrature comparison must use the exact 641 then 1281 saved-MPH grids")
    metrics: dict[str, Any] = {}
    for basis in ("signal", "BMA_mode"):
        for observable in ("global_plus_x_power", "outward_n_dot_S"):
            a = _finite(coarse[observable][basis], f"coarse {observable}.{basis}")
            b = _finite(fine[observable][basis], f"fine {observable}.{basis}")
            denom = max(abs(b), 1e-30)
            relative = abs(a - b) / denom
            metrics[f"{observable}.{basis}"] = {
                "coarse": a, "fine": b, "relative_difference": relative,
                "within_frozen_1e-3": relative <= RELATIVE_TOLERANCE,
            }
    return {"status": "DIAGNOSTIC_ONLY_NO_ACCEPTANCE_CHANGE", "method": "composite Simpson",
            "relative_tolerance": RELATIVE_TOLERANCE, "metrics": metrics,
            "native_scientific_acceptance": "NOT_EVALUATED"}


def validate_native_integral_receipt(response: Mapping[str, Any], slot: Mapping[str, Any], *,
                                     terminal_pair_proof: Mapping[str, Any],
                                     selection_before: Mapping[str, Any],
                                     selection_after: Mapping[str, Any]) -> dict[str, Any]:
    """Validate one raw public result.evaluate response without rewriting it."""
    validate_terminal_operation_job_pair(
        response, terminal_pair_proof, expected_operation="result.evaluate")
    execution = response.get("execution")
    data = response.get("data")
    if not isinstance(data, Mapping):
        raise ObservationError("native integral public response has no data object")
    if (data.get("aggregate") != "integral" or data.get("complex_mode") != "real"
            or data.get("dataset") != slot.get("dataset_tag_observed")
            or data.get("solution") != slot.get("solution_tag_observed")
            or data.get("expressions") != slot.get("expressions")):
        raise ObservationError("native integral response changed aggregate, solution, or expression identity")
    expected_units = dict(zip(slot["expressions"], slot["requested_units"]))
    if data.get("expression_units") != expected_units:
        raise ObservationError("native integral expression-unit readback differs from the exact W/m request")
    status = data.get("status")
    if not isinstance(status, Mapping) or status.get("ok") is not True or status.get("cleanup_failed") is not False:
        raise ObservationError("native integral response did not report successful engine and cleanup status")
    cleanup = data.get("cleanup")
    if (not isinstance(cleanup, Mapping) or cleanup.get("created") is not True
            or cleanup.get("removed") is not True or cleanup.get("verified_removed") is not True
            or cleanup.get("cleanup_failed") is not False):
        raise ObservationError("native integral primary temporary feature lacks verified cleanup")
    children = cleanup.get("children")
    if not isinstance(children, list):
        raise ObservationError("native integral cleanup child inventory is unavailable")
    for index, row in enumerate(children):
        if not isinstance(row, Mapping):
            raise ObservationError(f"native integral cleanup child {index} is malformed")
        if row.get("created") is True and (
                row.get("removed") is not True or row.get("verified_removed") is not True
                or row.get("cleanup_failed") is not False):
            raise ObservationError(f"native integral cleanup child {index} was not verified removed")
    field_array = data.get("field_array")
    if (not isinstance(field_array, Mapping)
            or field_array.get("axes") != ["expression", "outer", "inner", "point"]
            or field_array.get("shape") != [4, 1, 1, 1]
            or field_array.get("is_complex") is not False):
        raise ObservationError("native integral must preserve a singleton four-expression real FieldArray")
    values = field_array.get("values")
    if values != data.get("values") or not isinstance(values, list) or len(values) != 4:
        raise ObservationError("native integral FieldArray and top-level values differ or have a wrong expression axis")
    scalars: list[float] = []
    for index, row in enumerate(values):
        if (not isinstance(row, list) or len(row) != 1 or not isinstance(row[0], list)
                or len(row[0]) != 1 or not isinstance(row[0][0], list) or len(row[0][0]) != 1):
            raise ObservationError(f"native integral expression {index} is not bound to one solution tuple")
        scalars.append(_finite(row[0][0][0], f"native integral expression {index}"))
    if (not isinstance(selection_before, Mapping) or not isinstance(selection_after, Mapping)
            or selection_before != selection_after
            or selection_before.get("component") != slot["selection"]["component"]
            or selection_before.get("tag") != slot["selection"]["tag"]
            or selection_before.get("entity_dimension") != PORT_BOUNDARY_DIMENSION
            or selection_before.get("dimension") != PORT_BOUNDARY_DIMENSION
            or selection_before.get("geometry") != slot["selection"]["geometry"]
            or selection_before.get("is_inheriting") is not False
            or selection_before.get("entities") != slot["selection"].get("actual_entity_ids")):
        raise ObservationError("native integral before/after selection identity or entity set changed")
    labels = slot["expression_labels"]
    return {
        "status": "PASS_NATIVE_SIGNED_INTEGRAL_RECEIPT_SHAPE_AND_CLEANUP",
        "role": slot["role"], "port_name_observed": slot["port_name_observed"],
        "dataset_observed": slot["dataset_tag_observed"],
        "solution_observed": slot["solution_tag_observed"],
        "geometry_dimension_observed": slot["geometry_dimension_observed"],
        "boundary_dimension_observed": PORT_BOUNDARY_DIMENSION,
        "selection_entities_observed": list(selection_before["entities"]),
        "signed_integrals_W_per_m": dict(zip(labels, scalars)),
        "raw_response_sha256": _sha_json(response),
        "raw_response_preserved": True,
        "cleanup_verified": True,
        "scientific_acceptance": "NOT_EVALUATED",
    }


def compare_native_integral_to_quadrature(native: Mapping[str, Any],
                                          coarse: Mapping[str, Any],
                                          fine: Mapping[str, Any]) -> dict[str, Any]:
    """Compare actual signed native totals with both independent field grids."""
    if (coarse.get("sample_count") != 641 or fine.get("sample_count") != 1281
            or coarse.get("port_name_observed") != native.get("port_name_observed")
            or fine.get("port_name_observed") != native.get("port_name_observed")
            or coarse.get("dataset_observed") != native.get("dataset_observed")
            or fine.get("dataset_observed") != native.get("dataset_observed")
            or coarse.get("solution_observed") != native.get("solution_observed")
            or fine.get("solution_observed") != native.get("solution_observed")):
        raise ObservationError("native integral and 641/1281 field grids do not share exact role/solution bindings")
    values = native.get("signed_integrals_W_per_m")
    if not isinstance(values, Mapping):
        raise ObservationError("native signed integral values are absent")
    comparisons: dict[str, Any] = {}
    for label, quadrature_key, basis in (
        ("signal_global_plus_x", "global_plus_x_power", "signal"),
        ("signal_outward_n_dot_S", "outward_n_dot_S", "signal"),
        ("BMA_mode_global_plus_x", "global_plus_x_power", "BMA_mode"),
        ("BMA_mode_outward_n_dot_S", "outward_n_dot_S", "BMA_mode"),
    ):
        native_value = _finite(values.get(label), f"native {label}")
        coarse_value = _finite(coarse[quadrature_key][basis], f"641 {label}")
        fine_value = _finite(fine[quadrature_key][basis], f"1281 {label}")
        denom_coarse = max(abs(coarse_value), 1e-30)
        denom_fine = max(abs(fine_value), 1e-30)
        comparisons[label] = {
            "native_W_per_m": native_value,
            "quadrature_641_W_per_m": coarse_value,
            "quadrature_1281_W_per_m": fine_value,
            "relative_difference_vs_641": abs(native_value - coarse_value) / denom_coarse,
            "relative_difference_vs_1281": abs(native_value - fine_value) / denom_fine,
            "signed_values_preserved": True,
        }
    return {"status": "DIAGNOSTIC_NATIVE_VS_OFFLINE_QUADRATURE_NO_ACCEPTANCE_CHANGE",
            "method": "result.evaluate aggregate=integral compared with composite-Simpson 641/1281 E/H reads",
            "metrics": comparisons, "no_absolute_value_or_forced_sign": True,
            "scientific_acceptance": "NOT_EVALUATED"}
