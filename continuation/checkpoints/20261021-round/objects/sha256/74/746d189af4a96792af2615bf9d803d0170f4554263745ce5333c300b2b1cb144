def _finite(value: Any, label: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(float(value)):
        raise ObservationError(f"{label} must be a finite observed real number")
    return float(value)


def validate_capture(decoded: Mapping[str, Any], slot: Mapping[str, Any],
                     selection_witness: Mapping[str, Any]) -> dict[str, list[complex]]:
    """Validate one normalized production result receipt before integration."""
    if (not isinstance(decoded, Mapping)
            or decoded.get("status") != "PRODUCTION_NATIVE_COMPLEX_POINT_READBACK"
            or decoded.get("operation") != "result.at_points"
            or decoded.get("science_acceptance") != "NOT_EVALUATED"
            or decoded.get("complex_readback") is not True
            or decoded.get("dataset") != slot.get("dataset_tag_observed")
            or decoded.get("solution") != slot.get("solution_tag_observed")
            or decoded.get("sample_count") != slot.get("sample_count")):
        raise ObservationError("field receipt status, complex mode, dataset/solution or sample count changed")
    if decoded.get("expressions") is None:
        raise ObservationError("field receipt has no expression-indexed raw E/H arrays")
    rows = decoded["expressions"]
    expressions = slot.get("expressions")
    units = slot.get("requested_units")
    if (not isinstance(rows, list) or not isinstance(expressions, list) or not isinstance(units, list)
            or [row.get("expression") for row in rows if isinstance(row, Mapping)] != expressions
            or len(rows) != len(expressions)
            or decoded.get("expression_units") != dict(zip(expressions, units))):
        raise ObservationError("field receipt expression order or exact units differ from the request")
    if not isinstance(slot.get("requested_points_um"), list) or not slot["requested_points_um"]:
        raise ObservationError("read slot has no exact requested coordinate grid")
    coordinates = decoded.get("coordinates_m")
    count = slot["sample_count"]
    if (not isinstance(coordinates, list) or len(coordinates) != 2
            or any(not isinstance(axis, list) or len(axis) != count for axis in coordinates)):
        raise ObservationError("raw coordinate readback must be exact dimension-major 2xN")
    coordinate_unit = decoded.get("coordinate_geometry_unit")
    if coordinate_unit not in {"m", "cm", "mm", "um", "µm", "nm"}:
        raise ObservationError("native coordinate unit is missing or unsupported")
    expected_points = slot["requested_points_um"]
    for index, point in enumerate(expected_points):
        # Production normalization already converts COMSOL's native geometry
        # coordinates to SI metres before storing them under coordinates_m.
        # The geometry unit remains a separate observed provenance field and
        # must never be applied a second time during validation or integration.
        expected_x_m, expected_y_m = point[0] * 1e-6, point[1] * 1e-6
        if (not math.isclose(_finite(coordinates[0][index], "x"), expected_x_m,
                             rel_tol=1e-10, abs_tol=1e-12)
                or not math.isclose(_finite(coordinates[1][index], "y"), expected_y_m,
                                    rel_tol=1e-10, abs_tol=1e-12)):
            raise ObservationError("native coordinates differ from the exact requested field grid")
    result: dict[str, list[complex]] = {}
    for name, row in zip(expressions, rows):
        if not isinstance(row, Mapping) or row.get("expression") != name:
            raise ObservationError("field expression row is malformed or reordered")
        real, imag = row.get("real"), row.get("imag")
        if (not isinstance(real, list) or not isinstance(imag, list)
                or len(real) != count or len(imag) != count):
            raise ObservationError(f"{name} requires matching complete real and imaginary sample arrays")
        result[name] = [complex(_finite(a, f"{name}.real"), _finite(b, f"{name}.imag"))
                        for a, b in zip(real, imag)]
    _validate_selection_witness(selection_witness, slot)
    return result


def _validate_selection_witness(witness: Any, slot: Mapping[str, Any]) -> None:
    if not isinstance(witness, Mapping) or set(witness) != {"before", "after"}:
        raise ObservationError("field receipt must preserve actual before/after selection readbacks")
    target = slot.get("selection")
    native_readbacks = []
    for key, stage in (("before", "before_numeric_read"), ("after", "after_numeric_read")):
        row = witness[key]
        native = row.get("native_selection_readback") if isinstance(row, Mapping) else None
        if (not isinstance(row, Mapping) or row.get("stage") != stage
                or row.get("component") != target.get("component")
                or row.get("geometry") != target.get("geometry") or row.get("tag") != target.get("tag")
                or row.get("entity_dimension") != 1 or row.get("kind") != "named"
                or not isinstance(native, Mapping) or native.get("geometry") != target.get("geometry")
                or native.get("dimension") != 1 or native.get("named") != target.get("tag")
                or native.get("is_inheriting") is not False
                or native.get("entities") != target.get("actual_entity_ids")):
            raise ObservationError("actual transient selection identity/entity readback differs from the planned port")
        native_readbacks.append(dict(native))
    if native_readbacks[0] != native_readbacks[1]:
        raise ObservationError("transient boundary selection changed during native point read")


def _simpson(values: Sequence[float], coordinates: Sequence[float]) -> float:
    if (len(values) != len(coordinates) or len(values) not in SAMPLE_COUNTS):
        raise ObservationError("signed-power integration requires the exact 641/1281 native grid")
    xs = [_finite(value, "coordinate") for value in coordinates]
    ys = [_finite(value, "integrand") for value in values]
    h = xs[1] - xs[0]
    if h <= 0 or any(not math.isclose(xs[i] - xs[i-1], h, rel_tol=1e-10, abs_tol=1e-18)
                      for i in range(2, len(xs))):
        raise ObservationError("native coordinate readback is not a strictly increasing uniform grid")
    total = ys[0] + ys[-1]
    total += 4.0 * math.fsum(ys[1:-1:2])
    total += 2.0 * math.fsum(ys[2:-1:2])
    return total * h / 3.0


def signed_power(decoded: Mapping[str, Any], slot: Mapping[str, Any],
                 selection_witness: Mapping[str, Any]) -> dict[str, Any]:
    """Report measured signed global and outward flux, never an acceptance claim."""
    fields = validate_capture(decoded, slot, selection_witness)
    prefix = slot["physics_identifier_observed"]
    port = slot["port_name_observed"]
    count = slot["sample_count"]
    axes = "xyz"
    get = lambda base, axis: fields[f"{prefix}.{base}{axis}_{port}"] if base in ("Emode", "Hmode") else fields[f"down({prefix}.{base}{axis})"]
    signal_e = {axis: fields[f"down({prefix}.E{axis})"] for axis in axes}
    signal_h = {axis: fields[f"down({prefix}.H{axis})"] for axis in axes}
    mode_e = {axis: get("Emode", axis) for axis in axes}
    mode_h = {axis: get("Hmode", axis) for axis in axes}
    nx_name, ny_name = f"{prefix}.nx", f"{prefix}.ny"
    nx, ny = fields[nx_name], fields[ny_name]
    if (any(abs(abs(value.real) - 1.0) > 1e-10 or abs(value.imag) > 1e-12 for value in nx)
            or any(abs(value.real) > 1e-10 or abs(value.imag) > 1e-12 for value in ny)
            or len({1 if value.real > 0 else -1 for value in nx}) != 1):
        raise ObservationError("native x-plane normals are not a constant unit x normal")

    def flux(e: Mapping[str, list[complex]], h: Mapping[str, list[complex]]) -> dict[str, list[float]]:
        sx, sy = [], []
        for i in range(count):
            sx.append(0.5 * (e["y"][i] * h["z"][i].conjugate()
                             - e["z"][i] * h["y"][i].conjugate()).real)
            sy.append(0.5 * (e["z"][i] * h["x"][i].conjugate()
                             - e["x"][i] * h["z"][i].conjugate()).real)
        outward = [nx[i].real * sx[i] + ny[i].real * sy[i] for i in range(count)]
        return {"global_sx_W_per_m2": sx, "outward_n_dot_s_W_per_m2": outward}

    signal_flux, mode_flux = flux(signal_e, signal_h), flux(mode_e, mode_h)
    y_m = decoded["coordinates_m"][1]
    signal_px = _simpson(signal_flux["global_sx_W_per_m2"], y_m)
    signal_out = _simpson(signal_flux["outward_n_dot_s_W_per_m2"], y_m)
    mode_px = _simpson(mode_flux["global_sx_W_per_m2"], y_m)
    mode_out = _simpson(mode_flux["outward_n_dot_s_W_per_m2"], y_m)
    return {
        "status": "SOFTWARE_RECOMPUTED_FROM_FRESH_NATIVE_COMPLEX_POINT_RECEIPT",
        "scope": "diagnostic signed power only; no physical acceptance",
        "role": slot["role"], "port_name_observed": port,
        "dataset_observed": slot["dataset_tag_observed"],
        "solution_observed": slot["solution_tag_observed"],
        "sample_count": count, "unit": "W/m",
        "native_normal_x": nx[0].real,
        "global_plus_x_power": {"signal": signal_px, "BMA_mode": mode_px},
        "outward_n_dot_S": {"signal": signal_out, "BMA_mode": mode_out},
        "measured_direction": {
            "signal": "+x" if signal_px > 0 else "-x" if signal_px < 0 else "zero/ambiguous",
            "BMA_mode": "+x" if mode_px > 0 else "-x" if mode_px < 0 else "zero/ambiguous",
            "same_global_direction": (signal_px > 0 and mode_px > 0) or (signal_px < 0 and mode_px < 0),
        },
        "raw_native_receipt_sha256": _sha_json(decoded),
        "raw_field_and_normal_arrays_preserved": True,
        "H_only_flip": False,
        "normal_inversion": False,
        "scientific_acceptance": "NOT_EVALUATED",
    }


