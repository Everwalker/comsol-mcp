"""Fresh W23 saved-MPH observation planning and signed-power proof helpers.

This module is source-only. It builds a bounded read plan from actual metadata
readbacks and consumes preserved complex point receipts; it has no transport,
COMSOL, approval, once-token, or native-dispatch capability.
"""
from __future__ import annotations

import hashlib
import json
import math
import re
from collections.abc import Mapping, Sequence
from typing import Any


SAVED_MPH_BYTES = 13_795_478
SAVED_MPH_SHA256 = "cba0c1d404003c4e60a20b04316cb1456c38cc2b45596dc2dc29bbed62674a8c"
SAMPLE_COUNTS = (641, 1281)
RELATIVE_TOLERANCE = 1e-3
MAX_RESULT_AT_POINTS_CALLS = 4
MAX_RESULT_EVALUATE_INTEGRAL_CALLS = 2
MAX_METADATA_PUBLIC_CALLS = 128
MAX_TOTAL_PUBLIC_CALLS = 134
OBSERVED_GEOMETRY_DIMENSION = 2
PORT_BOUNDARY_DIMENSION = 1
_IDENTIFIER = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
_TAG = re.compile(r"^[A-Za-z][A-Za-z0-9_]{0,63}$")


class ObservationError(ValueError):
    """A fresh observation plan or raw receipt is incomplete or ambiguous."""


_TERMINAL_PAIR_PROOF_FIELDS = {
    "schema", "source", "terminal_pair_status", "public_operation",
    "raw_response_sha256", "operation_result_sha256", "job_result_sha256",
    "operation_id", "job_id", "request_id", "idempotency_key", "request_hash",
    "operation_status", "job_status", "operation_finished_at", "job_finished_at",
    "operation_metadata_sha256", "job_metadata_sha256", "request_sha256",
    "owner_identity",
}


def validate_terminal_operation_job_pair(response: Mapping[str, Any], proof: Mapping[str, Any], *,
                                         expected_operation: str) -> dict[str, Any]:
    """Bind a raw public response to separate original-owner terminal ledger proof.

    The public producer does not promise ``execution.status``. A positive
    response is accepted only with a separately captured operation/job pair
    from the live owner OperationStore. This validator never edits the raw
    response or infers its terminal status from the expected result.
    """
    if not isinstance(response, Mapping) or response.get("success") is not True:
        raise ObservationError("public response is not successful")
    execution = response.get("execution")
    if not isinstance(execution, Mapping):
        raise ObservationError("public response omitted its raw execution identity")
    response_status = execution.get("status")
    if response_status is not None and not isinstance(response_status, str):
        raise ObservationError("public response execution status is malformed")
    if response_status in {"QUEUED", "RUNNING", "UNKNOWN"}:
        raise ObservationError("public response is explicitly nonterminal or UNKNOWN")
    if response_status is not None and response_status not in {"SUCCEEDED", "COMPLETED"}:
        raise ObservationError("public response has an unrecognized execution status")
    data = response.get("data")
    if not isinstance(data, Mapping) or data.get("execution_state_unknown") is True:
        raise ObservationError("public response data is absent or explicitly UNKNOWN")
    if (not isinstance(expected_operation, str) or not expected_operation
            or not isinstance(proof, Mapping) or set(proof) != _TERMINAL_PAIR_PROOF_FIELDS
            or proof.get("schema") != "W23_OWNER_OPERATION_JOB_TERMINAL_PAIR_R1"
            or proof.get("source") != "LIVE_BOUND_MANAGED_PUBLIC_GATE_OPERATIONSTORE"
            or proof.get("terminal_pair_status") != "OPERATION_AND_JOB_SUCCEEDED"
            or proof.get("public_operation") != expected_operation):
        raise ObservationError("original-owner terminal operation/job proof is missing or malformed")
    raw_sha = hashlib.sha256(json.dumps(
        response, sort_keys=True, separators=(",", ":"),
        ensure_ascii=False, allow_nan=False).encode("utf-8")).hexdigest()

    def _sha(value: Any, label: str) -> str:
        if (not isinstance(value, str) or len(value) != 64
                or any(char not in "0123456789abcdef" for char in value)):
            raise ObservationError(f"terminal pair {label} is not a lowercase SHA-256")
        return value

    request_hash = _sha(execution.get("request_hash"), "request hash")
    for field in ("operation_id", "job_id", "request_id", "idempotency_key"):
        value = execution.get(field)
        if not isinstance(value, str) or not value or proof.get(field) != value:
            raise ObservationError(f"terminal pair {field} differs from the exact raw response")
    owner = proof.get("owner_identity")
    if (not isinstance(owner, Mapping)
            or set(owner) != {"project_id", "session_id", "server_pid", "worker_pid",
                              "worker_instance_id", "worker_epoch"}
            or owner.get("project_id") != execution.get("project_id")
            or owner.get("session_id") != execution.get("session_id")
            or not isinstance(owner.get("project_id"), str) or not owner["project_id"]
            or not isinstance(owner.get("session_id"), str) or not owner["session_id"]
            or type(owner.get("server_pid")) is not int or owner["server_pid"] <= 1
            or type(owner.get("worker_pid")) is not int or owner["worker_pid"] <= 1
            or not isinstance(owner.get("worker_instance_id"), str) or not owner["worker_instance_id"]
            or type(owner.get("worker_epoch")) is not int or owner["worker_epoch"] < 1):
        raise ObservationError("terminal pair proof is not bound to the original project/session owners")
    for field in ("operation_result_sha256", "job_result_sha256"):
        if _sha(proof.get(field), field) != raw_sha:
            raise ObservationError(f"terminal pair {field} differs from the preserved raw response")
    if (_sha(proof.get("raw_response_sha256"), "raw response hash") != raw_sha
            or proof.get("request_hash") != request_hash
            or proof.get("operation_status") != "SUCCEEDED"
            or proof.get("job_status") != "SUCCEEDED"):
        raise ObservationError("terminal operation/job pair is not a successful pair for this raw response")
    for field in ("operation_finished_at", "job_finished_at"):
        if not isinstance(proof.get(field), str) or not proof[field].strip():
            raise ObservationError(f"terminal pair {field} is absent")
    for field in ("operation_metadata_sha256", "job_metadata_sha256", "request_sha256"):
        _sha(proof.get(field), field)
    return dict(proof)


def sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def verify_saved_mph_copy(path: str) -> dict[str, Any]:
    """Verify the candidate input bytes without opening or modifying the model."""
    import os
    import stat

    info = os.lstat(path)
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise ObservationError("saved-MPH input must be a regular non-symlink file")
    digest = sha256_file(path)
    if info.st_size != SAVED_MPH_BYTES or digest != SAVED_MPH_SHA256:
        raise ObservationError("saved-MPH candidate input differs from the immutable Activity009 artifact")
    if stat.S_IMODE(info.st_mode) & 0o222:
        raise ObservationError("saved-MPH candidate input must remain read-only")
    return {"path": path, "bytes": info.st_size, "sha256": digest,
            "mode": oct(stat.S_IMODE(info.st_mode)), "opened_by_comsol": False}


def _exact_text(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value or value != value.strip() or len(value) > 128:
        raise ObservationError(f"{label} must be exact bounded text")
    return value


def _typed_property(properties: Any, name: str, *, allowed_kinds: Sequence[str] = ("string", "expression")) -> tuple[str, Mapping[str, Any]]:
    if not isinstance(properties, Mapping) or name not in properties:
        raise ObservationError(f"{name} is absent from the exact schema-before-get property map")
    row = properties[name]
    if not isinstance(row, Mapping) or set(row) != {"schema", "decision", "typed_get"}:
        raise ObservationError(f"{name} lacks the exact captured schema/decision/getter tuple")
    schema, decision, getter = row["schema"], row["decision"], row["typed_get"]
    if (not isinstance(schema, Mapping) or schema.get("name") != name
            or schema.get("has_property") is not True or schema.get("metadata_status") != "KNOWN"
            or not isinstance(decision, Mapping) or decision.get("status") != "PROPERTY_PRESENT_TYPED"
            or decision.get("should_get") is not True
            or not isinstance(getter, Mapping) or getter.get("status") != "TYPED_VALUE_CAPTURED"
            or getter.get("name") != name):
        raise ObservationError(f"{name} lacks a positive authoritative schema and exact typed getter result")
    typed = getter.get("typed_value")
    if (not isinstance(typed, Mapping) or typed.get("kind") not in allowed_kinds
            or typed.get("shape") != [] or not isinstance(typed.get("data"), str)):
        raise ObservationError(f"{name} typed value is not a scalar string/expression readback")
    value = _exact_text(typed["data"], name)
    allowed = schema.get("allowed_values")
    if allowed is not None:
        if (not isinstance(allowed, list) or not allowed
                or any(not isinstance(item, str) or not item for item in allowed)
                or len(set(allowed)) != len(allowed) or value not in allowed):
            raise ObservationError(f"{name} actual value is outside its unique observed finite enum")
    return value, schema


def _validate_actual_namespace(physics_inventory: Any) -> tuple[str, str]:
    if not isinstance(physics_inventory, list) or not physics_inventory:
        raise ObservationError("complete public physics inventory is required")
    rows = [row for row in physics_inventory if isinstance(row, Mapping)]
    if len(rows) != len(physics_inventory):
        raise ObservationError("physics inventory contains malformed rows")
    if any(row.get("identifier_status") != "OBSERVED"
           or not isinstance(row.get("identifier"), str) or not _IDENTIFIER.fullmatch(row["identifier"])
           for row in rows):
        raise ObservationError("every physics identifier must be a fresh observed scalar; no tag substitution")
    tags = [_exact_text(row.get("tag"), "physics tag") for row in rows]
    identifiers = [row["identifier"] for row in rows]
    if len(set(tags)) != len(tags) or len(set(identifiers)) != len(identifiers):
        raise ObservationError("physics tags and expression identifiers must be unique")
    waves = [row for row in rows if row.get("type_id") == "ElectromagneticWaves"]
    if len(waves) != 1:
        raise ObservationError("exactly one observed ElectromagneticWaves interface is required")
    return waves[0]["tag"], waves[0]["identifier"]


_PORT_PROPERTIES = (
    "PortName", "PortType", "PortOrientation", "PortExcitation", "Pin",
    "PortModeNumber", "PortSlit", "SlitType",
)


def _validate_ports(port_rows: Any) -> dict[str, dict[str, Any]]:
    if not isinstance(port_rows, list):
        raise ObservationError("fresh Port feature rows are required")
    ports = [row for row in port_rows if isinstance(row, Mapping) and row.get("type_id") == "Port"]
    if len(ports) != 2 or len(ports) != len(port_rows):
        raise ObservationError("saved model must expose exactly two complete Port feature rows")
    by_name: dict[str, dict[str, Any]] = {}
    for row in ports:
        tag = _exact_text(row.get("tag"), "Port tag")
        name, _ = _typed_property(row.get("properties"), "PortName")
        if name not in {"1", "2"} or name in by_name:
            raise ObservationError("PortName must bind exactly one observed Port to each frozen port role 1/2")
        properties = row["properties"]
        values: dict[str, str] = {}
        schemas: dict[str, Mapping[str, Any]] = {}
        for prop in _PORT_PROPERTIES:
            values[prop], schemas[prop] = _typed_property(properties, prop)
        if values["PortName"] != name or values["PortType"] != "Numeric":
            raise ObservationError("actual PortName/PortType differs from the numeric-port source model")
        expected_excitation = "on" if name == "1" else "off"
        if values["PortExcitation"].lower() != expected_excitation:
            raise ObservationError("actual Port excitation role differs from the frozen input/listener roles")
        by_name[name] = {"tag": tag, "port_name": name, "properties": values,
                         "raw_properties": dict(properties), "property_schemas": schemas}
    if set(by_name) != {"1", "2"}:
        raise ObservationError("unique exact PortName mapping is incomplete")
    return by_name


def _selection_for_port(selection_rows: Any, port_name: str) -> dict[str, Any]:
    if not isinstance(selection_rows, list):
        raise ObservationError("fresh actual selection readbacks are required")
    expected_tag = "selInputPort" if port_name == "1" else "selReceiverX8"
    rows = [row for row in selection_rows if isinstance(row, Mapping) and row.get("tag") == expected_tag]
    if len(rows) != 1:
        raise ObservationError(f"expected exact saved-model named selection {expected_tag!r} is absent or ambiguous")
    row = rows[0]
    entities = row.get("entities")
    if (row.get("component") != "comp1" or row.get("geometry") != "geom1"
            or row.get("entity_dimension") != 1 or row.get("dimension") != 1
            or row.get("is_inheriting") is not False or row.get("named") != expected_tag
            or not isinstance(entities, list) or not entities
            or any(type(entity) is not int or entity <= 0 for entity in entities)
            or len(set(entities)) != len(entities)):
        raise ObservationError(f"{expected_tag} lacks complete exact geometry/dimension/entity readback")
    return {"kind": "named", "component": "comp1", "geometry": "geom1",
            "entity_dimension": 1, "tag": expected_tag,
            "actual_entity_ids": list(entities), "actual_entity_ids_sha256": _sha_json(entities)}


def _sha_json(value: Any) -> str:
    import json
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"),
                                  allow_nan=False).encode("utf-8")).hexdigest()


def _validate_physical_binding(binding: Any) -> tuple[str, str]:
    if not isinstance(binding, Mapping):
        raise ObservationError("fresh physical dataset/solution readbacks are required")
    required = {
        "status": "UNIQUE_EXACT_FREQUENCY_DATASET_BINDING",
        "dataset_tag": "dset1", "dataset_type": "Solution", "solution_tag": "sol1",
        "binding_complete": True, "numeric_solution_count": 1,
        "source": "fresh dataset.list + dataset.solution_indices + exact StudyStep/StoreSolution chain",
    }
    if any(binding.get(key) != value for key, value in required.items()):
        raise ObservationError("fresh physical dataset/solution chain does not match the exact saved-MPH selector")
    return "dset1", "sol1"


def _validate_bma_bindings(bindings: Any) -> dict[str, dict[str, str]]:
    if not isinstance(bindings, list):
        raise ObservationError("fresh BMA-to-solution graph is required")
    by_port: dict[str, dict[str, str]] = {}
    for row in bindings:
        if not isinstance(row, Mapping):
            raise ObservationError("BMA binding row is malformed")
        port = row.get("port_name")
        if port not in {"1", "2"} or port in by_port or row.get("status") != "UNIQUE_EXACT_LINK":
            raise ObservationError("BMA port binding is missing, duplicated, or non-unique")
        fields = {name: _exact_text(row.get(name), f"BMA {name}")
                  for name in ("study_tag", "bma_tag", "dataset_tag", "solution_tag")}
        if row.get("dataset_type") != "Solution" or row.get("dataset_binding_complete") is not True:
            raise ObservationError("BMA link lacks the actual Solution dataset.solution readback")
        if row.get("source") != "fresh StudyStep.study/studystep -> StoreSolution.sol -> Dataset.solution":
            raise ObservationError("BMA solution link source is not the exact public metadata chain")
        by_port[port] = fields
    expected = {"1": ("dset2", "sol2"), "2": ("dset3", "sol3")}
    if set(by_port) != {"1", "2"}:
        raise ObservationError("exact one-to-one BMA binding for PortName 1 and 2 is required")
    if any((by_port[key]["dataset_tag"], by_port[key]["solution_tag"]) != value
           for key, value in expected.items()):
        raise ObservationError("actual BMA dataset/solution links differ from the exact saved-MPH identities")
    if len({row["dataset_tag"] for row in by_port.values()}) != 2 or len({row["solution_tag"] for row in by_port.values()}) != 2:
        raise ObservationError("BMA dataset and solution identities must be distinct")
    return by_port


def field_expressions(physics_identifier: str, port_name: str) -> tuple[str, ...]:
    identifier = _exact_text(physics_identifier, "Physics.identifier")
    if not _IDENTIFIER.fullmatch(identifier) or port_name not in {"1", "2"}:
        raise ObservationError("field expressions require the exact observed physics identifier and PortName 1/2")
    return tuple(
        [f"down({identifier}.E{axis})" for axis in "xyz"]
        + [f"down({identifier}.H{axis})" for axis in "xyz"]
        + [f"{identifier}.Emode{axis}_{port_name}" for axis in "xyz"]
        + [f"{identifier}.Hmode{axis}_{port_name}" for axis in "xyz"]
        + [f"{identifier}.nx", f"{identifier}.ny"]
    )


def field_units(expressions: Sequence[str], physics_identifier: str) -> tuple[str, ...]:
    nx, ny = f"{physics_identifier}.nx", f"{physics_identifier}.ny"
    expected = field_expressions(physics_identifier, "1")
    if not isinstance(expressions, Sequence) or isinstance(expressions, (str, bytes)):
        raise ObservationError("field unit plan requires the exact ordered expression tuple")
    if len(expressions) != len(expected):
        raise ObservationError("field unit plan has an invalid expression count")
    if list(expressions[:6]) != list(expected[:6]) or expressions[-2:] != (nx, ny):
        raise ObservationError("field unit plan expression order or normal identities changed")
    if not any(list(expressions[6:12]) == [f"{physics_identifier}.Emode{axis}_{port}"
                                           for axis in "xyz"]
               + [f"{physics_identifier}.Hmode{axis}_{port}" for axis in "xyz"]
               for port in ("1", "2")):
        raise ObservationError("field mode expressions do not match one exact PortName")
    return tuple(["V/m"] * 3 + ["A/m"] * 3 + ["V/m"] * 3 + ["A/m"] * 3 + ["", ""])


def signed_flux_integral_expressions(physics_identifier: str, port_name: str) -> tuple[str, ...]:
    """Return the fixed ordered signed global-x/outward flux expressions.

    E and H remain full three-component fields in the 2D spatial geometry.
    Signal fields use the documented lower-side selector already used by the
    point sampler; mode fields bind to the actual PortName-specific variables.
    """
    identifier = _exact_text(physics_identifier, "Physics.identifier")
    if not _IDENTIFIER.fullmatch(identifier) or port_name not in {"1", "2"}:
        raise ObservationError("signed integral expressions require the observed namespace and PortName 1/2")

    def pair(prefix: str, port: str | None) -> tuple[str, str]:
        def name(field: str) -> str:
            suffix = f"_{port}" if port is not None else ""
            base = f"{identifier}.{field}{suffix}"
            return f"down({base})" if port is None else base
        ex, ey, ez = (name(f"E{axis}") for axis in "xyz")
        hx, hy, hz = (name(f"H{axis}") for axis in "xyz")
        return (
            f"0.5*real(({ey})*conj({hz})-({ez})*conj({hy}))",
            f"0.5*real(({ez})*conj({hx})-({ex})*conj({hz}))",
        )

    signal_sx, signal_sy = pair("signal", None)
    mode_sx, mode_sy = pair("mode", port_name)
    nx, ny = f"{identifier}.nx", f"{identifier}.ny"
    return (
        signal_sx,
        f"({nx})*({signal_sx})+({ny})*({signal_sy})",
        mode_sx,
        f"({nx})*({mode_sx})+({ny})*({mode_sy})",
    )


def _validate_geometry_readback(raw: Any) -> dict[str, Any]:
    expected_path = {"segments": [
        {"collection": "component", "tag": "comp1"},
        {"collection": "geom", "tag": "geom1"},
    ]}
    if (not isinstance(raw, Mapping) or raw.get("path") != expected_path
            or raw.get("kind") != "geom"):
        raise ObservationError("fresh geometry.inspect readback must bind exact comp1/geom1")
    geometry_state = raw.get("geometry_state")
    dimension = geometry_state.get("dimension") if isinstance(geometry_state, Mapping) else None
    if type(dimension) is not int or dimension != OBSERVED_GEOMETRY_DIMENSION:
        raise ObservationError("fresh geometry.inspect must report the exact observed 2D geometry")
    return {"component": "comp1", "geometry": "geom1", "dimension": dimension,
            "source": "geometry.inspect geometry_state.dimension",
            "raw_readback": json.loads(json.dumps(raw, sort_keys=True, ensure_ascii=False,
                                                  allow_nan=False)),
            "raw_readback_sha256": _sha_json(raw)}


def _grid(x_um: float, sample_count: int) -> list[list[float]]:
    if sample_count not in SAMPLE_COUNTS:
        raise ObservationError("only frozen 641/1281 saved-MPH grids are permitted")
    if x_um not in (-10.0, 8.0):
        raise ObservationError("field plane must be the exact saved-MPH input or output plane")
    return [[x_um, -8.0 + 16.0 * i / (sample_count - 1)] for i in range(sample_count)]


def build_read_plan(observed: Mapping[str, Any]) -> dict[str, Any]:
    """Build exact point and signed-integral slots from live typed metadata.

    Inputs to this function are observations; the function never fills an
    observed value from a plan constant. Fixed saved-MPH identities are only
    comparison gates and any mismatch fails closed.
    """
    if not isinstance(observed, Mapping) or observed.get("schema") != "W23_FRESH_TYPED_METADATA_OBSERVATION_R1":
        raise ObservationError("exact fresh W23 typed metadata observation envelope is required")
    if (observed.get("saved_model_bytes") != SAVED_MPH_BYTES
            or observed.get("saved_model_sha256") != SAVED_MPH_SHA256):
        raise ObservationError("metadata observation is not bound to the immutable saved-MPH bytes")
    geometry = _validate_geometry_readback(observed.get("geometry_readback_raw_observed"))
    physics_tag, physics_identifier = _validate_actual_namespace(observed.get("physics_inventory"))
    ports = _validate_ports(observed.get("ports"))
    physical_dataset, physical_solution = _validate_physical_binding(observed.get("physical_solution_binding"))
    bma = _validate_bma_bindings(observed.get("bma_solution_bindings"))
    selection_rows = observed.get("port_selection_readbacks")
    slots: list[dict[str, Any]] = []
    for port_name, role, x_um in (("1", "input_xminus10", -10.0), ("2", "output_x8", 8.0)):
        selection = _selection_for_port(selection_rows, port_name)
        expressions = field_expressions(physics_identifier, port_name)
        units = field_units(expressions, physics_identifier)
        for sample_count in SAMPLE_COUNTS:
            slot = {
                "ordinal": len(slots) + 1,
                "label": f"{role}_{sample_count}",
                "role": role,
                "geometry_dimension_observed": geometry["dimension"],
                "physics_tag_observed": physics_tag,
                "physics_identifier_observed": physics_identifier,
                "port_tag_observed": ports[port_name]["tag"],
                "port_name_observed": port_name,
                "port_properties_raw_observed": dict(ports[port_name]["raw_properties"]),
                "bma_link_observed": dict(bma[port_name]),
                "dataset_tag_observed": physical_dataset,
                "solution_tag_observed": physical_solution,
                "sample_count": sample_count,
                "requested_points_um": _grid(x_um, sample_count),
                "coordinate_unit": "um",
                "frame": "spatial",
                "selection": selection,
                "expressions": list(expressions),
                "requested_units": list(units),
                "complex_mode": "preserve",
                "operation_id": "result.at_points",
                "native_scientific_acceptance": "NOT_EVALUATED",
            }
            slot["request_arguments"] = {
                "spec": {
                    "expressions": list(expressions),
                    "solution": {"dataset": physical_dataset, "solution": physical_solution},
                    "complex_mode": "preserve", "units": list(units),
                    "selection": {key: selection[key] for key in
                                  ("kind", "component", "geometry", "entity_dimension", "tag")},
                    "entity_dim": 1,
                },
                "points": [{"x": x, "y": y} for x, y in slot["requested_points_um"]],
                "coordinate_unit": "um", "frame": "spatial",
            }
            slots.append(slot)
    if len(slots) != MAX_RESULT_AT_POINTS_CALLS:
        raise ObservationError("fresh point-read slot count differs from the four-call fixed budget")
    integral_slots: list[dict[str, Any]] = []
    for port_name, role in (("1", "input_xminus10"), ("2", "output_x8")):
        selection = _selection_for_port(selection_rows, port_name)
        expressions = signed_flux_integral_expressions(physics_identifier, port_name)
        integral_slots.append({
            "ordinal": len(integral_slots) + 1,
            "label": f"{role}_signed_native_integral",
            "role": role,
            "geometry_dimension_observed": geometry["dimension"],
            "physics_tag_observed": physics_tag,
            "physics_identifier_observed": physics_identifier,
            "port_tag_observed": ports[port_name]["tag"],
            "port_name_observed": port_name,
            "bma_link_observed": dict(bma[port_name]),
            "dataset_tag_observed": physical_dataset,
            "solution_tag_observed": physical_solution,
            "selection": selection,
            "expressions": list(expressions),
            "expression_labels": ["signal_global_plus_x", "signal_outward_n_dot_S",
                                  "BMA_mode_global_plus_x", "BMA_mode_outward_n_dot_S"],
            "requested_units": ["W/m"] * 4,
