def _canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode("utf-8")


class _Gate:
    def __init__(self, daemon, project_id, session_id):
        self.daemon = daemon
        self.project_id = project_id
        self.session_id = session_id
        self.requests = []

    def assert_live(self):
        return {"server_pid": 41001, "worker_pid": 41002,
                "worker_instance_id": "r6-test-worker",
                "worker_epoch": 9}

    def dispatch(self, request):
        self.requests.append(copy.deepcopy(request))
        return self.daemon.dispatch(dict(request))


def _bridge(daemon, gate):
    # Exercise the production W23OwnedRuntimeBridge.dispatch body while
    # keeping this offline test clear of Server/Worker construction.
    bridge = object.__new__(owned.W23OwnedRuntimeBridge)
    bridge.host = SimpleNamespace(daemon=daemon)
    bridge.daemon = daemon
    bridge.gate = gate
    bridge.store = daemon.store
    bridge.project_id = gate.project_id
    bridge.session_id = gate.session_id
    bridge._control_daemon_type = ControlDaemon
    bridge._operation_store_type = type(daemon.store)
    return bridge


def _durable_owner_response(daemon, *, project_id, session_id, operation_id):
    request_id = f"r6-{operation_id}-request"
    idempotency_key = f"r6-{operation_id}-idempotency"
    nested = {
        "operation_id": operation_id,
        "arguments": {"r6_fixture": operation_id},
    }
    execution = {
        "project_id": project_id, "session_id": session_id,
        "request_id": request_id, "idempotency_key": idempotency_key,
        "model_ref": None, "expected_revision": None,
        "rpc_timeout_s": 30.0, "execution_timeout_s": None,
        "queue_timeout_s": 60.0,
    }
    request = {"operation": "operation_call", "arguments": nested,
               "execution": execution}
    request_hash = hashlib.sha256(_canonical(request)).hexdigest()
    metadata = {"operation": "operation_call", "arguments": nested,
                "execution": execution}
    record, replay = daemon.store.begin(
        request_id=request_id, idempotency_key=idempotency_key,
        request_hash=request_hash, operation="operation_call",
        metadata=metadata, timeouts={},
    )
    if replay:
        raise AssertionError("test fixture unexpectedly reused an idempotency key")
    response = {
        "success": True,
        "data": {"durable_fixture": operation_id},
        "execution": {
            "project_id": project_id, "request_id": request_id,
            "idempotency_key": idempotency_key,
            "operation_id": record["operation_id"], "job_id": record["job_id"],
            "request_hash": request_hash,
        },
    }
    daemon.store.finish(record["operation_id"], status="SUCCEEDED", result=response)
    return {
        "operation_id": operation_id, "request_id": request_id,
        "idempotency_key": idempotency_key, "nested_arguments": nested,
        "execution": execution, "response": response,
    }


class R6TransportAndCachedStatusContractTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix="w23-r6-contract-")
        root = Path(self.temp.name)
        self.project_root = root / "projects"
        self.project_root.mkdir(mode=0o700)
        self.daemon = ControlDaemon(root / "home", project_root=self.project_root)
        self.project_id = "r6-project-contract"
        self.session_id = "r6-session-contract"
        self.gate = _Gate(self.daemon, self.project_id, self.session_id)
        self.bridge = _bridge(self.daemon, self.gate)

    def tearDown(self):
        try:
            self.daemon.close()
        finally:
            self.temp.cleanup()

    def test_fresh_owner_status_uses_real_bare_cached_job_read_and_same_owner_record(self):
        owner_call = _durable_owner_response(
            self.daemon, project_id=self.project_id, session_id=self.session_id,
            operation_id="artifact.register",
        )
        owner_execution = owner_call["response"]["execution"]
        owner_call["execution"] = {
            **owner_call["execution"],
            "request_id": owner_call["request_id"],
            "idempotency_key": owner_call["idempotency_key"],
        }
        with tempfile.TemporaryDirectory(prefix="w23-r6-status-journal-") as journal_root:
            journal = runtime.DurableJournal(journal_root)
            route = runtime.FreshOwnerRoute(
                {"project_id": self.project_id, "session_id": self.session_id},
                journal, dispatcher=self.bridge.dispatch,
            )
            route.calls.append(owner_call)
            route.owner_calls.append(owner_call)
            raw = route.call_raw("job.status", {"job_id": owner_execution["job_id"]})
            journal.close()

            self.assertEqual(set(raw), {"success", "data"})
            self.assertNotIn("execution", raw)
            self.assertEqual(raw["data"]["job_id"], owner_execution["job_id"])
            self.assertEqual(raw["data"]["status"], "SUCCEEDED")
            self.assertEqual(raw["data"]["operation"]["result"], owner_call["response"])
            self.assertEqual(route.terminal_status_reads[0]["response"], raw)

        self.assertEqual(len(self.gate.requests), 1)
        request = self.gate.requests[0]
        self.assertEqual(request["operation"], "operation_call")
        self.assertEqual(request["arguments"], {
            "operation_id": "job.status",
            "arguments": {"job_id": owner_execution["job_id"]},
        })
        self.assertEqual(request["execution"]["project_id"], self.project_id)
        self.assertEqual(request["execution"]["session_id"], self.session_id)

    def test_owner_status_rejects_wrong_job_and_cached_snapshot_drift(self):
        owner_call = _durable_owner_response(
            self.daemon, project_id=self.project_id, session_id=self.session_id,
            operation_id="model.load",
        )
        response_execution = owner_call["response"]["execution"]
        owner_call["execution"] = {
            **owner_call["execution"], "request_id": owner_call["request_id"],
            "idempotency_key": owner_call["idempotency_key"],
        }
        with tempfile.TemporaryDirectory(prefix="w23-r6-negative-journal-") as journal_root:
            journal = runtime.DurableJournal(journal_root)
            route = runtime.FreshOwnerRoute(
                {"project_id": self.project_id, "session_id": self.session_id},
                journal, dispatcher=self.bridge.dispatch,
            )
            route.calls.append(owner_call)
            route.owner_calls.append(owner_call)
            with self.assertRaises(runtime.RuntimeEntryError):
                route.call_raw("job.status", {"job_id": "foreign-job"})
            self.assertEqual(self.gate.requests, [])

            real = self.daemon.dispatch({
                "operation": "operation_call",
                "arguments": {"operation_id": "job.status",
                              "arguments": {"job_id": response_execution["job_id"]}},
                "execution": {"project_id": self.project_id, "session_id": self.session_id},
            })
            route._validate_status_readback_envelope(real)
            bad_envelopes = [
                {**real, "execution": {"status": "SUCCEEDED"}},
                {**real, "extra": "unexpected"},
                {"success": False, "data": real["data"]},
            ]
            for bad in bad_envelopes:
                with self.subTest(envelope=sorted(bad)):
                    with self.assertRaises(runtime.RuntimeOutcomeUnknown):
                        route._validate_status_readback_envelope(bad)

            for field, value in (("status", "UNKNOWN"), ("job_id", "foreign-job")):
                drift = copy.deepcopy(real["data"])
                drift[field] = value
                with self.subTest(snapshot_field=field):
                    with self.assertRaises(runtime.RuntimeOutcomeUnknown):
                        route._validate_terminal_status_snapshot(drift)
            journal.close()

    def test_public_route_passes_one_complete_transport_envelope_to_real_daemon(self):
        context = {
            "project_id": self.project_id,
            "model_ref": {
                "schema_version": 1, "session_id": self.session_id,
                "server_instance_id": "r6-server", "model_tag": "Model",
                "generation": 1,
            },
            "expected_revision": 0,
        }
        with tempfile.TemporaryDirectory(prefix="w23-r6-public-journal-") as journal_root:
            journal = runtime.DurableJournal(journal_root)
            route = runtime.PublicRoute(context, journal, dispatcher=self.bridge.dispatch)
            with self.assertRaises(runtime.RuntimeEntryError):
                route.call_raw("model.inspect", {"deep": False})
            journal.close()
        self.assertEqual(len(self.gate.requests), 1)
        request = self.gate.requests[0]
        self.assertEqual(request["operation"], "operation_call")
        self.assertEqual(request["arguments"], {
            "operation_id": "model.inspect", "arguments": {"deep": False},
        })
        self.assertNotEqual(request["arguments"].get("operation_id"), "operation_call")

    def test_bridge_rejects_extra_or_cross_session_transport_before_dispatch(self):
        malformed = [
            ("operation_call", {"operation_id": "model.inspect", "arguments": {},
                                "extra": "not-public-contract"},
             {"project_id": self.project_id, "session_id": self.session_id}),
            ("operation_call", {"operation_id": "model.inspect", "arguments": {}},
             {"project_id": "foreign-project", "session_id": self.session_id}),
            ("model.inspect", {"deep": False},
             {"project_id": self.project_id, "session_id": self.session_id}),
        ]
        for operation, arguments, execution in malformed:
            with self.subTest(operation=operation, arguments=arguments):
                with self.assertRaises(owned.OwnedRuntimeEntryError):
                    self.bridge.dispatch(operation, arguments, execution)
        self.assertEqual(self.gate.requests, [])

    def test_persisted_raw_evidence_copies_only_the_fixed_manifested_files(self):
