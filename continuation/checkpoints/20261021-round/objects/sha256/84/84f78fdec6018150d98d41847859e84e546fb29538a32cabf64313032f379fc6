            model.chmod(0o400)
            source_identity = actual.entry.verify_saved_mph_copy(str(actual.SAVED_MPH_PATH))
            destination_identity = actual.entry.verify_saved_mph_copy(str(model))
            binding = {
                "schema": "w23-r6-saved-mph-copy-binding/2",
                "status": "PASS_EXACT_IMMUTABLE_SOURCE_COPIED_TO_NON_HIDDEN_PROJECT_INPUT",
                "run_id": run_id, "project_id": "r6-project-contract",
