            (root / "W23_SAVED_MPH_COPY_BINDING_R2.json").chmod(0o600)
            journal = run / "public-receipts.jsonl"
            journal.write_bytes(b'{"raw_response":{"success":true}}\n')
            journal.chmod(0o600)
            destination = scratch_root / "persistent"
            destination.mkdir(mode=0o700)

            manifest = actual._persist_raw_evidence(
                root, destination, project_input_root=project_root)
            self.assertEqual(manifest["status"],
                             "PASS_EXACT_BOUNDED_RAW_EVIDENCE_COPIED_AND_READ_BACK")
            self.assertEqual(manifest["file_count"], 10)
            self.assertEqual((destination / f"w23-input-{run_id}" / model.name).read_bytes(),
                             model.read_bytes())
            self.assertEqual(manifest["workspace_archive_disposition"],
                             "EMPTY_PRIVATE_W25_WORKSPACE_PROJECT_INPUT_COPY_INCLUDED")
            self.assertEqual((destination / "w23-evidence" / run.name /
                              "public-receipts.jsonl").read_bytes(), journal.read_bytes())

            (workspace / "unreviewed-extra.bin").write_bytes(b"outside the exact W23 input")
            (workspace / "unreviewed-extra.bin").chmod(0o600)
            second_destination = scratch_root / "persistent-extra-workspace"
            second_destination.mkdir(mode=0o700)
            with self.assertRaisesRegex(
                    actual.ActualEntryGuardError,
                    "W25 admitted workspace must remain empty after project-input relocation"):
                actual._persist_raw_evidence(
                    root, second_destination, project_input_root=project_root)
            (workspace / "unreviewed-extra.bin").unlink()

            (root / "unexpected.json").write_bytes(b"must reject")
            (root / "unexpected.json").chmod(0o600)
            with self.assertRaises(actual.ActualEntryGuardError):
                actual._persist_raw_evidence(root, destination, partial=True,
                                             project_input_root=project_root)

    def test_real_artifact_register_accepts_nonhidden_input_and_rejects_private_workspace(self):
        """Use the actual public ControlDaemon -> ManagedBackend -> ArtifactStore route."""
        class Snapshot:
            def model_snapshot(self, _tag):
                return {"model_tag": "unused", "server_instance_id": "r6-path-server",
                        "external_event_counter": 0, "fingerprint": "unused"}

        with tempfile.TemporaryDirectory(prefix="w23-r6-artifact-register-") as scratch:
            root = Path(scratch).resolve(strict=True)
            project_container = root / "projects"
            project_container.mkdir(mode=0o700)
            ledger = SessionLedger("r6-path-session", "r6-path-server")
            service = ExecutionService(ledger, Snapshot(), project_root=project_container)
            daemon = ControlDaemon(root / "control", service=service, registry={},
                                  project_root=project_container)
            daemon.backend.endpoint_key = "127.0.0.1:2040"
            try:
                created = daemon.dispatch({
                    "operation": "project.create",
                    "arguments": {
                        "label": "r6-path-project", "workspace": "r6-path-project",
                        "policy": {"permissions": ["inspect", "project_write", "compute"]},
                    },
                    "execution": {"request_id": "r6-path-project-create",
                                  "idempotency_key": "r6-path-project-create"},
                })
                self.assertTrue(created["success"], created)
                project = created["data"]["project"]
                project_root = Path(project["workspace"]).resolve(strict=True)
                run_id = uuid.uuid4().hex
                input_root = project_root / f"w23-input-{run_id}"
                input_root.mkdir(mode=0o700)
                saved = input_root / actual.SAVED_MPH_PATH.name
                shutil.copyfile(actual.SAVED_MPH_PATH, saved)
                saved.chmod(0o400)
                expected_sha = "cba0c1d404003c4e60a20b04316cb1456c38cc2b45596dc2dc29bbed62674a8c"
                self.assertEqual(actual.entry.verify_saved_mph_copy(str(saved))["sha256"],
                                 expected_sha)

                def register(path, key):
                    return daemon.dispatch({
                        "operation": "artifact.register",
                        "arguments": {
                            "project_id": project["project_id"],
                            "idempotency_key": key, "path": path,
                            "role": "saved_model", "classification": "project_local",
                            "artifact_type": "application/vnd.comsol.mph",
                            "format_version": "comsol-mph-savecopy/1",
                        },
                        "execution": {"project_id": project["project_id"],
                                      "request_id": key + "-request",
                                      "idempotency_key": key},
                    })

                allowed_relative = f"w23-input-{run_id}/{saved.name}"
                accepted = register(allowed_relative, "r6-nonhidden-register")
                self.assertTrue(accepted["success"], accepted)
                self.assertEqual(accepted["data"]["sha256"], expected_sha)
                self.assertEqual(accepted["data"]["provenance"]["source_project_relative_path"],
                                 allowed_relative)
                before = daemon.store.list_metadata("artifacts")
                self.assertEqual(len(before), 1)

                private = project_root / f".w25-probe-{run_id}" / "workspace"
                private.mkdir(parents=True, mode=0o700)
                private_saved = private / saved.name
                shutil.copyfile(saved, private_saved)
                private_saved.chmod(0o400)
                refused = register(
                    f".w25-probe-{run_id}/workspace/{saved.name}",
                    "r6-hidden-workspace-register",
                )
                error = refused.get("error") or refused.get("data", {}).get("error", {})
                self.assertFalse(refused["success"], refused)
                self.assertEqual(error.get("code"), "ACCESS_VIOLATION", refused)
                self.assertEqual(daemon.store.list_metadata("artifacts"), before)
            finally:
                daemon.close()


