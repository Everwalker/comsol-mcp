"""Compose W23 reads with an already-admitted W25 original-owner runtime.

This bridge never creates an admission, once token, approval, Server, Worker,
or project. Main must supply the exact still-live W25 admission object. Every
W23 public request goes through that admission's BoundManagedPublicGate and
terminal status is read directly from the same ControlDaemon OperationStore.
"""
from __future__ import annotations

import hashlib
import importlib
import json
import os
import stat
import sys
from pathlib import Path
from typing import Any, Mapping

from . import w23_zero_solve_runtime as runtime


_W25_ROOT_NAME = "w25-r5-fresh-runtime-entry-6fc675b5-c7a1-4483-9de5-51d2ceeccd8f-20261019"
_W25_FILES = {
    "probe/admission.py": {
        "bytes": 31173,
        "sha256": "90cdfc37e38d93ff7de773a389bfbda11ab60ef28a4a7ff4dbfae1c3e0675798",
    },
    "probe/runner.py": {
        "bytes": 92778,
        "sha256": "6c677fe266d977b8ab6a4cd4edc799d6764061ba4113d8c6213956a87c685930",
    },
    "probe/operation_store_witness.py": {
        "bytes": 13572,
        "sha256": "37a81dc70d01cca7f09b14a6a77a48eab3bf871212c4fa7b23603eae7143f08f",
    },
}


class OwnedRuntimeEntryError(RuntimeError):
    """The supplied W25 owner is not the exact live, source-pinned admission."""


def _canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode("utf-8")


def _w25_modules() -> tuple[Any, Any, Any, Any]:
    repository = Path(__file__).resolve().parents[3]
    w25_root = repository / "_state" / _W25_ROOT_NAME
    probe_root = w25_root / "probe"
    for relative, expected in _W25_FILES.items():
        path = w25_root / relative
        try:
            raw = path.read_bytes()
        except OSError as exc:
            raise OwnedRuntimeEntryError(f"pinned W25 source dependency is unavailable: {relative}") from exc
        if len(raw) != expected["bytes"] or hashlib.sha256(raw).hexdigest() != expected["sha256"]:
            raise OwnedRuntimeEntryError(f"pinned W25 source dependency changed: {relative}")
    source_root = Path(__file__).resolve().parents[1] / "source"
    for value in (str(probe_root), str(source_root)):
        if value in sys.path:
            sys.path.remove(value)
    sys.path[:0] = [str(source_root), str(probe_root)]
    expected_paths = {
        "runner": probe_root / "runner.py",
        "admission": probe_root / "admission.py",
        "operation_store_witness": probe_root / "operation_store_witness.py",
    }
    for name, path in expected_paths.items():
        loaded = sys.modules.get(name)
        loaded_path = getattr(loaded, "__file__", None) if loaded is not None else None
        if loaded_path is not None and Path(loaded_path).resolve() != path.resolve():
            del sys.modules[name]
    try:
        witness = importlib.import_module("operation_store_witness")
        runner = importlib.import_module("runner")
        admission_module = importlib.import_module("admission")
        from comsol_mcp._control_daemon import ControlDaemon
        from comsol_mcp._operation_store import OperationStore
    except Exception as exc:
        raise OwnedRuntimeEntryError("pinned W25 original-owner source could not be imported") from exc
    for name, module in (("runner", runner), ("admission", admission_module),
                         ("operation_store_witness", witness)):
        if Path(module.__file__).resolve() != expected_paths[name].resolve():
            raise OwnedRuntimeEntryError(f"W25 {name} import escaped its pinned source file")
    expected_source_modules = {
        "comsol_mcp._control_daemon": source_root / "comsol_mcp" / "_control_daemon.py",
        "comsol_mcp._operation_store": source_root / "comsol_mcp" / "_operation_store.py",
    }
    for name, path in expected_source_modules.items():
        loaded = sys.modules.get(name)
        loaded_path = getattr(loaded, "__file__", None) if loaded is not None else None
        if loaded_path is None or Path(loaded_path).resolve() != path.resolve():
            raise OwnedRuntimeEntryError(f"{name} import escaped the exact W23 candidate source projection")
    if (getattr(ControlDaemon, "__module__", None) != "comsol_mcp._control_daemon"
            or getattr(OperationStore, "__module__", None) != "comsol_mcp._operation_store"):
        raise OwnedRuntimeEntryError("pinned owner types are not loaded from the expected W23 source modules")
    candidate_root = Path(__file__).resolve().parents[1]
    source_root_real = source_root.resolve(strict=True)
    if (Path(runtime.__file__).resolve() != candidate_root / "probe" / "w23_zero_solve_runtime.py"
            or Path(runtime.entry.__file__).resolve() != candidate_root / "probe" / "w23_zero_solve_entry.py"
            or Path(sys.modules["probe"].__file__).resolve() != candidate_root / "probe" / "__init__.py"):
        raise OwnedRuntimeEntryError("W23 runtime, entry, or probe package escaped the exact candidate projection")
    for name, module in tuple(sys.modules.items()):
        if name == "comsol_mcp" or name.startswith("comsol_mcp."):
            loaded_path = getattr(module, "__file__", None)
            if loaded_path is None or not Path(loaded_path).resolve().is_relative_to(source_root_real):
                raise OwnedRuntimeEntryError(
                    f"loaded COMSOL module escaped the exact W23 candidate source projection: {name}")
    return admission_module, runner, ControlDaemon, OperationStore


class W23OwnedRuntimeBridge:
    """Public dispatcher and terminal-pair reader bound to one live W25 gate."""

    def __init__(self, admission: Any):
        admission_module, runner, control_daemon_type, operation_store_type = _w25_modules()
        if type(admission) is not admission_module.ProbeSessionAdmission:
            raise OwnedRuntimeEntryError("W23 requires the exact pinned W25 ProbeSessionAdmission object")
        host, daemon, gate = admission.host, admission.daemon, admission.gate
        if (type(host) is not admission_module.ProbeControlHost
                or type(daemon) is not control_daemon_type
                or type(gate) is not runner.BoundManagedPublicGate
                or host.daemon is not daemon or gate.daemon is not daemon
                or host.close_delegator is not gate.close_delegator
                or daemon._scoped_host_provider is not host.close_delegator
                or daemon.backend.scoped_host_provider is not host.close_delegator
                or host.run_id != admission.run_id
                or host.root != admission.root
                or gate.project_id != admission.project_id
                or gate.session_id != admission.session_id
                or gate.context.project_id != admission.project_id
                or gate.context.session_id != admission.session_id
                or host._unknown_owner_hold is not None
                or not isinstance(admission.setup_result, Mapping)
                or admission.setup_result.get("status") != "ADMITTED_REGISTERED_MANAGED_SESSION"):
            raise OwnedRuntimeEntryError("W25 admission, host, and original gate identities do not agree")
        if type(daemon.store) is not operation_store_type:
            raise OwnedRuntimeEntryError("W23 terminal proof requires the exact pinned OperationStore")
        try:
            self.owner_identity = gate.assert_live()
        except Exception as exc:
            raise OwnedRuntimeEntryError("W25 original Server/Worker owner is not live") from exc
        self.admission = admission
        self.host = host
        self.daemon = daemon
        self.gate = gate
        self.store = daemon.store
        self.project_id = admission.project_id
        self.session_id = admission.session_id
        self._control_daemon_type = control_daemon_type
        self._operation_store_type = operation_store_type

    def _assert_owner(self) -> dict[str, Any]:
        if (type(self.daemon) is not self._control_daemon_type
                or self.host.daemon is not self.daemon
                or self.gate.daemon is not self.daemon
                or self.daemon.store is not self.store
                or type(self.store) is not self._operation_store_type
                or self.gate.project_id != self.project_id
                or self.gate.session_id != self.session_id):
            raise OwnedRuntimeEntryError("W23 original owner or OperationStore identity changed")
        try:
            return self.gate.assert_live()
        except Exception as exc:
            raise OwnedRuntimeEntryError("W23 original Server/Worker owner changed or became terminal") from exc

    def dispatch(self, operation: str, arguments: Mapping[str, Any],
                 execution: Mapping[str, Any]) -> Mapping[str, Any]:
        """Forward the complete transport request supplied by the W23 routes.

        FreshOwnerRoute and PublicRoute already call their dispatcher with
        operation="operation_call" and arguments={operation_id, arguments}.
        Wrapping that payload again changes the semantic operation into a
        nested operation_call(operation_call(...)) and is not the producer
        contract. Keep the caller's raw transport shape intact.
        """
        self._assert_owner()
        if (not isinstance(operation, str) or not isinstance(arguments, Mapping)
                or not isinstance(execution, Mapping)
                or operation != "operation_call"
                or set(arguments) != {"operation_id", "arguments"}
                or not isinstance(arguments.get("operation_id"), str)
                or not arguments.get("operation_id")
                or not isinstance(arguments.get("arguments"), Mapping)
                or execution.get("project_id") != self.project_id
                or execution.get("session_id") != self.session_id):
            raise OwnedRuntimeEntryError("W23 public request escaped the exact admitted project/session")
        request = {"operation": operation, "arguments": dict(arguments),
                   "execution": dict(execution)}
        try:
            response = self.gate.dispatch(request)
        except BaseException:
            # A dispatched call may have reached Worker; the caller records
            # UNKNOWN and must never replay it.
            raise
        self._assert_owner()
        if not isinstance(response, Mapping):
            raise OwnedRuntimeEntryError("original ControlDaemon returned a non-mapping public response")
        return response

    def read_terminal_pair(self, request: Mapping[str, Any],
                           response: Mapping[str, Any]) -> dict[str, Any]:
        owner_before = self._assert_owner()
        execution = response.get("execution") if isinstance(response, Mapping) else None
        if (not isinstance(execution, Mapping)
                or execution.get("project_id") != self.project_id
                or execution.get("session_id") != self.session_id):
            raise OwnedRuntimeEntryError("raw response does not bind to this original owner project/session")
        operation_id = execution.get("operation_id")
        job_id = execution.get("job_id")
        if not isinstance(operation_id, str) or not operation_id or not isinstance(job_id, str) or not job_id:
            raise OwnedRuntimeEntryError("raw response omitted exact OperationStore operation/job ids")
        try:
            operation = self.store.get_operation(operation_id)
            job = self.store.operation_job(operation_id)
        except Exception as exc:
            raise OwnedRuntimeEntryError("same-owner OperationStore terminal pair could not be read") from exc
        owner_after = self._assert_owner()
        if (owner_before.get("server_pid") != owner_after.get("server_pid")
                or owner_before.get("worker_pid") != owner_after.get("worker_pid")
                or owner_before.get("worker_instance_id") != owner_after.get("worker_instance_id")
                or owner_before.get("worker_epoch") != owner_after.get("worker_epoch")):
            raise OwnedRuntimeEntryError("original owner identity changed during terminal pair readback")
        if (not isinstance(operation, Mapping) or not isinstance(job, Mapping)
                or job.get("job_id") != job_id):
            raise OwnedRuntimeEntryError("same-owner OperationStore did not return the exact operation/job pair")
        return {
            "operation": dict(operation), "job": dict(job),
            "owner_identity": {
                "project_id": self.project_id, "session_id": self.session_id,
                "server_pid": owner_after["server_pid"], "worker_pid": owner_after["worker_pid"],
                "worker_instance_id": owner_after["worker_instance_id"],
                "worker_epoch": owner_after["worker_epoch"],
            },
        }


def _write_new_json(path: Path, value: Mapping[str, Any]) -> str:
    raw = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False,
                      allow_nan=False) + "\n").encode("utf-8")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        dfd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) |
                      getattr(os, "O_NOFOLLOW", 0))
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        raise
    return hashlib.sha256(raw).hexdigest()


def _path_signature(info: os.stat_result) -> tuple[int, int, int, int, int, int, int, int]:
    return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink,
            info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def _copy_pinned_mph_to_project_input(*, project_root: str | Path, workspace: str | Path,
                                      run_id: str) -> dict[str, Any]:
    """Create the exact read-only MPH copy at a non-hidden project input path.

    The destination is created once with O_EXCL and fsynced. A partial or
    pre-existing destination is retained and fails closed. The W25 workspace
    remains private and empty; artifact.register reads the byte-identical copy
    from the ordinary project-relative ``w23-input-<run-id>/`` directory.
    """
    candidate_root = Path(__file__).resolve().parents[1]
    source = candidate_root / "inputs" / "w23_coarse-phase0_provisional.mph"
    source_fd = -1
    target_fd = -1
    try:
        identity = runtime.entry.verify_saved_mph_copy(str(source))
        base = Path(project_root)
        base_info = base.lstat()
        base_real = base.resolve(strict=True)
        if (not base.is_absolute() or stat.S_ISLNK(base_info.st_mode)
                or not stat.S_ISDIR(base_info.st_mode) or base_info.st_uid != os.getuid()
                or base_real != base):
            raise OwnedRuntimeEntryError("W23 project root is not the exact owned canonical directory")
        if (not isinstance(run_id, str) or len(run_id) != 32
                or any(char not in "0123456789abcdef" for char in run_id)):
            raise OwnedRuntimeEntryError("W23 managed workspace requires the exact fresh W25 run id")
        owner_root = base / f".w25-probe-{run_id}"
        expected_workspace = owner_root / "workspace"
        workspace_path = Path(workspace)
        if not workspace_path.is_absolute() or workspace_path != expected_workspace:
            raise OwnedRuntimeEntryError("W23 saved-MPH destination is not the exact admitted W25 workspace")
        for directory in (owner_root, workspace_path):
            info = directory.lstat()
            if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700
                    or directory.resolve(strict=True) != directory):
                raise OwnedRuntimeEntryError("W23 admitted workspace is not a private owned directory")

        source_before = source.lstat()
        if (stat.S_ISLNK(source_before.st_mode) or not stat.S_ISREG(source_before.st_mode)
                or source_before.st_uid != os.getuid() or source_before.st_nlink != 1
                or stat.S_IMODE(source_before.st_mode) & 0o222):
            raise OwnedRuntimeEntryError("immutable W23 MPH candidate is not a private read-only regular file")
        source_fd = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        source_open = os.fstat(source_fd)
        if _path_signature(source_before) != _path_signature(source_open):
            raise OwnedRuntimeEntryError("immutable W23 MPH candidate changed while opening")

        input_root = base / f"w23-input-{run_id}"
        try:
            os.mkdir(input_root, 0o700)
        except FileExistsError as exc:
            raise OwnedRuntimeEntryError("fresh W23 non-hidden project input directory already exists") from exc
        input_info = input_root.lstat()
        if (stat.S_ISLNK(input_info.st_mode) or not stat.S_ISDIR(input_info.st_mode)
                or input_info.st_uid != os.getuid() or stat.S_IMODE(input_info.st_mode) != 0o700
                or input_root.resolve(strict=True) != input_root
                or input_root.parent != base or input_root.name.startswith(".")):
            raise OwnedRuntimeEntryError("W23 project input directory is not an owned canonical non-hidden child")

        target = input_root / source.name
        target_fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                            getattr(os, "O_NOFOLLOW", 0), 0o400)
        os.fchmod(target_fd, 0o400)
        digest = hashlib.sha256()
        copied = 0
        while block := os.read(source_fd, 1024 * 1024):
            copied += len(block)
            if copied > identity["bytes"]:
                raise OwnedRuntimeEntryError("immutable W23 MPH exceeded its pinned byte count")
            digest.update(block)
            view = memoryview(block)
            while view:
                written = os.write(target_fd, view)
                if written <= 0:
                    raise OwnedRuntimeEntryError("W23 MPH destination write made no progress")
                view = view[written:]
        if copied != identity["bytes"] or digest.hexdigest() != identity["sha256"]:
            raise OwnedRuntimeEntryError("W23 MPH bytes differ from the exact immutable input")
        os.fsync(target_fd)
        target_open = os.fstat(target_fd)
        source_after = os.fstat(source_fd)
        source_named_after = source.lstat()
        if (_path_signature(source_open) != _path_signature(source_after)
                or _path_signature(source_after) != _path_signature(source_named_after)):
            raise OwnedRuntimeEntryError("immutable W23 MPH candidate changed during copy")
        os.close(target_fd)
        target_fd = -1
        os.close(source_fd)
        source_fd = -1
        target_named = target.lstat()
        if (stat.S_ISLNK(target_named.st_mode)
                or _path_signature(target_open) != _path_signature(target_named)):
            raise OwnedRuntimeEntryError("W23 managed-workspace MPH identity changed after copy")
        dfd = os.open(input_root, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) |
                      getattr(os, "O_NOFOLLOW", 0))
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
        destination_identity = runtime.entry.verify_saved_mph_copy(str(target))
        if (destination_identity["bytes"] != identity["bytes"]
                or destination_identity["sha256"] != identity["sha256"]
                or destination_identity["mode"] != "0o400"):
            raise OwnedRuntimeEntryError("W23 project-input MPH readback differs from its immutable source")
        relative = target.relative_to(base).as_posix()
        if relative != f"w23-input-{run_id}/{source.name}":
            raise OwnedRuntimeEntryError("W23 project input did not remain at the exact non-hidden relative path")
        return {"source_identity": identity, "destination_identity": destination_identity,
                "source_project_relative_path": relative}
    except OwnedRuntimeEntryError:
        raise
    except Exception as exc:
        raise OwnedRuntimeEntryError("exact immutable W23 MPH copy could not be prepared") from exc
    finally:
        if target_fd >= 0:
            os.close(target_fd)
        if source_fd >= 0:
            os.close(source_fd)


def run_w23_from_owned_admission(admission: Any, *, source_projection_sha256: str,
                                 execute_numeric: bool = False) -> dict[str, Any]:
    """Run the fresh W23 entry only inside Main's already-admitted W25 owner."""
    bridge = W23OwnedRuntimeBridge(admission)
    admission_root = Path(admission.root)
    root_info = admission_root.lstat()
    if (stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode)
            or root_info.st_uid != os.getuid() or stat.S_IMODE(root_info.st_mode) != 0o700
            or admission_root.resolve(strict=True) != admission_root):
        raise OwnedRuntimeEntryError("W25 admission evidence root is not the exact private owned directory")
    # W25's public project.create request is deliberately relative (for
    # example ``.w25-probe-<run-id>/workspace``), while its admitted
    # ``setup_result.workspace`` is the absolute path returned by the public
    # response.  Bind those two producer fields to the exact project root
    # before the MPH copy; passing ``admission.workspace`` directly to the
    # strict copy helper rejects every genuine W25 admission before any W23
    # read can start.
    project_root = Path(bridge.daemon.backend.project_root)
    expected_owner_root = project_root / f".w25-probe-{admission.run_id}"
    expected_workspace = expected_owner_root / "workspace"
    expected_relative_workspace = f"{expected_owner_root.name}/workspace"
    public_workspace = admission.setup_result.get("workspace")
    if (admission.root != expected_owner_root
            or admission.workspace != expected_relative_workspace
            or not isinstance(public_workspace, str)
            or Path(public_workspace) != expected_workspace):
        raise OwnedRuntimeEntryError(
            "W25 relative workspace and public absolute workspace do not bind the exact admitted project root")
    source_copy = _copy_pinned_mph_to_project_input(
        project_root=project_root,
        workspace=public_workspace, run_id=admission.run_id)
    receipt_path = admission_root / "W23_SAVED_MPH_COPY_BINDING_R2.json"
    source_copy_record = {
        "schema": "w23-r6-saved-mph-copy-binding/2",
        "status": "PASS_EXACT_IMMUTABLE_SOURCE_COPIED_TO_NON_HIDDEN_PROJECT_INPUT",
        "run_id": admission.run_id, "project_id": bridge.project_id,
        "session_id": bridge.session_id,
        "project_root": str(project_root),
        "source_identity": source_copy["source_identity"],
        "destination_identity": source_copy["destination_identity"],
        "source_project_relative_path": source_copy["source_project_relative_path"],
        "opened_by_comsol": False,
    }
    receipt_sha256 = _write_new_json(receipt_path, source_copy_record)
    evidence_parent = admission_root / "w23-evidence"
    os.mkdir(evidence_parent, 0o700)
    evidence_info = evidence_parent.lstat()
    if (stat.S_ISLNK(evidence_info.st_mode) or not stat.S_ISDIR(evidence_info.st_mode)
            or evidence_info.st_uid != os.getuid() or stat.S_IMODE(evidence_info.st_mode) != 0o700
            or evidence_parent.resolve(strict=True) != evidence_parent):
        raise OwnedRuntimeEntryError("W23 durable evidence directory is not a private owned child")
    session_context = {"project_id": bridge.project_id, "session_id": bridge.session_id}
    result = runtime.run_zero_solve_entry(
        session_context=session_context,
        source_projection_sha256=source_projection_sha256,
        project_root=str(bridge.daemon.backend.project_root),
        source_project_relative_path=source_copy["source_project_relative_path"],
        saved_mph_copy=source_copy["destination_identity"]["path"], evidence_parent=evidence_parent,
        execute_numeric=execute_numeric, dispatcher=bridge.dispatch,
        terminal_pair_reader=bridge.read_terminal_pair, owned_gate=bridge.gate,
    )
    return {**result, "saved_mph_copy_binding": {
        "path": str(receipt_path), "sha256": receipt_sha256, "identity": source_copy_record,
    }}
