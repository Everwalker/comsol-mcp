+    """Reject a substitute/tampered record; preserve the historical UNKNOWN."""
+    route = result
+    response = route["response"]
+    data = response["data"]
+    worker = data["worker"]
+    failure = worker["failure"]
+    cause_chain = failure["cause_chain"]
+    testcase.assertEqual(route["operation"], "operation_call")
+    testcase.assertEqual(route["slot"], ["baseline", "step"])
+    testcase.assertEqual(response["success"], False)
+    testcase.assertEqual(response["execution_state_unknown"], True)
+    testcase.assertEqual(response["error"]["code"], "EXECUTION_STATE_UNKNOWN")
+    testcase.assertEqual(response["error"]["safe_retry"], False)
+    testcase.assertEqual(data["source_sha256"], ORIGINAL_FIXTURE_SHA256)
+    testcase.assertEqual(worker["status"], "FAILED")
+    testcase.assertEqual(failure["code"], "ENGINE_CALL_FAILED")
+    testcase.assertEqual(cause_chain[-1]["type"], "java.lang.IllegalStateException")
+    testcase.assertEqual(cause_chain[-1]["message"], "selection trace exceeded its fixed safe envelope")
+    testcase.assertEqual(len(rows), 1024)
+    testcase.assertEqual([row["sequence"] for row in rows], list(range(1, 1025)))
+    testcase.assertEqual(rows[-1]["stage"], "solver.sol1.feature.t1.i1.resolve")
+    testcase.assertEqual(rows[-1]["phase"], "before")
+
+
