def _verify_r16_historical_output(root: Path | None = None) -> dict[str, Any]:
    """Verify only the exact R16 UNKNOWN output subtree appended to R15."""
    root = R6_PREVIOUS_ROOT if root is None else Path(root)
    run_root = root / R16_HISTORICAL_RUN_RELATIVE
    review, review_sha = _strict_json(R16_MAIN_TERMINAL_REVIEW, limit=256 * 1024)
    if (review_sha != R16_MAIN_TERMINAL_REVIEW_SHA256
            or review.get("schema") != "W23_R16_MAIN_ACTUAL_FAILURE_TERMINAL_REVIEW_V1"
            or review.get("status") != "FAIL_PROTECTED_PATH_VALIDATION_OUTER_UNKNOWN_RETAINED_EXACT_OWNERS_TERMINAL"
            or review.get("root_cause") != "W23 attempted to register saved MPH from protected hidden W25 workspace; production path guard correctly refused"
            or review.get("actual_public_calls") != 4
            or review.get("model_load") != 0
            or review.get("field_reads") != 0
            or review.get("no_replay") is not True
            or review.get("native_acceptance") != "NOT_ACCEPTED"):
        raise OuterControllerError("R16 historical output is not bound to the exact preserved Main terminal review")
    expected_files = set(R16_HISTORICAL_RUN_FILES)
    actual_files: set[str] = set()
    actual_dirs: set[str] = set()
    for current in run_root.rglob("*"):
        info = current.lstat()
        rel = current.relative_to(run_root).as_posix()
        if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            raise OuterControllerError("R16 historical output contains a symlink or special file")
        if stat.S_ISDIR(info.st_mode):
            actual_dirs.add(rel)
        else:
            actual_files.add(rel)
    expected_dirs = {str(parent) for rel in expected_files
                     for parent in Path(rel).parents if str(parent) != "."}
    if actual_files != expected_files or actual_dirs != expected_dirs:
        raise OuterControllerError("R16 historical output tree differs from the exact declared 15-file set")
    verified = []
    for rel, (expected_bytes, expected_sha) in sorted(R16_HISTORICAL_RUN_FILES.items()):
        raw, info = _stable_bytes(run_root / rel, limit=64 * 1024 * 1024)
        digest = hashlib.sha256(raw).hexdigest()
        if (len(raw) != expected_bytes or stat.S_IMODE(info.st_mode) != 0o600
                or digest != expected_sha):
            raise OuterControllerError(f"R16 historical output changed: {rel}")
        verified.append({"path": rel, "bytes": expected_bytes, "mode_octal": "0600",
                         "sha256": digest})
    manifest_path = run_root / "PERSISTED_RAW_EVIDENCE_MANIFEST_R1.json"
    entry_failure, _ = _strict_json(run_root / "R6_ENTRY_FAILURE.json")
    manifest_sha = hashlib.sha256(manifest_path.read_bytes()).hexdigest()
    if (manifest_sha != "784374d35f53ce2170f2765cb515e46cbd8086f3bfae4ef1494e0892e943904b"
            or entry_failure.get("status") != "UNKNOWN_OR_BLOCKED_NO_REPLAY"
            or entry_failure.get("persistent_evidence_manifest", {}).get("sha256") != manifest_sha
            or entry_failure.get("first_failure_record", {}).get("sha256") != R16_HISTORICAL_RUN_FILES["R6_FIRST_FAILURE.json"][1]
            or "ACCESS_VIOLATION" not in entry_failure.get("failure_short", "")
            or ".w25-probe-" not in entry_failure.get("failure_short", "")):
        raise OuterControllerError("R16 historical UNKNOWN first-cause and retained raw manifest do not bind")
    return {"status": "PASS_EXACT_R16_UNKNOWN_OUTPUT_PRESERVED",
            "main_terminal_review_sha256": review_sha,
            "run_relative_path": R16_HISTORICAL_RUN_RELATIVE.as_posix(),
            "files": verified, "file_count": len(verified)}


def _canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode("utf-8")


def _attach_r6_inner_failure(failure: dict[str, Any], outcome: Any) -> None:
    """Retain the exact R6 UNKNOWN result when outer validation also fails.

    R6's result mapping is the in-memory primary-cause record.  It is preserved
    verbatim alongside the outer error so a later evidence-copy failure cannot
    reduce the report to a generic R8 validation message.
    """
    result = getattr(outcome, "result", None)
    if (not isinstance(result, Mapping)
            or result.get("status") != "UNKNOWN_OR_BLOCKED_NO_REPLAY"
            or result.get("schema") != "w23-zero-solve-r6-actual-entry-failure/1"):
        return
    exact = dict(result)
    raw = _canonical_bytes(exact)
    failure["r6_inner_failure"] = exact
    failure["r6_inner_failure_sha256"] = hashlib.sha256(raw).hexdigest()
    failure["r6_inner_failure_bytes"] = len(raw)


def _pairs_unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise OuterControllerError("duplicate JSON key")
        result[key] = value
    return result


def _stable_bytes(path: Path, *, limit: int) -> tuple[bytes, os.stat_result]:
    path = Path(path)
    named = path.lstat()
    if (stat.S_ISLNK(named.st_mode) or not stat.S_ISREG(named.st_mode)
            or named.st_uid != os.getuid() or named.st_nlink != 1
            or named.st_mode & 0o022 or named.st_size > limit):
        raise OuterControllerError(f"unsafe or oversized evidence file: {path}")
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        before = os.fstat(fd)
        sig = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_nlink,
                         s.st_size, s.st_mtime_ns, s.st_ctime_ns)
        if sig(named) != sig(before):
            raise OuterControllerError("evidence identity changed while opening")
        chunks: list[bytes] = []
        count = 0
        while True:
            block = os.read(fd, min(1024 * 1024, limit + 1 - count))
            if not block:
                break
            count += len(block)
            if count > limit:
                raise OuterControllerError("evidence exceeds exact read bound")
            chunks.append(block)
        after = os.fstat(fd)
        if sig(before) != sig(after) or sig(after) != sig(path.lstat()):
            raise OuterControllerError("evidence identity changed during read")
        raw = b"".join(chunks)
        if len(raw) != before.st_size:
            raise OuterControllerError("evidence size differs from stable file identity")
        return raw, after
    finally:
        os.close(fd)


def _strict_json(path: Path, *, limit: int = MAX_AUTHORITY_BYTES) -> tuple[dict[str, Any], str]:
    raw, _ = _stable_bytes(path, limit=limit)
    try:
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=_pairs_unique,
                           parse_constant=lambda _: (_ for _ in ()).throw(
                               OuterControllerError("non-finite JSON number")))
    except OuterControllerError:
        raise
    except Exception as exc:
        raise OuterControllerError("strict JSON evidence is malformed") from exc
    if not isinstance(value, dict):
        raise OuterControllerError("JSON evidence root must be an object")
    return value, hashlib.sha256(raw).hexdigest()


def _write_new_json(path: Path, value: Mapping[str, Any]) -> str:
    path = Path(path)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    parent_info = path.parent.lstat()
    if (stat.S_ISLNK(parent_info.st_mode) or not stat.S_ISDIR(parent_info.st_mode)
            or parent_info.st_uid != os.getuid() or stat.S_IMODE(parent_info.st_mode) != 0o700):
        raise OuterControllerError("outer evidence parent is not a private owned directory")
    raw = _canonical_bytes(dict(value)) + b"\n"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        view = memoryview(raw)
        while view:
            count = os.write(fd, view)
            if count <= 0:
                raise OuterControllerError("evidence write made no forward progress")
            view = view[count:]
        os.fsync(fd)
    finally:
        os.close(fd)
    _parent_fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(_parent_fd)
    finally:
        os.close(_parent_fd)
    readback, _ = _stable_bytes(path, limit=MAX_AUTHORITY_BYTES)
    if readback != raw:
        raise OuterControllerError("new authority/receipt differs on stable readback")
    return hashlib.sha256(raw).hexdigest()


def _approval_digest(review: Mapping[str, Any]) -> str:
    return hashlib.sha256(_canonical_bytes({k: v for k, v in review.items()
                                            if k != "approval_sha256"})).hexdigest()


def _load_r6_package() -> tuple[ModuleType, ModuleType]:
    """Load canonical probe only when its package origin is this exact R6 root."""
    probe_root = (R6_ROOT / "probe").resolve(strict=True)
    init_path = (probe_root / "__init__.py").resolve(strict=True)

    def validate_package(package: ModuleType) -> None:
        try:
            package_file = Path(package.__file__).resolve(strict=True)
            package_paths = tuple(Path(value).resolve(strict=True)
                                  for value in getattr(package, "__path__", ()))
            spec_paths = tuple(Path(value).resolve(strict=True)
                               for value in getattr(getattr(package, "__spec__", None),
                                                    "submodule_search_locations", ()) or ())
        except (OSError, TypeError, ValueError) as exc:
            raise OuterControllerError("canonical probe package has no stable filesystem origin") from exc
        if package_file != init_path or package_paths != (probe_root,) or spec_paths != (probe_root,):
            raise OuterControllerError("canonical probe package is already bound to a different source root")

    package = sys.modules.get("probe")
    if package is None:
        spec = importlib.util.spec_from_file_location(
            "probe", init_path, submodule_search_locations=[str(probe_root)])
        if spec is None or spec.loader is None:
            raise OuterControllerError("fresh R6 canonical probe package cannot be loaded")
        package = importlib.util.module_from_spec(spec)
        before = {name for name in sys.modules if name == "probe" or name.startswith("probe.")}
        sys.modules["probe"] = package
        try:
            spec.loader.exec_module(package)
        except BaseException:
            for name in tuple(sys.modules):
                if (name == "probe" or name.startswith("probe.")) and name not in before:
                    sys.modules.pop(name, None)
            raise
        validate_package(package)
    else:
        validate_package(package)

    expected_modules = {
        "probe.w23_actual_entry_r6": R6_ENTRY_PATH,
        "probe.w23_zero_solve_runtime": R6_ROOT / "probe/w23_zero_solve_runtime.py",
    }
    for name, expected_path in expected_modules.items():
        existing = sys.modules.get(name)
        if existing is not None:
            try:
                observed = Path(existing.__file__).resolve(strict=True)
            except (OSError, TypeError) as exc:
                raise OuterControllerError(f"{name} has no stable source origin") from exc
            if observed != expected_path.resolve(strict=True):
                raise OuterControllerError(f"{name} is already loaded from another R6 source root")

    entry_module = importlib.import_module("probe.w23_actual_entry_r6")
    runtime_module = importlib.import_module("probe.w23_zero_solve_runtime")
    validate_package(package)
    if (entry_module.__name__ != "probe.w23_actual_entry_r6"
            or runtime_module.__name__ != "probe.w23_zero_solve_runtime"
            or Path(entry_module.__file__).resolve(strict=True) != R6_ENTRY_PATH.resolve(strict=True)
            or Path(runtime_module.__file__).resolve(strict=True) !=
                (R6_ROOT / "probe/w23_zero_solve_runtime.py").resolve(strict=True)):
        raise OuterControllerError("R6 canonical package import escaped the exact fresh candidate")
    return entry_module, runtime_module



def _load_r5_controller() -> ModuleType:
    name = "_w25_r5_owner_lifecycle_frozen_6fc675b5"
    existing = sys.modules.get(name)
    if existing is not None:
        if Path(getattr(existing, "__file__", "")).resolve() != R5_CONTROLLER_PATH.resolve():
            raise OuterControllerError("R5 lifecycle helper module name is bound to another source")
        return existing
    spec = importlib.util.spec_from_file_location(name, R5_CONTROLLER_PATH)
    if spec is None or spec.loader is None:
        raise OuterControllerError("pinned R5 original-owner controller cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        sys.modules.pop(name, None)
        raise
    if Path(module.__file__).resolve() != R5_CONTROLLER_PATH.resolve():
        raise OuterControllerError("R5 helper import escaped its frozen file")
    return module


def _verify_r6_live_member_set(root: Path, expected: set[str], excluded: set[str], *,
                               separately_verified: set[str] | None = None) -> dict[str, Any]:
    """Match packet files, authority leaves, and an exact verified sidecar.

    The authority leaf contents remain the pinned R6 entry's responsibility:
    its strict current-hash reader consumes them before admission. This helper
    only prevents those two declared runtime files from being mistaken for
    packet source members. A sidecar allowlist is used only for the historical
    R15 predecessor after its exact compile-sidecar consumer has validated all
    paths, bytes, modes, class rows, and compiler streams.
    """
    separately_verified = set() if separately_verified is None else set(separately_verified)
    if expected & R6_RUNTIME_AUTHORITY_LEAVES or excluded & R6_RUNTIME_AUTHORITY_LEAVES:
        raise OuterControllerError("R6 runtime authority leaves cannot be packet records or self exclusions")
    if separately_verified & (expected | excluded | R6_RUNTIME_AUTHORITY_LEAVES):
        raise OuterControllerError("separately verified sidecar overlaps packet or authority leaves")
    actual: set[str] = set()
    for current in root.rglob("*"):
        try:
            info = current.lstat()
        except OSError as exc:
            raise OuterControllerError("R6 candidate changed during packet member enumeration") from exc
        rel = current.relative_to(root).as_posix()
        if stat.S_ISLNK(info.st_mode):
            raise OuterControllerError(f"R6 candidate contains a symlink outside its regular-file packet: {rel}")
        if stat.S_ISDIR(info.st_mode):
            continue
        if not stat.S_ISREG(info.st_mode):
            raise OuterControllerError(f"R6 candidate contains a special file: {rel}")
        if ("__pycache__" in Path(rel).parts or rel.endswith(".pyc")
                or ".pytest_cache" in Path(rel).parts):
            continue
        if rel in excluded:
            continue
        if rel in separately_verified:
            continue
        actual.add(rel)

    observed_authorities = actual & R6_RUNTIME_AUTHORITY_LEAVES
    if observed_authorities and observed_authorities != R6_RUNTIME_AUTHORITY_LEAVES:
        raise OuterControllerError("R6 fixed runtime authority leaves must be both absent or both present")
    source_actual = actual - observed_authorities
    if source_actual != expected:
        raise OuterControllerError("R6 packet record set differs from the exact live regular-file set")
    return {
        "status": "PASS_EXACT_LIVE_RECORDS_AND_DECLARED_RUNTIME_AUTHORITIES",
        "record_count": len(expected),
        "separately_verified_file_count": len(separately_verified),
        "observed_runtime_authority_leaves": sorted(observed_authorities),
        "runtime_authority_content_consumer": (
            "PINNED_R6_STRICT_CURRENT_HASH_READER" if observed_authorities else "NOT_PRESENT"
        ),
    }


def _verify_r6_compile_sidecar(*, root: Path | None = None,
                               expected_receipt_sha256: str | None = None,
                               expected_review_sha256: str | None = None) -> dict[str, Any]:
    """Validate the exact JDK11 build sidecar without treating it as R6 source.

    The R17 source packet contains exactly 921 frozen R6 records.  The separately
    Main-reviewed compile receipt adds a finite, exact set of 19 files to the
    live R6 tree: the receipt, its review, two raw compiler streams, and the 15
    class files named and hashed by that receipt.  Every file is checked by
    exact path, bytes, mode, and SHA; extra files still fail the enclosing live
    set comparison.
    """
    # This unchanged source-only javac receipt was produced and Main-reviewed
    # under the prior R15 candidate.  R17 changes only the Python saved-MPH
    # path handling; keep the original receipt/classes at their true source
    # paths instead of copying or rewriting provenance into the new root.
    root = R6_PREVIOUS_ROOT if root is None else Path(root)
    expected_receipt_sha256 = (R6_COMPILE_RECEIPT_SHA256 if expected_receipt_sha256 is None
                               else expected_receipt_sha256)
    expected_review_sha256 = (R6_COMPILE_REVIEW_SHA256 if expected_review_sha256 is None
                              else expected_review_sha256)
    compile_root = root / "evidence/JAVA11_COMPILE_R6"
    receipt_path = compile_root / "JAVA11_COMPILE_RECEIPT_R6.json"
    review_path = compile_root / "MAIN_JAVA11_COMPILE_REVIEW_R15.json"
    receipt, receipt_sha = _strict_json(receipt_path, limit=2 * 1024 * 1024)
    review, review_sha = _strict_json(review_path, limit=256 * 1024)
    if receipt_sha != expected_receipt_sha256 or review_sha != expected_review_sha256:
        raise OuterControllerError("R6 JDK11 compile receipt or Main review SHA changed")
    classes_root = compile_root / "classes_r15"
    if (receipt.get("schema") != "w23-r6-local-jdk11-javac-receipt/1"
            or receipt.get("status") != "COMPILE_PASS_SOURCE_ONLY"
            or receipt.get("returncode") != 0
            or receipt.get("release") != "11"
            or receipt.get("compiler_version") != "javac 11.0.31"
            or receipt.get("class_file_count") != 15
            or receipt.get("classfile_major_versions") != [55]
            or receipt.get("classes_root") != str(classes_root)
            or receipt.get("plan_path") != str(compile_root / "JAVA11_COMPILE_PLAN_R15_UNSIGNED.json")
            or receipt.get("plan_sha256") != "250c9380d5c398396efe97fb166f9c11ea97eddb5d064cfeb7ed60f801a09cd9"
            or receipt.get("source_sha256") != "7054a163f8a68732922320f4906d0586cb8481d7ca0bbfbd1593aace2b50c5d7"
            or receipt.get("native") != "NOT_RUN"
            or receipt.get("once") != "NOT_CREATED"
            or receipt.get("worker_process") != "NOT_RUN"):
        raise OuterControllerError("R6 JDK11 compile receipt does not describe the exact reviewed source-only build")
    if (review.get("status") != "APPROVE_EXACT_SOURCE_ONLY_JAVAC"
            or review.get("native") != "NOT_RUN"
            or review.get("source_sha256") != receipt.get("source_sha256")
            or review.get("plan_sha256") != receipt.get("plan_sha256")
            or review.get("compiler_sha256") != receipt.get("compiler_sha256")
            or review.get("new_output") != str(classes_root)
            or receipt.get("Main_review_sha256") != review_sha):
        raise OuterControllerError("R6 JDK11 compile review and receipt are not a matching source-only pair")

    class_rows = receipt.get("class_files")
    if not isinstance(class_rows, list) or len(class_rows) != 15:
        raise OuterControllerError("R6 JDK11 compile receipt does not contain 15 class rows")
    relative_class_paths: set[str] = set()
    sidecar_paths = {
        "evidence/JAVA11_COMPILE_R6/JAVA11_COMPILE_RECEIPT_R6.json",
        "evidence/JAVA11_COMPILE_R6/MAIN_JAVA11_COMPILE_REVIEW_R15.json",
        "evidence/JAVA11_COMPILE_R6/javac_r15.stdout.raw",
        "evidence/JAVA11_COMPILE_R6/javac_r15.stderr.raw",
    }
    for row in class_rows:
        if (not isinstance(row, Mapping)
                or set(row) != {"path", "bytes", "classfile_major_version", "sha256"}
                or not isinstance(row.get("path"), str)
                or Path(row["path"]).is_absolute()
                or ".." in Path(row["path"]).parts
                or row.get("classfile_major_version") != 55
                or type(row.get("bytes")) is not int
                or not isinstance(row.get("sha256"), str)
                or not HEX64.fullmatch(row["sha256"])
                or row["path"] in relative_class_paths):
            raise OuterControllerError("R6 JDK11 compile class row is malformed or duplicated")
        relative_class_paths.add(row["path"])
        sidecar_paths.add((Path("evidence/JAVA11_COMPILE_R6/classes_r15") / row["path"]).as_posix())
        class_path = classes_root / row["path"]
        class_raw, class_info = _stable_bytes(class_path, limit=8 * 1024 * 1024)
        if (len(class_raw) != row["bytes"] or stat.S_IMODE(class_info.st_mode) != 0o644
                or hashlib.sha256(class_raw).hexdigest() != row["sha256"]
                or len(class_raw) < 8 or class_raw[:4] != b"\xca\xfe\xba\xbe"
                or int.from_bytes(class_raw[6:8], "big") != 55):
            raise OuterControllerError(f"R6 JDK11 class file differs from its receipt: {row['path']}")

    observed_class_files: set[str] = set()
    if not classes_root.is_dir() or classes_root.is_symlink():
        raise OuterControllerError("R6 JDK11 class output root is not a real directory")
    for current in classes_root.rglob("*"):
        info = current.lstat()
        if stat.S_ISLNK(info.st_mode):
            raise OuterControllerError("R6 JDK11 class output contains a symlink")
        if stat.S_ISDIR(info.st_mode):
            continue
        if not stat.S_ISREG(info.st_mode):
            raise OuterControllerError("R6 JDK11 class output contains a special file")
        observed_class_files.add(current.relative_to(classes_root).as_posix())
    if observed_class_files != relative_class_paths:
        raise OuterControllerError("R6 JDK11 class output file set differs from its exact receipt rows")

    for filename, receipt_bytes_key, receipt_sha_key in (
            ("javac_r15.stdout.raw", "stdout_bytes", "stdout_sha256"),
            ("javac_r15.stderr.raw", "stderr_bytes", "stderr_sha256")):
        path = compile_root / filename
        raw, info = _stable_bytes(path, limit=1024 * 1024)
        if (len(raw) != receipt.get(receipt_bytes_key)
                or stat.S_IMODE(info.st_mode) != 0o600
                or hashlib.sha256(raw).hexdigest() != receipt.get(receipt_sha_key)):
            raise OuterControllerError(f"R6 JDK11 compiler stream differs from receipt: {filename}")
    for path in (receipt_path, review_path):
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600:
            raise OuterControllerError("R6 JDK11 receipt/review metadata differs from its producer")
    return {"status": "PASS_EXACT_MAIN_REVIEWED_JDK11_BUILD_SIDECAR",
            "receipt_sha256": receipt_sha, "review_sha256": review_sha,
            "sidecar_paths": sorted(sidecar_paths), "sidecar_file_count": len(sidecar_paths),
            "class_file_count": len(relative_class_paths), "classfile_major_version": 55}


def _verify_r6_packet_manifest(packet: Mapping[str, Any], packet_sha: str) -> dict[str, Any]:
    """Check every R6 packet record against the live tree, including mode and set."""
    if (packet_sha != R6_PACKET_MANIFEST_SHA256
            or packet.get("schema") != "W23_R6_PACKET_MANIFEST_R3_CURRENT_SOURCE/1"
            or packet.get("candidate_root") != str(R6_ROOT)
            or packet.get("record_count") != len(packet.get("records", []))):
        raise OuterControllerError("fresh R6 packet manifest identity/schema/count is not exact")
    excluded = {
        "evidence/PACKET_MANIFEST_R6_R3.json",
        "evidence/W23_R6_SOURCE_REVIEW_REQUEST_R3.json",
        "evidence/VALIDATION_RECEIPT_R3.json",
    }
    if set(packet.get("excluded_self_referential_files", [])) != excluded:
        raise OuterControllerError("R6 packet exclusions do not exactly name the R2 self-referential artifacts")
    records = packet.get("records")
    if not isinstance(records, list):
        raise OuterControllerError("R6 packet records are not a list")
    seen: set[str] = set()
    for row in records:
        if (not isinstance(row, Mapping)
                or set(row) != {"path", "bytes", "mode_octal", "sha256"}
                or not isinstance(row.get("path"), str)
                or row["path"] in seen
                or Path(row["path"]).is_absolute()
                or ".." in Path(row["path"]).parts
                or type(row.get("bytes")) is not int or row["bytes"] < 0
                or row.get("mode_octal") not in {"0400", "0444", "0600", "0644", "0700"}
                or not isinstance(row.get("sha256"), str)
                or not HEX64.fullmatch(row["sha256"])):
            raise OuterControllerError("R6 packet record is malformed or duplicated")
        if row["path"] in R6_RUNTIME_AUTHORITY_LEAVES:
            raise OuterControllerError("R6 runtime authority leaf is not a frozen packet source record")
        seen.add(row["path"])
        path = R6_ROOT / row["path"]
        raw, info = _stable_bytes(path, limit=64 * 1024 * 1024)
        if (len(raw) != row["bytes"]
                or stat.S_IMODE(info.st_mode) != int(row["mode_octal"], 8)
                or hashlib.sha256(raw).hexdigest() != row["sha256"]):
            raise OuterControllerError(f"R6 packet live record differs from exact bytes/mode: {row['path']}")
    compile_sidecar = _verify_r6_compile_sidecar()
    live = _verify_r6_live_member_set(R6_ROOT, seen, excluded)
    return {**live, "record_count": len(seen),
            "live_file_count": len(seen) + compile_sidecar["sidecar_file_count"],
            "excluded_self_referential_files": sorted(excluded),
            "compile_sidecar": compile_sidecar}


def _verify_r2_reviewed_closure() -> dict[str, Any]:
    review, review_sha = _strict_json(R2_MAIN_REVIEW)
    closure, closure_sha = _strict_json(R2_SOURCE_CLOSURE, limit=4 * 1024 * 1024)
    pins, pins_sha = _strict_json(R2_POSTIMAGE_PINS, limit=64 * 1024)
    if (review_sha != R2_MAIN_REVIEW_SHA256
            or review.get("schema") != "W23_R12_DURABILITY_WORKSPACE_R2_MAIN_SOURCE_REVIEW_V1"
            or review.get("status") != "APPROVED_SOURCE_ONLY_FRESH_NATIVE_CHAIN_REQUIRED"
            or review.get("manifest_sha256") != R2_SOURCE_CLOSURE_SHA256
            or review.get("members_rehashed") != 884
            or review.get("source_members_identical_to_previous_frozen_R6") != 875
            or review.get("native") != "NOT_RUN_FOR_R2"
            or review.get("scientific_acceptance") != "NOT_EVALUATED"
            or closure_sha != R2_SOURCE_CLOSURE_SHA256
            or closure.get("candidate_root") != str(R2_ROOT)
            or closure.get("status") != "FROZEN_SOURCE_AND_TEST_INPUT_CLOSURE"
            or closure.get("member_count") != 884
            or not isinstance(closure.get("members"), list)
            or pins_sha != R2_POSTIMAGE_PINS_SHA256
            or pins.get("schema") != "W23_R6_R2_POSTIMAGES_R2/1"
            or pins.get("r2_main_source_review_sha256") != R2_MAIN_REVIEW_SHA256
            or pins.get("r2_source_closure_manifest_sha256") != R2_SOURCE_CLOSURE_SHA256
            or pins.get("status") != "FROZEN_SOURCE_CANDIDATE_R2_REVIEW_ACCEPTED"):
        raise OuterControllerError("Main-accepted R2 source review, closure, or live postimage pins do not match")
    members = closure["members"]
    seen: set[str] = set()
    closure_rows: dict[str, dict[str, Any]] = {}
    for row in members:
        if (not isinstance(row, Mapping)
                or set(row) != {"path", "bytes", "mode", "sha256"}
                or not isinstance(row.get("path"), str)
                or row["path"] in seen or Path(row["path"]).is_absolute()
                or ".." in Path(row["path"]).parts
                or type(row.get("bytes")) is not int or type(row.get("mode")) is not int
                or not isinstance(row.get("sha256"), str)
                or not HEX64.fullmatch(row["sha256"])):
            raise OuterControllerError("R2 source closure row is malformed or duplicated")
        seen.add(row["path"])
        path = R2_ROOT / row["path"]
        raw, info = _stable_bytes(path, limit=64 * 1024 * 1024)
        if (len(raw) != row["bytes"] or stat.S_IMODE(info.st_mode) != row["mode"]
                or hashlib.sha256(raw).hexdigest() != row["sha256"]):
            raise OuterControllerError(f"Main-reviewed R2 closure differs from its live bytes: {row['path']}")
        closure_rows[row["path"]] = dict(row)
    if len(seen) != 884 or closure.get("source_member_count") != 875:
        raise OuterControllerError("R2 reviewed closure counts no longer match the approved review")
    return {"review_sha256": review_sha, "closure_manifest_sha256": closure_sha,
            "postimage_pins_sha256": pins_sha, "reviewed_member_count": len(seen),
            "source_member_count": closure["source_member_count"],
            "postimages": pins.get("postimages"), "closure_rows": closure_rows}


def _live_source_rows(source_root: Path) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for path in sorted(source_root.rglob("*")):
        if "__pycache__" in path.parts or path.suffix == ".pyc" or ".pytest_cache" in path.parts:
            continue
        info = path.lstat()
        if stat.S_ISDIR(info.st_mode):
            continue
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            raise OuterControllerError("accepted upstream source tree contains a symlink or special file")
        raw, _ = _stable_bytes(path, limit=MAX_JOURNAL_BYTES)
        rows.append({"path": path.relative_to(source_root).as_posix(),
                     "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()})
    return rows


