def _load_gate_source():
    raw = read_regular(R6I_GATE_PATH, maximum=2 * 1024 * 1024)
    if sha(raw) != R6I_GATE_SHA256:
        raise RuntimeError("frozen R6I gate source hash changed")
    module = types.ModuleType("r6i_frozen_gate_source_only")
    module.__file__ = str(R6I_GATE_PATH)
    module.__package__ = ""
    exec(compile(raw.decode("utf-8", "strict"), str(R6I_GATE_PATH), "exec"), module.__dict__)
    return module


def _validate_capture_fixture(gate, proof_raw: bytes) -> dict[str, Any]:
    proof = strict_json(proof_raw, "captured empty MAIN_APPROVAL proof")
    if sha(gate._canonical_json(proof)) != EMPTY_APPROVAL_RAW_PROOF_SHA256:
        raise RuntimeError("captured empty approval proof raw digest changed")
    projected = gate._r5j_identity_projection(proof)
    if sha(gate._canonical_json(projected)) != EMPTY_APPROVAL_PROJECTED_SHA256:
        raise RuntimeError("captured empty approval proof gate projection changed")
    leaf = proof.get("path_chain", [])[-1]
    if (proof.get("source_bytes") != 0 or proof.get("source_content_sha256") != EMPTY_APPROVAL_SHA256
            or proof.get("identity") != {"device": EMPTY_APPROVAL_DEVICE, "inode": EMPTY_APPROVAL_INODE,
                                         "security_sha256": EMPTY_APPROVAL_SECURITY_SHA256}
            or leaf.get("path") != gate.APPROVAL_PATH or leaf.get("info_size") != 0
            or leaf.get("directory") is not False or leaf.get("identity") != {
                "device": EMPTY_APPROVAL_DEVICE, "inode": EMPTY_APPROVAL_INODE}
            or leaf.get("owner_classification") != "daemon"
            or leaf.get("owner_sid") != "S-1-5-21-2844656816-882443001-4055095909-1001"):
        raise RuntimeError("captured empty approval proof no longer binds the exact accepted leaf")
    return proof


