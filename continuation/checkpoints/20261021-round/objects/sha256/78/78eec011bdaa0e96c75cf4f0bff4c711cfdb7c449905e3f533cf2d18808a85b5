def invocation(payload: bytes) -> dict[str, Any]:
    argv = ssh_argv()
    value = {"argv": argv, "argv_sha256": sha(canonical(argv)), "shell": False,
             "target": SSH_USER_HOST, "remote_command": REMOTE_COMMAND,
             "stdin_mode": "one exact byte write then EOF to the sole original Popen",
             "payload_sha256": sha(payload), "payload_bytes": len(payload),
             "active_cutoff_seconds": SSH_ACTIVE_CUTOFF_SECONDS,
             "after_cutoff": "retain and passively wait on same original Popen to natural terminal",
             "stdout_max_bytes": MAX_STDOUT_BYTES, "stderr_max_bytes": MAX_STDERR_BYTES,
             "remote_native_budget": {"child_processes": 1, "active_seconds": REMOTE_ACTIVE_SECONDS,
                                      "COMSOL": 0, "GUI": 0, "JVM": 0, "Study": 0, "solver": 0},
             "retry_or_replay": False, "signals_or_kills": False}
    return {"value": value, "sha256": sha(canonical(value))}


