            "r6i_prep_acceptance_sha256": R6I_PREP_ACCEPTANCE_SHA256,
            "prebirth_capture_acceptance_sha256": PREBIRTH_ACCEPTANCE_SHA256,
            "empty_approval_capture_acceptance_sha256": EMPTY_APPROVAL_ACCEPTANCE_SHA256,
            "historical_prep_checkpoint_sha256": binding["historical_r6i_prep_checkpoint_sha256"],
            "current_live_resume_sha256": binding["current_live_resume_sha256"],
            "original_popen_owner_sha256": ORIGINAL_READONLY_WRAPPER_SHA256,
            "payload_template_reviewed_before_approval_render": True,
            "remote_target": SSH_USER_HOST, "remote_writes": 1,
            "scope": {"native_children": 1, "active_seconds": REMOTE_ACTIVE_SECONDS,
                      "COMSOL": 0, "GUI": 0, "JVM": 0, "Study": 0, "solver": 0,
                      "account_acl_or_privilege_mutation": False,
                      "automatic_retry_or_replay": False}}


def _render_payload(approval_raw: bytes, template: bytes) -> bytes:
    if len(approval_raw) <= 0 or len(approval_raw) > MAX_APPROVAL_BYTES:
        raise RuntimeError("Main approval bytes outside the exact R6I bounded range")
    approval = strict_json(approval_raw, "Main R6I native approval")
    template_approval = strict_json(read_regular(APPROVAL_TEMPLATE_PATH, maximum=64 * 1024), "unsigned R6I approval template")
    expected = dict(template_approval)
    expected["status"] = "APPROVED_EXECUTE_ONCE"
    nonce = approval.get("native_nonce")
    if not isinstance(nonce, str) or re.fullmatch(r"[0-9a-f]{32}", nonce) is None:
        raise RuntimeError("Main approval nonce must be exactly 32 lowercase hexadecimal characters")
    expected["native_nonce"] = nonce
    if approval != expected:
        raise RuntimeError("Main approval differs from the frozen closed R6I field/value template")
    rendered = template.replace(APPROVAL_MARKER,
                                b'APPROVAL_B64 = "' + base64.b64encode(approval_raw) + b'"')
    rendered = rendered.replace(APPROVAL_SHA_MARKER,
                                b'APPROVAL_SHA256 = "' + sha(approval_raw).encode("ascii") + b'"')
    if len(rendered) > MAX_PAYLOAD_BYTES or b"__R6I_R2_" in rendered:
        raise RuntimeError("rendered R6I native payload has unresolved markers or exceeds its bound")
    compile(rendered.decode("utf-8", "strict"), "<R6I_R2_RENDERED_PAYLOAD>", "exec")
    return rendered


def _authority_inputs(binding: dict[str, Any], wrapper_sha: str,
                      rendered_payload: bytes) -> dict[str, Any]:
    resume_raw = read_regular(RESUME_PATH, maximum=16 * 1024 * 1024)
    if sha(resume_raw) != binding["current_live_resume_sha256"]:
        raise RuntimeError("live RESUME changed since current R2 admission binding; rerender/review required")
    inv = invocation(rendered_payload)
    source_review_raw = read_regular(SOURCE_REVIEW_PATH, maximum=256 * 1024)
    source_review = strict_json(source_review_raw, "Main R6I R2 source review")
    expected_source_review = _expected_unsigned_review(binding, wrapper_sha)
    if source_review != expected_source_review:
        raise RuntimeError("Main source review does not bind the exact R6I R2 payload and current checkpoint")
    source_review_sha = sha(source_review_raw)
    wrapper_review_raw = read_regular(WRAPPER_REVIEW_PATH, maximum=256 * 1024)
    wrapper_review = strict_json(wrapper_review_raw, "Main R6I R2 wrapper review")
    expected_wrapper = {"schema": "windows-r6i-native-entry-r2-wrapper-review/1",
                       "status": "PASS_EXACT_R6I_R2_STRICT_SSH_WRAPPER_NO_REMOTE_ACTION",
                       "wrapper_sha256": wrapper_sha, "source_review_sha256": source_review_sha,
                       "payload_template_sha256": binding["payload_template"]["sha256"],
                       "argv_sha256": sha(canonical(ssh_argv())),
                       "run_root": str(RUN_ROOT.relative_to(ROOT)), "one_original_popen": True,
                       "one_payload_send_then_eof": True, "passive_wait_same_popen_to_natural_terminal": True,
                       "stdout_max_bytes": MAX_STDOUT_BYTES, "stderr_max_bytes": MAX_STDERR_BYTES,
                       "active_cutoff_seconds": SSH_ACTIVE_CUTOFF_SECONDS, "retry_or_replay": False,
                       "remote_writes": 1, "native_children": 1}
    if wrapper_review != expected_wrapper:
        raise RuntimeError("Main wrapper review does not bind exact source, Popen, payload and run root")
    wrapper_review_sha = sha(wrapper_review_raw)
    admission_raw = read_regular(ENTRY_ADMISSION_PATH, maximum=256 * 1024)
    admission = strict_json(admission_raw, "Main R6I R2 entry admission")
    expected_admission = {"schema": "windows-r6i-native-entry-r2-admission/1",
                          "status": "MAIN_ADMITTED_EXACT_R6I_R2_ONE_CHILD_ENTRY",
                          "source_review_sha256": source_review_sha,
                          "wrapper_review_sha256": wrapper_review_sha,
                          "payload_sha256": sha(rendered_payload), "payload_bytes": len(rendered_payload),
                          "invocation_sha256": inv["sha256"], "current_live_resume_sha256": binding["current_live_resume_sha256"],
                          "historical_prep_checkpoint_sha256": binding["historical_r6i_prep_checkpoint_sha256"],
                          "run_root": str(RUN_ROOT.relative_to(ROOT)),
                          "limits": {"native_children": 1, "active_seconds": 60,
                                     "COMSOL": 0, "GUI": 0, "JVM": 0, "Study": 0, "solver": 0},
                          "remote_writes": 1, "approval_bytes_write": "exact approved JSON only",
                          "automatic_retry_or_replay": False}
    if admission != expected_admission:
        raise RuntimeError("Main admission does not bind exact R6I R2 one-child scope")
    admission_sha = sha(admission_raw)
    approval_raw = read_regular(MAIN_APPROVAL_PATH, maximum=MAX_APPROVAL_BYTES)
    rendered_check = _render_payload(approval_raw, read_regular(PAYLOAD_TEMPLATE_PATH, maximum=MAX_PAYLOAD_BYTES))
    if rendered_check != rendered_payload:
        raise RuntimeError("rendered payload changed after Main approval binding")
    once_raw = read_regular(ONCE_AUTHORIZATION_PATH, maximum=256 * 1024)
    once = strict_json(once_raw, "Main one-use R6I R2 authorization")
    expected_once = {"schema": "windows-r6i-native-entry-r2-once-authorization/1",
                     "status": "MAIN_AUTHORIZED_EXACT_R6I_R2_ONCE",
                     "source_review_sha256": source_review_sha,
                     "wrapper_review_sha256": wrapper_review_sha,
                     "entry_admission_sha256": admission_sha,
                     "wrapper_sha256": wrapper_sha,
                     "payload_sha256": sha(rendered_payload), "payload_bytes": len(rendered_payload),
                     "approval_sha256": sha(approval_raw), "approval_bytes": len(approval_raw),
                     "invocation_sha256": inv["sha256"], "argv_sha256": inv["value"]["argv_sha256"],
                     "run_root": str(RUN_ROOT.relative_to(ROOT)), "send_count": 1,
                     "remote_write_count": 1, "native_children": 1, "active_seconds": 60,
                     "COMSOL": 0, "GUI": 0, "JVM": 0, "Study": 0, "solver": 0,
                     "retry_or_replay": False, "process_signals_or_kills": False}
    if once != expected_once:
        raise RuntimeError("Main once authorization differs from exact R6I R2 invocation")
    return {"source_review_sha256": source_review_sha,
            "wrapper_review_sha256": wrapper_review_sha,
            "entry_admission_sha256": admission_sha,
            "once_authorization_sha256": sha(once_raw),
            "approval_sha256": sha(approval_raw), "approval_bytes": len(approval_raw),
            "invocation": inv["value"], "invocation_sha256": inv["sha256"],
            "approval_raw": approval_raw}


def _load_original_owner():
    raw = read_regular(ORIGINAL_READONLY_WRAPPER_PATH, maximum=512 * 1024)
    if sha(raw) != ORIGINAL_READONLY_WRAPPER_SHA256:
        raise RuntimeError("reviewed original-Popen owner source changed")
    module = types.ModuleType("r6i_reviewed_original_popen_owner_r2")
    module.__file__ = str(ORIGINAL_READONLY_WRAPPER_PATH)
    module.__package__ = ""
    exec(compile(raw.decode("utf-8", "strict"), str(ORIGINAL_READONLY_WRAPPER_PATH), "exec"), module.__dict__)
    owner_cls = getattr(module, "OriginalReadOnlyPopenOwner", None)
    if not callable(owner_cls):
        raise RuntimeError("reviewed original-Popen owner class unavailable")
    module.MAX_STDOUT_BYTES = MAX_STDOUT_BYTES
    module.MAX_STDERR_BYTES = MAX_STDERR_BYTES
    module.ACTIVE_CUTOFF_SECONDS = SSH_ACTIVE_CUTOFF_SECONDS
    return owner_cls


def _validate_remote_result(raw: bytes, authority: dict[str, Any], returncode: int,
                            owner: Any) -> dict[str, Any]:
    record = strict_json(raw, "R6I R2 remote result")
    exact = (record.get("schema") == "cv3-windows-r6i-native-result-r2/1"
             and record.get("approval_sha256") == authority["approval_sha256"]
             and record.get("approval_bytes") == authority["approval_bytes"]
             and record.get("gate_sha256") == R6I_GATE_SHA256
             and record.get("helper_sha256") == R6I_HELPER_SHA256
             and record.get("binding_sha256") == R6I_INNER_SHA256
             and record.get("outer_binding_sha256") == R6I_OUTER_SHA256
             and record.get("replay") is False and record.get("no_retry") is True
             and record.get("COMSOL") == 0 and record.get("GUI") == 0
             and record.get("JVM") == 0 and record.get("Study") == 0 and record.get("solver") == 0)
    for raw_field, size_field, hash_field in (("gate_stdout_b64", "gate_stdout_bytes", "gate_stdout_sha256"),
                                               ("gate_stderr_b64", "gate_stderr_bytes", "gate_stderr_sha256")):
        data = base64.b64decode(record.get(raw_field, ""), validate=True)
        if len(data) != record.get(size_field) or sha(data) != record.get(hash_field):
            raise RuntimeError("remote R6I gate stream raw bytes do not match bounded digest record")
    successful = (exact and returncode == 0 and owner.first_cause is None
                  and not owner.active_cutoff_exceeded
                  and record.get("status") == "R6I_GATE_RETURNED"
                  and record.get("gate_returncode") == 0
                  and record.get("gate_functional_status") == "PASS_SAME_SID_PRIMARY_OWNER_FILE_PROBE"
                  and record.get("native_children") == 1
                  and record.get("approval_write", {}).get("status") == "SAME_OBJECT_APPROVAL_WRITE_READBACK_PASS")
    return {"status": "PASS_ONE_CHILD_TOKEN_FILE_PROBE" if successful else "UNKNOWN_OR_FAILED_NO_REPLAY",
            "remote_record": record, "remote_result_exact": exact,
            "native_children": 1 if successful else "UNKNOWN",
            "ssh_returncode": returncode, "same_original_popen_natural_terminal": True,
            "first_cause": owner.first_cause,
            "active_cutoff_exceeded": owner.active_cutoff_exceeded,
            "automatic_retry": False, "replay": False}


def execute_once(*, popen_factory: Callable[..., Any] = subprocess.Popen) -> int:
    binding = _check_source_inputs()
    template = read_regular(PAYLOAD_TEMPLATE_PATH, maximum=MAX_PAYLOAD_BYTES)
    wrapper_sha = sha(read_regular(Path(__file__).resolve(), maximum=MAX_PAYLOAD_BYTES))
    approval_raw = read_regular(MAIN_APPROVAL_PATH, maximum=MAX_APPROVAL_BYTES)
    payload = _render_payload(approval_raw, template)
    authority = _authority_inputs(binding, wrapper_sha, payload)
    owner_cls = _load_original_owner()
    if RUN_ROOT.exists() or RUN_ROOT.is_symlink():
        raise RuntimeError("fresh R6I R2 run root already exists; no replay")
    RUN_ROOT.mkdir(mode=0o700, parents=False, exist_ok=False)
    paths = {"intent": RUN_ROOT / "SSH_LAUNCH_INTENT.json", "stdout": RUN_ROOT / "SSH.stdout",
             "stderr": RUN_ROOT / "SSH.stderr", "state": RUN_ROOT / "SSH_STATE.jsonl",
             "terminal": RUN_ROOT / "SSH_TERMINAL.json", "report": RUN_ROOT / "LOCAL_NATIVE_RESULT_R2.json"}
    started = time.monotonic()
    write_exclusive(paths["intent"], canonical({"schema": "windows-r6i-native-entry-r2-launch/1",
                    "status": "ONE_SSH_PAYLOAD_SEND_INTENT", "payload_sha256": sha(payload),
                    "payload_bytes": len(payload), "approval_sha256": authority["approval_sha256"],
                    "invocation": authority["invocation"], "authority": {k: v for k, v in authority.items()
                                    if k not in ("approval_raw", "invocation")},
                    "scope": {"native_children": 1, "active_seconds": 60, "COMSOL": 0,
                              "GUI": 0, "JVM": 0, "Study": 0, "solver": 0},
                    "retry_or_replay": False}))
    write_exclusive(LOCAL_ONCE_PATH, canonical({"schema": "windows-r6i-native-entry-r2-local-once/1",
                    "status": "CONSUMED_BEFORE_POPEN_NO_REPLAY", "payload_sha256": sha(payload),
                    "approval_sha256": authority["approval_sha256"], "run_root": str(RUN_ROOT.relative_to(ROOT))}))
    paths["state"].open("xb").close()
    child = owner = None
    final = {"status": "UNKNOWN_NO_REPLAY", "native_children": "UNKNOWN"}
    try:
        child = popen_factory(authority["invocation"]["argv"], stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, shell=False,
                              cwd=str(ROOT), bufsize=0)
        owner = owner_cls(child)
        owner.start_drainers(paths["stdout"], paths["stderr"])
        if type(owner.pid) is not int or owner.pid <= 0:
            owner.first_cause = "original SSH Popen PID is malformed"
        else:
            owner.send_once_then_eof(payload)
        owner.wait_naturally()
        stdout_raw = read_regular(paths["stdout"], maximum=MAX_STDOUT_BYTES)
        if owner.first_cause is None and child.returncode == 0 and not owner.active_cutoff_exceeded:
            final = _validate_remote_result(stdout_raw, authority, child.returncode, owner)
        else:
            final = {"status": "UNKNOWN_OR_FAILED_NO_REPLAY", "native_children": "UNKNOWN",
                     "ssh_returncode": child.returncode, "first_cause": owner.first_cause,
                     "active_cutoff_exceeded": owner.active_cutoff_exceeded,
                     "same_original_popen_natural_terminal": child.returncode is not None,
                     "automatic_retry": False, "replay": False}
    except BaseException as exc:
        if owner is not None:
            owner.first_cause = owner.first_cause or (type(exc).__name__ + ":" + str(exc)[:1000])
            owner.wait_naturally()
        final = {"status": "UNKNOWN_OR_FAILED_NO_REPLAY", "native_children": "UNKNOWN",
                 "error_type": type(exc).__name__, "error": str(exc)[:2000], "replay": False}
    terminal = {"schema": "windows-r6i-native-entry-r2-terminal/1", **final,
                "local_original_popen_pid": getattr(owner, "pid", None),
                "local_original_popen_returncode": getattr(child, "returncode", None),
                "same_original_popen_natural_terminal": bool(child is not None and child.returncode is not None),
                "payload_send_attempted_once": bool(owner and owner.sent),
                "active_cutoff_exceeded": bool(owner and owner.active_cutoff_exceeded),
                "elapsed_seconds": time.monotonic() - started,
                "stdout_bytes": paths["stdout"].stat().st_size if paths["stdout"].exists() else 0,
                "stderr_bytes": paths["stderr"].stat().st_size if paths["stderr"].exists() else 0,
                "signals_kills_retries_resends": 0, "remote_replay": False,
                "source_review_sha256": authority["source_review_sha256"],
                "wrapper_review_sha256": authority["wrapper_review_sha256"],
                "entry_admission_sha256": authority["entry_admission_sha256"],
                "once_authorization_sha256": authority["once_authorization_sha256"],
                "approval_sha256": authority["approval_sha256"]}
    write_exclusive(paths["terminal"], canonical(terminal))
    write_exclusive(paths["report"], canonical({"schema": "windows-r6i-native-entry-r2-report/1",
                    "status": terminal["status"], "terminal": terminal,
                    "remote_write_count": 1 if owner and owner.sent else 0,
                    "native_children": terminal.get("native_children", "UNKNOWN"),
                    "automatic_retry": False, "replay": False}))
    return 0 if terminal["status"] == "PASS_ONE_CHILD_TOKEN_FILE_PROBE" else 1


def main(argv: list[str] | None = None, *, popen_factory: Callable[..., Any] = subprocess.Popen) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args == ["--check-only"]:
        sys.stdout.write(json.dumps(check_only(), sort_keys=True, separators=(",", ":")) + "\n")
        return 0
    if args == ["--execute-once"]:
        return execute_once(popen_factory=popen_factory)
    raise RuntimeError("use --check-only or a separately Main-authorized --execute-once")


if __name__ == "__main__":
    try:
        _code = main()
    except BaseException as _exc:
        sys.stderr.write(type(_exc).__name__ + ":" + str(_exc)[:2000] + "\n")
        _code = 2
    raise SystemExit(_code)
