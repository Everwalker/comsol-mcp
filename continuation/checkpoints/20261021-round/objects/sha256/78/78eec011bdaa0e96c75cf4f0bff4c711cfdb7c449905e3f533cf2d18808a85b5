               (SOURCE_REVIEW_PATH, WRAPPER_REVIEW_PATH, ENTRY_ADMISSION_PATH,
                ONCE_AUTHORIZATION_PATH, MAIN_APPROVAL_PATH, LOCAL_ONCE_PATH) if path.exists() or path.is_symlink()]
    if present:
        raise RuntimeError("effective Main records or local once unexpectedly exist: " + repr(present))
    return {"schema": "windows-r6i-native-entry-r2-check-only/1",
            "status": "PASS_EXACT_SOURCE_AND_CAPTURE_PROOFS_UNSIGNED_NO_SSH",
            **binding, "invocation": inv["value"], "invocation_sha256": inv["sha256"],
