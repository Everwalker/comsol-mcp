class OuterControllerError(RuntimeError):
    pass


class WallDeadlineExceeded(OuterControllerError):
    """The fixed route budget or its cleanup reserve has been reached."""


def _canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode("utf-8")


def _sha(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def _strict_json_bytes(raw: bytes, label: str) -> dict[str, Any]:
    def pairs_unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise OuterControllerError(f"duplicate JSON key in {label}")
            result[key] = value
        return result
    try:
        value = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=pairs_unique,
                           parse_constant=lambda _: (_ for _ in ()).throw(
                               OuterControllerError(f"non-finite JSON value in {label}")))
    except OuterControllerError:
        raise
    except Exception as exc:
        raise OuterControllerError(f"invalid strict JSON: {label}") from exc
    if not isinstance(value, dict):
        raise OuterControllerError(f"JSON object required: {label}")
    return value


def _stable_bytes(path: Path, limit: int) -> bytes:
    path = Path(path)
    named = path.lstat()
    if (stat.S_ISLNK(named.st_mode) or not stat.S_ISREG(named.st_mode)
            or named.st_uid != os.getuid() or named.st_nlink != 1
            or named.st_mode & 0o022 or named.st_size > limit):
        raise OuterControllerError(f"unsafe or oversized evidence file: {path}")
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    try:
        before = os.fstat(fd)
        signature = lambda item: (item.st_dev, item.st_ino, item.st_mode, item.st_uid,
                                  item.st_nlink, item.st_size, item.st_mtime_ns, item.st_ctime_ns)
        if signature(named) != signature(before):
            raise OuterControllerError("evidence identity changed during open")
        chunks = []
        size = 0
        while True:
            block = os.read(fd, min(1024 * 1024, limit + 1 - size))
            if not block:
                break
            size += len(block)
            if size > limit:
                raise OuterControllerError("evidence exceeded its exact read bound")
            chunks.append(block)
        after = os.fstat(fd)
        if signature(before) != signature(after) or signature(after) != signature(path.lstat()):
            raise OuterControllerError("evidence identity changed during read")
        raw = b"".join(chunks)
        if len(raw) != after.st_size:
            raise OuterControllerError("stable evidence size differs from bytes read")
        return raw
    finally:
        os.close(fd)


def _read_json(path: Path, limit: int = 1024 * 1024) -> tuple[dict[str, Any], str]:
    raw = _stable_bytes(path, limit)
    return _strict_json_bytes(raw, str(path)), _sha(raw)


def _verify_r12_source_manifest(*, root: Path = OUTER_ROOT,
                               manifest_path: Path = R12_SOURCE_MANIFEST_PATH,
                               expected_members: tuple[str, ...] = R12_SOURCE_MEMBERS) -> dict[str, Any]:
    """Verify every R12 source/test member against the exact local manifest."""
    root = Path(root)
    root_info = root.lstat()
    if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
        raise OuterControllerError("R12 candidate root is not a real directory")
    root_real = root.resolve(strict=True)
    manifest, manifest_sha = _read_json(Path(manifest_path), 4 * 1024 * 1024)
    if set(manifest) != {"schema", "candidate_root", "files"}:
        raise OuterControllerError("R12 source manifest has missing or unknown fields")
    if manifest.get("schema") != "W23_R12_SOURCE_MANIFEST/1":
        raise OuterControllerError("R12 source manifest schema changed")
    if manifest.get("candidate_root") != str(root_real):
        raise OuterControllerError("R12 source manifest candidate root changed")
    rows = manifest.get("files")
    if not isinstance(rows, list) or [row.get("path") for row in rows if isinstance(row, dict)] != sorted(expected_members):
        raise OuterControllerError("R12 source manifest membership or order changed")
    if len(rows) != len(expected_members):
        raise OuterControllerError("R12 source manifest has duplicate or malformed members")
    observations = []
    for row, expected_path in zip(rows, sorted(expected_members)):
        if set(row) != {"path", "bytes", "sha256"} or row["path"] != expected_path:
            raise OuterControllerError("R12 source manifest row has missing/unknown fields or wrong member")
        relative = PurePosixPath(row["path"])
        if relative.is_absolute() or "\\" in row["path"] or any(part in {"", ".", ".."} for part in relative.parts):
            raise OuterControllerError("R12 source manifest path is not a safe candidate-relative path")
        target = root_real
        for part in relative.parts[:-1]:
            target = target / part
            info = target.lstat()
            if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
                raise OuterControllerError("R12 source parent is not a real directory")
        target = target / relative.parts[-1]
        resolved_target = target.resolve(strict=True)
        if resolved_target != target:
            raise OuterControllerError("R12 source path resolves through an alias")
        raw = _stable_bytes(target, 8 * 1024 * 1024)
        actual_sha = _sha(raw)
        if type(row["bytes"]) is not int or row["bytes"] != len(raw) or row["sha256"] != actual_sha:
            raise OuterControllerError(f"R12 source member differs from manifest: {row['path']}")
        observations.append({"path": row["path"], "bytes": len(raw), "sha256": actual_sha})
    return {"sha256": manifest_sha, "member_count": len(observations), "files": observations}


def _write_new_json(path: Path, value: Mapping[str, Any]) -> str:
    path = Path(path)
    if path.exists() or path.is_symlink():
        raise OuterControllerError(f"R12 output already exists; no overwrite: {path}")
    raw = _canonical_bytes(dict(value)) + b"\n"
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        view = memoryview(raw)
        while view:
            count = os.write(fd, view)
            if count <= 0:
                raise OuterControllerError("short write to R12 local evidence")
            view = view[count:]
        os.fsync(fd)
    finally:
        os.close(fd)
    parent_fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(parent_fd)
    finally:
        os.close(parent_fd)
    if _stable_bytes(path, 1024 * 1024) != raw:
        raise OuterControllerError("R12 local evidence differs on stable readback")
    return _sha(raw)


def _load_r8() -> ModuleType:
    name = "_w23_r8_frozen_for_r16_d8b0a788"
    existing = sys.modules.get(name)
    if existing is not None:
        if Path(existing.__file__).resolve() != R8_CONTROLLER_PATH.resolve():
            raise OuterControllerError("R8 import name is already bound to another candidate")
        return existing
    spec = importlib.util.spec_from_file_location(name, R8_CONTROLLER_PATH)
    if spec is None or spec.loader is None:
        raise OuterControllerError("frozen R8 controller cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    try:
        spec.loader.exec_module(module)
    except BaseException:
        sys.modules.pop(name, None)
        raise
    if Path(module.__file__).resolve() != R8_CONTROLLER_PATH.resolve():
        raise OuterControllerError("R8 controller import escaped the frozen path")
    return module


def verify_frozen_inputs() -> dict[str, Any]:
    r12_source = _verify_r12_source_manifest()
    expected = {
        R8_SOURCE_MANIFEST_PATH: R8_SOURCE_MANIFEST_SHA256,
        R8_SOURCE_MAP_PATH: R8_SOURCE_MAP_SHA256,
        R8_SOURCE_PLAN_PATH: R8_SOURCE_PLAN_SHA256,
