        R8_PACKET_MANIFEST_PATH: R8_PACKET_MANIFEST_SHA256,
        R8_REVIEW_REQUEST_PATH: R8_REVIEW_REQUEST_SHA256,
    }
    observed = {}
    for path, digest in expected.items():
        raw = _stable_bytes(path, 64 * 1024 * 1024)
        actual = _sha(raw)
        if digest is not None and actual != digest:
            raise OuterControllerError(f"frozen R8 input changed: {path}")
        observed[str(path)] = {"bytes": len(raw), "sha256": actual}
    r8_manifest, _ = _read_json(R8_SOURCE_MANIFEST_PATH, 2 * 1024 * 1024)
    if r8_manifest.get("schema") != "W23_R8_OUTER_SOURCE_MANIFEST/1":
        raise OuterControllerError("R8 source manifest schema changed")
    for row in r8_manifest.get("files", []):
        path = R8_ROOT / row["path"]
        raw = _stable_bytes(path, 64 * 1024 * 1024)
        if len(raw) != row["bytes"] or _sha(raw) != row["sha256"]:
            raise OuterControllerError(f"R8 source member changed: {row['path']}")
    r8 = _load_r8()
    preflight = r8.source_only_preflight()
    if (preflight.get("status") != "SOURCE_ONLY_PASS_NO_AUTHORITY_NO_DISPATCH"
            or preflight.get("public_calls") != 0
            or preflight.get("approval_created") is not False
            or preflight.get("once_created") is not False):
        raise OuterControllerError("frozen R8 source-only consumer did not remain no-authority/no-dispatch")
    return {"r8_source_manifest_sha256": R8_SOURCE_MANIFEST_SHA256,
            "r8_source_map_sha256": R8_SOURCE_MAP_SHA256,
