class DispatchDeadline:
    """Check the fixed Server-birth deadline before each R6 route call body."""

    def __init__(self, r5: ModuleType, *, now: Callable[[], float] = time.time):
        self.r5 = r5
        self.now = now
        self.deadline_epoch: float | None = None
        self.server_birth_epoch: float | None = None
        self.checks: list[dict[str, Any]] = []

    def before_dispatch(self, route: Any) -> dict[str, Any]:
        dispatcher = getattr(route, "dispatcher", None)
        bridge = getattr(dispatcher, "__self__", None)
        gate = getattr(bridge, "gate", None)
        if gate is None:
            raise OuterControllerError("R6 route dispatcher is not bound to the exact owned public gate")
        if self.deadline_epoch is None:
            birth = self.r5._server_birth_epoch_seconds(gate)
            if isinstance(birth, bool) or not isinstance(birth, (int, float)) or not math.isfinite(float(birth)):
                raise OuterControllerError("original Server birth epoch is unavailable or invalid")
            self.server_birth_epoch = float(birth)
            self.deadline_epoch = self.server_birth_epoch + WALL_BUDGET_SECONDS
        now = float(self.now())
        remaining = self.deadline_epoch - now
        row = {"check_ordinal": len(self.checks) + 1,
               "server_birth_epoch_seconds": self.server_birth_epoch,
               "now_epoch_seconds": now, "deadline_epoch_seconds": self.deadline_epoch,
               "remaining_seconds": remaining,
               "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
               "route_class": type(route).__name__, "dispatch_allowed": remaining > CLEANUP_RESERVE_SECONDS}
        self.checks.append(row)
        if remaining <= CLEANUP_RESERVE_SECONDS:
            raise WallDeadlineExceeded("total W23 route deadline reached before dispatch; no dispatch/replay")
        return row


def install_dispatch_deadline(runtime: ModuleType, deadline: DispatchDeadline) -> Callable[[], None]:
    """Wrap only R6's two frozen route call boundaries, restoring exact methods."""
    originals = []
    for class_name in ("FreshOwnerRoute", "PublicRoute"):
        route_class = getattr(runtime, class_name, None)
        if route_class is None or not callable(getattr(route_class, "call_raw", None)):
            raise OuterControllerError(f"frozen R6 route class is unavailable: {class_name}")
        original = route_class.call_raw

        def guarded(self, *args, _original=original, **kwargs):
            deadline.before_dispatch(self)
            return _original(self, *args, **kwargs)

        route_class.call_raw = guarded
        originals.append((route_class, original, guarded))

    def restore() -> None:
        for route_class, original, guarded in reversed(originals):
            if route_class.call_raw is guarded:
                route_class.call_raw = original
            else:
                raise OuterControllerError("R6 route method changed while R12 deadline guard was installed")
    return restore


def _canonical_owner_references(holder: Any, r5: ModuleType, *,
                                on_observer_error: Callable[[BaseException], None] | None = None
                                ) -> tuple[tuple[str, subprocess.Popen], ...]:
    known = tuple(getattr(holder, "owner_references", ()))
    known_by_role = {}
    for row in known:
        if not isinstance(row, tuple) or len(row) != 2:
            raise OuterControllerError("R8 holder returned malformed original-owner reference")
        role, process = row
        if role not in {"server", "worker"} or type(process) is not subprocess.Popen or role in known_by_role:
            raise OuterControllerError("R8 holder did not return unique original Popen role references")
        known_by_role[role] = process
    try:
        observed = tuple(r5._original_owner_references(holder.host, holder.outcome))
    except BaseException as exc:
        if on_observer_error is None:
            raise
        # R8's holder already owns its original Popen references. A local
        # observer failure cannot invalidate or discard those references.
        on_observer_error(exc)
        observed = ()
    observed_by_role = {}
    for role, process in observed:
        if role not in {"server", "worker"} or type(process) is not subprocess.Popen or role in observed_by_role:
            raise OuterControllerError("same-host observer returned malformed owner Popen references")
        observed_by_role[role] = process
    for role, process in observed_by_role.items():
        if role in known_by_role and known_by_role[role] is not process:
            raise OuterControllerError("original owner Popen identity changed; passive hold remains UNKNOWN")
        known_by_role[role] = process
    updated = tuple((role, known_by_role[role]) for role in ("server", "worker") if role in known_by_role)
    holder.owner_references = updated
    return updated


def _passive_hold_unknown(result: Mapping[str, Any], holders: tuple[Any, ...],
                          r5: ModuleType, *, run_root: Path,
                          poll_interval: float = PASSIVE_POLL_INTERVAL_SECONDS,
                          now: Callable[[], float] = time.time,
                          sleep: Callable[[float], None] = time.sleep) -> dict[str, Any]:
    if result.get("status") == "PASS_SOURCE_READS_TERMINAL_THEN_WORKER_RETIRED_SERVER_CLOSED_NOT_NATIVE_ACCEPTANCE":
        return {"schema": "w23-r12-external-driver-terminal/1",
                "status": "PASS_R8_NORMAL_RETIREMENT_TERMINAL", "r8_result": dict(result),
                "driver_public_calls_after_r8_return": 0, "driver_process_signals": 0,
                "driver_host_close_after_r8_return": 0, "science": "NOT_EVALUATED",
                "direction": "NOT_PROVEN", "native_acceptance": "NOT_CLAIMED"}

    refs: dict[tuple[str, int], tuple[str, subprocess.Popen]] = {}
    previous_owner_by_role: dict[str, subprocess.Popen] = {}
    observer_error_count = 0
    first_observer_error: str | None = None
    first_error: str | None = None

    def record_observer_error(exc: BaseException) -> None:
        nonlocal observer_error_count, first_observer_error
        observer_error_count += 1
        if first_observer_error is None:
            first_observer_error = f"{type(exc).__name__}: {str(exc)[:400]}"

    for holder in holders:
        for role, proc in _canonical_owner_references(
                holder, r5, on_observer_error=record_observer_error):
            refs[(role, id(proc))] = (role, proc)
            previous = previous_owner_by_role.get(role)
            if previous is None:
                previous_owner_by_role[role] = proc
            elif previous is not proc:
                # Keep both already-proven handles and poll them passively,
                # while retaining the identity conflict as an UNKNOWN cause.
                first_error = first_error or "multiple original Popen identities observed for one owner role"
    if not refs:
        return {"schema": "w23-r12-external-driver-terminal/1",
                "status": "UNKNOWN_NO_REPLAY_TERMINAL_NO_ORIGINAL_OWNER_REFERENCES",
                "r8_result": dict(result), "retained_holder_count": len(holders),
                "original_owner_processes": [], "driver_process_signals": 0,
                "driver_public_calls_after_r8_return": 0,
                "driver_host_close_after_r8_return": 0,
                "native_child_absence_claimed": False,
                "first_observer_error": first_observer_error,
                "owner_observer_error_count": observer_error_count,
                "science": "NOT_EVALUATED", "direction": "NOT_PROVEN"}

    start = float(now())
    hold_record = {"schema": "w23-r12-passive-original-owner-hold/1",
                   "status": "UNKNOWN_ORIGINAL_OWNERS_PASSIVELY_HELD_NO_RPC_NO_CLOSE",
                   "r8_result_status": result.get("status"),
                   "started_epoch_seconds": start,
                   "r8_result_sha256": _sha(_canonical_bytes(dict(result))),
                   "retained_holder_count": len(holders),
                   "first_observer_error": first_observer_error,
                   "owner_observer_error_count": observer_error_count,
                   "original_owner_processes": [{"role": role, "pid": proc.pid,
                                                  "original_popen_object_retained": True}
                                                 for role, proc in refs.values()],
                   "passive_process_poll_only": True, "signals": 0, "RPC_after_R8_return": 0,
                   "host_close_after_R8_return": 0, "retries": 0, "replays": 0,
                   "native_child_absence_claimed": False}
    hold_path = run_root / "R12_PASSIVE_HOLD_STARTED.json"
    hold_record["path"] = str(hold_path)
    hold_record["sha256"] = _write_new_json(hold_path, hold_record)

    # The same original R8 holder is re-read only through R5's same-host owner
    # reference function. Any later original Worker birth is added by identity;
    # replacement Popen objects are rejected. This is not process inventory.
    while True:
        for holder in holders:
            try:
                for role, proc in _canonical_owner_references(
                        holder, r5, on_observer_error=record_observer_error):
                    previous = previous_owner_by_role.get(role)
                    if previous is not None and previous is not proc:
                        raise OuterControllerError("same original owner role changed Popen identity")
                    previous_owner_by_role[role] = proc
                    refs[(role, id(proc))] = (role, proc)
            except BaseException as exc:
                first_error = first_error or f"{type(exc).__name__}: {str(exc)[:400]}"
        states = []
        all_terminal = bool(refs)
        for role, proc in refs.values():
            try:
                returncode = proc.poll()
                poll_error = None
            except BaseException as exc:
                returncode = None
                poll_error = f"{type(exc).__name__}: {str(exc)[:240]}"
                first_error = first_error or poll_error
            if returncode is None or poll_error is not None:
                all_terminal = False
            states.append({"role": role, "pid": proc.pid, "returncode": returncode,
                           "poll_error": poll_error, "same_original_popen_retained": True})
        if all_terminal:
            return {"schema": "w23-r12-external-driver-terminal/1",
                    "status": "UNKNOWN_NO_REPLAY_ORIGINAL_OWNERS_TERMINAL_OBSERVED",
                    "r8_result": dict(result), "hold_started_path": str(hold_path),
                    "hold_started_sha256": hold_record["sha256"],
                    "original_owner_processes": states,
                    "passive_hold_seconds": max(0.0, float(now()) - start),
                    "passive_process_poll_only": True, "signals": 0,
                    "RPC_after_R8_return": 0, "host_close_after_R8_return": 0,
                    "first_observer_error": first_observer_error,
                    "owner_observer_error_count": observer_error_count,
                    "first_reference_or_poll_error": first_error,
                    "native_child_absence_claimed": False,
                    "science": "NOT_EVALUATED", "direction": "NOT_PROVEN"}
        sleep(poll_interval)


def _review_authority_sha(review: Mapping[str, Any]) -> str:
    return _sha(_canonical_bytes({key: value for key, value in review.items()
                                  if key != "approval_sha256"}))


def _verify_once_matches_expected(once: Mapping[str, Any], expected: Mapping[str, Any]) -> None:
    """Require the one-use record to bind every independently expected value."""
    if any(once.get(key) != value for key, value in expected.items()):
        raise OuterControllerError("R12 once does not bind the exact source, authority and budget")


def _strict_r12_authority(*, r12_review_sha256: str, r12_once_sha256: str,
                         r8_review_sha256: str, r8_once_sha256: str,
                         r6_review_sha256: str, r6_once_sha256: str,
                         source_projection_sha256: str):
    for digest in (r12_review_sha256, r12_once_sha256, r8_review_sha256,
                   r8_once_sha256, r6_review_sha256, r6_once_sha256,
                   source_projection_sha256):
        if not isinstance(digest, str) or len(digest) != 64 or any(ch not in "0123456789abcdef" for ch in digest):
            raise OuterControllerError("exact R12/R8/R6 authority and source SHA-256 values are required")
    frozen = verify_frozen_inputs()
    review, review_sha = _read_json(R12_MAIN_REVIEW_PATH)
    once, once_sha = _read_json(R12_ONCE_BINDING_PATH)
    if review_sha != r12_review_sha256 or once_sha != r12_once_sha256:
        raise OuterControllerError("R12 authority files differ from the exact entry arguments")
    if set(review) != R12_REVIEW_FIELDS or set(once) != R12_ONCE_FIELDS:
        raise OuterControllerError("R12 Main authority contains missing or unknown fields")
    if (review.get("schema") != R12_REVIEW_SCHEMA
            or review.get("decision") != "APPROVE_ONE_W23_R12_EXTERNAL_DRIVER_ENTRY"
            or once.get("schema") != R12_ONCE_SCHEMA
            or once.get("status") != "AUTHORIZED_SINGLE_ENTRY"
            or type(once.get("normal_attempts")) is not int or once["normal_attempts"] != 1
            or review.get("approval_sha256") != _review_authority_sha(review)
            or once.get("approval_sha256") != review.get("approval_sha256")
            or once.get("main_review_sha256") != review_sha):
        raise OuterControllerError("R12 review or one-use authorization is not an exact single-entry decision")
    source_plan, source_plan_sha = _read_json(R12_SOURCE_PLAN_PATH)
    source_manifest, source_manifest_sha = _read_json(R12_SOURCE_MANIFEST_PATH, 4 * 1024 * 1024)
    controller_sha = _sha(_stable_bytes(Path(__file__), 8 * 1024 * 1024))
    expected = {
        "source_plan_sha256": source_plan_sha,
        "source_manifest_sha256": source_manifest_sha,
        "controller_sha256": controller_sha,
        "r8_main_review_sha256": r8_review_sha256,
        "r8_once_binding_sha256": r8_once_sha256,
        "r8_controller_sha256": R8_CONTROLLER_SHA256,
        "r8_source_manifest_sha256": R8_SOURCE_MANIFEST_SHA256,
        "r8_source_map_sha256": R8_SOURCE_MAP_SHA256,
        "r8_packet_manifest_sha256": R8_PACKET_MANIFEST_SHA256,
        "r6_main_review_sha256": r6_review_sha256,
        "r6_once_binding_sha256": r6_once_sha256,
        "r6_source_projection_sha256": source_projection_sha256,
        "wall_budget_seconds": WALL_BUDGET_SECONDS,
        "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
        "public_budgets": PUBLIC_BUDGETS,
    }
    if source_projection_sha256 != R6_SOURCE_PROJECTION_SHA256:
        raise OuterControllerError("R12 source projection differs from the frozen R6 source identity")
    if any(review.get(key) != value for key, value in expected.items()):
        raise OuterControllerError("R12 review does not bind the exact source, authority and budget")
    _verify_once_matches_expected(once, expected)
    if any(once.get(key) != review.get(key) for key in (
            "runtime_root", "host_provider_config_root", "persistent_evidence_root",
            "r8_outer_run_root", "driver_run_root")):
        raise OuterControllerError("R12 once paths differ from the exact Main-reviewed paths")
    r8 = _load_r8()
    r8_review, _r8_once, r8_source, r6, r6_runtime, r5 = r8._strict_authority(
        outer_review_sha256=r8_review_sha256, outer_once_sha256=r8_once_sha256,
        r6_review_sha256=r6_review_sha256, r6_once_sha256=r6_once_sha256,
        source_projection_sha256=source_projection_sha256)
    bound = {
        "runtime_root": r8_review["runtime_root"],
        "host_provider_config_root": r8_review["host_provider_config_root"],
        "persistent_evidence_root": r8_review["persistent_evidence_root"],
        "r8_outer_run_root": r8_review["outer_run_root"],
    }
    if any(review.get(key) != value for key, value in bound.items()):
        raise OuterControllerError("R12 paths diverge from exact R8 Main-bound owner/runtime paths")
    driver_root = Path(str(review["driver_run_root"]))
    if (not driver_root.is_absolute() or driver_root.parent != EVIDENCE_ROOT / "DRIVER_RUNS"
            or not driver_root.name.startswith("w23-r12-driver-")
            or driver_root.exists() or driver_root.is_symlink()):
        raise OuterControllerError("R12 Main did not bind a fresh private driver evidence child")
    suffix = driver_root.name.removeprefix("w23-r12-driver-")
    try:
        if str(uuid.UUID(suffix)) != suffix:
            raise ValueError
    except (ValueError, AttributeError) as exc:
        raise OuterControllerError("R12 driver path suffix is not a canonical UUID") from exc
    if source_plan.get("schema") != "W23_R12_EXTERNAL_DRIVER_SOURCE_PLAN/1" or source_manifest.get("schema") != "W23_R12_SOURCE_MANIFEST/1":
        raise OuterControllerError("R12 source plan/manifest schema changed")
    if any(review.get(key) != value for key, value in bound.items()):
        raise OuterControllerError("R12 review changed an R8-bound path")
    return review, once, {**frozen, "source_plan_sha256": source_plan_sha,
                          "source_manifest_sha256": source_manifest_sha,
                          "controller_sha256": controller_sha,
                          "driver_run_root": driver_root}, r8, r8_review, r6, r6_runtime, r5


def _consume_r12_once(review: Mapping[str, Any], once: Mapping[str, Any],
                     review_sha: str, once_sha: str, run_root: Path,
                     source_data: Mapping[str, Any]) -> str:
    run_root.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    parent_info = run_root.parent.lstat()
    if (stat.S_ISLNK(parent_info.st_mode) or not stat.S_ISDIR(parent_info.st_mode)
            or parent_info.st_uid != os.getuid() or stat.S_IMODE(parent_info.st_mode) != 0o700):
        raise OuterControllerError("R12 driver parent is not a private owned directory")
    run_root.mkdir(mode=0o700, parents=False, exist_ok=False)
    marker = {
        "schema": "w23-r12-driver-once-guard/1",
        "status": "CONSUMED_BEFORE_R8_ENTRY_NO_REPLAY",
        "r12_main_review_sha256": review_sha, "r12_once_binding_sha256": once_sha,
        "r8_main_review_sha256": review["r8_main_review_sha256"],
        "r8_once_binding_sha256": review["r8_once_binding_sha256"],
        "r6_main_review_sha256": review["r6_main_review_sha256"],
        "r6_once_binding_sha256": review["r6_once_binding_sha256"],
        "r6_source_projection_sha256": R6_SOURCE_PROJECTION_SHA256,
        "controller_sha256": source_data["controller_sha256"],
        "public_budgets": PUBLIC_BUDGETS,
        "approval_created_here": False, "once_created_here": False,
        "COMSOL_started_here": False,
    }
    return _write_new_json(run_root / "R12_OUTER_ONCE_GUARD.json", marker)


def run_authorized_external_driver(*, r12_review_sha256: str, r12_once_sha256: str,
                                   r8_review_sha256: str, r8_once_sha256: str,
                                   r6_review_sha256: str, r6_once_sha256: str,
                                   source_projection_sha256: str) -> dict[str, Any]:
    """Make one authorized call into R8, then passively hold only its original owners."""
    review, _once, source_data, r8, _r8_review, _r6, runtime, r5 = _strict_r12_authority(
        r12_review_sha256=r12_review_sha256, r12_once_sha256=r12_once_sha256,
        r8_review_sha256=r8_review_sha256, r8_once_sha256=r8_once_sha256,
        r6_review_sha256=r6_review_sha256, r6_once_sha256=r6_once_sha256,
        source_projection_sha256=source_projection_sha256)
    run_root = source_data["driver_run_root"]
    r12_guard_sha = _consume_r12_once(review, _once, r12_review_sha256,
                                   r12_once_sha256, run_root, source_data)
    before_holder_ids = {id(holder) for holder, _module in r8.RETAINED_UNKNOWN_HOLDERS}
    deadline = DispatchDeadline(r5)
    restore = install_dispatch_deadline(runtime, deadline)
    first_error = None
    try:
        # One call only. R8/R6 retain their own exact approvals/once gates.
        result = r8.run_authorized_outer_entry(
            outer_review_sha256=r8_review_sha256, outer_once_sha256=r8_once_sha256,
            r6_review_sha256=r6_review_sha256, r6_once_sha256=r6_once_sha256,
            source_projection_sha256=source_projection_sha256)
    except BaseException as exc:
        first_error = f"{type(exc).__name__}: {str(exc)[:500]}"
        result = {"schema": "w23-r12-r8-entry-exception/1",
                  "status": "UNKNOWN_NO_REPLAY_R8_CALL_RAISED",
                  "exception_type": type(exc).__name__, "exception_short": str(exc)[:500]}
    finally:
        restore()
    new_holders = tuple(holder for holder, _module in r8.RETAINED_UNKNOWN_HOLDERS
                        if id(holder) not in before_holder_ids)
    terminal = _passive_hold_unknown(result, new_holders, r5, run_root=run_root)
    final = {
        "schema": "w23-r12-external-driver-result/1",
        "status": terminal["status"],
        "r12_once_guard_sha256": r12_guard_sha,
        "r12_controller_sha256": source_data["controller_sha256"],
        "r8_controller_sha256": R8_CONTROLLER_SHA256,
        "r6_source_projection_sha256": R6_SOURCE_PROJECTION_SHA256,
        "r8_result": dict(result),
        "deadline": {"wall_budget_seconds": WALL_BUDGET_SECONDS,
                     "cleanup_reserve_seconds": CLEANUP_RESERVE_SECONDS,
                     "server_birth_epoch_seconds": deadline.server_birth_epoch,
                     "deadline_epoch_seconds": deadline.deadline_epoch,
                     "route_checks": deadline.checks,
                     "dispatches_blocked_before_route_body": sum(not row["dispatch_allowed"] for row in deadline.checks)},
        "passive_terminal": terminal,
        "r8_outer_call_count": 1,
        "driver_public_calls_after_r8_return": 0,
        "driver_process_signals": 0,
        "driver_host_close_after_r8_return": 0,
        "first_error": first_error,
        "direction_status": "NOT_PROVEN", "scientific_acceptance": "NOT_EVALUATED",
        "native_acceptance": "NOT_CLAIMED",
    }
    _write_new_json(run_root / "R12_EXTERNAL_DRIVER_TERMINAL.json", final)
    return final


def check_imports_preflight() -> dict[str, Any]:
    """Run exact R6 package and W25 import consumers without authority reads or dispatch."""
    r8 = _load_r8()
    entry_module, runtime_module = r8._load_r6_package()
    projection = runtime_module._verify_source_projection(r8.R6_SOURCE_MANIFEST_SHA256)
    if projection.get("member_count") != 914:
        raise OuterControllerError("R6 import preflight did not resolve the exact 914-member source projection")
    imports = r8._preflight_r6_w25_imports(entry_module)
    return {"status": "SOURCE_IMPORTS_PASS_NO_AUTHORITY_NO_DISPATCH",
            "r6_source_projection_sha256": r8.R6_SOURCE_MANIFEST_SHA256,
            "r6_source_map_sha256": r8.R6_SOURCE_MAP_SHA256,
            "r6_projected_member_count": projection.get("member_count"),
            "r6_w25_import_preflight": imports,
            "approval_created": False, "once_created": False,
            "host_created": False, "process_started": False,
            "public_calls": 0, "COMSOL": "NOT_RUN", "native": "NOT_RUN"}


def source_only_preflight() -> dict[str, Any]:
    frozen = verify_frozen_inputs()
    return {"status": "SOURCE_ONLY_PASS_NO_AUTHORITY_NO_DISPATCH",
            "frozen_inputs": frozen, "r12_main_review": "NOT_CREATED_BY_CANDIDATE; path not inspected",
            "r12_once_binding": "NOT_CREATED_BY_CANDIDATE; path not inspected", "r8_entry_calls": 0,
            "public_calls": 0, "approval_created": False, "once_created": False,
            "COMSOL": "NOT_RUN", "Java": "NOT_RUN", "native": "NOT_RUN",
            "direction_status": "NOT_PROVEN", "scientific_acceptance": "NOT_EVALUATED",
            "authorized_callable": "probe.w23_actual_controller_r12.run_authorized_external_driver"}


def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--source-only", action="store_true")
    mode.add_argument("--check-imports", action="store_true")
    mode.add_argument("--run-authorized-once", action="store_true")
    for name in ("r12-review-sha256", "r12-once-sha256", "r8-review-sha256",
                 "r8-once-sha256", "r6-review-sha256", "r6-once-sha256",
                 "source-projection-sha256"):
        parser.add_argument("--" + name)
    args = parser.parse_args(argv)
    if args.run_authorized_once and any(getattr(args, name.replace("-", "_")) is None for name in (
            "r12_review_sha256", "r12_once_sha256", "r8_review_sha256", "r8_once_sha256",
            "r6_review_sha256", "r6_once_sha256", "source_projection_sha256")):
        parser.error("--run-authorized-once requires all seven exact authority/source SHA-256 arguments")
    if (args.source_only or args.check_imports) and any(getattr(args, name.replace("-", "_")) is not None for name in (
            "r12_review_sha256", "r12_once_sha256", "r8_review_sha256", "r8_once_sha256",
            "r6_review_sha256", "r6_once_sha256", "source_projection_sha256")):
        parser.error("--source-only and --check-imports accept no authority arguments")
    return args


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv)
    if args.source_only:
        print(json.dumps(source_only_preflight(), sort_keys=True, separators=(",", ":")))
        return 0
    if args.check_imports:
        print(json.dumps(check_imports_preflight(), sort_keys=True, separators=(",", ":")))
        return 0
    result = run_authorized_external_driver(
        r12_review_sha256=args.r12_review_sha256, r12_once_sha256=args.r12_once_sha256,
        r8_review_sha256=args.r8_review_sha256, r8_once_sha256=args.r8_once_sha256,
        r6_review_sha256=args.r6_review_sha256, r6_once_sha256=args.r6_once_sha256,
        source_projection_sha256=args.source_projection_sha256)
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0 if result.get("status") in {
        "PASS_R8_NORMAL_RETIREMENT_TERMINAL",
        "UNKNOWN_NO_REPLAY_ORIGINAL_OWNERS_TERMINAL_OBSERVED",
        "UNKNOWN_NO_REPLAY_TERMINAL_NO_ORIGINAL_OWNER_REFERENCES",
    } else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OuterControllerError, OSError, subprocess.SubprocessError) as exc:
        print(f"W23_R12_OUTER_DRIVER_BLOCKED: {type(exc).__name__}: {str(exc)[:800]}", file=sys.stderr)
        raise SystemExit(2)
