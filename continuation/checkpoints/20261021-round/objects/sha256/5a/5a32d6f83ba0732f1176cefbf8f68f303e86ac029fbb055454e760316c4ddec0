@pytest.mark.parametrize("mutation", [None, "legacy_mode", "wrong_scope", "wrong_mu_scale", "wrong_plan"])
def test_existing_offline_candidate_consumer_accepts_only_the_finite_survey_profile(tmp_path, monkeypatch, mutation):
    source_root = tmp_path / "repository"
    freeze_root = source_root / "docs/full_project_execution/w24/evidence/setup_candidate_"
    freeze_root.mkdir(parents=True)
    plan = source_root / "docs/full_project_execution/w24/W24_GEONL_PROPERTY_SURVEY_PLAN_R1.md"
    plan.parent.mkdir(parents=True, exist_ok=True)
    plan.write_text("survey plan fixture\n", encoding="utf-8")
    expected_sources = {"tools/java/W24CureCouponFixture.java": {
        "path": str(source_root / "tools/java/W24CureCouponFixture.java"), "sha256": "a" * 64}}
    monkeypatch.setattr(preflight, "REPO", source_root)
    monkeypatch.setattr(preflight, "PROPERTY_SURVEY_PLAN", plan)
    monkeypatch.setattr(preflight, "_frozen_hashes", lambda: expected_sources)
    candidate = _freeze_candidate(source_root, plan)
    if mutation == "legacy_mode":
        candidate["mode"] = "build_v2"
    elif mutation == "wrong_scope":
        candidate["setter_save_solve_compute_allowed"] = True
    elif mutation == "wrong_mu_scale":
        candidate["mu_scale"] = 1.25
    elif mutation == "wrong_plan":
        candidate["plan"]["sha256"] = "f" * 64
    path = freeze_root / "survey_candidate.json"
    path.write_text(json.dumps(candidate), encoding="utf-8")
    digest = preflight.sha256(path)
    if mutation is None:
        verified = preflight._verify_offline_candidate_freeze(path, digest)
        assert verified["survey_only"] is True
        assert verified["candidate_id"] == "W24-CURE-GEONL-SURVEY-01"
        assert verified["mu_scale"] == 1.0
    else:
        with pytest.raises(RuntimeError):
            preflight._verify_offline_candidate_freeze(path, digest)

