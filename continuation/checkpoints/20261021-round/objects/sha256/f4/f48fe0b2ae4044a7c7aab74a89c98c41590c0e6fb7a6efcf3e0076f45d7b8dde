"""Finite proposal integrity checks; the active reader remains current175-r13."""
import hashlib
import json
from pathlib import Path
import unittest
ROOT = Path(__file__).resolve().parents[1]
LOCK = ROOT / "tools/w26_application_sources_175_r14_prepared.lock.json"
MAP = ROOT / "tools/w26_profile_map_current_r14_proposed.json"
R13_LOCK = ROOT / "tools/w26_application_sources_175_r13_prepared.lock.json"
R13_SHA256 = "1dd9ba4db2264e44a6c778eff8d9d18d34709f7b954bff6252bce6cbede9b826"
CHANGED_PACKAGE_PATHS = ("comsol_mcp/_control_daemon.py", "comsol_mcp/_session_server.py", "comsol_mcp/data/science_recipes/SOURCE_ORIGINS.json", "comsol_mcp/data/science_recipes/java/W24StaticShapeFixture.java", "comsol_mcp/data/science_recipes/java/W24CureCouponFixture.java")
def digest(data): return hashlib.sha256(data).hexdigest()
class Current175R14ProposalTests(unittest.TestCase):
 def test_old_lock_unchanged_and_new_finite_member_set(self):
  self.assertEqual(digest(R13_LOCK.read_bytes()), R13_SHA256)
  old=json.loads(R13_LOCK.read_text()); lock=json.loads(LOCK.read_text())
  self.assertEqual(old["profile"],"current175-r13"); self.assertEqual(lock["profile"],"current175-r14")
  self.assertEqual((lock["member_count"],lock["package_count"],lock["root_count"]),(175,172,3))
  self.assertEqual(set(lock["members"]),set(old["members"]))
  changed={p for p in lock["members"] if lock["members"][p]!=old["members"][p]}
  self.assertEqual(changed,set(CHANGED_PACKAGE_PATHS))
  for rel in CHANGED_PACKAGE_PATHS:
   raw=(ROOT/rel).read_bytes(); row=lock["members"][rel]
   if isinstance(row,dict):
    self.assertEqual(row["bytes"],len(raw),rel); self.assertEqual(row["sha256"],digest(raw),rel)
   else: self.assertEqual(row,digest(raw),rel)
 def test_proposed_map_pins_new_lock_without_activating_reader(self):
  lockbytes=LOCK.read_bytes(); lock=json.loads(lockbytes); pm=json.loads(MAP.read_text())
  row=pm["current_profiles"]["current175-r14"]; supported=pm["supported_current_profiles"]["current175-r14"]
  self.assertEqual(row["source_lock_name"],LOCK.name); self.assertEqual(row["source_lock_sha256"],digest(lockbytes))
  self.assertEqual(supported["source_lock_name"],LOCK.name); self.assertEqual(supported["source_lock_sha256"],digest(lockbytes))
  self.assertEqual(row["source_profile"],"current175-r14")
  fp=digest(json.dumps(lock["members"],sort_keys=True,separators=(",",":"),ensure_ascii=False,allow_nan=False).encode())
  self.assertEqual(row["member_fingerprint_sha256"],fp)
  self.assertEqual(pm["current_profiles"]["current175-r13"]["source_lock_sha256"],R13_SHA256)
  active=json.loads((ROOT/"tools/w26_profile_map_current.json").read_text())
  self.assertNotIn("current175-r14",active["current_profiles"])
 def test_every_proposed_lock_member_matches_its_candidate_source_bytes(self):
  lock=json.loads(LOCK.read_text())
  self.assertEqual(len(lock["members"]),175)
  for rel,declared in lock["members"].items():
   raw=(ROOT/rel).read_bytes(); actual=digest(raw)
   expected=declared["sha256"] if isinstance(declared,dict) else declared
   self.assertEqual(actual,expected,rel)
   if isinstance(declared,dict): self.assertEqual(declared["bytes"],len(raw),rel)
 def test_r32_survey_is_additive_and_preserves_r31_v2_and_r5_setter(self):
  source=(ROOT/"tools/java/W24CureCouponFixture.java").read_text()
  package=(ROOT/"comsol_mcp/data/science_recipes/java/W24CureCouponFixture.java").read_bytes()
  origins=json.loads((ROOT/"comsol_mcp/data/science_recipes/SOURCE_ORIGINS.json").read_text())
  self.assertEqual(package,(ROOT/"tools/java/W24CureCouponFixture.java").read_bytes())
  origin=next(row for row in origins["files"] if row.get("origin")=="tools/java/W24CureCouponFixture.java")
  self.assertEqual(origin["sha256"],digest(package))

  def method_digest(signature):
   start=source.index(signature)
   opening=source.index("{",start)
   depth=0
   for end in range(opening,len(source)):
    if source[end]=="{": depth+=1
    elif source[end]=="}":
     depth-=1
     if depth==0: return digest(source[start:end+1].encode())
   self.fail("unterminated Java method: "+signature)

  self.assertEqual(method_digest("private static Map<String, Object> buildV2(Model model, Map<String, Object> args)"),"afb39257260c7ee01dd8f46f825aea778147c6d40dab121c19daf1d5f40c516b")
  self.assertEqual(method_digest("private static void configureV2GeometricNonlinearity(Model model)"),"f1183f676b8e59cff55b63838d6c3baa354f313dc19d1c99c4d4a41594b3ff8a")
  survey=source[source.index("private static Map<String, Object> buildV2GeometricNonlinearitySurvey"):source.index("private static Map<String, Object> observeV2GeometricNonlinearity")]
  self.assertIn("configureV2DoseSolverTolerance(model);",survey)
  self.assertNotIn("configureV2GeometricNonlinearity(model);",survey)
  self.assertNotIn("readbackV2(model)",survey)
if __name__=="__main__": unittest.main()
