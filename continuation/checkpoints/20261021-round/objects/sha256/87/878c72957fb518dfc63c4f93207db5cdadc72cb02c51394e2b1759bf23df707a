def canonical(value):
    return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False).encode()


def signature(st):
    return (st.st_dev,st.st_ino,st.st_mode,st.st_uid,st.st_nlink,st.st_size,st.st_mtime_ns,st.st_ctime_ns)


def pairs(rows):
    result={}
    for k,v in rows:
        if k in result:raise ValueError('duplicate key')
        result[k]=v
    return result


def read_file(path,*,private=False):
    path=Path(path)
    if not path.is_absolute() or path.resolve(strict=True)!=path:raise ValueError('canonical no-symlink path required')
    before=path.lstat()
    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=os.getuid() or before.st_nlink!=1
            or (private and stat.S_IMODE(before.st_mode)!=0o600)):
        raise ValueError('ordinary owner single-link file required')
    if before.st_size>64*1024*1024 or (private and before.st_size>2*1024*1024):raise ValueError('bounded input record required')
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        opened=os.fstat(fd);raw=b''
        while chunk:=os.read(fd,1048576):raw+=chunk
        after=os.fstat(fd)
    finally:os.close(fd)
    if any(signature(before)!=signature(st) for st in (opened,after,path.lstat())):raise ValueError('sameFD input changed')
    return raw,signature(before)


def read_json(path,sha):
    if not isinstance(sha,str) or not SHA.fullmatch(sha):raise ValueError('exact SHA required')
    raw,sig=read_file(path,private=True)
    if hashlib.sha256(raw).hexdigest()!=sha:raise ValueError('record SHA differs')
    value=json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in ()).throw(ValueError('nonfinite')))
    return value,sig


def _strict_json_bytes(raw):
    return json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in ()).throw(ValueError('nonfinite')))


def _profile_spec():
    raw,_=read_file(PROFILE_SPEC_PATH)
    if hashlib.sha256(raw).hexdigest()!=PROFILE_SPEC_SHA256:
        raise ValueError('frozen installed-profile spec SHA differs')
    spec=_strict_json_bytes(raw)
    if (set(spec)!={'schema','profile','scope','source_commit','product_lock_sha256',
            'runtime_build_result_sha256','runtime_main_acceptance_sha256','application_result_sha256',
            'application_main_acceptance_sha256','application_wheel_sha256','offline_bundle_sha256',
            'requirements_lock_sha256','requirements_lock_bytes','offline_wheels','wheelhouse_member_count',
            'expected_distributions','expected_distribution_count','python_version','base_python',
            'base_prefix','platform','ensurepip_version'}
            or spec['schema']!='SCIENCE76_CURRENT175_R13_INSTALLED_PROFILE_SPEC/1'
            or spec['profile']!='current175-r13-installed-macos-arm64'
            or spec['source_commit']!=SOURCE_COMMIT or len(spec['offline_wheels'])!=42
            or len(spec['expected_distributions'])!=43 or spec['expected_distribution_count']!=43):
        raise ValueError('closed installed-profile spec differs')
    return spec


def _normalized_dist_name(name):
    return re.sub(r'[-_.]+','-',name).lower()


def _dist_records(site_packages):
    rows=[]
    for dist in importlib.metadata.distributions(path=[str(site_packages)]):
        name=dist.metadata.get('Name')
        version=dist.version
        if not isinstance(name,str) or not name or not isinstance(version,str) or not version:
            raise ValueError('installed distribution metadata incomplete')
        rows.append({'name':_normalized_dist_name(name),'version':version})
    rows.sort(key=lambda row:(row['name'],row['version']))
    if len({row['name'] for row in rows})!=len(rows):
        raise ValueError('duplicate installed distribution name')
    return rows


def _no_source_shadow(source):
    source=Path(source).resolve(strict=True)
    for raw in sys.path:
        if not raw:
            continue
        try:
            resolved=Path(raw).resolve(strict=True)
        except (OSError,RuntimeError):
            continue
        if resolved==source or resolved==source/'comsol_mcp':
            raise ValueError('source snapshot would shadow installed package')


def _package_tree(source,freeze):
    source=Path(source).resolve(strict=True)
    expected=freeze.get('files')
    if not isinstance(expected,dict) or len(expected)!=172:
        raise ValueError('exact frozen current172 package map required')
    package=source/'comsol_mcp'
    if package.is_symlink() or not package.is_dir():
        raise ValueError('frozen source package root required')
    actual={p.relative_to(source).as_posix() for p in package.rglob('*')
            if p.is_file() and '__pycache__' not in p.parts}
    if actual!=set(expected):
        raise ValueError('frozen package member set differs')
    for rel,sha in expected.items():
        if not rel.startswith('comsol_mcp/') or not isinstance(sha,str) or not SHA.fullmatch(sha):
            raise ValueError('invalid frozen package member')
        p=source/rel
        raw,_=read_file(p)
        if p.is_symlink() or p.lstat().st_mode&0o222 or hashlib.sha256(raw).hexdigest()!=sha:
            raise ValueError('frozen source package member differs: '+rel)
    return expected


def _resolve_venv(expected_venv):
    root=Path(expected_venv)
    if not root.is_absolute() or root.is_symlink() or root.resolve(strict=True)!=root:
        raise ValueError('canonical installed venv path required')
    st=root.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid!=os.getuid():
        raise ValueError('owned installed venv directory required')
    return root


def _live_installed_state(expected_venv,source,freeze):
    spec=_profile_spec();venv=_resolve_venv(expected_venv)
    if (set(freeze)!={'schema','profile','active_manifest','active_manifest_sha256','active_source_fingerprint',
            'product_lock','product_lock_sha256','files','source_commit','scope','uncommitted_source_delta'}
            or freeze.get('schema')!='SCIENCE_CURRENT175_R13_SOURCE_FREEZE_V2'
            or freeze.get('profile')!='current175-r13' or freeze.get('source_commit')!=SOURCE_COMMIT
            or freeze.get('product_lock_sha256')!=spec['product_lock_sha256']
            or not isinstance(freeze.get('active_source_fingerprint'),str)
            or not SHA.fullmatch(freeze['active_source_fingerprint'])
            or not isinstance(freeze.get('active_manifest_sha256'),str)
            or not SHA.fullmatch(freeze['active_manifest_sha256'])
            or not isinstance(freeze.get('uncommitted_source_delta'),list)):
        raise ValueError('complete exact current R13 source freeze required')
    lock_rel=freeze['product_lock']
    if (not isinstance(lock_rel,str) or Path(lock_rel).is_absolute() or '..' in Path(lock_rel).parts
            or '\\' in lock_rel):
        raise ValueError('relative pinned current175 product lock path required')
    lock_path=Path(source).resolve(strict=True)/lock_rel
    lock_raw,_=read_file(lock_path)
    if hashlib.sha256(lock_raw).hexdigest()!=spec['product_lock_sha256']:
        raise ValueError('current175-r13 product lock bytes differ')
    if Path(sys.prefix).resolve(strict=True)!=venv or Path(sys.executable).resolve(strict=True)!=venv/'bin/python3.12':
        raise ValueError('actual Python prefix/executable differs from bound venv')
    if Path(sys.base_prefix).resolve(strict=True)!=Path(spec['base_prefix']).resolve(strict=True):
        raise ValueError('venv base prefix differs from accepted R16 runtime')
    if sys.version.split()[0]!=spec['python_version'] or platform.machine()!='arm64' or sys.platform!='darwin':
        raise ValueError('exact Python/macOS ARM runtime required')
    _no_source_shadow(source)
    site=Path(sysconfig.get_paths()['purelib']).resolve(strict=True)
    expected_site=venv/'lib/python3.12/site-packages'
    if site!=expected_site or site.is_symlink():
        raise ValueError('venv site-packages path differs')
    package=site/'comsol_mcp'
    expected_files=_package_tree(source,freeze)
    if package.is_symlink() or not package.is_dir():
        raise ValueError('installed application package absent')
    actual_files={p.relative_to(site).as_posix() for p in package.rglob('*')
                  if p.is_file() and '__pycache__' not in p.parts}
    if actual_files!=set(expected_files):
        raise ValueError('installed package member set differs')
    for rel,sha in expected_files.items():
        p=site/rel
        raw,_=read_file(p)
        if p.is_symlink() or hashlib.sha256(raw).hexdigest()!=sha:
            raise ValueError('installed package member differs: '+rel)
    distributions=_dist_records(site)
    if distributions!=spec['expected_distributions']:
        raise ValueError('installed exact locked distribution set differs')
    origins={}
    for name in ('comsol_mcp','mcp','psutil'):
        found=importlib.util.find_spec(name)
        if found is None or found.origin is None:
            raise ValueError('required installed import absent: '+name)
        origin=Path(found.origin).resolve(strict=True)
        if not origin.is_relative_to(site):
            raise ValueError('required import is not from venv site-packages: '+name)
        origins[name]=str(origin)
    if Path(origins['comsol_mcp'])!=package/'__init__.py':
        raise ValueError('production package import origin differs')
    return {'spec':spec,'venv':venv,'site':site,'package':package,'package_files':expected_files,
            'distributions':distributions,'origins':origins}


def capture_installed_profile(output,source,freeze_path,freeze_sha256,expected_venv):
    """Capture a new local readback profile after the exact offline installation."""
    freeze_raw,_=read_file(freeze_path)
    if hashlib.sha256(freeze_raw).hexdigest()!=freeze_sha256:
        raise ValueError('current source freeze SHA differs')
    freeze=_strict_json_bytes(freeze_raw)
    if (freeze.get('profile')!='current175-r13' or freeze.get('source_commit')!=SOURCE_COMMIT
            or freeze.get('product_lock_sha256')!='1dd9ba4db2264e44a6c778eff8d9d18d34709f7b954bff6252bce6cbede9b826'):
        raise ValueError('current R13 source freeze identity differs')
    live=_live_installed_state(expected_venv,source,freeze)
    venv=live['venv'];site=live['site'];package=live['package'];python=Path(sys.executable).resolve(strict=True)
    rows={'schema':INSTALLED_PROFILE_SCHEMA,'profile':live['spec']['profile'],
          'source_commit':SOURCE_COMMIT,'product_lock_sha256':live['spec']['product_lock_sha256'],
          'runtime_build_result_sha256':live['spec']['runtime_build_result_sha256'],
          'runtime_main_acceptance_sha256':live['spec']['runtime_main_acceptance_sha256'],
          'application_result_sha256':live['spec']['application_result_sha256'],
          'application_main_acceptance_sha256':live['spec']['application_main_acceptance_sha256'],
          'application_wheel_sha256':live['spec']['application_wheel_sha256'],
          'offline_bundle_sha256':live['spec']['offline_bundle_sha256'],
          'requirements_lock_sha256':live['spec']['requirements_lock_sha256'],
          'profile_spec_sha256':PROFILE_SPEC_SHA256,'source_freeze_sha256':freeze_sha256,
          'venv_root':str(venv),'venv_root_identity':list(signature(venv.lstat())),
          'python_executable':str(python),'python_identity':list(signature(python.lstat())),
          'python_version':sys.version.split()[0],'base_prefix':str(Path(sys.base_prefix).resolve(strict=True)),
          'site_packages':str(site),'site_packages_identity':list(signature(site.lstat())),
          'package_root':str(package),'package_root_identity':list(signature(package.lstat())),
          'package_files':live['package_files'],'distributions':live['distributions'],
          'import_origins':live['origins'],'source_freeze_profile':freeze['profile']}
    out=Path(output)
    if not out.is_absolute() or out.resolve(strict=False)!=out or out.exists() or out.is_symlink():
        raise ValueError('new canonical installed-profile output path required')
    parent=out.parent
    pst=parent.lstat()
    if (parent.resolve(strict=True)!=parent or not stat.S_ISDIR(pst.st_mode) or pst.st_uid!=os.getuid()
            or stat.S_IMODE(pst.st_mode)!=0o700):
        raise ValueError('private owner profile directory required')
    raw=canonical(rows)+b'\n'
    fd=os.open(out,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    dirfd=os.open(parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    try:
        with os.fdopen(fd,'wb',closefd=False) as stream:stream.write(raw);stream.flush();os.fsync(fd)
        os.fsync(dirfd)
    finally:os.close(fd);os.close(dirfd)
    return hashlib.sha256(raw).hexdigest()


def verify_installed_profile(profile_path,profile_sha256,source,freeze,*,expected_venv,source_freeze_sha256):
    profile,_=read_json(profile_path,profile_sha256)
    if not isinstance(source_freeze_sha256,str) or not SHA.fullmatch(source_freeze_sha256):
        raise ValueError('exact source freeze SHA required')
    keys={'schema','profile','source_commit','product_lock_sha256','runtime_build_result_sha256',
          'runtime_main_acceptance_sha256','application_result_sha256','application_main_acceptance_sha256',
          'application_wheel_sha256','offline_bundle_sha256','requirements_lock_sha256','profile_spec_sha256',
          'source_freeze_sha256','venv_root','venv_root_identity','python_executable','python_identity',
          'python_version','base_prefix','site_packages','site_packages_identity','package_root',
          'package_root_identity','package_files','distributions','import_origins','source_freeze_profile'}
    if set(profile)!=keys or profile['schema']!=INSTALLED_PROFILE_SCHEMA:
        raise ValueError('closed exact installed-profile record required')
    live=_live_installed_state(profile['venv_root'] if expected_venv is None else expected_venv,source,freeze)
    spec=live['spec'];venv=live['venv'];site=live['site'];package=live['package'];python=Path(sys.executable).resolve(strict=True)
    expected={'schema':INSTALLED_PROFILE_SCHEMA,'profile':spec['profile'],'source_commit':SOURCE_COMMIT,
          'product_lock_sha256':spec['product_lock_sha256'],'runtime_build_result_sha256':spec['runtime_build_result_sha256'],
          'runtime_main_acceptance_sha256':spec['runtime_main_acceptance_sha256'],
          'application_result_sha256':spec['application_result_sha256'],
          'application_main_acceptance_sha256':spec['application_main_acceptance_sha256'],
          'application_wheel_sha256':spec['application_wheel_sha256'],'offline_bundle_sha256':spec['offline_bundle_sha256'],
          'requirements_lock_sha256':spec['requirements_lock_sha256'],'profile_spec_sha256':PROFILE_SPEC_SHA256,
          'source_freeze_sha256':source_freeze_sha256,'venv_root':str(venv),
          'venv_root_identity':list(signature(venv.lstat())),'python_executable':str(python),
          'python_identity':list(signature(python.lstat())),'python_version':sys.version.split()[0],
          'base_prefix':str(Path(sys.base_prefix).resolve(strict=True)),'site_packages':str(site),
          'site_packages_identity':list(signature(site.lstat())),'package_root':str(package),
          'package_root_identity':list(signature(package.lstat())),'package_files':live['package_files'],
          'distributions':live['distributions'],'import_origins':live['origins'],
          'source_freeze_profile':freeze['profile']}
    if profile!=expected:
        raise ValueError('installed profile first-record or package/distribution readback differs')
    return profile


def namespace_absent(path):
    path=Path(path)
    if path.parent!=Path('/private/tmp') or path.parent.resolve()!=path.parent or path.exists() or path.is_symlink():
        raise ValueError('fresh direct private native namespace absent required')


def source_identity(binding):
    source=Path(binding['source_root'])
    if source.resolve(strict=True)!=source or source.lstat().st_uid!=os.getuid() or source.lstat().st_mode&0o222:
        raise ValueError('canonical owner readonly source copy required')
    for member in source.rglob('*'):
        if member.is_symlink() or (member.is_dir() and (member.lstat().st_uid!=os.getuid() or member.lstat().st_mode&0o222)):
            raise ValueError('source symlink or writable directory forbidden')
    files=binding['source_files']
    if not isinstance(files,dict) or not files:raise ValueError('closed nonempty source inventory required')
    actual={p.relative_to(source).as_posix() for p in source.rglob('*') if p.is_file() and '__pycache__' not in p.parts}
    if actual!=set(files):raise ValueError('source file set differs')
    for rel,sha in files.items():
        if not isinstance(sha,str) or not SHA.fullmatch(sha):raise ValueError('source SHA required')
        p=source/rel;raw,_=read_file(p)
        if not p.is_relative_to(source) or p.lstat().st_mode&0o222 or hashlib.sha256(raw).hexdigest()!=sha:
            raise ValueError('readonly source SHA differs')
    if hashlib.sha256(canonical(files)).hexdigest()!=binding['source_sha256']:raise ValueError('source closure differs')
    if Path(__file__).resolve()!=source/'tools/science_native_once_entry.py':raise ValueError('fixed actual entry import origin differs')


def validate_production_identity(binding, appfiles):
    if binding['schema']==BINDING_SCHEMA:
        count, key = 174, 'app4_production_sha256'
    elif binding['schema'] in {CURRENT_BINDING_SCHEMA,INSTALLED_BINDING_SCHEMA}:
        count, key = 175, 'production_sha256'
        package={p for p in appfiles if p.startswith('comsol_mcp/')}
        if len(package)!=172 or 'comsol_mcp/_windows_state_restore.py' not in package:
            raise ValueError('exact current172 package membership differs')
    else:
        raise ValueError('unknown production binding schema')
    if len(appfiles)!=count or hashlib.sha256(canonical(appfiles)).hexdigest()!=binding[key]:
        raise ValueError('exact schema-bound production source differs')


def validate(binding_path,binding_sha,approval_path,approval_sha,nonce):
    binding,bsig=read_json(binding_path,binding_sha);approval,asig=read_json(approval_path,approval_sha)
    keys = (BINDING_KEYS if binding.get('schema')==BINDING_SCHEMA else
            CURRENT_BINDING_KEYS if binding.get('schema')==CURRENT_BINDING_SCHEMA else
            INSTALLED_BINDING_KEYS if binding.get('schema')==INSTALLED_BINDING_SCHEMA else None)
    if keys is None or set(binding)!=keys:raise ValueError('closed binding required')
    if set(approval)!=APPROVAL_KEYS or approval['schema']!=APPROVAL_SCHEMA:raise ValueError('closed Main approval required')
    authority=Path(binding['authority']);before=authority.lstat()
    if (authority.resolve()!=authority or authority.parent!=Path('/private/tmp') or not stat.S_ISDIR(before.st_mode)
            or before.st_uid!=os.getuid() or stat.S_IMODE(before.st_mode)!=0o700
            or Path(binding_path)!=authority/'BINDING.json' or Path(approval_path)!=authority/'MAIN_APPROVAL.json'):
        raise ValueError('private canonical fixed authority paths required')
    if (approval['status']!='APPROVED_BY_MAIN_FRESH_SCOPED' or approval['issuer']!='Main'
            or approval['approval_scope']!='SCIENCE76_REAL_PUBLIC_RECIPE_UNSOLVED_ONLY'
            or approval['binding_sha256']!=binding_sha or approval['activity_id']!=binding['activity_id']
            or not isinstance(nonce,str) or not re.fullmatch(r'[0-9a-f]{64}',nonce) or approval['nonce']!=nonce):
        raise ValueError('Main exact fresh approval/nonce differs')
    expires=datetime.fromisoformat(approval['expires_at_utc'].replace('Z','+00:00'))
    if expires.tzinfo is None or expires<=datetime.now(timezone.utc):raise ValueError('Main approval expired')
    namespace_absent(binding['runtime_namespace']);source_identity(binding)
    if binding['activity_id']!=Path(binding['runtime_namespace']).name:raise ValueError('activity/namespace differs')
    if binding['schema']==INSTALLED_BINDING_SCHEMA:
        if binding.get('execution_mode')!='installed-current175-r13' or not isinstance(binding.get('installed_venv'),str):
            raise ValueError('explicit current R13 installed mode and venv required')
        if (not isinstance(binding.get('installed_profile_sha256'),str)
                or not SHA.fullmatch(binding['installed_profile_sha256'])):
            raise ValueError('exact installed profile SHA required')
        if Path(binding['installed_profile'])!=authority/'INSTALLED_PROFILE.json':
            raise ValueError('installed profile must be the fresh authority member')
        venv=Path(binding['installed_venv'])
        if not venv.is_absolute() or venv.resolve(strict=True)!=venv:
            raise ValueError('canonical absolute installed venv required')
    raw,_=read_file(Path(__file__).resolve())
    if hashlib.sha256(raw).hexdigest()!=approval['entry_sha256']:raise ValueError('actual entry differs')
    source=Path(binding['source_root']);sys.path.insert(0,str(source/'tools'))
    import science_recipe_cycle as science
    if Path(science.__file__).resolve()!=source/'tools/science_recipe_cycle.py':raise ValueError('fixed helper origin differs')
    plan=science.validate_plan(binding['plan'],binding['plan_sha256'],source=source,runtime=binding['runtime_namespace'],
         installation=binding['argv'][binding['argv'].index('--installation')+1],java_home=binding['argv'][binding['argv'].index('--java-home')+1])
    freeze,_=read_json(binding['source_freeze'],binding['source_freeze_sha256'])
    if binding['schema']==INSTALLED_BINDING_SCHEMA:
        if freeze.get('source_commit')!=SOURCE_COMMIT:
            raise ValueError('actual current product source commit differs')
        verify_installed_profile(binding['installed_profile'],binding['installed_profile_sha256'],source,freeze,
            expected_venv=binding['installed_venv'],source_freeze_sha256=binding['source_freeze_sha256'])
    if freeze['files']!={p:sha for p,sha in binding['source_files'].items() if p.startswith('comsol_mcp/')}:
        raise ValueError('production freeze differs from closed source inventory')
    appfiles={p:sha for p,sha in binding['source_files'].items() if p.startswith('comsol_mcp/') or p in {'LICENSE','README.md','pyproject.toml'}}
    validate_production_identity(binding, appfiles)
    if not isinstance(binding['sdk_receipt_sha256'],str) or not SHA.fullmatch(binding['sdk_receipt_sha256']):raise ValueError('SDK receipt SHA required')
    if binding['budget']!=plan['budget'] or approval['budget']!=plan['budget'] or plan['budget']['public_calls']!=76:
        raise ValueError('exact 76-call science budget differs')
    expected=[sys.executable,str(source/'tools/run_v3_public_mcp_smoke.py'),'--source',str(source),'--freeze',binding['source_freeze'],
      '--runtime',binding['runtime_namespace'],'--installation',plan['runtime_identity']['comsol_root'],'--java-home',plan['runtime_identity']['java_home'],
      '--science-recipes','--science-plan',binding['plan'],'--science-plan-sha256',binding['plan_sha256']]
    if binding['schema']==INSTALLED_BINDING_SCHEMA:
        expected += ['--execution-mode','installed-current175-r13','--installed-profile',binding['installed_profile'],
                     '--installed-profile-sha256',binding['installed_profile_sha256'],'--installed-venv',binding['installed_venv']]
    if binding['argv']!=expected:raise ValueError('fixed literal executable argv differs')
    env={'HOME':str(Path.home()),'PATH':'/usr/bin:/bin:/usr/sbin:/sbin','LANG':'C','LC_ALL':'C',
         'PYTHONUTF8':'1','PYTHONDONTWRITEBYTECODE':'1'}
    if binding['schema']!=INSTALLED_BINDING_SCHEMA:
        env['PYTHONPATH']=str(source)
    if binding['environment']!=env:raise ValueError('fixed host environment differs')
    # Recheck all pinned records/authority after source/runtime reads.
    if (read_file(binding_path,private=True)[1]!=bsig or read_file(approval_path,private=True)[1]!=asig
            or signature(authority.lstat())!=signature(before)):
        raise ValueError('authority/approval changed during prebirth verification')
    return binding,before


def ensure_quiescent():
    import psutil
    for process in psutil.process_iter(['pid','name','create_time']):
        name=process.info.get('name') or ''
        if 'comsol' in name.lower() or name.lower() in {'java','java.exe'}:
            raise ValueError('existing native/JDK process; no new birth authorized')


def consume_and_exec(binding,authority_before,binding_sha,approval_sha,nonce):
    authority=Path(binding['authority']);fd=os.open(authority,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    try:
        if signature(os.fstat(fd))!=signature(authority_before):raise ValueError('authority directory changed')
        ensure_quiescent();namespace_absent(binding['runtime_namespace'])
        oncefd=os.open('ONCE_CONSUMED.json',os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=fd)
        try:
            data=canonical({'schema':'science-native-once-consumed/1','binding_sha256':binding_sha,
                 'approval_sha256':approval_sha,'nonce_sha256':hashlib.sha256(nonce.encode()).hexdigest(),
                 'activity_id':binding['activity_id'],'state':'CONSUMED_BEFORE_EXEC_NO_AUTOMATIC_RETRY'})
            with os.fdopen(oncefd,'wb',closefd=False) as stream:stream.write(data);stream.flush();os.fsync(oncefd)
        finally:os.close(oncefd)
        os.fsync(fd)
        namespace_absent(binding['runtime_namespace']);source_identity(binding)
        current=authority.lstat()
        if (current.st_dev,current.st_ino,current.st_uid,current.st_mode)!=(authority_before.st_dev,authority_before.st_ino,authority_before.st_uid,authority_before.st_mode):
            raise ValueError('authority original directory lost after once')
        read_json(authority/'BINDING.json',binding_sha);read_json(authority/'MAIN_APPROVAL.json',approval_sha)
        if binding['schema']==INSTALLED_BINDING_SCHEMA:
            freeze,_=read_json(binding['source_freeze'],binding['source_freeze_sha256'])
            verify_installed_profile(binding['installed_profile'],binding['installed_profile_sha256'],
                Path(binding['source_root']),freeze,expected_venv=binding['installed_venv'],
                source_freeze_sha256=binding['source_freeze_sha256'])
        os.chdir(binding['source_root'])
        os.execve(binding['argv'][0],binding['argv'],binding['environment'])
    finally:os.close(fd)


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--capture-installed-profile',action='store_true')
    parser.add_argument('--profile-output',type=Path)
    parser.add_argument('--source-root',type=Path)
    parser.add_argument('--source-freeze',type=Path)
    parser.add_argument('--source-freeze-sha256')
    parser.add_argument('--installed-venv',type=Path)
    for name in ['binding','binding-sha256','approval','approval-sha256','nonce']:parser.add_argument('--'+name)
    args=parser.parse_args(argv)
    if args.capture_installed_profile:
        if any((args.binding,args.binding_sha256,args.approval,args.approval_sha256,args.nonce)):
            parser.error('profile capture is a separate pre-effect operation')
        if not all((args.profile_output,args.source_root,args.source_freeze,args.source_freeze_sha256,args.installed_venv)):
            parser.error('complete profile capture inputs required')
        print(json.dumps({'status':'PROFILE_CAPTURED','profile_sha256':capture_installed_profile(
            args.profile_output,args.source_root,args.source_freeze,args.source_freeze_sha256,args.installed_venv)},sort_keys=True))
        return 0
    if not all((args.binding,args.binding_sha256,args.approval,args.approval_sha256,args.nonce)):
        parser.error('exact Main binding and approval arguments required')
    binding,before=validate(Path(args.binding),args.binding_sha256,Path(args.approval),args.approval_sha256,args.nonce)
    consume_and_exec(binding,before,args.binding_sha256,args.approval_sha256,args.nonce)
    return 1

if __name__=='__main__':raise SystemExit(main())
