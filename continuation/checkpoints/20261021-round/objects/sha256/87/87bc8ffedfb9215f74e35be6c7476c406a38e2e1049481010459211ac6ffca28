            or frozen.get("source_projection_sha256") != R6_SOURCE_MANIFEST_SHA256
            or frozen.get("source_map_sha256") != R6_SOURCE_MAP_SHA256
            or frozen.get("packet_manifest_sha256") != R6_PACKET_MANIFEST_SHA256
            or frozen.get("entry_sha256") != R6_ENTRY_SHA256
            or frozen.get("main_source_review_sha256") != R6_MAIN_REVIEW_SHA256
            or inherited.get("reviewed_source_projection_sha256") != R6_REVIEWED_SOURCE_MANIFEST_SHA256
            or inherited.get("reviewed_packet_manifest_sha256") != R6_REVIEWED_PACKET_MANIFEST_SHA256
            or inherited.get("review_sha256") != R6_MAIN_REVIEW_SHA256
            or source_plan.get("pinned_r5_lifecycle_helpers", {}).get("sha256") != R5_CONTROLLER_SHA256
            or source_plan.get("outer_authority", {}).get("main_review") !=
                "NOT_CREATED; Main must bind this R8 source packet, fresh R6 runtime review/once, and new roots/budgets"
            or source_plan.get("outer_authority", {}).get("once_binding") !=
                "NOT_CREATED; exactly one normal attempt; Main-owned only"
            or source_plan.get("public_budgets") != PUBLIC_BUDGETS
