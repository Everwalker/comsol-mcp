            or source_map.get("candidate_root") != str(OUTER_ROOT)
            or source_map.get("frozen_r6_source_projection_sha256") != R6_SOURCE_MANIFEST_SHA256
            or source_map.get("frozen_r6_source_map_sha256") != R6_SOURCE_MAP_SHA256
